<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Deep Work OS — Cognitive Architecture for Deep Focus</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        :root {
            --bg-primary: #0a0c10;
            --bg-surface: #12161f;
            --bg-surface-elevated: #1a202c;
            --bg-glass: rgba(18, 22, 31, 0.75);
            --border-subtle: rgba(255, 255, 255, 0.08);
            --border-focus: rgba(99, 102, 241, 0.4);
            
            --text-main: #f1f5f9;
            --text-muted: #94a3b8;
            --text-dim: #64748b;
            
            --accent-primary: #6366f1;
            --accent-primary-hover: #4f46e5;
            --accent-glow: rgba(99, 102, 241, 0.15);
            --accent-emerald: #10b981;
            --accent-amber: #f59e0b;
            --accent-rose: #f43f5e;
            
            --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            
            --radius-sm: 8px;
            --radius-md: 14px;
            --radius-lg: 20px;
            --radius-full: 9999px;
            
            --transition-smooth: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* Light theme overrides */
        body.theme-light {
            --bg-primary: #f8fafc;
            --bg-surface: #ffffff;
            --bg-surface-elevated: #f1f5f9;
            --bg-glass: rgba(255, 255, 255, 0.85);
            --border-subtle: rgba(0, 0, 0, 0.08);
            --border-focus: rgba(99, 102, 241, 0.4);
            
            --text-main: #0f172a;
            --text-muted: #475569;
            --text-dim: #94a3b8;
            
            --accent-glow: rgba(99, 102, 241, 0.08);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            outline: none;
        }

        body {
            background-color: var(--bg-primary);
            color: var(--text-main);
            font-family: var(--font-sans);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
            transition: var(--transition-smooth);
        }

        /* App Container */
        #app-root {
            display: grid;
            grid-template-rows: auto 1fr auto;
            min-height: 100vh;
            position: relative;
        }

        header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 18px 32px;
            border-bottom: 1px solid var(--border-subtle);
            background: var(--bg-glass);
            backdrop-filter: blur(12px);
            position: sticky;
            top: 0;
            z-index: 50;
            transition: var(--transition-smooth);
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 700;
            font-size: 1.1rem;
            letter-spacing: -0.02em;
        }

        .brand-icon {
            width: 32px;
            height: 32px;
            background: linear-gradient(135deg, var(--accent-primary), #818cf8);
            border-radius: var(--radius-sm);
            display: grid;
            place-items: center;
            color: white;
            box-shadow: 0 4px 12px var(--accent-glow);
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            border-radius: var(--radius-sm);
            font-size: 0.875rem;
            font-weight: 500;
            font-family: var(--font-sans);
            cursor: pointer;
            border: 1px solid var(--border-subtle);
            background: var(--bg-surface);
            color: var(--text-main);
            transition: var(--transition-smooth);
        }

        .btn:hover {
            border-color: var(--accent-primary);
            background: var(--bg-surface-elevated);
        }

        .btn-primary {
            background: var(--accent-primary);
            color: white;
            border: none;
        }

        .btn-primary:hover {
            background: var(--accent-primary-hover);
            box-shadow: 0 4px 14px var(--accent-glow);
        }

        .btn-icon {
            padding: 8px;
            border-radius: var(--radius-sm);
        }

        main {
            display: grid;
            grid-template-columns: 320px 1fr 340px;
            gap: 24px;
            padding: 24px 32px;
            max-width: 1700px;
            margin: 0 auto;
            width: 100%;
            transition: var(--transition-smooth);
        }

        /* Monk Mode Hide UI */
        body.monk-mode header,
        body.monk-mode .sidebar-left,
        body.monk-mode .sidebar-right,
        body.monk-mode footer {
            opacity: 0;
            pointer-events: none;
            transform: translateY(-10px);
        }

        body.monk-mode main {
            grid-template-columns: 1fr;
            max-width: 800px;
        }

        .monk-mode-exit {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 100;
            display: none;
        }

        body.monk-mode .monk-mode-exit {
            display: flex;
        }

        /* Panel Container Base */
        .panel {
            background: var(--bg-surface);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-md);
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 20px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        }

        .panel-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .panel-title {
            font-size: 0.95rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .audio-node-card {
            background: var(--bg-surface-elevated);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-sm);
            padding: 14px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .audio-node-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .audio-node-title {
            font-weight: 600;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .slider-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .slider-label {
            display: flex;
            justify-content: space-between;
            font-size: 0.75rem;
            color: var(--text-dim);
            font-family: var(--font-mono);
        }

        input[type="range"] {
            -webkit-appearance: none;
            width: 100%;
            height: 5px;
            border-radius: var(--radius-full);
            background: var(--border-subtle);
            outline: none;
        }

        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background: var(--accent-primary);
            cursor: pointer;
            transition: transform 0.1s ease;
        }

        input[type="range"]::-webkit-slider-thumb:hover {
            transform: scale(1.2);
        }

        .preset-pills {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }

        .pill {
            padding: 4px 10px;
            border-radius: var(--radius-full);
            font-size: 0.75rem;
            background: var(--bg-surface-elevated);
            border: 1px solid var(--border-subtle);
            color: var(--text-muted);
            cursor: pointer;
            transition: var(--transition-smooth);
        }

        .pill.active {
            background: var(--accent-glow);
            border-color: var(--accent-primary);
            color: var(--accent-primary);
        }

        .center-stage {
            display: flex;
            flex-direction: column;
            gap: 24px;
            align-items: center;
            justify-content: center;
        }

        .timer-card {
            width: 100%;
            background: var(--bg-surface);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-lg);
            padding: 40px;
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
            box-shadow: 0 8px 32px rgba(0,0,0,0.1);
        }

        .timer-ring-wrapper {
            position: relative;
            width: 320px;
            height: 320px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 20px 0;
        }

        .timer-svg {
            transform: rotate(-90deg);
            width: 100%;
            height: 100%;
        }

        .timer-bg-circle {
            stroke: var(--border-subtle);
            stroke-width: 8;
            fill: none;
        }

        .timer-progress-circle {
            stroke: var(--accent-primary);
            stroke-width: 8;
            stroke-dasharray: 880;
            stroke-dashoffset: 0;
            stroke-linecap: round;
            fill: none;
            transition: stroke-dashoffset 0.5s ease;
        }

        .timer-display {
            position: absolute;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .time-digits {
            font-family: var(--font-mono);
            font-size: 3.8rem;
            font-weight: 500;
            letter-spacing: -0.05em;
        }

        .phase-indicator {
            margin-top: 6px;
            padding: 4px 12px;
            border-radius: var(--radius-full);
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            background: var(--accent-glow);
            color: var(--accent-primary);
        }

        .current-intent-card {
            width: 100%;
            background: var(--bg-surface-elevated);
            border: 1px border var(--border-subtle);
            border-left: 4px solid var(--accent-primary);
            border-radius: var(--radius-sm);
            padding: 16px;
            margin-bottom: 20px;
        }

        .intent-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--text-dim);
            margin-bottom: 4px;
        }

        .intent-text {
            font-size: 1.05rem;
            font-weight: 600;
            color: var(--text-main);
        }

        .timer-controls {
            display: flex;
            gap: 16px;
            margin-top: 10px;
        }

        .btn-large {
            padding: 12px 32px;
            font-size: 1rem;
            border-radius: var(--radius-md);
        }

        .ledger-input-group {
            display: flex;
            gap: 8px;
        }

        .input-field {
            width: 100%;
            padding: 10px 14px;
            background: var(--bg-surface-elevated);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-sm);
            color: var(--text-main);
            font-family: var(--font-sans);
            font-size: 0.875rem;
            transition: var(--transition-smooth);
        }

        .input-field:focus {
            border-color: var(--accent-primary);
            box-shadow: 0 0 0 2px var(--accent-glow);
        }

        .ledger-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
            max-height: 280px;
            overflow-y: auto;
        }

        .ledger-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: var(--bg-surface-elevated);
            padding: 10px 12px;
            border-radius: var(--radius-sm);
            font-size: 0.85rem;
            border-left: 3px solid var(--accent-amber);
            animation: fadeIn 0.2s ease;
        }

        .ledger-item.tag-urgent {
            border-left-color: var(--accent-rose);
        }

        .ledger-item.completed {
            opacity: 0.5;
            text-decoration: line-through;
        }

        .metrics-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .metric-card {
            background: var(--bg-surface-elevated);
            padding: 14px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border-subtle);
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .metric-value {
            font-family: var(--font-mono);
            font-size: 1.4rem;
            font-weight: 600;
            color: var(--accent-primary);
        }

        .metric-title {
            font-size: 0.75rem;
            color: var(--text-dim);
        }

        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(8px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            opacity: 0;
            pointer-events: none;
            transition: var(--transition-smooth);
        }

        .modal-overlay.active {
            opacity: 1;
            pointer-events: all;
        }

        .modal-card {
            background: var(--bg-surface);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-lg);
            width: 90%;
            max-width: 520px;
            padding: 32px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.3);
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .modal-title {
            font-size: 1.25rem;
            font-weight: 700;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .form-label {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-muted);
        }

        /* Responsive Breakpoints */
        @media (max-width: 1200px) {
            main {
                grid-template-columns: 280px 1fr;
            }
            .sidebar-right {
                grid-column: span 2;
            }
        }

        @media (max-width: 768px) {
            main {
                grid-template-columns: 1fr;
            }
            .sidebar-right {
                grid-column: span 1;
            }
            header {
                padding: 16px;
            }
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(4px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>
    <div id="app-root">
        <!-- Top Navigation -->
        <header>
            <div class="brand-logo">
                <div class="brand-icon"><i data-lucide="brain-circuit"></i></div>
                <span>DEEP WORK OS</span>
            </div>
            
            <div class="header-actions">
                <button class="btn" id="monk-toggle-btn" title="Toggle Monk Mode (Alt+M)">
                    <i data-lucide="eye-off"></i> Monk Mode
                </button>
                <button class="btn btn-icon" id="theme-toggle-btn" title="Toggle Theme">
                    <i data-lucide="moon"></i>
                </button>
            </div>
        </header>

        <!-- Main Workplace Workspace -->
        <main>
            <!-- Left Panel: Soundscape Synthesizer -->
            <aside class="sidebar-left panel">
                <div class="panel-header">
                    <span class="panel-title"><i data-lucide="waves"></i> Soundscape Engine</span>
                    <button class="btn btn-icon" id="master-audio-toggle" title="Toggle Audio Generator">
                        <i data-lucide="power"></i>
                    </button>
                </div>

                <!-- Binaural Beat Control -->
                <div class="audio-node-card">
                    <div class="audio-node-head">
                        <span class="audio-node-title"><i data-lucide="activity"></i> Binaural Protocol</span>
                        <input type="checkbox" id="binaural-enable">
                    </div>
                    <div class="preset-pills">
                        <span class="pill active" data-preset="alpha">Alpha (10Hz Focus)</span>
                        <span class="pill" data-preset="theta">Theta (6Hz Flow)</span>
                        <span class="pill" data-preset="gamma">Gamma (40Hz Peak)</span>
                    </div>
                    <div class="slider-group">
                        <div class="slider-label"><span>Intensity</span><span id="binaural-vol-txt">40%</span></div>
                        <input type="range" id="binaural-vol" min="0" max="100" value="40">
                    </div>
                </div>

                <!-- Brown Noise Base Layer -->
                <div class="audio-node-card">
                    <div class="audio-node-head">
                        <span class="audio-node-title"><i data-lucide="wind"></i> Brown Noise Layer</span>
                        <input type="checkbox" id="noise-enable">
                    </div>
                    <div class="slider-group">
                        <div class="slider-label"><span>Density</span><span id="noise-vol-txt">50%</span></div>
                        <input type="range" id="noise-vol" min="0" max="100" value="50">
                    </div>
                </div>

                <!-- Ambient Rain/Filter Synthesizer -->
                <div class="audio-node-card">
                    <div class="audio-node-head">
                        <span class="audio-node-title"><i data-lucide="cloud-rain"></i> Resonant Hum</span>
                        <input type="checkbox" id="ambient-enable">
                    </div>
                    <div class="slider-group">
                        <div class="slider-label"><span>Low Cutoff Filter</span><span id="cutoff-txt">350Hz</span></div>
                        <input type="range" id="cutoff-freq" min="100" max="1200" value="350">
                    </div>
                </div>
            </aside>

            <!-- Center Stage: Timer & Ritual Focus Ring -->
            <section class="center-stage">
                <div class="timer-card">
                    <!-- Current Ingress Intent -->
                    <div class="current-intent-card">
                        <div class="intent-label">Active Focus Intention</div>
                        <div class="intent-text" id="active-intent-display">Architect system schema without context switching</div>
                    </div>

                    <!-- Progress Ring Display -->
                    <div class="timer-ring-wrapper">
                        <svg class="timer-svg" viewBox="0 0 300 300">
                            <circle class="timer-bg-circle" cx="150" cy="150" r="135"></circle>
                            <circle class="timer-progress-circle" id="timer-ring" cx="150" cy="150" r="135"></circle>
                        </svg>
                        <div class="timer-display">
                            <span class="time-digits" id="timer-digits">90:00</span>
                            <span class="phase-indicator" id="phase-badge">DEEP FOCUS</span>
                        </div>
                    </div>

                    <!-- Main Timer Controls -->
                    <div class="timer-controls">
                        <button class="btn btn-primary btn-large" id="start-timer-btn"><i data-lucide="play"></i> Start Block</button>
                        <button class="btn btn-large" id="pause-timer-btn"><i data-lucide="pause"></i> Pause</button>
                        <button class="btn" id="finish-ritual-btn"><i data-lucide="check-circle"></i> Shutdown Ritual</button>
                    </div>
                </div>
            </section>

            <!-- Right Panel: Distraction Ledger & Session Analytics -->
            <aside class="sidebar-right panel">
                <!-- Distraction Capture -->
                <div class="panel-header">
                    <span class="panel-title"><i data-lucide="parking-square"></i> Friction Ledger</span>
                    <span style="font-size:0.75rem; color:var(--text-dim);">Ctrl+K</span>
                </div>

                <div class="ledger-input-group">
                    <input type="text" class="input-field" id="distraction-input" placeholder="Capture intrusive thought...">
                    <button class="btn btn-primary" id="add-ledger-btn"><i data-lucide="plus"></i></button>
                </div>

                <div class="ledger-list" id="ledger-items">
                    <!-- Rendered ledger items -->
                </div>

                <hr style="border: 0; border-top: 1px solid var(--border-subtle);">

                <!-- Flow Metrics -->
                <div class="panel-header">
                    <span class="panel-title"><i data-lucide="bar-chart-3"></i> Daily Execution</span>
                </div>

                <div class="metrics-grid">
                    <div class="metric-card">
                        <span class="metric-value" id="metric-deep-hours">3.5h</span>
                        <span class="metric-title">Deep Work Time</span>
                    </div>
                    <div class="metric-card">
                        <span class="metric-value" id="metric-flow-score">92%</span>
                        <span class="metric-title">Flow Consistency</span>
                    </div>
                    <div class="metric-card">
                        <span class="metric-value" id="metric-streak">5 Days</span>
                        <span class="metric-title">Ritual Streak</span>
                    </div>
                    <div class="metric-card">
                        <span class="metric-value" id="metric-friction-count">3</span>
                        <span class="metric-title">Frictions Logged</span>
                    </div>
                </div>
            </aside>
        </main>

        <!-- Exit Monk Mode floating action -->
        <button class="btn btn-primary monk-mode-exit" id="exit-monk-btn">
            <i data-lucide="eye"></i> Exit Monk Mode
        </button>
    </div>

    <!-- Pre-Flight Ingress Ritual Modal -->
    <div class="modal-overlay" id="ingress-modal">
        <div class="modal-card">
            <h3 class="modal-title"><i data-lucide="shield-alert"></i> Set Deep Work Ingress Intention</h3>
            <p style="font-size: 0.875rem; color: var(--text-muted);">Define explicit boundaries to prevent cognitive drift before starting this block.</p>
            
            <div class="form-group">
                <label class="form-label">Single Singular Target Goal</label>
                <input type="text" class="input-field" id="modal-intent-input" placeholder="e.g. Refactor audio synthesis graph pipeline">
            </div>

            <div class="form-group">
                <label class="form-label">Block Duration (Minutes)</label>
                <select class="input-field" id="modal-duration-select">
                    <option value="90">90 Minutes (Ultradian Focus)</option>
                    <option value="60">60 Minutes (Standard Block)</option>
                    <option value="45">45 Minutes (High Intensity Sprint)</option>
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Clear Friction Protocols</label>
                <label style="font-size:0.8rem; color:var(--text-muted); display:flex; gap:8px; align-items:center;">
                    <input type="checkbox" checked> Phone placed out of visual line-of-sight
                </label>
                <label style="font-size:0.8rem; color:var(--text-muted); display:flex; gap:8px; align-items:center;">
                    <input type="checkbox" checked> Notifications disabled on native OS
                </label>
            </div>

            <button class="btn btn-primary btn-large" id="confirm-ingress-btn" style="margin-top: 10px;">
                Begin Focus Ingress
            </button>
        </div>
    </div>

    <script>
        /* Initialize Lucide Icons */
        lucide.createIcons();

        /* Audio Engine State & Web Audio API setup */
        let audioCtx = null;
        let masterGain = null;

        // Soundscape Nodes
        let binauralNodes = { leftOsc: null, rightOsc: null, gain: null };
        let noiseNodes = { source: null, gain: null };
        let ambientNodes = { source: null, filter: null, gain: null };

        // Presets for Binaural Beats (Base carrier: 200Hz)
        const binauralPresets = {
            alpha: { carrier: 200, beat: 10 },
            theta: { carrier: 200, beat: 6 },
            gamma: { carrier: 200, beat: 40 }
        };
        let currentBinauralPreset = 'alpha';

        function initAudioEngine() {
            if (audioCtx) return;
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            audioCtx = new AudioContext();

            masterGain = audioCtx.createGain();
            masterGain.gain.value = 0.8;
            masterGain.connect(audioCtx.destination);

            setupBinauralNodes();
            setupNoiseNodes();
            setupAmbientNodes();
        }

        function setupBinauralNodes() {
            const merger = audioCtx.createChannelMerger(2);
            binauralNodes.leftOsc = audioCtx.createOscillator();
            binauralNodes.rightOsc = audioCtx.createOscillator();
            binauralNodes.gain = audioCtx.createGain();
            binauralNodes.gain.gain.value = 0.0;

            const preset = binauralPresets[currentBinauralPreset];
            binauralNodes.leftOsc.frequency.value = preset.carrier;
            binauralNodes.rightOsc.frequency.value = preset.carrier + preset.beat;

            binauralNodes.leftOsc.connect(merger, 0, 0); // Left channel
            binauralNodes.rightOsc.connect(merger, 0, 1); // Right channel

            merger.connect(binauralNodes.gain);
            binauralNodes.gain.connect(masterGain);

            binauralNodes.leftOsc.start();
            binauralNodes.rightOsc.start();
        }

        function setupNoiseNodes() {
            const bufferSize = audioCtx.sampleRate * 2;
            const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
            const data = buffer.getChannelData(0);
            let lastOut = 0.0;

            for (let i = 0; i < bufferSize; i++) {
                const white = Math.random() * 2 - 1;
                data[i] = (lastOut + (0.02 * white)) / 1.02;
                lastOut = data[i];
                data[i] *= 3.5; // Boost gain
            }

            noiseNodes.source = audioCtx.createBufferSource();
            noiseNodes.source.buffer = buffer;
            noiseNodes.source.loop = true;

            noiseNodes.gain = audioCtx.createGain();
            noiseNodes.gain.gain.value = 0.0;

            noiseNodes.source.connect(noiseNodes.gain);
            noiseNodes.gain.connect(masterGain);
            noiseNodes.source.start();
        }

        function setupAmbientNodes() {
            ambientNodes.filter = audioCtx.createBiquadFilter();
            ambientNodes.filter.type = 'lowpass';
            ambientNodes.filter.frequency.value = 350;

            ambientNodes.gain = audioCtx.createGain();
            ambientNodes.gain.gain.value = 0.0;

            // Connect Noise generator through resonant filter
            const osc = audioCtx.createOscillator();
            osc.type = 'sawtooth';
            osc.frequency.value = 55; // Low hum frequency
            osc.connect(ambientNodes.filter);
            ambientNodes.filter.connect(ambientNodes.gain);
            ambientNodes.gain.connect(masterGain);
            osc.start();
        }

        let timerState = {
            totalSeconds: 90 * 60,
            remainingSeconds: 90 * 60,
            isRunning: false,
            intervalId: null,
            phase: 'DEEP FOCUS'
        };

        const timerDigits = document.getElementById('timer-digits');
        const timerRing = document.getElementById('timer-ring');
        const startBtn = document.getElementById('start-timer-btn');
        const pauseBtn = document.getElementById('pause-timer-btn');

        function updateTimerDisplay() {
            const mins = Math.floor(timerState.remainingSeconds / 60);
            const secs = timerState.remainingSeconds % 60;
            timerDigits.textContent = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;

            // Ring Progress
            const totalDash = 880;
            const progress = timerState.remainingSeconds / timerState.totalSeconds;
            const offset = totalDash - (progress * totalDash);
            timerRing.style.strokeDashoffset = offset;
        }

        function startTimer() {
            if (timerState.isRunning) return;
            timerState.isRunning = true;
            timerState.intervalId = setInterval(() => {
                if (timerState.remainingSeconds > 0) {
                    timerState.remainingSeconds--;
                    updateTimerDisplay();
                } else {
                    clearInterval(timerState.intervalId);
                    timerState.isRunning = false;
                    alert('Focus Session Complete! Proceed to Shutdown Ritual.');
                }
            }, 1000);
        }

        function pauseTimer() {
            clearInterval(timerState.intervalId);
            timerState.isRunning = false;
        }

        const ledgerItemsContainer = document.getElementById('ledger-items');
        const distractionInput = document.getElementById('distraction-input');
        const addLedgerBtn = document.getElementById('add-ledger-btn');

        function addDistractionItem(text) {
            if (!text.trim()) return;
            const item = document.createElement('div');
            item.className = 'ledger-item';
            item.innerHTML = `
                <span>${text}</span>
                <i data-lucide="check" style="cursor:pointer; width:16px;" onclick="this.parentElement.classList.toggle('completed')"></i>
            `;
            ledgerItemsContainer.prepend(item);
            lucide.createIcons();
            distractionInput.value = '';
        }

        addLedgerBtn.addEventListener('click', () => addDistractionItem(distractionInput.value));
        distractionInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') addDistractionItem(distractionInput.value);
        });

        // Theme Toggle
        document.getElementById('theme-toggle-btn').addEventListener('click', () => {
            document.body.classList.toggle('theme-light');
        });

        // Monk Mode Toggle
        const monkToggleBtn = document.getElementById('monk-toggle-btn');
        const exitMonkBtn = document.getElementById('exit-monk-btn');

        function toggleMonkMode() {
            document.body.classList.toggle('monk-mode');
        }

        monkToggleBtn.addEventListener('click', toggleMonkMode);
        exitMonkBtn.addEventListener('click', toggleMonkMode);

        // Audio Controls Binding
        document.getElementById('master-audio-toggle').addEventListener('click', () => {
            initAudioEngine();
            if (audioCtx.state === 'suspended') audioCtx.resume();
        });

        document.getElementById('binaural-enable').addEventListener('change', (e) => {
            initAudioEngine();
            const vol = document.getElementById('binaural-vol').value / 100;
            binauralNodes.gain.gain.value = e.target.checked ? vol : 0.0;
        });

        document.getElementById('binaural-vol').addEventListener('input', (e) => {
            document.getElementById('binaural-vol-txt').textContent = `${e.target.value}%`;
            if (binauralNodes.gain && document.getElementById('binaural-enable').checked) {
                binauralNodes.gain.gain.value = e.target.value / 100;
            }
        });

        document.getElementById('noise-enable').addEventListener('change', (e) => {
            initAudioEngine();
            const vol = document.getElementById('noise-vol').value / 100;
            noiseNodes.gain.gain.value = e.target.checked ? vol : 0.0;
        });

        document.getElementById('noise-vol').addEventListener('input', (e) => {
            document.getElementById('noise-vol-txt').textContent = `${e.target.value}%`;
            if (noiseNodes.gain && document.getElementById('noise-enable').checked) {
                noiseNodes.gain.gain.value = e.target.value / 100;
            }
        });

        // Ingress Ritual Modal Handlers
        const ingressModal = document.getElementById('ingress-modal');
        const confirmIngressBtn = document.getElementById('confirm-ingress-btn');

        startBtn.addEventListener('click', () => {
            if (!timerState.isRunning && timerState.remainingSeconds === timerState.totalSeconds) {
                ingressModal.classList.add('active');
            } else {
                startTimer();
            }
        });

        pauseBtn.addEventListener('click', pauseTimer);

        confirmIngressBtn.addEventListener('click', () => {
            const intent = document.getElementById('modal-intent-input').value;
            const duration = parseInt(document.getElementById('modal-duration-select').value);

            if (intent) {
                document.getElementById('active-intent-display').textContent = intent;
            }

            timerState.totalSeconds = duration * 60;
            timerState.remainingSeconds = duration * 60;
            updateTimerDisplay();

            ingressModal.classList.remove('active');
            startTimer();
        });

        // Keyboard Shortcuts
        document.addEventListener('keydown', (e) => {
            if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
                e.preventDefault();
                distractionInput.focus();
            }
            if (e.altKey && e.key.toLowerCase() === 'm') {
                toggleMonkMode();
            }
        });

        // Initial Load Display Setup
        updateTimerDisplay();
    </script>
</body>
</html>
