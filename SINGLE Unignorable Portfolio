<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PathKeeper — Portfolio Intelligence</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --cream-bg: #FDFBF7;
      --cream-surface: #F5F0E6;
      --cream-card: #FAF6EE;
      --cream-border: #E6DFCD;
      --black-main: #0B1120;
      --black-card: #151D30;
      --black-text: #1F2937;
      --text-muted: #6B7280;
      --blue-accent: #1E3A8A;
      --blue-bright: #2563EB;
      --blue-light: #EFF6FF;
      --blue-border: #93C5FD;
      --blue-glow: rgba(37, 99, 235, 0.15);
    }

    body {
      background-color: var(--cream-bg);
      color: var(--black-text);
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      line-height: 1.6;
    }

    /* Typography Polish */
    h1, h2, h3, h4, .font-heading {
      letter-spacing: -0.02em;
    }

    /* Custom Accordion / Details */
    details.lesson {
      background: #FFFFFF;
      border: 1px solid var(--cream-border);
      border-radius: 12px;
      margin-bottom: 1rem;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 1px 3px rgba(11, 17, 32, 0.02);
      overflow: hidden;
    }

    details.lesson[open] {
      border-color: var(--blue-bright);
      box-shadow: 0 8px 24px -4px rgba(37, 99, 235, 0.08);
    }

    summary {
      list-style: none;
      padding: 1.25rem 1.5rem;
      font-weight: 700;
      font-size: 1.1rem;
      color: var(--black-main);
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      user-select: none;
      transition: background-color 0.2s;
    }

    summary::-webkit-details-marker {
      display: none;
    }

    summary:hover {
      background-color: var(--cream-surface);
    }

    summary::after {
      content: '';
      display: inline-block;
      width: 10px;
      height: 10px;
      border-right: 2px solid var(--black-main);
      border-bottom: 2px solid var(--black-main);
      transform: rotate(45deg);
      transition: transform 0.3s ease, border-color 0.2s;
      margin-left: 1rem;
      flex-shrink: 0;
    }

    details[open] summary::after {
      transform: rotate(-135deg);
      border-color: var(--blue-bright);
    }

    details[open] summary {
      border-bottom: 1px solid var(--cream-border);
      background-color: var(--cream-bg);
      color: var(--blue-accent);
    }

    .lesson-body {
      padding: 1.5rem;
      background-color: #FFFFFF;
    }

    .lesson-body h4 {
      font-size: 0.95rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--blue-accent);
      font-weight: 700;
      margin-top: 1.25rem;
      margin-bottom: 0.5rem;
    }

    .lesson-body h4:first-child {
      margin-top: 0;
    }

    .lesson-body p, .lesson-body ul, .lesson-body ol {
      color: var(--black-text);
      font-size: 0.975rem;
      line-height: 1.7;
      margin-bottom: 0.75rem;
    }

    .lesson-body ul {
      list-style: none;
      padding-left: 0;
    }

    .lesson-body ul li {
      position: relative;
      padding-left: 1.5rem;
      margin-bottom: 0.5rem;
    }

    .lesson-body ul li::before {
      content: '•';
      position: absolute;
      left: 0.5rem;
      color: var(--blue-bright);
      font-weight: bold;
    }

    .lesson-body ol {
      counter-reset: lesson-counter;
      list-style: none;
      padding-left: 0;
    }

    .lesson-body ol li {
      counter-increment: lesson-counter;
      position: relative;
      padding-left: 2.25rem;
      margin-bottom: 0.6rem;
    }

    .lesson-body ol li::before {
      content: counter(lesson-counter);
      position: absolute;
      left: 0;
      top: 0.15rem;
      width: 1.5rem;
      height: 1.5rem;
      background: var(--blue-light);
      color: var(--blue-bright);
      border-radius: 50%;
      font-size: 0.75rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Callout Card */
    .callout {
      background: var(--cream-surface);
      border-left: 4px solid var(--blue-bright);
      padding: 1rem 1.25rem;
      border-radius: 0 8px 8px 0;
      margin-top: 1.25rem;
      font-size: 0.925rem;
      color: var(--black-main);
    }

    .callout strong {
      color: var(--blue-accent);
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.75rem 1.5rem;
      font-weight: 600;
      border-radius: 8px;
      transition: all 0.2s ease;
      cursor: pointer;
      font-size: 0.9rem;
      gap: 0.5rem;
    }

    .btn-dark {
      background: var(--black-main);
      color: var(--cream-bg);
      border: 1px solid var(--black-main);
    }

    .btn-dark:hover {
      background: var(--blue-accent);
      border-color: var(--blue-accent);
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(11, 17, 32, 0.15);
    }

    .btn-light {
      background: var(--cream-surface);
      color: var(--black-main);
      border: 1px solid var(--cream-border);
    }

    .btn-light:hover {
      background: var(--cream-border);
      color: var(--black-main);
    }

    /* Form Fields */
    .field {
      margin-bottom: 1.25rem;
    }

    .field label {
      display: block;
      font-size: 0.85rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--black-main);
      margin-bottom: 0.4rem;
    }

    .field input[type="text"],
    .field textarea,
    .field select {
      width: 100%;
      background: #FFFFFF;
      border: 1px solid var(--cream-border);
      border-radius: 8px;
      padding: 0.75rem 1rem;
      font-size: 0.95rem;
      color: var(--black-main);
      transition: all 0.2s ease;
      outline: none;
    }

    .field input[type="text"]:focus,
    .field textarea:focus,
    .field select:focus {
      border-color: var(--blue-bright);
      box-shadow: 0 0 0 3px var(--blue-glow);
    }

    .field textarea {
      min-height: 90px;
      resize: vertical;
    }

    /* Interactive Tab Navigation */
    .tab-btn {
      padding: 0.6rem 1.2rem;
      border-radius: 30px;
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--text-muted);
      background: transparent;
      border: 1px solid transparent;
      cursor: pointer;
      transition: all 0.2s ease;
      white-space: nowrap;
    }

    .tab-btn:hover {
      color: var(--black-main);
      background: var(--cream-surface);
    }

    .tab-btn.active {
      background: var(--black-main);
      color: #FFFFFF;
      border-color: var(--black-main);
      box-shadow: 0 2px 8px rgba(11, 17, 32, 0.12);
    }

    /* Evidence Cards */
    .evidence-card {
      background: #FFFFFF;
      border: 1px solid var(--cream-border);
      border-radius: 12px;
      padding: 1.5rem;
      transition: all 0.25s ease;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .evidence-card:hover {
      border-color: var(--blue-border);
      box-shadow: 0 6px 18px rgba(37, 99, 235, 0.06);
      transform: translateY(-2px);
    }

    .tag {
      display: inline-block;
      font-size: 0.725rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 0.25rem 0.6rem;
      border-radius: 4px;
      width: fit-content;
    }

    .tag-accent {
      background: var(--blue-light);
      color: var(--blue-bright);
    }

    .bad-label {
      font-size: 0.75rem;
      font-weight: 700;
      color: #DC2626;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-top: 0.5rem;
    }

    .good-label {
      font-size: 0.75rem;
      font-weight: 700;
      color: #059669;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-top: 0.5rem;
    }

    /* Dynamic Output & Feedback Container */
    .feedback pre {
      background: var(--black-main);
      color: #F3F4F6;
      padding: 1.25rem;
      border-radius: 8px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.85rem;
      white-space: pre-wrap;
      word-break: break-word;
      margin-top: 1rem;
      border: 1px solid #1F2937;
      max-height: 400px;
      overflow-y: auto;
    }

    /* Template Display Block */
    .template-block {
      background: #FFFFFF;
      border: 1px solid var(--cream-border);
      padding: 1.25rem;
      border-radius: 8px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.825rem;
      color: var(--black-main);
      white-space: pre-wrap;
      line-height: 1.6;
      margin-top: 1rem;
    }

    /* Score Meter Panel */
    .score-panel {
      background: #FFFFFF;
      border: 1px solid var(--cream-border);
      border-radius: 12px;
      padding: 1.75rem;
    }

    .score-number {
      font-size: 3.5rem;
      font-weight: 800;
      line-height: 1;
      color: var(--black-main);
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .meter {
      height: 10px;
      background: var(--cream-surface);
      border-radius: 20px;
      overflow: hidden;
      margin: 1rem 0;
      border: 1px solid var(--cream-border);
    }

    .meter-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, var(--blue-accent), var(--blue-bright));
      transition: width 0.5s ease;
      border-radius: 20px;
    }

    .status {
      display: inline-block;
      font-weight: 700;
      font-size: 0.875rem;
      padding: 0.25rem 0.75rem;
      border-radius: 20px;
      background: var(--blue-light);
      color: var(--blue-bright);
      margin-bottom: 1rem;
    }

    /* Checklist Styling */
    .check-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1rem;
    }

    .check-item {
      background: #FFFFFF;
      border: 1px solid var(--cream-border);
      padding: 1.25rem;
      border-radius: 10px;
      cursor: pointer;
      display: flex;
      align-items: flex-start;
      gap: 0.85rem;
      transition: all 0.2s ease;
    }

    .check-item:hover {
      border-color: var(--blue-border);
      background: var(--cream-bg);
    }

    .check-item input[type="checkbox"] {
      width: 1.2rem;
      height: 1.2rem;
      margin-top: 0.15rem;
      accent-color: var(--blue-bright);
      border-radius: 4px;
      cursor: pointer;
    }

    .check-item span {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .check-item strong {
      color: var(--black-main);
      font-size: 0.95rem;
    }

    .check-item small {
      color: var(--text-muted);
      font-size: 0.825rem;
      line-height: 1.4;
    }

    /* Layout Sections */
    .section {
      margin-bottom: 4rem;
    }

    .section-head {
      margin-bottom: 2rem;
    }

    .section-head h2 {
      font-size: 1.75rem;
      font-weight: 800;
      color: var(--black-main);
      margin-bottom: 0.5rem;
    }

    .section-head p {
      color: var(--text-muted);
      font-size: 1.05rem;
      max-width: 700px;
    }

    /* Custom Cards & Panels */
    .panel {
      background: #FFFFFF;
      border: 1px solid var(--cream-border);
      border-radius: 12px;
      padding: 1.75rem;
    }

    .dark-panel {
      background: var(--black-main);
      color: var(--cream-bg);
      border-radius: 16px;
      padding: 3rem 2.5rem;
      box-shadow: 0 20px 40px -15px rgba(11, 17, 32, 0.3);
    }

    .dark-panel h2 {
      color: #FFFFFF;
      font-size: 2rem;
      font-weight: 800;
      margin-top: 0.5rem;
      margin-bottom: 1.5rem;
      line-height: 1.25;
    }

    .dark-panel p {
      color: #D1D5DB;
      font-size: 1.1rem;
      margin-bottom: 1.75rem;
    }

    .dark-panel ol {
      counter-reset: dark-counter;
      list-style: none;
      padding: 0;
    }

    .dark-panel ol li {
      counter-increment: dark-counter;
      position: relative;
      padding-left: 2.5rem;
      margin-bottom: 1rem;
      color: #E5E7EB;
      font-size: 1rem;
    }

    .dark-panel ol li::before {
      content: counter(dark-counter);
      position: absolute;
      left: 0;
      top: 0.1rem;
      width: 1.75rem;
      height: 1.75rem;
      background: rgba(37, 99, 235, 0.2);
      border: 1px solid var(--blue-bright);
      color: #93C5FD;
      border-radius: 50%;
      font-size: 0.8rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .card {
      background: #FFFFFF;
      border: 1px solid var(--cream-border);
      border-radius: 12px;
      padding: 1.5rem;
      height: 100%;
    }

    .eyebrow {
      font-size: 0.75rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--blue-bright);
      margin-bottom: 0.5rem;
    }

    .quote {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--black-main);
      border-left: 4px solid var(--blue-bright);
      padding-left: 1.25rem;
      font-style: italic;
      background: var(--cream-surface);
      padding-top: 1rem;
      padding-bottom: 1rem;
      border-radius: 0 8px 8px 0;
    }

    /* Layout Grids */
    .workspace {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    @media (min-width: 1024px) {
      .workspace {
        grid-template-columns: 1.4fr 1fr;
      }
    }

    .grid-2 {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    @media (min-width: 768px) {
      .grid-2 {
        grid-template-columns: 1fr 1fr;
      }
    }

    .grid-3 {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    @media (min-width: 768px) {
      .grid-3 {
        grid-template-columns: repeat(3, 1fr);
      }
    }
  </style>
</head>
