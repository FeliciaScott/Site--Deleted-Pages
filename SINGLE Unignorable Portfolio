      return {
        status: "Insufficient evidence",
        interpretation: "This evidence functions more like a claim than proof. It may not reduce evaluator skepticism.",
        lever: "Add inspectable documentation, measurement, or third-party validation."
      };
    }

    function updateEvidenceDisplay() {
      if (!evidenceForm) return;
      const score = calculateEvidenceScore();
      const assessment = evidenceAssessment(score);
      $("evScore").textContent = score;
      $("evMeterFill").style.width = score + "%";
      $("evStatus").textContent = assessment.status;
      $("evInterpretation").textContent = assessment.interpretation;
      $("evLever").textContent = assessment.lever;
    }

    if (evidenceForm) {
      evidenceForm.addEventListener("input", updateEvidenceDisplay);
      evidenceForm.addEventListener("change", updateEvidenceDisplay);

      evidenceForm.addEventListener("submit", function (event) {
        event.preventDefault();
        updateEvidenceDisplay();
      });

      const resetBtn = $("resetEvidenceForm");
      if (resetBtn) {
        resetBtn.addEventListener("click", function () {
          evidenceForm.reset();
          updateEvidenceDisplay();
        });
      }

      updateEvidenceDisplay();
    }

    // ============================================================
    // 4. READINESS AUDIT LOGIC
    // ============================================================
    const auditBoxes = Array.from(document.querySelectorAll("[data-audit]"));

    function updateAudit() {
      if (!auditBoxes.length) return;
      const count = auditBoxes.filter(box => box.checked).length;
      const total = auditBoxes.length;

      $("auditProgress").textContent = count + " of " + total + " checks completed";

      if (count === total) {
        $("auditAdvice").textContent =
          "All checks marked complete. Confirm the underlying evidence and ensure the case studies match the specific opportunity you are targeting.";
      } else if (count >= total / 2) {
        $("auditAdvice").textContent =
          "Good progress. Focus on completing remaining items to turn stated claims into fully inspectable evidence.";
      } else {
        $("auditAdvice").textContent =
          "Complete the audit to see your portfolio readiness diagnostic. Aim for complete verifiability across all projects.";
      }
    }

    auditBoxes.forEach(box => {
      box.addEventListener("change", updateAudit);
    });

    updateAudit();

  })();
  </script>
</body>
</html>
