      const relevance = Number($("evRelevance").value);
      const verifiability = Number($("evVerifiability").value);
      const decision = Number($("evDecision").value);
      const transfer = Number($("evTransfer").value);

      const score =
        (pyramid / 5) * 35 +
        (relevance / 3) * 20 +
        (verifiability / 3) * 20 +
        (decision / 3) * 15 +
        (transfer / 2) * 10;

      return Math.round(score);
    }

    function evidenceAssessment(score) {
