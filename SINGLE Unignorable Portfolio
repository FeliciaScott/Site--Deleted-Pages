  <!-- MAIN CONTAINER -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex-grow w-full">

    <!-- HERO HEADER -->
    <div class="mb-12 border-b border-[var(--cream-border)] pb-8">
      <div class="eyebrow">Evidence Architecture Framework</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-[var(--black-main)] tracking-tight mb-4">
        Design Evidence That Removes Uncertainty.
      </h1>
      <p class="text-lg text-[var(--text-muted)] max-w-3xl leading-relaxed">
        Turn raw accomplishments into inspectable career capital. Evaluators spend under 45 seconds analyzing your work—make every signal count.
      </p>
    </div>

    <!-- SECTION 01 — PROFESSION EVIDENCE EXPLORER -->
    <section class="section" id="explorer">
      <div class="section-head">
