        <span class="font-bold text-lg tracking-tight text-[var(--black-main)]">PATHKEEPER <span class="text-xs uppercase font-semibold text-[var(--blue-bright)] tracking-widest ml-1 hidden sm:inline">· Portfolio Intelligence</span></span>
      </div>
      <nav class="flex items-center gap-4 text-sm font-semibold">
