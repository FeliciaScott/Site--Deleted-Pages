
<div id="lws-contact">
  <style>
    #lws-contact {
      --cream: #F7F2E8;
      --cream-dark: #EDE2D1;
      --brown: #49352A;
      --brown-light: #674C3B;
      --blue: #294F6D;
      --blue-mid: #3D6F91;
      --blue-light: #DCEAF1;
      --text: #302820;
      --muted: #71685F;
      --white: #FFFDF8;

      font-family: Arial, Helvetica, sans-serif;
      color: var(--text);
      background: var(--cream);
      width: 100%;
      box-sizing: border-box;
      overflow: hidden;
      border-radius: 20px;
    }

    #lws-contact *,
    #lws-contact *::before,
    #lws-contact *::after {
      box-sizing: border-box;
    }

    #lws-contact a {
      color: inherit;
    }

    #lws-contact .contact-container {
      width: 100%;
      max-width: 1120px;
      margin: auto;
      padding: 42px 24px;
    }

    #lws-contact .contact-hero {
      background: var(--blue);
      color: var(--cream);
      padding: 56px 44px;
      border-radius: 20px;
      position: relative;
      overflow: hidden;
      margin-bottom: 30px;
    }

    #lws-contact .contact-hero::after {
      content: "";
      position: absolute;
      width: 230px;
      height: 230px;
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 50%;
      right: -65px;
      top: -80px;
      pointer-events: none;
    }

    #lws-contact .hero-label {
      display: inline-block;
      font-size: 13px;
      letter-spacing: 2px;
      text-transform: uppercase;
      font-weight: 700;
      color: #DCEAF1;
      margin-bottom: 18px;
    }

    #lws-contact .contact-hero h1 {
      font-size: clamp(32px, 5vw, 52px);
      line-height: 1.15;
      margin: 0 0 20px;
      color: var(--cream);
    }

    #lws-contact .contact-hero p {
      font-size: 18px;
      line-height: 1.8;
      max-width: 680px;
      color: #F0E9DD;
      margin: 0;
    }

    #lws-contact .contact-grid {
      display: grid;
      grid-template-columns: 0.85fr 1.5fr;
      gap: 26px;
      align-items: stretch;
    }

    #lws-contact .contact-info {
      background: var(--brown);
      color: var(--cream);
      padding: 34px 30px;
      border-radius: 18px;
      display: flex;
      flex-direction: column;
    }

    #lws-contact .contact-info h2 {
      font-size: 25px;
      line-height: 1.3;
      margin: 0 0 14px;
      color: var(--cream);
    }

    #lws-contact .contact-info > p {
      font-size: 16px;
      line-height: 1.7;
      color: #E6D8C6;
      margin: 0 0 28px;
    }

    #lws-contact .email-label {
      display: block;
      font-size: 12px;
      letter-spacing: 1.5px;
      font-weight: 700;
      text-transform: uppercase;
      color: #D7C2A9;
      margin-bottom: 10px;
    }

    #lws-contact .email-address {
      display: block;
      font-size: 17px;
      line-height: 1.6;
      font-weight: 700;
      color: #FFFFFF;
      text-decoration: none;
      overflow-wrap: anywhere;
      margin-bottom: 22px;
    }

    #lws-contact .email-address:hover {
      text-decoration: underline;
    }

    #lws-contact .direct-email-button {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      text-align: center;
      width: 100%;
      min-height: 48px;
      padding: 13px 18px;
      background: var(--cream);
      color: var(--brown);
      font-weight: 700;
      font-size: 15px;
      text-decoration: none;
      border-radius: 9px;
      margin-bottom: 30px;
      transition: background 0.2s ease;
    }

    #lws-contact .direct-email-button:hover {
      background: var(--cream-dark);
    }

    #lws-contact .contact-note {
      border-top: 1px solid rgba(255,255,255,0.2);
      padding-top: 22px;
      margin-top: auto;
    }

    #lws-contact .contact-note p {
      font-size: 14px;
      line-height: 1.7;
      color: #E6D8C6;
      margin: 0;
    }

    #lws-contact .contact-form-card {
      background: var(--white);
      border: 1px solid #D9CDBD;
      border-radius: 18px;
      padding: 36px;
    }

    #lws-contact .contact-form-card h2 {
      font-size: 27px;
      line-height: 1.3;
      color: var(--blue);
      margin: 0 0 10px;
    }

    #lws-contact .form-intro {
      font-size: 15px;
      line-height: 1.7;
      color: var(--muted);
      margin: 0 0 26px;
    }

    #lws-contact .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    #lws-contact .form-group {
      margin-bottom: 19px;
    }

    #lws-contact label {
      display: block;
      font-size: 14px;
      font-weight: 700;
      color: var(--brown);
      margin-bottom: 8px;
    }

    #lws-contact input,
    #lws-contact textarea {
      display: block;
      width: 100%;
      min-height: 48px;
      padding: 13px 14px;
      border: 1px solid #D4C7B6;
      border-radius: 8px;
      background: #FFFEFC;
      color: var(--text);
      font-family: inherit;
      font-size: 16px;
      line-height: 1.5;
      outline: none;
    }

    #lws-contact textarea {
      min-height: 160px;
      resize: vertical;
    }

    #lws-contact input:focus,
    #lws-contact textarea:focus {
      border-color: var(--blue-mid);
      box-shadow: 0 0 0 3px rgba(61,111,145,0.16);
    }

    #lws-contact input::placeholder,
    #lws-contact textarea::placeholder {
      color: #897F74;
      opacity: 1;
    }

    #lws-contact .submit-button {
      width: 100%;
      min-height: 52px;
      padding: 14px 20px;
      border: none;
      border-radius: 9px;
      background: var(--blue);
      color: #FFFFFF;
      font-family: inherit;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.2s ease, transform 0.2s ease;
    }

    #lws-contact .submit-button:hover {
      background: var(--blue-mid);
    }

    #lws-contact .submit-button:active {
      transform: translateY(1px);
    }

    #lws-contact .submit-button:focus-visible,
    #lws-contact .direct-email-button:focus-visible,
    #lws-contact .email-address:focus-visible {
      outline: 3px solid #729BB5;
      outline-offset: 4px;
    }

    #lws-contact .form-footnote {
      font-size: 13px;
      line-height: 1.6;
      color: var(--muted);
      text-align: center;
      margin: 15px 0 0;
    }

    #lws-contact .contact-bottom {
      margin-top: 28px;
      padding: 28px;
      background: var(--blue-light);
      border: 1px solid #C4D8E4;
      border-radius: 15px;
      text-align: center;
    }

    #lws-contact .contact-bottom h2 {
      font-size: 23px;
      line-height: 1.4;
      color: var(--blue);
      margin: 0 0 10px;
    }

    #lws-contact .contact-bottom p {
      font-size: 15px;
      line-height: 1.8;
      color: var(--brown);
      margin: 0;
    }

    #lws-contact .contact-bottom a {
      color: var(--blue);
      font-weight: 700;
      overflow-wrap: anywhere;
    }

    #lws-contact .form-status {
      margin-top: 14px;
      font-size: 14px;
      line-height: 1.6;
      color: var(--brown);
    }

    @media (max-width: 760px) {
      #lws-contact .contact-container {
        padding: 22px 14px;
      }

      #lws-contact .contact-hero {
        padding: 38px 24px;
      }

      #lws-contact .contact-grid {
        grid-template-columns: 1fr;
      }

      #lws-contact .contact-info {
        padding: 28px 24px;
      }

      #lws-contact .contact-form-card {
        padding: 25px 20px;
      }

      #lws-contact .form-row {
        grid-template-columns: 1fr;
        gap: 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #lws-contact *,
      #lws-contact *::before,
      #lws-contact *::after {
        transition: none !important;
        animation: none !important;
        scroll-behavior: auto !important;
      }
    }
  </style>

  <div class="contact-container">

    <!-- HERO -->
    <section class="contact-hero" aria-labelledby="lws-contact-heading">
      <span class="hero-label">LeadWithSpeaking · Contact</span>

      <h1 id="lws-contact-heading">Let's Start a Conversation.</h1>

      <p>
        Have a question, an idea, or something you would like to share?
        I'd welcome the opportunity to hear from you. Use the form below
        or reach out directly by email.
      </p>
    </section>

    <!-- CONTACT DETAILS + FORM -->
    <div class="contact-grid">

      <!-- CONTACT INFORMATION -->
      <section class="contact-info" aria-labelledby="lws-contact-info-heading">

        <h2 id="lws-contact-info-heading">Get in Touch</h2>

        <p>
          Every meaningful connection begins with communication.
          Reach out to share a question, request information,
          or start a conversation.
        </p>

        <span class="email-label">Email Address</span>

        <a
          class="email-address"
          href="mailto:admin@leadwithspeaking.cvm"
        >
          admin@leadwithspeaking.cvm
        </a>

        <a
          class="direct-email-button"
          href="mailto:admin@leadwithspeaking.cvm?subject=Contact%20LeadWithSpeaking"
        >
          Send an Email
        </a>

        <div class="contact-note">
          <p>
            You don't need to have everything figured out before
            reaching out. A question is a good place to begin.
          </p>
        </div>

      </section>

      <!-- CONTACT FORM -->
      <section class="contact-form-card" aria-labelledby="lws-form-heading">

        <h2 id="lws-form-heading">Send a Message</h2>

        <p class="form-intro">
          Complete the form below to prepare a message to send directly
          through your email application.
        </p>

        <form id="lws-contact-form">

          <div class="form-row">

            <div class="form-group">
              <label for="lws-name">Your Name</label>
              <input
                type="text"
                id="lws-name"
                name="name"
                placeholder="Enter your name"
                autocomplete="name"
                required
              >
            </div>

            <div class="form-group">
              <label for="lws-email">Your Email</label>
              <input
                type="email"
                id="lws-email"
                name="email"
                placeholder="you@example.com"
                autocomplete="email"
                required
              >
            </div>

          </div>

          <div class="form-group">
            <label for="lws-subject">Subject</label>
            <input
              type="text"
              id="lws-subject"
              name="subject"
              placeholder="What would you like to discuss?"
              required
            >
          </div>

          <div class="form-group">
            <label for="lws-message">Your Message</label>
            <textarea
              id="lws-message"
              name="message"
              placeholder="Write your message here..."
              required
            ></textarea>
          </div>

          <button class="submit-button" type="submit">
            Prepare My Email
          </button>

          <p class="form-footnote">
            Your email application will open with your message ready to send.
          </p>

          <div
            class="form-status"
            id="lws-form-status"
            role="status"
            aria-live="polite"
          ></div>

        </form>
      </section>

    </div>

    <!-- BOTTOM MESSAGE -->
    <section class="contact-bottom">
      <h2>Communication Creates Possibility.</h2>
      <p>
        Whether you are exploring an idea, looking for information,
        or simply have something to say, your message is welcome.
        <br>
        <a href="mailto:admin@leadwithspeaking.cvm">
          Reach out directly.
        </a>
      </p>
    </section>

  </div>

  <!-- FORM FUNCTIONALITY -->
  <script>
    (function () {
      const root = document.getElementById("lws-contact");
      if (!root) return;

      const form = root.querySelector("#lws-contact-form");
      const status = root.querySelector("#lws-form-status");

      const recipient = "admin@leadwithspeaking.cvm";

      form.addEventListener("submit", function (event) {
        event.preventDefault();

        if (!form.reportValidity()) {
          return;
        }

        const name = root.querySelector("#lws-name").value.trim();
        const email = root.querySelector("#lws-email").value.trim();
        const subject = root.querySelector("#lws-subject").value.trim();
        const message = root.querySelector("#lws-message").value.trim();

        const emailSubject = encodeURIComponent(subject);
        const emailBody = encodeURIComponent(
          "Name: " + name + "\n" +
          "Email: " + email + "\n\n" +
          "Message:\n" + message
        );

        const mailtoLink =
          "mailto:" + recipient +
          "?subject=" + emailSubject +
          "&body=" + emailBody;

        status.textContent =
          "Opening your email application. Review your message and press Send to deliver it.";

        window.location.href = mailtoLink;
      });
    })();
  </script>

</div>
