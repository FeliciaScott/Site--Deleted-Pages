                    </div>
                </div>

                <div class="form-group">
                    <label>Cost Efficiency <span class="value-display" id="costValue">5</span></label>
                    <div class="range-row">
                        <input id="cost" type="range" min="1" max="10" value="5" oninput="updateLocationScore()">
                        <div> / 10</div>
                    </div>
                </div>

                <div class="form-group">
                    <label>Network Access <span class="value-display" id="networkValue">5</span></label>
                    <div class="range-row">
                        <input id="network" type="range" min="1" max="10" value="5" oninput="updateLocationScore()">
                        <div> / 10</div>
                    </div>
                </div>

                <div class="form-group">
                    <label>Infrastructure <span class="value-display" id="infrastructureValue">5</span></label>
                    <div class="range-row">
                        <input id="infrastructure" type="range" min="1" max="10" value="5" oninput="updateLocationScore()">
                        <div> / 10</div>
                    </div>
                </div>

                <div class="form-group">
                    <label>Expansion Potential <span class="value-display" id="expansionValue">5</span></label>
                    <div class="range-row">
