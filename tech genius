  getField("systemRecommendation").innerHTML =
    "<h4>Recommended system change</h4><p>Your recommendation will appear after the review.</p>";

  getField("outputQuality").textContent = "—";
  getField("frictionIndex").textContent = "—";
  getField("learningValue").textContent = "—";
  getField("nextReadiness").textContent = "—";

  getField("practiceStatus").textContent = "";

  getField("cycleLabel").textContent = "SYSTEM READY";
  getField("pauseButton").textContent = "Pause";
  getField("currentAction").textContent =
