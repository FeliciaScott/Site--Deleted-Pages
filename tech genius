  alert("The current session records have been reset.");
}

/* =========================================
   LIVE SETTINGS AND INITIAL STATE
========================================= */

getField("energy").addEventListener("change", function() {
  getField("capacityStatus").textContent = this.value.toUpperCase();
});

getField("noise").addEventListener("change", function() {
  getField("noiseStatus").textContent = this.value.toUpperCase();
});

