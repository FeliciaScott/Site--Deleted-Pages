<script>
"use strict";

/* =========================================
   SYSTEM STATE
========================================= */

let currentPlan = null;
let practiceCompleted = false;
let latestRecommendation = null;

let learningHistory = [];
let cycleHistory = [];

let failureStreak = 0;
let adaptationLevel = 0;

let timer = null;
let seconds = 1500;
let totalSeconds = 1500;
let cycleRunning = false;
let cycleStarted = false;

let cycleCount = 0;
let focusMinutes = 0;
let interruptions = 0;
let outputUnits = 0;
let cyclesAttempted = 0;

let lastCycleAnalysis = null;
let lastLearningRecord = null;

/* =========================================
   STRATEGY LIBRARY
========================================= */

const strategies = {
  teach: {
    title: "Worked example",
    steps: [
      "Study one complete example of the skill.",
      "Explain why each step works.",
      "Complete a similar example without looking."
    ],
    reason: "Build a clearer mental model before increasing difficulty."
  },

  guided: {
    title: "Guided practice",
    steps: [
      "Attempt a problem with a small hint.",
      "Explain the step where you became stuck.",
      "Retry the problem with fewer hints."
    ],
    reason: "Reduce execution difficulty while developing independence."
  },

  independent: {
    title: "Independent practice",
    steps: [
      "Solve a new problem without assistance.",
      "Check the result against clear criteria.",
      "Explain and correct any mistakes."
    ],
    reason: "Test whether the skill can be performed independently."
  },

  spaced: {
    title: "Spaced retrieval",
    steps: [
      "Recall the concept without opening your notes.",
      "Check the answer and correct any gaps.",
      "Schedule another recall attempt after a delay."
    ],
    reason: "Strengthen recall and test whether learning persists."
  },

  transfer: {
    title: "Transfer challenge",
    steps: [
      "Solve an unfamiliar problem using the skill.",
      "Explain why the chosen approach fits the problem.",
      "Compare the result with the assessment criteria."
    ],
    reason: "Test application beyond familiar examples."
  }
};

/* =========================================
   HELPERS AND VALIDATION
========================================= */

function getField(id) {
  return document.getElementById(id);
}

function numberFrom(id, fallback = 0) {
  const field = getField(id);
  if (!field) return fallback;

  const value = Number(field.value);
  return Number.isFinite(value) ? value : fallback;
}

function safeText(value) {
  return String(value).replace(/[&<>"']/g, character => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#39;"
  })[character]);
}

function validPercent(id, label, minimum = 0) {
  const field = getField(id);
  const value = Number(field.value);

  if (
    field.value.trim() === "" ||
    !Number.isFinite(value) ||
    value < minimum ||
    value > 100
  ) {
    alert(label + " must be a number from " + minimum + " to 100.");
    field.focus();
    return null;
  }

  return value;
}

function showResult(id, title, message, type = "") {
  const element = getField(id);
  element.classList.remove("hidden", "result-success", "result-warning");

  if (type) {
    element.classList.add(type);
  }

  element.innerHTML =
    "<h4>" + safeText(title) + "</h4>" +
    "<p>" + safeText(message) + "</p>";
}

function log(message) {
  console.log("[PathKeeper] " + message);
}

/* =========================================
   LEARNING CONTROLLER
========================================= */

function recommendStrategy(baseline, confidence, difficulty) {
  if (difficulty === "retention") return "spaced";
  if (difficulty === "transfer") return "transfer";

  if (baseline < 45 || difficulty === "concept") {
    return "teach";
  }

  if (
    baseline < 70 ||
    difficulty === "process" ||
    difficulty === "unknown"
  ) {
    return "guided";
  }

  if (
    confidence >= 4 &&
    baseline >= 85 &&
    difficulty !== "accuracy"
  ) {
    return "transfer";
  }

  if (difficulty === "accuracy") {
    return "guided";
  }

  return "independent";
}

function explainRecommendation(plan) {
  if (plan.difficulty === "retention") {
    return "The priority is strengthening recall over time.";
  }

  if (plan.difficulty === "transfer") {
    return "The priority is applying knowledge to unfamiliar tasks.";
  }

  if (plan.baseline < 45 || plan.difficulty === "concept") {
    return "The available evidence suggests starting with conceptual understanding.";
  }

  if (plan.baseline < 70 || plan.difficulty === "process") {
    return "Guided practice can reveal where execution breaks down.";
  }

  if (plan.difficulty === "accuracy") {
    return "Guided practice can help expose and correct recurring mistakes.";
  }

  return "The next activity is selected to challenge the current skill level.";
}

function createPlan() {
  const goal = getField("learningGoal").value.trim();
  const skill = getField("skill").value.trim();

  const target = validPercent("target", "Target performance", 1);
  const baseline = validPercent("baseline", "Baseline accuracy");

  if (target === null || baseline === null) return;

  if (!goal || !skill) {
    alert("Enter both a learning goal and a skill to improve.");
    return;
  }

  const minutes = numberFrom("minutes", 25);

  if (minutes < 5 || minutes > 240) {
    alert("Practice time must be between 5 and 240 minutes.");
    getField("minutes").focus();
    return;
  }

  currentPlan = {
    goal,
    skill,
    target,
    baseline,
    confidence: numberFrom("confidence", 3),
    minutes,
    difficulty: getField("errorType").value,
    deadline: getField("learningDeadline").value
  };

  latestRecommendation = recommendStrategy(
    baseline,
    currentPlan.confidence,
    currentPlan.difficulty
  );

  getField("strategy").value = "auto";

  practiceCompleted = false;
  getField("practiceStatus").textContent = "";

  getField("planResult").classList.remove("hidden");

  getField("planResult").innerHTML = `
    <h4>Learning objective established</h4>
    <p><strong>Goal:</strong> ${safeText(goal)}</p>
    <p><strong>Skill:</strong> ${safeText(skill)}</p>
    <p><strong>Baseline:</strong> ${baseline}%</p>
    <p><strong>Target:</strong> ${target}%</p>
    <p><strong>Initial gap:</strong> ${Math.max(0, target - baseline)} percentage points</p>
    <p><strong>Available practice time:</strong> ${minutes} minutes</p>
  `;

  renderRecommendation();
  renderActionPlan();

  getField("activity").value =
    "Practice " + skill + " using the recommended strategy.";

  log("Learning plan created for " + skill);
}

function renderRecommendation() {
  if (!currentPlan || !latestRecommendation) return;

  const strategy = strategies[latestRecommendation];

  getField("controllerResult").innerHTML = `
    <h4>Recommended: ${safeText(strategy.title)}</h4>
    <p>${safeText(strategy.reason)}</p>
    <p><strong>Reason for selection:</strong>
      ${safeText(explainRecommendation(currentPlan))}
    </p>
  `;
}

function renderActionPlan() {
  if (!currentPlan || !latestRecommendation) return;

  const strategy = strategies[latestRecommendation];
  const minutes = Math.max(5, currentPlan.minutes);

  const preparation = Math.max(2, Math.round(minutes * .2));
  const practice = Math.max(3, Math.round(minutes * .6));
  const review = Math.max(2, minutes - preparation - practice);

  getField("actionPlan").innerHTML = `
    <h4>${safeText(strategy.title)}</h4>
    <p>${safeText(strategy.reason)}</p>
    <ul class="action-list">
      ${strategy.steps.map(step =>
        "<li>" + safeText(step) + "</li>"
      ).join("")}
    </ul>
    <p><strong>Suggested time:</strong>
      ${preparation} minutes preparation,
      ${practice} minutes practice,
      ${review} minutes review.
    </p>
    <p><strong>Evidence to collect:</strong>
      accuracy on a new task, errors encountered, and hints needed.
    </p>
  `;
}

function chooseStrategy() {
  if (!currentPlan) {
    alert("Analyze your baseline before selecting a strategy.");
    return;
  }

  const selected = getField("strategy").value;

  if (selected !== "auto") {
    latestRecommendation = selected;
  } else {
    latestRecommendation = recommendStrategy(
      currentPlan.baseline,
      currentPlan.confidence,
      currentPlan.difficulty
    );
  }

  practiceCompleted = false;
  getField("practiceStatus").textContent =
    "Recommendation updated. Complete the selected practice before recording results.";

  renderRecommendation();
  renderActionPlan();
}

/* =========================================
   PRACTICE TRACKING
========================================= */

function markPracticeComplete() {
  if (!currentPlan) {
    alert("Create a learning plan first.");
    return;
  }

  const activity = getField("activity").value.trim();

  if (!activity) {
    alert("Describe the activity you completed first.");
    getField("activity").focus();
    return;
  }

  practiceCompleted = true;

  getField("practiceStatus").textContent =
    "Practice recorded. Complete a post-practice assessment using new questions when possible.";

  log("Practice marked complete.");
}

/* =========================================
   MISSION AND ENVIRONMENT SETUP
========================================= */

function initializeSystem() {
  const goal = getField("missionGoal").value.trim();
  const definition = getField("definition").value.trim();

  const energy = getField("energy").value;
  const noise = getField("noise").value;
  const duration = numberFrom("focusDuration", 25);

  if (!goal) {
    alert("Enter a mission before preparing the focus system.");
    getField("missionGoal").focus();
    return;
  }

  if (!definition) {
    alert("Describe what a completed mission should look like.");
    getField("definition").focus();
    return;
  }

  if (cycleRunning) {
    alert("Pause or complete the active focus cycle before changing the mission.");
    return;
  }

  getField("capacityStatus").textContent = energy.toUpperCase();
  getField("noiseStatus").textContent = noise.toUpperCase();

  let mode = "BUILD";
  let action = "Define the next observable deliverable and work only on it.";

  if (noise === "high") {
    mode = "ENVIRONMENT RESET";
    action = "Remove competing inputs before beginning: silence notifications, close unrelated tabs, and isolate the work surface.";
  } else if (energy === "low") {
    mode = "SIMPLIFY";
    action = "Reduce the mission to the smallest useful deliverable. Create one concrete piece of progress without demanding peak cognition.";
  } else if (energy === "high") {
    mode = "DEEP BUILD";
    action = "Work on the highest-leverage reasoning task inside the mission. Build, solve, analyze, or create the part that changes the outcome most.";
  }

  getField("modeStatus").textContent = mode;

  if (currentPlan && !getField("activity").value.trim()) {
    getField("activity").value =
      "Practice " + currentPlan.skill + " using " +
      (latestRecommendation ? strategies[latestRecommendation].title : "independent practice");
  }

  const practiceTarget = getField("activity").value.trim();

  if (practiceTarget) {
    action += " Practice target: " + practiceTarget;
  }

  getField("currentAction").textContent = action;

  seconds = duration * 60;
  totalSeconds = seconds;
  cycleStarted = false;

  updateClock();

  getField("cycleLabel").textContent = "READY TO EXECUTE";
  getField("pauseButton").textContent = "Pause";

  getField("missionResult").classList.remove("hidden");

  getField("missionResult").innerHTML = `
    <h4>Mission prepared</h4>
    <p><strong>Mission:</strong> ${safeText(goal)}</p>
    <p><strong>Definition of done:</strong> ${safeText(definition)}</p>
    <p><strong>Mode:</strong> ${safeText(mode)}</p>
    <p><strong>Focus duration:</strong> ${duration} minutes</p>
    <p><strong>Next action:</strong> ${safeText(action)}</p>
  `;

  log("Mission initialized.");
}

/* =========================================
   TIMER ENGINE
========================================= */

function updateClock() {
  const minutes = Math.floor(seconds / 60);
  const remainingSeconds = seconds % 60;

  getField("clock").textContent =
    String(minutes).padStart(2, "0") + ":" +
    String(remainingSeconds).padStart(2, "0");

  const elapsed = totalSeconds - seconds;
  const percent = totalSeconds > 0
    ? (elapsed / totalSeconds) * 100
    : 0;

  getField("progressBar").style.width =
    Math.max(0, Math.min(100, percent)) + "%";
}

function startTimer() {
  if (cycleRunning) return;

  if (seconds <= 0) {
    alert("Reset or initialize a new focus cycle before starting.");
    return;
  }

  if (!cycleStarted) {
    cycleStarted = true;
    cyclesAttempted++;
    updateMetrics();
  }

  cycleRunning = true;
  getField("cycleLabel").textContent = "DEEP WORK ACTIVE";
  getField("pauseButton").textContent = "Pause";

  timer = setInterval(() => {
    if (seconds > 0) {
      seconds--;
      updateClock();
    } else {
      finishCycle(true);
    }
  }, 1000);

  log("Focus timer started.");
}

function pauseTimer() {
  if (!cycleRunning) {
    if (cycleStarted && seconds > 0) {
      startTimer();
    }
    return;
  }

  clearInterval(timer);
  timer = null;
  cycleRunning = false;

  interruptions++;

  getField("pauseButton").textContent = "Resume";
  getField("cycleLabel").textContent = "PAUSED";

  updateMetrics();
  log("Focus cycle paused. Interruption recorded.");
}

function completeCycle() {
  if (!cycleStarted) {
    alert("Start a focus cycle before completing it.");
    return;
  }

  if (!confirm("Complete this focus cycle and open the review?")) {
    return;
  }

  finishCycle(false);
}

function finishCycle(automatic) {
  if (!cycleStarted) return;

  clearInterval(timer);
  timer = null;
  cycleRunning = false;

  const elapsedSeconds = Math.max(0, totalSeconds - seconds);
  const elapsedMinutes = Math.max(1, Math.round(elapsedSeconds / 60));

  cycleCount++;
  focusMinutes += elapsedMinutes;

  getField("cycleLabel").textContent =
    automatic ? "CYCLE COMPLETE" : "CYCLE ENDED";

  getField("pauseButton").textContent = "Pause";

  updateMetrics();

  getField("outputReview").focus();

  log("Focus cycle completed.");

  getField("systemDiagnosis").scrollIntoView({
    behavior: "smooth",
    block: "center"
  });

  if (automatic) {
    alert("Focus cycle complete. Take a moment to review what you produced.");
  }
}

function resetTimer() {
  clearInterval(timer);
  timer = null;
  cycleRunning = false;
  cycleStarted = false;

  const duration = numberFrom("focusDuration", 25);

  seconds = duration * 60;
  totalSeconds = seconds;

  getField("cycleLabel").textContent = "SYSTEM READY";
  getField("pauseButton").textContent = "Pause";
  getField("currentAction").textContent =
    "Prepare a mission and initialize the system.";

  updateClock();
  log("Timer reset. Performance records preserved.");
}

/* =========================================
   PERFORMANCE METRICS
========================================= */

function updateMetrics() {
  getField("cycles").textContent = cycleCount;
  getField("focusMinutes").textContent = focusMinutes;
  getField("interruptions").textContent = interruptions;
  getField("outputUnits").textContent = outputUnits;

  const focusScore = Math.max(
    0,
    Math.round(100 - (interruptions * 8))
  );

  getField("focusScore").textContent = focusScore;

  const completionRate = cyclesAttempted > 0
    ? Math.round((cycleCount / cyclesAttempted) * 100)
    : 0;

  getField("efficiency").textContent = completionRate + "%";
}

/* =========================================
   CYCLE ANALYSIS ENGINE
========================================= */

function analyzeCycle() {
  const output = getField("outputReview").value.trim();
  const friction = getField("frictionReview").value.trim();
  const insight = getField("insightReview").value.trim();
  const next = getField("nextReview").value.trim();
  const environment = getField("environmentReview").value.trim();

  if (!output) {
    alert("Describe what you actually produced before analyzing the cycle.");
    getField("outputReview").focus();
    return null;
  }

  const outputScore = output.length >= 80
    ? 90
    : output.length >= 35
      ? 70
      : 45;

  const learningScore = insight.length >= 80
    ? 95
    : insight.length >= 35
      ? 75
      : insight.length > 0
        ? 55
        : 30;

  const readinessScore = next.length >= 80
    ? 95
    : next.length >= 35
      ? 80
      : next.length > 0
        ? 60
        : 25;

  const frictionIndex = friction.length === 0
    ? 0
    : friction.length >= 80
      ? 70
      : friction.length >= 35
        ? 45
        : 25;

  const adjustedReadiness = environment.length >= 35
    ? Math.min(100, readinessScore + 5)
    : readinessScore;

  let diagnosis = "";
  let recommendation = "";

  if (frictionIndex >= 60) {
    diagnosis =
      "Your primary bottleneck appears to be environmental or process friction.";

    recommendation =
      "Identify the specific friction named in your review and eliminate it before the next cycle. Change the environment, workflow, file structure, notification settings, or preparation process.";
  } else if (outputScore < 60) {
    diagnosis =
      "The cycle produced limited observable output. The objective may have been too large, unclear, or insufficiently decomposed.";

    recommendation =
      "Reduce the next cycle to one visible artifact or decision. Define exactly what should exist when the timer ends.";
  } else if (learningScore < 60) {
    diagnosis =
      "Execution occurred, but the system captured little learning.";

    recommendation =
      "Record one specific discovery, mistake, pattern, or decision from the cycle. Use it to change the next attempt.";
  } else if (adjustedReadiness < 60) {
    diagnosis =
      "The current work may be progressing, but the next cycle is not sufficiently prepared.";

    recommendation =
      "Define the next action in physical terms: what file to open, what problem to solve, what section to write, or what decision to make.";
  } else {
    diagnosis =
      "The cycle generated usable output and enough information to improve the next cycle.";

    recommendation =
      "Preserve the conditions that worked, remove one remaining source of friction, and begin the next cycle with the recorded next action.";
  }

  const intelligence = Math.round(
    (
      outputScore +
      (100 - frictionIndex) +
      learningScore +
      adjustedReadiness
    ) / 4
  );

  lastCycleAnalysis = {
    outputScore,
    frictionIndex,
    learningScore,
    readinessScore: adjustedReadiness,
    intelligence,
    diagnosis,
    recommendation,
    output,
    friction,
    insight,
    next,
    environment
  };

  getField("outputQuality").textContent = outputScore;
  getField("frictionIndex").textContent = frictionIndex;
  getField("learningValue").textContent = learningScore;
  getField("nextReadiness").textContent = adjustedReadiness;

  showResult(
    "systemDiagnosis",
    "System diagnosis · Intelligence " + intelligence,
    diagnosis,
    "result-warning"
  );

  showResult(
    "systemRecommendation",
    "Recommended system change",
    recommendation,
    "result-success"
  );

  return lastCycleAnalysis;
}

/* =========================================
   SAVE CYCLE INTELLIGENCE
========================================= */

function saveCycle() {
  const analysis = analyzeCycle();

  if (!analysis) return;

  const record = {
    date: new Date().toLocaleString(),
    cycle: cycleCount,
    output: analysis.output,
    friction: analysis.friction || "None recorded",
    insight: analysis.insight || "None recorded",
    next: analysis.next || "No next action recorded",
    intelligence: analysis.intelligence
  };

  cycleHistory.unshift(record);
  outputUnits++;

  renderCycleHistory();
  updateMetrics();

  alert("Cycle intelligence record saved.");
  log("Cycle intelligence record saved.");
}

function renderCycleHistory() {
  const container = getField("historyContainer");

  if (cycleHistory.length === 0) {
    container.innerHTML =
      '<div class="empty-history">No cycle intelligence records yet.</div>';
    return;
  }

  const rows = cycleHistory.map(record => `
    <tr>
      <td><strong>Cycle ${record.cycle}</strong><br>${safeText(record.date)}</td>
      <td>${safeText(record.output)}</td>
      <td>${safeText(record.friction)}</td>
      <td>${safeText(record.insight)}</td>
      <td>${safeText(record.next)}</td>
      <td><strong>${record.intelligence}</strong></td>
    </tr>
  `).join("");

  container.innerHTML = `
    <div class="table-wrap">
      <table class="history-table">
        <thead>
          <tr>
            <th>Cycle</th>
            <th>Output</th>
            <th>Friction</th>
            <th>Learning</th>
            <th>Next action</th>
            <th>Intelligence</th>
          </tr>
        </thead>
        <tbody>${rows}</tbody>
      </table>
    </div>
  `;
}

/* =========================================
   LEARNING ASSESSMENT
========================================= */

function recordResult() {
  if (!currentPlan) {
    alert("Create a learning plan before recording results.");
    return;
  }

  if (!practiceCompleted) {
    const proceed = confirm(
      "You have not marked the practice as complete. Record the assessment anyway?"
    );

    if (!proceed) return;
  }

  const score = validPercent("afterScore", "Post-practice accuracy");

  if (score === null) return;

  const retentionField = getField("retention");
  let retention = null;

  if (retentionField.value.trim() !== "") {
    retention = validPercent("retention", "Delayed retention");

    if (retention === null) return;
  }

  const testType = getField("testType").value;
  const afterConfidence = numberFrom("afterConfidence", 3);

  const previousComparable = [...learningHistory]
    .reverse()
    .find(record => record.testType === "comparable");

  const previousScore = previousComparable
    ? previousComparable.score
    : currentPlan.baseline;

  const delta = score - previousScore;

  const record = {
    date: new Date().toLocaleString(),
    goal: currentPlan.goal,
    skill: currentPlan.skill,
    baseline: currentPlan.baseline,
    score,
    delta,
    retention,
    confidence: afterConfidence,
    testType,
    strategy: latestRecommendation,
    target: currentPlan.target
  };

  learningHistory.push(record);
  lastLearningRecord = record;

  if (testType === "comparable") {
    if (delta <= 0) {
      failureStreak++;
    } else {
      failureStreak = 0;
    }
  }

  const result = getField("feedbackResult");
  result.classList.remove("hidden");

  let feedbackTitle = "Assessment recorded";
  let feedbackMessage = "";

  if (testType !== "comparable") {
    feedbackMessage =
      "This assessment is not directly comparable with the baseline. Keep the result as context, but do not use it alone to claim improvement or trigger a strategy change.";
  } else if (score >= currentPlan.target) {
    feedbackMessage =
      "The target was reached on this assessment. Verify delayed retention and apply the skill to an unfamiliar task before declaring mastery.";
  } else if (delta > 0) {
    feedbackMessage =
      "Performance improved by " + delta + " percentage points compared with the previous comparable result. Continue and verify the improvement with another test.";
  } else {
    feedbackMessage =
      "No improvement was demonstrated on this comparable assessment. Review the errors, difficulty, and possible barriers before repeating the same activity.";
  }

  result.innerHTML = `
    <h4>${safeText(feedbackTitle)}</h4>
    <p><strong>Score:</strong> ${score}%</p>
    <p><strong>Change from previous comparable result:</strong>
      ${delta > 0 ? "+" : ""}${delta} percentage points
    </p>
    <p>${safeText(feedbackMessage)}</p>
    ${retention !== null
      ? "<p><strong>Delayed retention:</strong> " + retention + "%</p>"
      : ""}
  `;

  updateAdaptation(record);
  updateLearningDashboard();

  practiceCompleted = false;

  getField("practiceStatus").textContent =
    "Assessment recorded. Review the adaptation recommendation before your next practice cycle.";

  log("Learning assessment recorded.");
}

/* =========================================
   ADAPTATION ENGINE
========================================= */

function updateAdaptation(record) {
  const result = getField("adaptationResult");
  const reliable = record.testType === "comparable";

  if (!reliable) {
    showResult(
      "adaptationResult",
      "Adaptation paused: verify the measurement",
      "Use a new test with similar difficulty. Do not change the learning strategy based only on a non-comparable assessment.",
      "result-warning"
    );
    return;
  }

  if (failureStreak === 1) {
    showResult(
      "adaptationResult",
      "Review the source of difficulty",
      "One unsuccessful result is not enough to prove the strategy failed. Inspect mistakes and check for fatigue, unclear instructions, or a harder-than-expected test.",
      "result-warning"
    );
    return;
  }

  if (failureStreak >= 2) {
    adaptationLevel++;

    let nextStrategy = "guided";

    if (latestRecommendation === "teach") {
      nextStrategy = "guided";
    } else if (latestRecommendation === "guided") {
      nextStrategy = "teach";
    } else if (
      latestRecommendation === "independent" ||
      latestRecommendation === "transfer"
    ) {
      nextStrategy = "guided";
    } else if (latestRecommendation === "spaced") {
      nextStrategy = "teach";
    }

    latestRecommendation = nextStrategy;
    getField("strategy").value = nextStrategy;

    renderRecommendation();
    renderActionPlan();

    showResult(
      "adaptationResult",
      "Strategy changed after repeated difficulty",
      "The last two comparable assessments did not improve. PathKeeper recommends " +
        strategies[nextStrategy].title +
        ". Inspect recurring errors, check prerequisites, and change one major variable at a time.",
      "result-warning"
    );

    return;
  }

  if (record.score >= currentPlan.target) {
    showResult(
      "adaptationResult",
      "Progress toward mastery",
      "The target was reached. Verify retention after a delay and apply the skill to an unfamiliar task before advancing.",
      "result-success"
    );
  } else if (record.delta > 0) {
    showResult(
      "adaptationResult",
      "Continue and verify",
      "Performance improved. Keep the current strategy for another comparable test. If improvement persists, increase difficulty gradually.",
      "result-success"
    );
  } else {
    showResult(
      "adaptationResult",
      "Investigate before repeating",
      "There is no demonstrated improvement yet. Review errors and barriers before deciding what to change.",
      "result-warning"
    );
  }
}

/* =========================================
   SAFEGUARDS
========================================= */

function reviewBarrier() {
  const barrier = getField("barrier").value;

  const guidance = {
    none:
      "No barrier has been reported. Continue monitoring test quality, workload, and recurring errors without assuming the current method is necessarily correct.",

    fatigue:
      "Consider a shorter session or a break, then retest when rested. Avoid interpreting a fatigue-affected score as a definitive skill level.",

    time:
      "Break the activity into smaller blocks and agree on a realistic time budget. Distinguish a speed problem from an understanding problem.",

    resources:
      "Locate a worked example, reference material, or appropriate practice resource before repeating the assessment.",

    instructions:
      "Clarify the instructions and success criteria. Ambiguous tasks can measure interpretation rather than the intended skill.",

    environment:
      "Reduce interruptions if possible, then repeat a comparable assessment. Record the changed conditions."
  };

  showResult(
    "barrierResult",
    "Barrier review",
    guidance[barrier],
    "result-warning"
  );
}

/* =========================================
   LEARNING DASHBOARD AND CHART
========================================= */

function updateLearningDashboard() {
  const latest = learningHistory[learningHistory.length - 1];

  getField("latestMetric").textContent =
    latest ? latest.score + "%" : "—";

  getField("changeMetric").textContent =
    latest
      ? (latest.score - latest.baseline > 0 ? "+" : "") +
        (latest.score - latest.baseline) + " pp"
      : "—";

  getField("countMetric").textContent = learningHistory.length;

  renderChart();
  renderLearningHistory();
}

function renderChart() {
  const chart = getField("chart");

  if (learningHistory.length === 0) {
    chart.innerHTML =
      '<p class="hint">Your scores will appear here.</p>';
    return;
  }

  const records = learningHistory.slice(-10);

  const values = records.map((record, index) => ({
    label: "Test " + (index + 1),
    score: record.score
  }));

  chart.innerHTML = values.map(item => `
    <div class="chart-column">
      <span class="chart-value">${item.score}%</span>
      <div class="chart-bar" style="height:${Math.max(3, item.score)}%"></div>
      <span class="chart-label">${item.label}</span>
    </div>
  `).join("");
}

function renderLearningHistory() {
  const container = getField("learningHistory");

  if (learningHistory.length === 0) {
    container.innerHTML =
      '<div class="empty-history">No learning assessments recorded yet.</div>';
    return;
  }

  container.innerHTML = learningHistory.slice().reverse().map(record => `
    <div class="empty-history" style="text-align:left">
      <strong>${safeText(record.skill)}</strong>
      <p>${safeText(record.date)}</p>
      <p>Score: ${record.score}% · Baseline: ${record.baseline}%</p>
      <p>Strategy: ${safeText(
        strategies[record.strategy]
          ? strategies[record.strategy].title
          : "Not recorded"
      )}</p>
      <p>Assessment: ${safeText(record.testType)}</p>
      ${record.retention !== null
        ? "<p>Delayed retention: " + record.retention + "%</p>"
        : ""}
    </div>
  `).join("");
}

/* =========================================
   DATA EXPORT
========================================= */

function downloadCSV(filename, rows) {
  if (!rows.length) {
    alert("There are no records to export yet.");
    return;
  }

  const headers = Object.keys(rows[0]);

  const escapeCSV = value =>
    '"' + String(value ?? "").replace(/"/g, '""') + '"';

  const csv = [
    headers.map(escapeCSV).join(","),
    ...rows.map(row =>
      headers.map(header => escapeCSV(row[header])).join(",")
    )
  ].join("\n");

  const blob = new Blob([csv], {
    type: "text/csv;charset=utf-8;"
  });

  const url = URL.createObjectURL(blob);
  const link = document.createElement("a");

  link.href = url;
  link.download = filename;

  document.body.appendChild(link);
  link.click();
  link.remove();

  URL.revokeObjectURL(url);
}

function exportLearningData() {
  downloadCSV("pathkeeper-learning-history.csv", learningHistory);
}

function exportCycleData() {
  downloadCSV("pathkeeper-focus-cycle-history.csv", cycleHistory);
}

function exportData() {
  const combined = [
    ...cycleHistory.map(record => ({
      recordType: "Focus cycle",
      ...record
    })),
    ...learningHistory.map(record => ({
      recordType: "Learning assessment",
      ...record
    }))
  ];

  downloadCSV("pathkeeper-combined-performance-records.csv", combined);
}

/* =========================================
   RESET SESSION DATA
========================================= */

function resetAllData() {
  const confirmed = confirm(
    "This will clear all focus and learning records in the current page session. Export anything you want to keep first. Continue?"
  );

