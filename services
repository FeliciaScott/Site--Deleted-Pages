<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>PathKeeper | Stop Searching. Start Building.</title>

<style>
:root{
  --cream:#F7F2E8;
  --cream2:#EEE3D1;
  --cream3:#E2D2B9;

  --brown:#49352A;
  --brown2:#674C3B;
  --brown3:#8B6A50;

  --blue:#294F6D;
  --blue2:#3D6F91;
  --blue3:#729BB5;
  --blue-light:#DCEAF1;

  --text:#30271F;
  --muted:#706356;
  --white:#FFFFFF;
}

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:"Segoe UI",Arial,sans-serif;
  background:var(--cream);
  color:var(--text);
  overflow-x:hidden;
  line-height:1.7;
}

header{
  width:100%;
  padding:20px 8%;
  background:var(--brown);
  border-bottom:2px solid var(--blue3);
  display:flex;
  justify-content:space-between;
  align-items:center;
  position:sticky;
  top:0;
  z-index:1000;
}

.logo{
  font-size:1.5rem;
  font-weight:800;
  color:var(--cream);
  text-decoration:none;
  letter-spacing:1px;
}

.logo span{
  color:#A9C9DC;
}

section{
  padding:60px 8%;
}

h1,h2,h3{
  font-weight:800;
}

p{
  color:var(--muted);
}

/* HERO */

.hero{
  padding:80px 8%;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;

  background:
    radial-gradient(circle at top,#729BB544,transparent 45%),
    radial-gradient(circle at bottom,#8B6A5044,transparent 40%),
    var(--blue);

  color:var(--cream);
  position:relative;
}

.badge{
  padding:8px 18px;
  border:1px solid #D8B894;
  border-radius:40px;
  color:var(--cream);
  margin-bottom:20px;
  font-size:.9rem;
  letter-spacing:1px;
}

.hero h1{
  font-size:3.8rem;
  max-width:900px;
  line-height:1.1;
  margin-bottom:20px;
}

.highlight{
  background:linear-gradient(90deg,#D8B894,#A9C9DC);
  -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
}

.hero p{
  max-width:760px;
  font-size:1.2rem;
  margin-bottom:30px;
  color:#E8EDF0;
}

/* BUTTONS */

.button{
  display:inline-block;
  padding:16px 40px;
  background:linear-gradient(90deg,var(--brown3),var(--blue3));
  border-radius:60px;
  color:white;
  font-weight:bold;
  text-decoration:none;
  transition:.35s;
  border:1px solid transparent;
}

.button:hover{
  transform:translateY(-4px) scale(1.03);
  box-shadow:0 20px 40px rgba(41,79,109,.3);
}

.button.service{
  background:var(--cream);
  color:var(--brown);
  border:2px solid var(--cream);
}

.button.service:hover{
  background:var(--blue-light);
  color:var(--blue);
  border-color:var(--blue-light);
}

.hero-buttons{
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:15px;
}

/* SCROLL */

.scroll{
  margin-top:35px;
  font-size:.85rem;
  letter-spacing:2px;
  color:#DCEAF1;
}

/* CARDS */

.cards{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
  gap:25px;
}

.card{
  background:var(--white);
  padding:30px;
  border-radius:18px;
  transition:.35s;
  border:1px solid var(--cream3);
  box-shadow:0 8px 25px rgba(73,53,42,.06);
}

.card:hover{
  transform:translateY(-6px);
  border-color:var(--blue3);
  box-shadow:0 15px 30px rgba(41,79,109,.12);
}

.card h3{
  margin:15px 0 10px;
  color:var(--brown);
}

.number{
  font-size:2.5rem;
  font-weight:900;
  color:var(--blue2);
}

/* BIG QUOTE */

.statement{
  background:var(--brown);
  text-align:center;
  border-radius:25px;
  padding:50px 8%;
  border:1px solid var(--brown3);
}

.statement h2{
  font-size:2.4rem;
  max-width:950px;
  margin:auto;
  line-height:1.3;
  color:var(--cream);
}

.statement span{
  color:#A9C9DC;
}

/* COMPARISON */

.compare{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:30px;
}

.side{
  padding:30px;
  border-radius:20px;
}

.old{
  background:var(--cream2);
  border:1px solid var(--cream3);
}

.new{
  background:var(--blue-light);
  border:1px solid var(--blue3);
}

.side h3{
  margin-bottom:20px;
  font-size:1.8rem;
  color:var(--brown);
}

.side ul{
  list-style:none;
}

.side li{
  margin:10px 0;
  color:var(--text);
}

/* CTA */

.cta{
  text-align:center;
}

.cta h2{
  font-size:2.8rem;
  margin-bottom:20px;
  color:var(--blue);
}

.cta p{
  max-width:700px;
  margin:auto auto 30px;
}

.cta-buttons{
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:15px;
}

/* FOOTER */

footer{
  padding:30px;
  text-align:center;
  border-top:1px solid var(--brown3);
  background:var(--brown);
  color:var(--cream);
}

footer p{
  color:#E5D9CA;
}

/* RESPONSIVE */

@media(max-width:900px){

  section{
    padding:40px 6%;
  }

  .hero{
    padding:60px 6%;
  }

  .hero h1{
    font-size:2.5rem;
  }

  .compare{
    grid-template-columns:1fr;
  }

  .statement h2{
    font-size:1.8rem;
  }

  .cta h2{
    font-size:2rem;
  }
}

@media(max-width:550px){

  .hero-buttons,
  .cta-buttons{
    flex-direction:column;
    width:100%;
  }

  .hero-buttons .button,
  .cta-buttons .button{
    width:100%;
  }

  header{
    justify-content:center;
  }

}
</style>
</head>

