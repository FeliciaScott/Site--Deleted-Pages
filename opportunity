function getSaved(){

return JSON.parse(
localStorage.getItem(
"opportunityAtlasSaved"
) || "[]"
);

}


function isSaved(index){

return getSaved().includes(index);

}


function toggleSave(index){

let saved =
getSaved();

if(saved.includes(index)){

saved =
saved.filter(
item => item !== index
);

}
else{

saved.push(index);

}

localStorage.setItem(
"opportunityAtlasSaved",
JSON.stringify(saved)
);

renderSaved();

renderOpportunities(opportunities);

}


function renderSaved(){

const grid =
document.getElementById("savedGrid");

const saved =
getSaved();

if(saved.length === 0){

grid.innerHTML = `
