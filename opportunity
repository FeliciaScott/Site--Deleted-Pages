</p>
</div>
`;

return;

}


grid.innerHTML =
list.map(item => {

const index =
opportunities.indexOf(item);

const saved =
isSaved(index);

return `

<article class="opportunity">

<div class="opportunity-top">

<div class="tag">
${item.category}
</div>

<button
class="save ${saved ? "saved":""}"
