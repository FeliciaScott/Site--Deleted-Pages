<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">

<title>Opportunity Atlas | Find Your Next Path</title>

<style>

*{
box-sizing:border-box;
margin:0;
padding:0;
}

:root{
--bg:#10150f;
--panel:#182018;
--panel2:#202a1f;
--line:#394735;
--brown:#76543a;
--brown-dark:#4d3828;
--brown-light:#a9825b;
--green:#7fb069;
--green-bright:#9acb7b;
--green-dark:#3f6338;
--cream:#f5f0df;
--cream-dark:#e3dcc8;
--muted:#b2b8a8;
--red:#c8786d;
}

html{
scroll-behavior:smooth;
}

body{
font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
background:
radial-gradient(circle at 10% 0%,rgba(127,176,105,.12),transparent 30%),
radial-gradient(circle at 90% 10%,rgba(118,84,58,.14),transparent 30%),
var(--bg);
color:var(--cream);
line-height:1.6;
overflow-x:hidden;
}

.container{
width:min(1500px,94%);
margin:auto;
}

/* =========================
HERO
========================= */

.hero{
padding:80px 20px 65px;
border-bottom:1px solid var(--line);
background:
linear-gradient(
135deg,
rgba(63,99,56,.18),
rgba(77,56,40,.15)
);
}

.eyebrow{
color:var(--green-bright);
font-size:.72rem;
font-weight:900;
letter-spacing:.2em;
text-transform:uppercase;
margin-bottom:16px;
}

.hero h1{
font-size:clamp(2.8rem,6vw,6rem);
line-height:.96;
max-width:1150px;
margin-bottom:25px;
}

.hero h1 span{
color:var(--green-bright);
}

.hero p{
max-width:950px;
font-size:1.12rem;
color:var(--muted);
}

.hero-grid{
display:grid;
grid-template-columns:2fr 1fr;
gap:18px;
margin-top:38px;
}

.hero-stat{
background:rgba(24,32,24,.9);
border:1px solid var(--line);
border-radius:18px;
padding:23px;
}

.hero-stat:first-child{
border-left:4px solid var(--green);
}

.hero-stat:last-child{
border-left:4px solid var(--brown-light);
}

.hero-stat strong{
display:block;
font-size:2.4rem;
color:var(--green-bright);
margin-bottom:3px;
}

.hero-stat span{
font-size:.75rem;
text-transform:uppercase;
letter-spacing:.1em;
color:var(--muted);
}

/* =========================
MAIN
========================= */

.dashboard{
padding:40px 0 80px;
}

.panel{
background:
linear-gradient(
145deg,
rgba(24,32,24,.98),
rgba(16,21,15,.98)
);
border:1px solid var(--line);
border-radius:20px;
padding:28px;
margin-bottom:22px;
}

.panel h2{
color:var(--green-bright);
font-size:1.3rem;
margin-bottom:18px;
}

/* =========================
OPPORTUNITY LIBRARY
========================= */

.opportunity-header{
display:flex;
justify-content:space-between;
align-items:center;
gap:20px;
margin-bottom:20px;
}

.result-count{
font-size:.8rem;
color:var(--muted);
}

.opportunity-grid{
display:grid;
grid-template-columns:repeat(3,minmax(0,1fr));
gap:18px;
width:100%;
}

.opportunity{
background:
linear-gradient(
145deg,
#172017,
#111811
);
border:1px solid var(--line);
border-radius:17px;
padding:21px;
display:flex;
flex-direction:column;
min-height:310px;
height:auto;
overflow:visible;
word-break:normal;
overflow-wrap:anywhere;
transition:.2s;
}

.opportunity:hover{
border-color:var(--green);
transform:translateY(-2px);
}

.opportunity-top{
display:flex;
justify-content:space-between;
gap:10px;
margin-bottom:12px;
}

.tag{
font-size:.65rem;
font-weight:900;
letter-spacing:.1em;
text-transform:uppercase;
color:var(--brown-light);
}

.save{
background:none;
border:0;
padding:0;
font-size:1.2rem;
color:var(--muted);
cursor:pointer;
}

.save.saved{
color:var(--green-bright);
}

.opportunity h3{
font-size:1.15rem;
margin-bottom:8px;
color:var(--cream);
line-height:1.3;
}

.opportunity p{
font-size:.84rem;
color:var(--muted);
margin-bottom:15px;
}

.meta{
display:flex;
flex-wrap:wrap;
gap:6px;
margin-bottom:16px;
}

.meta span{
font-size:.65rem;
padding:4px 8px;
border-radius:20px;
background:#253023;
color:#d1dfc6;
border:1px solid #344331;
}

.opportunity-footer{
margin-top:auto;
display:flex;
gap:8px;
padding-top:10px;
}

.opportunity-footer a{
flex:1;
text-decoration:none;
text-align:center;
padding:11px;
border-radius:9px;
font-weight:900;
font-size:.78rem;
background:var(--green);
color:#10150f;
}

.opportunity-footer button{
background:var(--brown-dark);
color:var(--cream);
border:1px solid var(--brown);
}

button:hover,
.opportunity-footer a:hover{
filter:brightness(1.1);
}

/* =========================
DISCOVERY
========================= */

.discovery{
display:grid;
grid-template-columns:1.5fr 1fr;
gap:20px;
}

.discovery-box{
background:
linear-gradient(
145deg,
#253224,
#151c15
);
border:1px solid #42523d;
border-radius:17px;
padding:23px;
height:100%;
}

.discovery-box h3{
color:var(--green-bright);
margin-bottom:8px;
}

.discovery-box p{
color:var(--muted);
font-size:.88rem;
}

.path-grid{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:12px;
margin-top:18px;
}

.path{
background:#111811;
border:1px solid var(--line);
border-radius:12px;
padding:16px;
}

.path strong{
display:block;
color:var(--cream);
}

.path span{
font-size:.76rem;
color:var(--muted);
}

/* =========================
TRACKER
========================= */

.tracker-grid{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:12px;
}

.tracker-stat{
background:#172017;
border:1px solid var(--line);
border-radius:13px;
padding:18px;
}

.tracker-stat strong{
display:block;
font-size:2rem;
color:var(--green-bright);
}

.tracker-stat span{
font-size:.68rem;
color:var(--muted);
text-transform:uppercase;
letter-spacing:.08em;
}

.tracker-form{
display:grid;
grid-template-columns:2fr 1fr 1fr auto;
gap:10px;
margin-top:20px;
}

input,
select{
width:100%;
background:#10160f;
border:1px solid var(--line);
border-radius:10px;
padding:13px;
color:var(--cream);
font-size:.95rem;
outline:none;
}

input:focus,
select:focus{
border-color:var(--green);
}

button{
border:0;
border-radius:10px;
padding:12px 17px;
font-weight:900;
cursor:pointer;
font-size:.88rem;
}

.primary{
background:var(--green);
color:#10150f;
}

.secondary{
background:var(--brown-dark);
color:var(--cream);
border:1px solid var(--brown);
}

.gold{
background:var(--brown-light);
color:#17100a;
}

.danger{
background:#3d2521;
color:#ffb8b0;
}

.tracker-list{
margin-top:18px;
display:grid;
gap:9px;
}

.tracker-item{
display:grid;
grid-template-columns:2fr 1fr 1fr auto;
gap:10px;
align-items:center;
background:#172017;
border:1px solid var(--line);
border-radius:10px;
padding:13px;
}

.tracker-item strong{
color:var(--cream);
}

.tracker-item span{
font-size:.78rem;
color:var(--muted);
}

.status{
display:inline-block;
padding:4px 8px;
border-radius:20px;
font-size:.62rem;
font-weight:900;
text-transform:uppercase;
}

.research{
background:#29402c;
color:#b9e6a7;
}

.preparing{
background:#4a4128;
color:#e5d797;
}

.applied{
background:#304338;
color:#b9d8b0;
}

.rejected{
background:#422625;
color:#ffb2aa;
}

.won{
background:#2e4b2f;
color:#b8edaa;
}

/* =========================
WARNING
========================= */

.warning{
margin-top:20px;
padding:20px;
border-left:3px solid var(--brown-light);
background:#1b2119;
border-radius:10px;
}

.warning h3{
color:var(--brown-light);
margin-bottom:5px;
}

.warning p{
color:var(--muted);
font-size:.85rem;
}

/* =========================
FOOTER
========================= */

footer{
border-top:1px solid var(--line);
padding:40px 20px;
text-align:center;
color:var(--muted);
background:#0d120d;
}

/* =========================
RESPONSIVE
========================= */

@media(max-width:1100px){

.opportunity-grid{
grid-template-columns:1fr 1fr;
}

.tracker-grid{
grid-template-columns:repeat(2,1fr);
}

.path-grid{
grid-template-columns:1fr 1fr;
}

}

@media(max-width:800px){

.hero-grid,
.discovery{
grid-template-columns:1fr;
}

.opportunity-grid{
grid-template-columns:1fr;
}

}

@media(max-width:600px){

.hero{
padding:55px 15px 45px;
}

.dashboard{
padding:25px 0 55px;
}

.panel{
padding:20px 15px;
}

.hero-grid{
grid-template-columns:1fr;
}

.path-grid,
.tracker-grid{
grid-template-columns:1fr;
}

.tracker-form{
grid-template-columns:1fr;
}

.tracker-item{
grid-template-columns:1fr;
}

.opportunity-header{
align-items:flex-start;
flex-direction:column;
}

}

</style>
</head>

