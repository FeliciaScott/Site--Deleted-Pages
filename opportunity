/* =========================
RENDER OPPORTUNITIES
========================= */

function renderOpportunities(list){

const grid =
document.getElementById("opportunityGrid");

document.getElementById("resultCount").textContent =
"Showing " + list.length + " opportunities";


if(list.length === 0){

grid.innerHTML = `
<div class="warning">
<h3>No opportunities found</h3>
<p>
There are currently no matching opportunities in this library.
Try another category or search term.
</p>
</div>
`;

return;

}


grid.innerHTML =
list.map(item => {

const index =
opportunities.indexOf(item);

const saved =
isSaved(index);

return `

<article class="opportunity">

<div class="opportunity-top">

<div class="tag">
${item.category}
</div>

<button
class="save ${saved ? "saved":""}"
onclick="toggleSave(${index})"
title="Save opportunity">

${saved ? "★":"☆"}

</button>

</div>

<h3>
${item.name}
</h3>

<p>
${item.description}
</p>

<div class="meta">

<span>${item.location}</span>
<span>${item.eligibility}</span>

${item.tags.map(
tag => `<span>${tag}</span>`
).join("")}

</div>

<div class="opportunity-footer">

<a
href="${item.url}"
target="_blank"
rel="noopener noreferrer">

Official Site

</a>

<button
onclick="trackOpportunity('${item.name.replace(/'/g,"\\'")}')">

Track

</button>

</div>

</article>

`;

}).join("");

}


/* =========================
WATCHLIST
========================= */

function getSaved(){

return JSON.parse(
localStorage.getItem(
"opportunityAtlasSaved"
) || "[]"
);

}


function isSaved(index){

return getSaved().includes(index);

}


function toggleSave(index){

let saved =
getSaved();

if(saved.includes(index)){

saved =
saved.filter(
item => item !== index
);

}
else{

saved.push(index);

}

localStorage.setItem(
"opportunityAtlasSaved",
JSON.stringify(saved)
);

renderSaved();

renderOpportunities(opportunities);

}


function renderSaved(){

const grid =
document.getElementById("savedGrid");

const saved =
getSaved();

if(saved.length === 0){

grid.innerHTML = `
<div class="warning">
<h3>Nothing saved yet</h3>
<p>
Save opportunities that may become useful later.
</p>
</div>
`;

return;

}


grid.innerHTML =
saved.map(index => {

const item =
opportunities[index];

return `

<article class="opportunity">

<div class="opportunity-top">

<div class="tag">
${item.category}
</div>

<button
class="save saved"
onclick="toggleSave(${index})">

★

</button>

</div>

<h3>
${item.name}
</h3>

<p>
${item.description}
</p>

<div class="meta">

<span>${item.location}</span>

${item.tags.map(
tag => `<span>${tag}</span>`
).join("")}

</div>

<div class="opportunity-footer">

<a
href="${item.url}"
target="_blank"
rel="noopener noreferrer">

Open

</a>

</div>

</article>

`;

}).join("");

}


/* =========================
APPLICATION TRACKER
========================= */

let applications =
JSON.parse(
localStorage.getItem(
"opportunityAtlasApplications"
) || "[]"
);


function addApplication(){

const name =
document.getElementById("trackName")
.value.trim();

const status =
document.getElementById("trackStatus")
.value;

const date =
document.getElementById("trackDate")
.value;

if(!name){

alert(
"Enter an opportunity name."
);

return;

}

applications.push({
name,
status,
date
});

saveApplications();

document.getElementById("trackName")
.value = "";

renderApplications();

}


function trackOpportunity(name){

document.getElementById("trackName")
.value =
name;

document
.getElementById("trackName")
.scrollIntoView({
behavior:"smooth",
block:"center"
});

}


function saveApplications(){

localStorage.setItem(
"opportunityAtlasApplications",
JSON.stringify(applications)
);

}


function renderApplications(){

const list =
document.getElementById("trackerList");

if(applications.length === 0){

list.innerHTML =
`
<div class="warning">
<h3>Your pipeline is empty</h3>
<p>
Track opportunities here so your search becomes a pipeline instead
of a collection of bookmarks.
</p>
</div>
`;

}
else{

list.innerHTML =
applications.map(
(item,index) => {

let cls =
item.status
.toLowerCase()
.replace(" ","");

return `

<div class="tracker-item">

<strong>
${item.name}
</strong>

<span>
${item.date || "No date"}
</span>

<span>
<span class="status ${cls}">
${item.status}
</span>
</span>

<button
class="danger"
onclick="removeApplication(${index})">

Remove

</button>

</div>

`;

}).join("");

}


updateTrackerStats();

}


function removeApplication(index){

applications.splice(index,1);

saveApplications();

renderApplications();

}


function updateTrackerStats(){

document.getElementById("researchCount")
.textContent =
applications.filter(
x => x.status === "Researching"
).length;

document.getElementById("preparingCount")
.textContent =
applications.filter(
x => x.status === "Preparing"
).length;

document.getElementById("appliedCount")
.textContent =
applications.filter(
x => x.status === "Applied"
).length;

document.getElementById("wonCount")
.textContent =
applications.filter(
x => x.status === "Won"
).length;

}


/* =========================
INITIALIZE
========================= */

renderOpportunities(opportunities);

renderSaved();

renderApplications();

</script>

