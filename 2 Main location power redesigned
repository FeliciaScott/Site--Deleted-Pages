    const items =
        document.querySelectorAll(".audit-item");

    let completed = 0;

    auditState = [];

    items.forEach(function(item,index){

        const checkbox =
            item.querySelector("input");

        if(checkbox.checked){

            completed++;

            item.classList.add("completed");

            auditState.push(index);

        }else{

            item.classList.remove("completed");

        }

    });

    const percentage =
        Math.round(
            (completed / items.length) * 100
        );

    document.getElementById("auditScore")
        .textContent = percentage + "%";

    document.getElementById("heroAudit")
        .textContent = percentage + "%";

    if(percentage === 100){

        document.getElementById("auditMessage")
            .textContent =
            "Your strategic assumptions have been fully audited. Move from analysis into verification.";

    }else if(percentage >= 60){

        document.getElementById("auditMessage")
            .textContent =
            "Your framework is becoming decision-ready. Resolve the remaining unknowns before making major commitments.";

    }else{

        document.getElementById("auditMessage")
            .textContent =
            "Several important variables remain untested. Continue the audit before treating the location as a strategic advantage.";

    }

    localStorage.setItem(
        "locationAudit",
        JSON.stringify(auditState)
    );
}


function completeAudit(){

    const items =
        document.querySelectorAll(".audit-item");

    const checked =
        document.querySelectorAll(
            ".audit-item input:checked"
        ).length;

    if(checked === items.length){

        addXP(150);

        showToast(
            "Audit completed +150 XP"
        );

    }else{

        showToast(
            "Complete every audit variable first."
        );

    }
}


/* =========================
   STRATEGY BUILDER
========================= */

function updateBuilder(){

    const capability =
        document.getElementById("capability").value.trim();

    const problem =
        document.getElementById("problem").value.trim();

    const environment =
        document.getElementById("environment").value;

    const objective =
        document.getElementById("objective").value;

    document.getElementById("outCapability")
        .textContent =
        capability || "Not defined";

    document.getElementById("outProblem")
        .textContent =
        problem || "Not defined";

    document.getElementById("outEnvironment")
        .textContent =
        environment;

    document.getElementById("outObjective")
        .textContent =
        objective;

    let conclusion =
        "Define your capability and target problem to generate a strategic hypothesis.";

    if(capability && problem){

        conclusion =
            "Strategic hypothesis: position " +
            capability +
            " inside a " +
            environment.toLowerCase() +
            " to address " +
            problem +
            ", with the primary objective of " +
            objective.toLowerCase() +
            ".";

    }

    document.getElementById(
        "strategyConclusion"
    ).textContent = conclusion;

    localStorage.setItem(
        "strategyBuilder",
        JSON.stringify({
            capability,
            problem,
            environment,
            objective
        })
    );
}


function copyStrategy(){

    const capability =
        document.getElementById("capability").value.trim();

    const problem =
        document.getElementById("problem").value.trim();

    const environment =
        document.getElementById("environment").value;

    const objective =
        document.getElementById("objective").value;

    if(!capability || !problem){

        showToast(
            "Add a capability and problem first."
        );

        return;
    }

    const text =
`LOCATION STRATEGY BRIEF

Capability:
${capability}

Target Problem:
${problem}

Preferred Environment:
${environment}

Primary Objective:
${objective}

Strategic Hypothesis:
Position ${capability} inside a ${environment.toLowerCase()} to address ${problem}, with the primary objective of ${objective.toLowerCase()}.`;

    navigator.clipboard.writeText(text)
        .then(function(){

            addXP(50);

            showToast(
                "Strategy brief copied +50 XP"
            );

        })
        .catch(function(){

            showToast(
                "Copy unavailable in this browser."
            );

        });
}


/* =========================
   PROGRESSION
========================= */

const levelDetails = {

    1:
    "Observer: You have started treating your environment as a variable instead of an unchangeable condition. Your next task is to identify measurable differences.",

    2:
    "Analyst: You compare demand, competition, cost, infrastructure, and network access instead of relying on reputation or instinct.",

    3:
    "Positioner: You deliberately match your capabilities with environments where they solve expensive or underserved problems.",

    4:
    "Strategist: You combine multiple variables and construct positioning that can survive changes in employers, customers, industries, or geography.",

    5:
    "Architect: You build an environment strategy around optionality, compounding networks, capital retention, learning velocity, and multiple future exits."

};


function selectLevel(level,element){

    document
        .querySelectorAll(".level")
        .forEach(function(item){
            item.classList.remove("active");
        });

    element.classList.add("active");

    document.getElementById(
        "levelDetail"
    ).textContent =
        levelDetails[level];

    showToast(
        "Strategic level " + level + " selected"
    );
}


/* =========================
   MISSIONS
========================= */

const missionXP = [
    50,
    75,
    100,
    75,
    100,
    125
];


function completeMission(index,button){

    if(missions.includes(index)){

        showToast(
            "Mission already completed."
        );

        return;
    }

    missions.push(index);

    localStorage.setItem(
        "locationMissions",
        JSON.stringify(missions)
    );

    const mission =
        button.closest(".mission");

    mission.classList.add("done");

    button.textContent =
        "Mission Complete";

    button.disabled = true;

    addXP(
        missionXP[index]
    );

    updateMissionStats();

    showToast(
        "Mission completed +" +
        missionXP[index] +
        " XP"
    );
}


function updateMissionStats(){

    document.getElementById(
        "heroMissions"
    ).textContent =
        missions.length + "/6";
}


/* =========================
   XP SYSTEM
========================= */

function addXP(amount){

    xp += amount;

    localStorage.setItem(
        "locationXP",
        xp
    );

    updateXP();
}


function updateXP(){

    const xpPerLevel = 300;

    const level =
        Math.min(
            10,
            Math.floor(xp / xpPerLevel) + 1
        );

    const currentLevelXP =
        xp % xpPerLevel;

    const percentage =
        Math.min(
            100,
            (currentLevelXP / xpPerLevel) * 100
        );

    document.getElementById(
        "xpNumber"
    ).textContent = xp;

    document.getElementById(
        "xpFill"
    ).style.width =
        percentage + "%";

    document.getElementById(
        "heroLevel"
    ).textContent =
        String(level).padStart(2,"0");

    const rankNames = [
        "STRATEGIST I",
        "STRATEGIST II",
        "POSITION ANALYST",
        "MARKET POSITIONER",
        "SYSTEM STRATEGIST",
        "MOBILITY ARCHITECT",
        "LEVERAGE ARCHITECT",
        "STRATEGIC OPERATOR",
        "SYSTEM DESIGNER",
        "ENVIRONMENT ARCHITECT"
    ];

    document.getElementById(
        "rankName"
    ).textContent =
        rankNames[level - 1] ||
        "ENVIRONMENT ARCHITECT";
}


/* =========================
   RESET
========================= */

function resetProgress(){

    const confirmReset =
        confirm(
            "Reset all saved Location Strategy progress?"
        );

    if(!confirmReset){
        return;
    }

    localStorage.removeItem("locationXP");
    localStorage.removeItem("locationMissions");
    localStorage.removeItem("locationAudit");
    localStorage.removeItem("locationScore");
    localStorage.removeItem("locationAnalysis");
    localStorage.removeItem("strategyBuilder");

    location.reload();
}


/* =========================
   SCROLL PROGRESS
========================= */

window.addEventListener(
    "scroll",
    function(){

        const scrollTop =
            window.scrollY;

        const height =
            document.documentElement.scrollHeight -
            window.innerHeight;

        const progress =
            height > 0
                ? (scrollTop / height) * 100
                : 0;

        document.getElementById(
            "scrollProgress"
        ).style.width =
            progress + "%";

    }
);


/* =========================
   RESTORE SAVED STATE
========================= */

function restoreState(){

    updateXP();

    updateMissionStats();

    missions.forEach(function(index){

        const mission =
            document.querySelector(
                '[data-mission="' + index + '"]'
            );

        if(mission){

            mission.classList.add("done");

            const button =
                mission.querySelector("button");

            button.textContent =
                "Mission Complete";

            button.disabled = true;

        }

    });


    const savedAudit =
        JSON.parse(
            localStorage.getItem("locationAudit") || "[]"
        );

    savedAudit.forEach(function(index){

        const item =
            document.querySelectorAll(
                ".audit-item"
            )[index];

        if(item){

            item.querySelector(
                "input"
            ).checked = true;

        }

    });

    updateAudit();


    const savedBuilder =
        JSON.parse(
            localStorage.getItem("strategyBuilder") || "null"
        );

    if(savedBuilder){

        document.getElementById(
            "capability"
        ).value =
            savedBuilder.capability || "";

        document.getElementById(
            "problem"
        ).value =
            savedBuilder.problem || "";

        document.getElementById(
            "environment"
        ).value =
            savedBuilder.environment ||
            "Remote-first market";

        document.getElementById(
            "objective"
        ).value =
            savedBuilder.objective ||
            "Increase income";

        updateBuilder();

    }

    const savedScore =
        localStorage.getItem(
            "locationScore"
        );

    if(savedScore){

        document.getElementById(
            "heroScore"
        ).textContent =
            savedScore;

    }
}


document.addEventListener(
    "DOMContentLoaded",
    function(){

        updateLocationScore();

        updateBuilder();

        restoreState();

    }
);

</script>

