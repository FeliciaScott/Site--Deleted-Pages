<script>

/* =========================
   GLOBAL STATE
========================= */

let xp = Number(localStorage.getItem("locationXP")) || 0;

let missions =
    JSON.parse(localStorage.getItem("locationMissions") || "[]");

let auditState =
    JSON.parse(localStorage.getItem("locationAudit") || "[]");


/* =========================
   NAVIGATION
========================= */

function scrollToSection(id){

    const element = document.getElementById(id);

    if(element){
        element.scrollIntoView({
            behavior:"smooth",
            block:"start"
        });
    }
}


/* =========================
   TOAST
========================= */

function showToast(message){

    const toast = document.getElementById("toast");

    toast.textContent = message;

    toast.classList.add("show");

    setTimeout(function(){
        toast.classList.remove("show");
    },2200);
}


/* =========================
   INSIGHT REVEALS
========================= */

function toggleInsight(button){

    const card = button.closest(".insight-card");

    card.classList.toggle("open");

    if(card.classList.contains("open")){
        button.textContent = "Collapse insight ↑";
    }else{
        button.textContent = "Explore mechanism →";
    }
}


/* =========================
   LOCATION SCORE
========================= */

function updateLocationScore(){

    const fields = [
        "demand",
        "competition",
        "cost",
        "network",
        "infrastructure",
        "expansion"
    ];

    let total = 0;

    fields.forEach(function(id){

        const value =
            Number(document.getElementById(id).value);

        total += value;

        document.getElementById(id + "Value").textContent = value;

    });

    const score =
        Math.round((total / 60) * 100);

    document.getElementById("locationScore").textContent = score;
    document.getElementById("heroScore").textContent = score;

    const ring =
        document.getElementById("scoreRing");

    ring.style.background =
        "radial-gradient(circle,#151C13 58%,transparent 59%)," +
        "conic-gradient(var(--accent) " +
        (score * 3.6) +
        "deg,#485444 0deg)";

    let status;
    let explanation;

    if(score >= 80){

        status = "High-Leverage Position";

        explanation =
            "The environment scores strongly across multiple variables. " +
            "The next question is whether the assumptions behind the score " +
            "can be verified in the real world.";

    }else if(score >= 65){

        status = "Promising Position";

        explanation =
            "Several variables create leverage, but at least one major " +
            "constraint should be investigated before committing resources.";

    }else if(score >= 45){

        status = "Neutral Position";

        explanation =
            "The environment is neither clearly advantageous nor clearly " +
            "disadvantageous. Your strategy needs stronger differentiation.";

    }else{

        status = "High-Friction Position";

        explanation =
            "The current assumptions indicate substantial structural friction. " +
            "Look for a different environment or redesign the operating model.";

    }

    document.getElementById("scoreStatus").textContent = status;
    document.getElementById("scoreExplanation").textContent = explanation;

    localStorage.setItem(
        "locationScore",
        score
    );
}


/* =========================
   SAVE LOCATION ANALYSIS
========================= */

function saveLocationAnalysis(){

    const name =
        document.getElementById("locationName").value.trim() ||
        "Unnamed Scenario";

    const score =
        document.getElementById("locationScore").textContent;

    const analysis = {

        name:name,
        score:score,
        demand:document.getElementById("demand").value,
        competition:document.getElementById("competition").value,
        cost:document.getElementById("cost").value,
        network:document.getElementById("network").value,
        infrastructure:document.getElementById("infrastructure").value,
        expansion:document.getElementById("expansion").value,
        date:new Date().toLocaleString()

    };

    localStorage.setItem(
        "locationAnalysis",
        JSON.stringify(analysis)
    );

    addXP(75);

    showToast(
        "Location analysis saved +75 XP"
    );
}


