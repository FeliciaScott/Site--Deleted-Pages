<script>

/* ==========================================
PATHKEEPER GAME ENGINE
========================================== */

let xp =
parseInt(localStorage.getItem("pkXP")) || 0;

let actions =
parseInt(localStorage.getItem("pkActions")) || 0;

let streak =
parseInt(localStorage.getItem("pkStreak")) || 1;


/* ==========================================
LEVEL
========================================== */

function level(){

return Math.floor(xp / 100) + 1;

}


/* ==========================================
CAREER SCORE
========================================== */

function careerScore(){

let score =
42 + Math.floor(xp / 12);

if(score > 100){
score = 100;
}

return score;

}


/* ==========================================
UPDATE UI
========================================== */

function updateUI(){

const currentLevel = level();

document.getElementById("levelText")
.textContent =
"LEVEL " + currentLevel;

document.getElementById("xpText")
.textContent =
xp + " XP";

document.getElementById("levelStat")
.textContent =
currentLevel;

document.getElementById("xpStat")
.textContent =
xp;

document.getElementById("streakStat")
.textContent =
streak + " 🔥";

document.getElementById("missionStat")
.textContent =
actions;

const score =
careerScore();

document.getElementById("careerScore")
.textContent =
score;

document.getElementById("scoreRing")
.style.background =
`conic-gradient(
var(--green) ${score * 3.6}deg,
#1c2a36 ${score * 3.6}deg
)`;

updateBadges();

}


/* ==========================================
ADD XP
========================================== */

function addXP(amount){

const oldLevel =
level();

xp += amount;

actions++;

localStorage.setItem("pkXP",xp);
localStorage.setItem("pkActions",actions);

updateUI();

showToast("+" + amount + " XP earned");

if(level() > oldLevel){

setTimeout(function(){

showToast(
"LEVEL UP! You reached Level " +
level()
);

},1000);

}

}


/* ==========================================
TASK
========================================== */

function completeTask(input,amount){

const task =
input.closest(".task");

if(input.checked){

task.classList.add("done");

addXP(amount);

}

}


/* ==========================================
MISSION
========================================== */

function missionComplete(button,amount){

if(button.dataset.completed){
return;
}

button.dataset.completed = "true";

button.textContent = "✓ Completed";

button.style.background =
"#0e2922";

button.style.color =
"var(--green)";

addXP(amount);

}


/* ==========================================
FOCUS
========================================== */

function focusBoost(){

showToast("Focus session started");

addXP(10);

}


/* ==========================================
OPPORTUNITY SCANNER
========================================== */

function scanOpportunities(){

showToast("Opportunity scan complete");

addXP(15);

}


/* ==========================================
DECISION SIMULATOR
========================================== */

function decision(choice){

const result =
document.getElementById("simResult");

result.classList.add("show");

if(choice === "search"){

result.innerHTML =
"<strong>Result:</strong> More information may feel productive, but without action it can create a larger collection of possibilities without increasing capability.";

}

if(choice === "skill"){

result.innerHTML =
"<strong>Result:</strong> Strong choice. You're balancing capability development with market exposure.";

addXP(15);

}

if(choice === "evidence"){

result.innerHTML =
"<strong>Result:</strong> Excellent. Creating evidence can simultaneously strengthen your skills, portfolio, confidence, and market position.";

addXP(25);

}

}


/* ==========================================
BADGES
========================================== */

function updateBadges(){

if(actions >= 3){

document
.getElementById("badge1")
.classList.add("unlocked");

}

if(xp >= 150){

document
.getElementById("badge2")
.classList.add("unlocked");

}

if(xp >= 300){

document
.getElementById("badge3")
.classList.add("unlocked");

}

if(actions >= 5){

document
.getElementById("badge4")
.classList.add("unlocked");

}

if(level() >= 5){

document
.getElementById("badge5")
.classList.add("unlocked");

}

let badges =
document.querySelectorAll(
".badge-card.unlocked"
).length;

document.getElementById("badgeStat")
.textContent =
badges;

}


/* ==========================================
TOAST
========================================== */

function showToast(message){

const toast =
document.getElementById("toast");

toast.textContent =
message;

toast.classList.add("show");

setTimeout(function(){

toast.classList.remove("show");

},2200);

}


/* ==========================================
START
========================================== */

updateUI();

</script>

