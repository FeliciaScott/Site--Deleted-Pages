<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>PathKeeper | Career Command Center</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
}

html{
scroll-behavior:smooth;
}

body{
font-family:"Segoe UI",Arial,sans-serif;
background:#081018;
color:#edf4f8;
line-height:1.6;
overflow-x:hidden;
}

button,
a{
font-family:inherit;
}

button{
cursor:pointer;
}

a{
text-decoration:none;
color:inherit;
}

:root{
--blue:#4385ff;
--green:#35e0a4;
--cyan:#55d8ff;
--gold:#ffc857;
--red:#ff6875;
--bg:#081018;
--panel:#101b27;
--panel2:#142231;
--border:#223548;
--muted:#8ea2b5;
}

/* =========================
GLOBAL
========================= */

.container{
width:88%;
max-width:1350px;
margin:auto;
}

section{
padding:90px 0;
}

.section-heading{
max-width:750px;
margin-bottom:50px;
}

.section-heading.center{
margin-left:auto;
margin-right:auto;
text-align:center;
}

.section-heading h2{
font-size:2.7rem;
line-height:1.15;
margin-bottom:15px;
}

.section-heading p{
color:var(--muted);
font-size:1.05rem;
}

.eyebrow{
display:inline-block;
font-size:.72rem;
font-weight:800;
letter-spacing:2px;
text-transform:uppercase;
color:var(--green);
margin-bottom:12px;
}

.btn{
border:0;
border-radius:12px;
padding:13px 22px;
font-weight:800;
transition:.25s;
}

.btn-primary{
background:linear-gradient(90deg,var(--blue),var(--green));
color:#fff;
}

.btn-primary:hover{
transform:translateY(-3px);
box-shadow:0 12px 30px #4385ff33;
}

.btn-dark{
background:#0b141d;
color:#dce8ef;
border:1px solid var(--border);
}

.btn-dark:hover{
border-color:var(--blue);
}

.card{
background:var(--panel);
border:1px solid var(--border);
border-radius:18px;
}

/* =========================
TOP NAV
========================= */

.topbar{
position:sticky;
top:0;
z-index:1000;
height:70px;
background:#081018eF;
backdrop-filter:blur(16px);
border-bottom:1px solid var(--border);
}

.topbar-inner{
height:100%;
display:flex;
align-items:center;
justify-content:space-between;
}

.logo{
font-size:1.2rem;
font-weight:900;
letter-spacing:1px;
}

.logo span{
color:var(--green);
}

.nav{
display:flex;
gap:25px;
font-size:.88rem;
color:#9eb0c0;
}

.nav a:hover{
color:#fff;
}

.profile{
display:flex;
align-items:center;
gap:10px;
}

.avatar{
width:36px;
height:36px;
border-radius:50%;
display:flex;
align-items:center;
justify-content:center;
background:linear-gradient(135deg,var(--blue),var(--green));
font-weight:900;
}

.level{
font-size:.75rem;
font-weight:800;
color:var(--green);
}

/* =========================
HERO
========================= */

.hero{
padding:70px 0 45px;
background:
radial-gradient(circle at 15% 20%,#4385ff18,transparent 35%),
radial-gradient(circle at 85% 30%,#35e0a418,transparent 35%),
var(--bg);
}

.hero-grid{
display:grid;
grid-template-columns:1.25fr .75fr;
gap:45px;
align-items:center;
}

.hero h1{
font-size:4.3rem;
line-height:1.03;
letter-spacing:-2px;
margin-bottom:25px;
}

.gradient-text{
background:linear-gradient(90deg,#fff,var(--green));
-webkit-background-clip:text;
-webkit-text-fill-color:transparent;
}

.hero-copy{
font-size:1.12rem;
color:var(--muted);
max-width:700px;
margin-bottom:30px;
}

.hero-actions{
display:flex;
gap:12px;
flex-wrap:wrap;
}

/* =========================
COMMAND PANEL
========================= */

.command-panel{
padding:25px;
}

.command-header{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:20px;
}

.command-header h3{
font-size:1rem;
}

.status{
font-size:.7rem;
padding:6px 10px;
border-radius:20px;
background:#0c2921;
color:var(--green);
}

.score-ring{
width:180px;
height:180px;
border-radius:50%;
margin:10px auto 20px;
background:
conic-gradient(var(--green) 0deg,#1c2a36 0deg);
display:flex;
align-items:center;
justify-content:center;
position:relative;
}

.score-ring:after{
content:"";
position:absolute;
width:140px;
height:140px;
border-radius:50%;
background:var(--panel);
}

.score-value{
position:relative;
z-index:2;
text-align:center;
}

.score-value strong{
display:block;
font-size:2.5rem;
}

.score-value span{
font-size:.7rem;
color:var(--muted);
}

.score-label{
text-align:center;
font-weight:800;
}

/* =========================
STAT STRIP
========================= */

.stats{
padding:20px 0 70px;
}

.stat-grid{
display:grid;
grid-template-columns:repeat(5,1fr);
gap:15px;
}

.stat{
padding:20px;
background:var(--panel);
border:1px solid var(--border);
border-radius:14px;
}

.stat small{
display:block;
color:var(--muted);
font-size:.7rem;
text-transform:uppercase;
letter-spacing:1px;
}

.stat strong{
display:block;
font-size:1.7rem;
margin:4px 0;
}

.stat span{
font-size:.75rem;
color:var(--green);
}

/* =========================
TODAY
========================= */

.today{
background:#0c151e;
}

.today-grid{
display:grid;
grid-template-columns:1.5fr .8fr;
gap:25px;
}

.daily{
padding:30px;
}

.daily-top{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:25px;
}

.daily-top span{
color:var(--gold);
font-size:.8rem;
font-weight:800;
}

.daily h3{
font-size:1.8rem;
margin-bottom:10px;
}

.daily p{
color:var(--muted);
margin-bottom:25px;
}

.task{
display:flex;
align-items:center;
gap:15px;
padding:16px;
background:#0b141d;
border:1px solid var(--border);
border-radius:12px;
margin-bottom:10px;
transition:.2s;
}

.task:hover{
border-color:var(--blue);
}

.task input{
width:19px;
height:19px;
accent-color:var(--green);
}

.task.done{
opacity:.55;
text-decoration:line-through;
}

.reward{
margin-left:auto;
font-size:.75rem;
color:var(--green);
font-weight:800;
}

.focus-card{
padding:30px;
}

.focus-card h3{
margin-bottom:10px;
}

.focus-meter{
height:12px;
background:#081018;
border-radius:20px;
overflow:hidden;
margin:20px 0;
}

.focus-fill{
width:35%;
height:100%;
background:linear-gradient(90deg,var(--blue),var(--green));
}

.focus-number{
font-size:3rem;
font-weight:900;
}

/* =========================
MISSION BOARD
========================= */

.missions{
background:var(--bg);
}

.mission-grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:20px;
}

.mission{
padding:27px;
position:relative;
overflow:hidden;
transition:.3s;
}

.mission:hover{
transform:translateY(-6px);
border-color:var(--blue);
}

.mission-icon{
font-size:2rem;
margin-bottom:18px;
}

.mission h3{
margin-bottom:8px;
}

.mission p{
font-size:.9rem;
color:var(--muted);
margin-bottom:20px;
}

.mission-meta{
display:flex;
justify-content:space-between;
align-items:center;
border-top:1px solid var(--border);
padding-top:15px;
font-size:.75rem;
}

.mission-xp{
color:var(--green);
font-weight:800;
}

.difficulty{
color:var(--gold);
}

/* =========================
CAREER MAP
========================= */

.map-section{
background:#0c151e;
}

.map{
display:grid;
grid-template-columns:repeat(5,1fr);
gap:10px;
position:relative;
}

.map:before{
content:"";
position:absolute;
height:3px;
left:8%;
right:8%;
top:43px;
background:#263747;
}

.node{
position:relative;
z-index:2;
text-align:center;
}

.node-circle{
width:86px;
height:86px;
border-radius:50%;
margin:auto;
display:flex;
align-items:center;
justify-content:center;
background:#101b27;
border:3px solid #263747;
font-size:1.5rem;
transition:.3s;
}

.node.unlocked .node-circle{
border-color:var(--green);
background:#0e2922;
box-shadow:0 0 25px #35e0a422;
}

.node.active .node-circle{
border-color:var(--blue);
box-shadow:0 0 30px #4385ff33;
}

.node h3{
font-size:.9rem;
margin-top:15px;
}

.node p{
font-size:.72rem;
color:var(--muted);
}

/* =========================
SKILL TREE
========================= */

.skill-tree{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:20px;
}

.skill{
padding:25px;
}

.skill-head{
display:flex;
justify-content:space-between;
margin-bottom:15px;
}

.skill-level{
color:var(--green);
font-weight:800;
font-size:.8rem;
}

.progress{
height:8px;
background:#081018;
border-radius:20px;
overflow:hidden;
}

.progress span{
display:block;
height:100%;
background:linear-gradient(90deg,var(--blue),var(--green));
}

.skill small{
display:block;
margin-top:12px;
color:var(--muted);
}

/* =========================
OPPORTUNITY SCANNER
========================= */

.scanner{
background:#0c151e;
}

.scanner-grid{
display:grid;
grid-template-columns:.7fr 1.3fr;
gap:25px;
}

.filter-box{
padding:25px;
}

.filter{
margin-bottom:20px;
}

.filter label{
display:block;
font-size:.75rem;
color:var(--muted);
margin-bottom:7px;
}

.filter select{
width:100%;
padding:12px;
border-radius:9px;
background:#0b141d;
color:#fff;
border:1px solid var(--border);
}

.opportunities{
display:grid;
gap:12px;
}

.opportunity{
padding:22px;
display:grid;
grid-template-columns:auto 1fr auto;
gap:18px;
align-items:center;
}

.op-icon{
width:48px;
height:48px;
border-radius:12px;
background:#172636;
display:flex;
align-items:center;
justify-content:center;
font-size:1.3rem;
}

.opportunity h3{
font-size:1rem;
}

.opportunity p{
font-size:.78rem;
color:var(--muted);
}

.match{
font-weight:900;
color:var(--green);
}

/* =========================
DECISION SIMULATOR
========================= */

.simulator{
background:var(--bg);
}

.simulator-box{
max-width:950px;
margin:auto;
padding:40px;
}

.scenario{
font-size:1.5rem;
font-weight:800;
margin-bottom:25px;
}

.sim-options{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:15px;
}

.sim-option{
padding:25px;
background:#0b141d;
border:1px solid var(--border);
border-radius:14px;
transition:.25s;
}

.sim-option:hover{
border-color:var(--blue);
transform:translateY(-4px);
}

.sim-result{
display:none;
margin-top:25px;
padding:20px;
background:#0e2922;
border:1px solid var(--green);
border-radius:12px;
color:#c8f7e7;
}

.sim-result.show{
display:block;
}

/* =========================
ACHIEVEMENTS
========================= */

.achievements{
background:#0c151e;
}

.badges{
display:grid;
grid-template-columns:repeat(6,1fr);
gap:15px;
}

.badge-card{
padding:22px 10px;
text-align:center;
opacity:.3;
filter:grayscale(1);
transition:.3s;
}

.badge-card.unlocked{
opacity:1;
filter:none;
border-color:var(--gold);
}

.badge-icon{
font-size:2.2rem;
margin-bottom:10px;
}

.badge-card h3{
font-size:.8rem;
}

.badge-card p{
font-size:.68rem;
color:var(--muted);
}

/* =========================
RESOURCE VAULT
========================= */

.vault-grid{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:18px;
}

.vault{
padding:25px;
}

.vault h3{
font-size:1rem;
margin:15px 0 7px;
}

.vault p{
font-size:.78rem;
}

.vault-tag{
display:inline-block;
padding:4px 8px;
background:#172636;
color:#9eb5c8;
font-size:.65rem;
border-radius:20px;
}

/* =========================
MOMENTUM LOOP
========================= */

.loop{
background:
radial-gradient(circle at center,#4385ff0d,transparent 45%),
#0b141d;
}

.loop-grid{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:20px;
}

.loop-card{
text-align:center;
padding:30px 20px;
}

.loop-number{
width:50px;
height:50px;
margin:auto auto 15px;
border-radius:50%;
background:#172636;
color:var(--green);
display:flex;
align-items:center;
justify-content:center;
font-weight:900;
}

/* =========================
FINAL CTA
========================= */

.cta{
text-align:center;
padding:120px 8%;
background:
radial-gradient(circle,#4385ff18,transparent 45%),
#081018;
}

.cta h2{
font-size:3.5rem;
line-height:1.1;
margin-bottom:20px;
}

.cta p{
max-width:700px;
margin:0 auto 35px;
color:var(--muted);
}

/* =========================
FOOTER
========================= */

footer{
padding:45px;
text-align:center;
color:#667b8e;
border-top:1px solid var(--border);
font-size:.85rem;
}

/* =========================
NOTIFICATION
========================= */

.toast{
position:fixed;
bottom:25px;
right:25px;
background:#35e0a4;
color:#06100c;
padding:15px 22px;
border-radius:12px;
font-weight:900;
transform:translateY(100px);
opacity:0;
transition:.4s;
z-index:9999;
box-shadow:0 15px 40px #0008;
}

.toast.show{
transform:translateY(0);
opacity:1;
}

/* =========================
RESPONSIVE
========================= */

@media(max-width:1100px){

.hero-grid,
.today-grid,
.scanner-grid{
grid-template-columns:1fr;
}

.stat-grid{
grid-template-columns:repeat(3,1fr);
}

.skill-tree{
grid-template-columns:repeat(2,1fr);
}

.vault-grid{
grid-template-columns:repeat(2,1fr);
}

.badges{
grid-template-columns:repeat(3,1fr);
}

}

@media(max-width:800px){

.hero h1{
font-size:3rem;
}

.mission-grid{
grid-template-columns:1fr 1fr;
}

.map{
grid-template-columns:1fr;
gap:25px;
}

.map:before{
display:none;
}

.sim-options{
grid-template-columns:1fr;
}

.loop-grid{
grid-template-columns:1fr 1fr;
}

.nav{
display:none;
}

}

@media(max-width:600px){

.container{
width:92%;
}

section{
padding:70px 0;
}

.hero h1{
font-size:2.45rem;
}

.hero-copy{
font-size:1rem;
}

.stat-grid,
.mission-grid,
.skill-tree,
.vault-grid,
.badges{
grid-template-columns:1fr;
}

.loop-grid{
grid-template-columns:1fr;
}

.hero-actions{
flex-direction:column;
}

.command-panel{
margin-top:20px;
}

.opportunity{
grid-template-columns:auto 1fr;
}

.match{
grid-column:2;
}

.simulator-box{
padding:25px;
}

.cta h2{
font-size:2.5rem;
}

}

</style>
</head>

