<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Cognitive Environment Design</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

:root{
    --cocoa:#231815;
    --aqua:#9ED8DB;
    --cream:#F7F5F0;
    --taupe:#463632;

    --cocoa-light:#2D211E;
    --cocoa-medium:#352723;
    --aqua-dark:#6FB9BD;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Arial, Helvetica, sans-serif;
    background:var(--cocoa);
    color:var(--cream);
    line-height:1.7;
}

/* =========================
   HERO
========================= */

.hero{
    min-height:600px;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:90px 25px;
    border-bottom:1px solid var(--taupe);

    background:
        radial-gradient(circle at 50% 30%, rgba(158,216,219,.10), transparent 35%),
        linear-gradient(180deg,#2D211E 0%,var(--cocoa) 100%);
}

.hero-inner{
    max-width:1000px;
}

.eyebrow{
    display:inline-block;
    color:var(--aqua);
    border:1px solid var(--taupe);
    padding:7px 15px;
    border-radius:30px;
    font-size:.78rem;
    letter-spacing:2px;
    text-transform:uppercase;
    margin-bottom:25px;
}

.hero h1{
    font-size:clamp(2.7rem,7vw,5.5rem);
    line-height:1.05;
    margin-bottom:25px;
    letter-spacing:-2px;
}

.hero h1 span{
    color:var(--aqua);
}

.hero p{
    max-width:800px;
    margin:auto;
    font-size:1.12rem;
    color:#E5E1DB;
}

.hero-button{
    display:inline-block;
    margin-top:35px;
    padding:14px 25px;
    background:var(--aqua);
    color:var(--cocoa);
    text-decoration:none;
    font-weight:bold;
    border-radius:5px;
    transition:.25s;
}

.hero-button:hover{
    transform:translateY(-3px);
}

/* =========================
   GENERAL
========================= */

.container{
    width:min(1120px,calc(100% - 40px));
    margin:auto;
}

section{
    padding:85px 0;
    border-bottom:1px solid var(--taupe);
}

.section-intro{
    max-width:780px;
    margin-bottom:40px;
}

.section-number{
    color:var(--aqua);
    font-size:.8rem;
    letter-spacing:3px;
    text-transform:uppercase;
    margin-bottom:10px;
}

h2{
    font-size:clamp(2rem,4vw,3.1rem);
    line-height:1.15;
    margin-bottom:20px;
}

h3{
    color:var(--aqua);
    margin-bottom:12px;
}

p{
    color:#E5E1DB;
}

strong{
    color:var(--cream);
}

/* =========================
   CONCEPT
========================= */

.concept{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:60px;
    align-items:center;
}

.concept-box{
    padding:35px;
    border:1px solid var(--taupe);
    background:var(--cocoa-light);
    position:relative;
}

.concept-box:before{
    content:"";
    position:absolute;
    top:0;
    left:0;
    width:70px;
    height:3px;
    background:var(--aqua);
}

.quote{
    font-size:1.35rem;
    font-style:italic;
    line-height:1.6;
}

.quote-mark{
    color:var(--aqua);
    font-size:4rem;
    line-height:.5;
    display:block;
    margin-bottom:20px;
}

/* =========================
   INTERACTIVE PRINCIPLES
========================= */

.principles{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:15px;
}

.principle{
    border:1px solid var(--taupe);
    background:var(--cocoa-light);
    padding:25px;
    cursor:pointer;
    transition:.25s;
}

.principle:hover{
    border-color:var(--aqua);
}

.principle.active{
    border-color:var(--aqua);
    background:#302320;
}

.principle-top{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;
}

.principle-number{
    color:var(--aqua);
    font-size:.8rem;
    letter-spacing:2px;
}

.principle-arrow{
    color:var(--aqua);
    font-size:1.3rem;
    transition:.25s;
}

.principle.active .principle-arrow{
    transform:rotate(45deg);
}

.principle-details{
    max-height:0;
    overflow:hidden;
    transition:max-height .35s ease;
}

.principle.active .principle-details{
    max-height:300px;
}

.principle-details p{
    padding-top:18px;
    border-top:1px solid var(--taupe);
    margin-top:18px;
}

/* =========================
   ENVIRONMENT SELECTOR
========================= */

.environment-selector{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
    margin-bottom:30px;
}

.environment-button{
    border:1px solid var(--taupe);
    background:var(--cocoa-light);
    color:var(--cream);
    padding:25px;
    text-align:left;
    cursor:pointer;
    transition:.25s;
}

.environment-button:hover,
.environment-button.active{
    border-color:var(--aqua);
    background:var(--cocoa-medium);
}

.environment-button strong{
    display:block;
    color:var(--aqua);
    font-size:1.2rem;
    margin-bottom:7px;
}

.audit-area{
    display:none;
}

.audit-area.active{
    display:block;
}

.audit-question{
    background:var(--cocoa-light);
    border:1px solid var(--taupe);
    padding:25px;
    margin-bottom:12px;
}

.audit-question p{
    margin-bottom:15px;
}

.choice-row{
    display:flex;
    gap:8px;
    flex-wrap:wrap;
}

.choice{
    background:transparent;
    border:1px solid var(--taupe);
    color:var(--cream);
    padding:9px 15px;
    cursor:pointer;
    transition:.2s;
}

.choice:hover{
    border-color:var(--aqua);
}

.choice.selected{
    background:var(--aqua);
    color:var(--cocoa);
    border-color:var(--aqua);
    font-weight:bold;
}

.audit-result{
    display:none;
    margin-top:30px;
    padding:30px;
    border-left:4px solid var(--aqua);
    background:var(--cocoa-light);
}

.audit-result.show{
    display:block;
}

.result-label{
    color:var(--aqua);
    text-transform:uppercase;
    letter-spacing:2px;
    font-size:.75rem;
    margin-bottom:8px;
}

.result-title{
    font-size:1.7rem;
    margin-bottom:10px;
}

/* =========================
   TRANSFORMATION TOOL
========================= */

.transform-tool{
    border:1px solid var(--taupe);
    background:var(--cocoa-light);
}

.transform-tabs{
    display:flex;
    border-bottom:1px solid var(--taupe);
}

.transform-tab{
    flex:1;
    padding:18px;
    background:transparent;
    color:var(--cream);
    border:none;
    cursor:pointer;
    font-weight:bold;
}

.transform-tab.active{
    background:var(--aqua);
    color:var(--cocoa);
}

.transform-content{
    padding:30px;
}

.transform-item{
    display:grid;
    grid-template-columns:1fr 50px 1fr;
    gap:20px;
    align-items:center;
    padding:25px 0;
    border-bottom:1px solid var(--taupe);
}

.transform-item:last-child{
    border-bottom:none;
}

.before,
.after{
    padding:20px;
    min-height:120px;
}

.before{
    background:#2B201D;
    border:1px solid var(--taupe);
}

.after{
    background:#302824;
    border:1px solid var(--aqua);
}

.label{
    color:var(--aqua);
    font-size:.7rem;
    text-transform:uppercase;
    letter-spacing:2px;
    margin-bottom:8px;
}

.arrow{
    text-align:center;
    color:var(--aqua);
    font-size:1.5rem;
}

/* =========================
   REDESIGN BUILDER
========================= */

.builder{
    border:1px solid var(--taupe);
    background:var(--cocoa-light);
    padding:35px;
}

.builder-intro{
    margin-bottom:30px;
}

.builder-question{
    margin-bottom:30px;
}

.builder-question h3{
    margin-bottom:15px;
}

.builder-options{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:10px;
}

.builder-option{
    padding:18px;
    border:1px solid var(--taupe);
    background:transparent;
    color:var(--cream);
    cursor:pointer;
    text-align:left;
    transition:.2s;
}

.builder-option:hover{
    border-color:var(--aqua);
}

.builder-option.selected{
    background:var(--aqua);
    color:var(--cocoa);
    border-color:var(--aqua);
}

.builder-option.selected strong{
    color:var(--cocoa);
}

.build-button{
    background:var(--aqua);
    color:var(--cocoa);
    border:none;
    padding:15px 25px;
    font-weight:bold;
    cursor:pointer;
    font-size:1rem;
}

.build-button:hover{
    opacity:.85;
}

.plan{
    display:none;
    margin-top:35px;
    border-top:1px solid var(--taupe);
    padding-top:35px;
}

.plan.show{
    display:block;
}

.plan-step{
    display:flex;
    gap:20px;
    padding:20px 0;
    border-bottom:1px solid var(--taupe);
}

.plan-number{
    width:35px;
    height:35px;
    min-width:35px;
    border:1px solid var(--aqua);
    color:var(--aqua);
    display:flex;
    align-items:center;
    justify-content:center;
}

.plan h3{
    margin-bottom:5px;
}

/* =========================
   QUESTIONS
========================= */

.questions{
    display:grid;
    gap:10px;
}

.question{
    border:1px solid var(--taupe);
    background:var(--cocoa-light);
}

.question button{
    width:100%;
    padding:22px;
    background:none;
    border:none;
    color:var(--cream);
    text-align:left;
    font-size:1rem;
    cursor:pointer;
    display:flex;
    justify-content:space-between;
    gap:20px;
}

.question button span{
    color:var(--aqua);
}

.answer{
    max-height:0;
    overflow:hidden;
    transition:max-height .3s ease;
}

.answer p{
    padding:0 22px 22px;
}

/* =========================
   FOOTER
========================= */

footer{
    padding:90px 20px;
    text-align:center;
    background:#1B1210;
}

footer h2{
    max-width:800px;
    margin:0 auto 20px;
}

footer p{
    max-width:700px;
    margin:auto;
}

/* =========================
   RESPONSIVE
========================= */

@media(max-width:750px){

    .concept,
    .environment-selector{
        grid-template-columns:1fr;
    }

    .principles{
        grid-template-columns:1fr;
    }

    .builder-options{
        grid-template-columns:1fr;
    }

    .transform-item{
        grid-template-columns:1fr;
    }

    .arrow{
        transform:rotate(90deg);
    }

    section{
        padding:65px 0;
    }

    .hero{
        min-height:520px;
    }
}

</style>
</head>

<body>

<!-- =========================
     HERO
========================= -->

<header class="hero">

    <div class="hero-inner">

        <div class="eyebrow">
            Environment Engineering
        </div>

        <h1>
            Design the Environment.<br>
            <span>Change the Default.</span>
        </h1>

        <p>
            Cognitive Environment Design examines how physical surroundings,
            digital systems, information exposure, and friction shape behavior.
            Instead of relying entirely on motivation, redesign the conditions
            surrounding the behavior you want to make easier.
        </p>

        <a href="#audit" class="hero-button">
            Begin the Environment Audit
        </a>

    </div>

</header>


<main>

<div class="container">


<!-- =========================
     SECTION 1
========================= -->

<section>

    <div class="concept">

        <div class="section-intro">

            <div class="section-number">
                01 — The Concept
            </div>

            <h2>
                Your environment is part of the system producing your behavior.
            </h2>

            <p>
                Every environment contains cues, obstacles, defaults and
                competing signals. These conditions influence what receives
                attention, what requires effort and what becomes the easiest
                available action.
            </p>

            <p style="margin-top:20px;">
                Cognitive Environment Design means deliberately changing those
                conditions instead of treating every behavioral problem as a
                personal failure of discipline.
            </p>

        </div>

        <div class="concept-box">

            <span class="quote-mark">"</span>

            <div class="quote">
                You don't rise to the level of your motivation—you often fall
                to the level of your environment.
            </div>

        </div>

    </div>

</section>


<!-- =========================
     SECTION 2
========================= -->

<section>

    <div class="section-intro">

        <div class="section-number">
            02 — Core Principles
        </div>

        <h2>
            Click a principle to examine the mechanism.
        </h2>

        <p>
            These principles can be applied to a workspace, phone, computer,
            schedule, study environment, business operation or personal
            routine.
        </p>

    </div>


    <div class="principles">

        <div class="principle">

            <div class="principle-top">

                <div>
                    <div class="principle-number">PRINCIPLE 01</div>
                    <h3>Reduce Visual Noise</h3>
                </div>

                <div class="principle-arrow">+</div>

            </div>

            <div class="principle-details">

                <p>
                    Remove objects, windows, notifications and information
                    that compete with the task currently requiring attention.
                    The objective is not sterile minimalism. The objective is
                    reducing unnecessary competition for attention.
                </p>

            </div>

        </div>


        <div class="principle">

            <div class="principle-top">

                <div>
                    <div class="principle-number">PRINCIPLE 02</div>
                    <h3>Create Spatial Zones</h3>
                </div>

                <div class="principle-arrow">+</div>

            </div>

            <div class="principle-details">

                <p>
                    Give important activities recognizable locations.
                    A particular chair, desk, room or physical arrangement
                    can become associated with a particular type of work.
                </p>

            </div>

        </div>


        <div class="principle">

            <div class="principle-top">

                <div>
                    <div class="principle-number">PRINCIPLE 03</div>
                    <h3>Manipulate Friction</h3>
                </div>

                <div class="principle-arrow">+</div>

            </div>

            <div class="principle-details">

                <p>
                    Make desired behaviors easier to begin and undesirable
                    defaults harder to initiate. Put important tools within
                    reach and introduce deliberate steps before distracting
                    behaviors.
                </p>

            </div>

        </div>


        <div class="principle">

            <div class="principle-top">

                <div>
                    <div class="principle-number">PRINCIPLE 04</div>
                    <h3>Anchor States</h3>
                </div>

                <div class="principle-arrow">+</div>

            </div>

            <div class="principle-details">

                <p>
                    Consistent environmental arrangements can become cues for
                    particular modes of work. Use repeatable physical and
                    digital setups to reduce the number of decisions required
                    to begin.
                </p>

            </div>

        </div>


        <div class="principle">

            <div class="principle-top">

                <div>
                    <div class="principle-number">PRINCIPLE 05</div>
                    <h3>Protect Attention</h3>
                </div>

                <div class="principle-arrow">+</div>

            </div>

            <div class="principle-details">

                <p>
                    Notifications, open communication channels and constantly
                    changing inputs create opportunities for interruption.
                    Design periods where external information cannot easily
                    interrupt the current task.
                </p>

            </div>

        </div>


        <div class="principle">

            <div class="principle-top">

                <div>
                    <div class="principle-number">PRINCIPLE 06</div>
                    <h3>Build Retrieval Systems</h3>
                </div>

                <div class="principle-arrow">+</div>

            </div>

            <div class="principle-details">

                <p>
                    Information becomes more useful when it can be found
                    quickly. Use predictable names, locations, categories and
                    relationships so previously created knowledge remains
                    accessible.
                </p>

            </div>

        </div>

    </div>

</section>


<!-- =========================
     SECTION 3 — AUDIT
========================= -->

<section id="audit">

    <div class="section-intro">

        <div class="section-number">
            03 — Interactive Audit
        </div>

        <h2>
            Find where your environment is creating friction.
        </h2>

        <p>
            Choose an environment and answer the questions honestly. The tool
            will identify the dominant environmental problem and suggest a
            starting intervention.
        </p>

    </div>


    <div class="environment-selector">

        <button class="environment-button active" data-target="physical">
            <strong>Physical Environment</strong>
            Workspace, room, objects, equipment and spatial arrangement.
        </button>

        <button class="environment-button" data-target="digital">
            <strong>Digital Environment</strong>
            Phone, computer, notifications, files, browser and information flow.
        </button>

    </div>


    <!-- PHYSICAL AUDIT -->

    <div class="audit-area active" id="physical">

        <div class="audit-question">

            <p>
                <strong>1. How difficult is it to begin the work you actually
                want to do?</strong>
            </p>

            <div class="choice-row" data-question="physical1">
                <button class="choice" data-value="1">Very easy</button>
                <button class="choice" data-value="2">Some effort</button>
                <button class="choice" data-value="3">Difficult</button>
                <button class="choice" data-value="4">Very difficult</button>
            </div>

        </div>


        <div class="audit-question">

            <p>
                <strong>2. How much unnecessary visual information surrounds
                your primary workspace?</strong>
            </p>

            <div class="choice-row" data-question="physical2">
                <button class="choice" data-value="1">Very little</button>
                <button class="choice" data-value="2">Some</button>
                <button class="choice" data-value="3">A lot</button>
                <button class="choice" data-value="4">Constantly distracting</button>
            </div>

        </div>


        <div class="audit-question">

            <p>
                <strong>3. Are your most useful tools easier to access than
                distracting alternatives?</strong>
            </p>

            <div class="choice-row" data-question="physical3">
                <button class="choice" data-value="1">Yes</button>
                <button class="choice" data-value="2">Mostly</button>
                <button class="choice" data-value="3">Not really</button>
                <button class="choice" data-value="4">No</button>
            </div>

        </div>


        <div class="audit-question">

            <p>
                <strong>4. Does entering your workspace immediately signal
                what you are supposed to do?</strong>
            </p>

            <div class="choice-row" data-question="physical4">
                <button class="choice" data-value="1">Strongly</button>
                <button class="choice" data-value="2">Somewhat</button>
                <button class="choice" data-value="3">Barely</button>
                <button class="choice" data-value="4">Not at all</button>
            </div>

        </div>

        <button class="build-button audit-button" data-type="physical">
            Analyze Physical Environment
        </button>

        <div class="audit-result" id="physical-result"></div>

    </div>


    <!-- DIGITAL AUDIT -->

    <div class="audit-area" id="digital">

        <div class="audit-question">

            <p>
                <strong>1. How frequently are you interrupted by
                notifications?</strong>
            </p>

            <div class="choice-row" data-question="digital1">
                <button class="choice" data-value="1">Rarely</button>
                <button class="choice" data-value="2">Sometimes</button>
                <button class="choice" data-value="3">Often</button>
                <button class="choice" data-value="4">Constantly</button>
            </div>

        </div>


        <div class="audit-question">

            <p>
                <strong>2. How easy is it to find important files,
                notes or information?</strong>
            </p>

            <div class="choice-row" data-question="digital2">
                <button class="choice" data-value="1">Very easy</button>
                <button class="choice" data-value="2">Usually easy</button>
                <button class="choice" data-value="3">Difficult</button>
                <button class="choice" data-value="4">Very difficult</button>
            </div>

        </div>


        <div class="audit-question">

            <p>
                <strong>3. How often do you open distracting websites or apps
                while working?</strong>
            </p>

            <div class="choice-row" data-question="digital3">
                <button class="choice" data-value="1">Rarely</button>
                <button class="choice" data-value="2">Sometimes</button>
                <button class="choice" data-value="3">Often</button>
                <button class="choice" data-value="4">Constantly</button>
            </div>

        </div>


        <div class="audit-question">

            <p>
                <strong>4. How many unrelated tasks compete for attention when
                you are trying to focus?</strong>
            </p>

            <div class="choice-row" data-question="digital4">
                <button class="choice" data-value="1">Almost none</button>
                <button class="choice" data-value="2">A few</button>
                <button class="choice" data-value="3">Many</button>
                <button class="choice" data-value="4">Too many</button>
            </div>

        </div>

        <button class="build-button audit-button" data-type="digital">
            Analyze Digital Environment
        </button>

        <div class="audit-result" id="digital-result"></div>

    </div>

</section>


<!-- =========================
     SECTION 4
========================= -->

<section>

    <div class="section-intro">

        <div class="section-number">
            04 — Transformation
        </div>

        <h2>
            Stop asking for more discipline. Change the conditions.
        </h2>

        <p>
            Select between physical and digital examples to see how an
            environmental problem can be converted into a structural solution.
        </p>

    </div>


    <div class="transform-tool">

        <div class="transform-tabs">

            <button class="transform-tab active" data-transform="physical-transform">
                Physical
            </button>

            <button class="transform-tab" data-transform="digital-transform">
                Digital
            </button>

        </div>


        <div class="transform-content">

            <div class="transform-panel" id="physical-transform">

                <div class="transform-item">

                    <div class="before">

                        <div class="label">Default</div>

                        <p>
                            Work materials are stored wherever they happen to
                            be left after previous activities.
                        </p>

                    </div>

                    <div class="arrow">→</div>

                    <div class="after">

                        <div class="label">Engineered</div>

                        <p>
                            Create a dedicated launch position where the tools
                            required for important work are always ready.
                        </p>

                    </div>

                </div>


                <div class="transform-item">

                    <div class="before">

                        <div class="label">Default</div>

                        <p>
                            Entertainment and work occur in the same physical
                            location with no distinction.
                        </p>

                    </div>

                    <div class="arrow">→</div>

                    <div class="after">

                        <div class="label">Engineered</div>

                        <p>
                            Assign different physical configurations or zones
                            to different behavioral purposes.
                        </p>

                    </div>

                </div>


                <div class="transform-item">

                    <div class="before">

                        <div class="label">Default</div>

                        <p>
                            Distracting objects are immediately available while
                            useful materials require setup.
                        </p>

                    </div>

                    <div class="arrow">→</div>

                    <div class="after">

                        <div class="label">Engineered</div>

                        <p>
                            Reverse the friction: prepare useful materials and
                            add distance or steps to distracting alternatives.
                        </p>

                    </div>

                </div>

            </div>


            <div class="transform-panel" id="digital-transform" style="display:none;">

                <div class="transform-item">

                    <div class="before">

                        <div class="label">Default</div>

                        <p>
                            Every notification competes for attention as soon
                            as it arrives.
                        </p>

                    </div>

                    <div class="arrow">→</div>

                    <div class="after">

                        <div class="label">Engineered</div>

                        <p>
                            Batch nonessential notifications so information
                            arrives during intentional review periods.
                        </p>

                    </div>

                </div>


                <div class="transform-item">

                    <div class="before">

                        <div class="label">Default</div>

                        <p>
                            Browser tabs remain open across unrelated tasks.
                        </p>

                    </div>

                    <div class="arrow">→</div>

                    <div class="after">

                        <div class="label">Engineered</div>

                        <p>
                            Use one working context at a time and close or
                            archive unrelated contexts when switching tasks.
                        </p>

                    </div>

                </div>


                <div class="transform-item">

                    <div class="before">

                        <div class="label">Default</div>

                        <p>
                            Important information is scattered across messages,
                            downloads, notes and temporary documents.
                        </p>

                    </div>

                    <div class="arrow">→</div>

                    <div class="after">

                        <div class="label">Engineered</div>

                        <p>
                            Establish predictable storage locations and naming
                            rules so information has a permanent destination.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================
     SECTION 5 — BUILDER
========================= -->

<section>

    <div class="section-intro">

        <div class="section-number">
            05 — Build Your Intervention
        </div>

        <h2>
            Design one environmental change you can actually implement.
        </h2>

        <p>
            Choose the conditions closest to your situation. The tool will
            construct a simple intervention instead of giving you a generic
            productivity checklist.
        </p>

    </div>


    <div class="builder">

        <div class="builder-question">

            <h3>What are you trying to make easier?</h3>

            <div class="builder-options">

                <button class="builder-option" data-group="goal" data-value="focus">
                    <strong>Focused Work</strong><br>
                    Staying with one important task.
                </button>

                <button class="builder-option" data-group="goal" data-value="study">
                    <strong>Studying</strong><br>
                    Making learning easier to begin.
                </button>

                <button class="builder-option" data-group="goal" data-value="creation">
                    <strong>Creating</strong><br>
                    Producing projects consistently.
                </button>

            </div>

        </div>


        <div class="builder-question">

            <h3>Where is the biggest problem?</h3>

            <div class="builder-options">

                <button class="builder-option" data-group="problem" data-value="clutter">
                    <strong>Clutter</strong><br>
                    Too many competing signals.
                </button>

                <button class="builder-option" data-group="problem" data-value="access">
                    <strong>Access</strong><br>
                    Important things take too much effort.
                </button>

                <button class="builder-option" data-group="problem" data-value="distraction">
                    <strong>Distraction</strong><br>
                    Competing activities are too accessible.
                </button>

            </div>

        </div>


        <div class="builder-question">

            <h3>What can you change today?</h3>

            <div class="builder-options">

                <button class="builder-option" data-group="resource" data-value="space">
                    <strong>Physical Space</strong><br>
                    I can rearrange my surroundings.
                </button>

                <button class="builder-option" data-group="resource" data-value="device">
                    <strong>Device</strong><br>
                    I can change my digital setup.
                </button>

                <button class="builder-option" data-group="resource" data-value="both">
                    <strong>Both</strong><br>
                    I can change physical and digital conditions.
                </button>

            </div>

        </div>


        <button class="build-button" id="buildPlan">
            Build My Intervention
        </button>


        <div class="plan" id="plan">

            <div class="result-label">
                Your Environmental Intervention
            </div>

            <h2 id="planTitle">
                Your redesigned environment
            </h2>

            <div id="planSteps"></div>

        </div>

    </div>

</section>


<!-- =========================
     SECTION 6
========================= -->

<section>

    <div class="section-intro">

        <div class="section-number">
            06 — Evaluation
        </div>

        <h2>
            Questions that expose environmental weaknesses.
        </h2>

    </div>


    <div class="questions">

        <div class="question">

            <button>
                Which environmental triggers cause the most task switching?
                <span>+</span>
            </button>

            <div class="answer">
                <p>
                    Look for recurring triggers rather than isolated events.
                    Notifications, visible devices, open browser tabs,
                    unfinished objects and incoming requests are examples of
                    environmental triggers worth examining.
                </p>
            </div>

        </div>


        <div class="question">

            <button>
                What important behavior currently requires unnecessary effort?
                <span>+</span>
            </button>

            <div class="answer">
                <p>
                    Examine the first few minutes of the behavior. If finding
                    the materials, opening the correct files, preparing the
                    workspace or remembering the next step requires repeated
                    effort, redesign the starting conditions.
                </p>
            </div>

        </div>


        <div class="question">

            <button>
                What distracting behavior has almost no friction?
                <span>+</span>
            </button>

            <div class="answer">
                <p>
                    Easy access can become an environmental invitation. Consider
                    adding distance, additional steps, blocked periods or
                    deliberate stopping points to behaviors that repeatedly
                    compete with your priorities.
                </p>
            </div>

        </div>


        <div class="question">

            <button>
                Does your environment tell you what to do next?
                <span>+</span>
            </button>

            <div class="answer">
                <p>
                    A strong environment reduces ambiguity. Materials can be
                    staged, files can have predictable locations and the next
                    action can be visible before the work session begins.
                </p>
            </div>

        </div>


        <div class="question">

            <button>
                What happens to your system when you are tired or stressed?
                <span>+</span>
            </button>

            <div class="answer">
                <p>
                    Stress often exposes weaknesses in environmental design.
                    Examine which behaviors become automatic under pressure and
                    then change the defaults surrounding those behaviors.
                </p>
            </div>

        </div>


        <div class="question">

            <button>
                What can be redesigned once instead of repeatedly managed?
                <span>+</span>
            </button>

            <div class="answer">
                <p>
                    Look for recurring decisions. A permanent storage system,
                    notification rule, workspace arrangement or preparation
                    routine can remove a decision that otherwise has to be made
                    repeatedly.
                </p>
            </div>

        </div>

    </div>

</section>


<!-- =========================
     SECTION 7
========================= -->

<section>

    <div class="section-intro">

        <div class="section-number">
            07 — The Principle
        </div>

        <h2>
            Design for the behavior that happens when motivation disappears.
        </h2>

        <p>
            A useful environment does not need to make you perfect. It should
            make the desired behavior easier to initiate, make distractions
            less automatic and preserve access to the systems you have already
            built.
        </p>

    </div>

</section>


</div>

</main>


<footer>

    <h2>
        Your environment is always shaping the next available action.
    </h2>

    <p>
        The goal is not to control every variable. The goal is to deliberately
        engineer enough of the environment that useful behavior has a better
        path to occur.
    </p>

</footer>


<script>

/* =========================
   PRINCIPLE ACCORDIONS
========================= */

document.querySelectorAll(".principle").forEach(function(principle){

    principle.addEventListener("click",function(){

        principle.classList.toggle("active");

    });

});


/* =========================
   ENVIRONMENT SELECTOR
========================= */

const environmentButtons =
document.querySelectorAll(".environment-button");

const auditAreas =
document.querySelectorAll(".audit-area");

environmentButtons.forEach(function(button){

    button.addEventListener("click",function(){

        environmentButtons.forEach(function(item){
            item.classList.remove("active");
        });

        auditAreas.forEach(function(area){
            area.classList.remove("active");
        });

        button.classList.add("active");

        const target =
        document.getElementById(button.dataset.target);

        target.classList.add("active");

    });

});


/* =========================
   AUDIT ANSWERS
========================= */

document.querySelectorAll(".choice").forEach(function(choice){

    choice.addEventListener("click",function(){

        const row = choice.parentElement;

        row.querySelectorAll(".choice").forEach(function(item){
            item.classList.remove("selected");
        });

        choice.classList.add("selected");

    });

});


/* =========================
   AUDIT ANALYSIS
========================= */

document.querySelectorAll(".audit-button").forEach(function(button){

    button.addEventListener("click",function(){

        const type = button.dataset.type;

        const questions =
        document.querySelectorAll("#" + type + " .choice-row");

        let total = 0;
        let answered = 0;

        questions.forEach(function(question){

            const selected =
            question.querySelector(".selected");

            if(selected){

                total += Number(selected.dataset.value);
                answered++;

            }

        });

        const result =
        document.getElementById(type + "-result");

        if(answered < questions.length){

            result.innerHTML = `
                <div class="result-label">Audit incomplete</div>
                <div class="result-title">Answer every question first.</div>
                <p>
                    The intervention becomes more useful when all of the
                    environmental conditions have been considered.
                </p>
            `;

            result.classList.add("show");

            return;

        }


        let title = "";
        let recommendation = "";

        if(total <= 7){

            title = "Your environment has a relatively low friction load.";

            recommendation =
            type === "physical"
            ?
            "Focus on refinement. Identify one recurring distraction and remove it permanently rather than redesigning everything."
            :
            "Focus on information boundaries. Preserve the digital structure that is already working and eliminate one remaining source of interruption.";

        }else if(total <= 11){

            title = "Your environment is creating moderate friction.";

            recommendation =
            type === "physical"
            ?
            "Prioritize access and zoning. Prepare important materials in advance and create a recognizable physical location for focused work."
            :
            "Prioritize notification control and information organization. Reduce incoming interruptions and give important information predictable locations.";

        }else{

            title = "Your environment is strongly competing with your goals.";

            recommendation =
            type === "physical"
            ?
            "Start with friction reversal. Make the desired activity immediately accessible while increasing the effort required to begin common distractions."
            :
            "Start with interruption control. Silence nonessential notifications, reduce competing applications and create a single working context for important tasks.";

        }

        result.innerHTML = `
            <div class="result-label">Audit Result</div>
            <div class="result-title">${title}</div>
            <p>${recommendation}</p>
        `;

        result.classList.add("show");

    });

});


/* =========================
   TRANSFORMATION TABS
========================= */

document.querySelectorAll(".transform-tab").forEach(function(tab){

    tab.addEventListener("click",function(){

        document.querySelectorAll(".transform-tab").forEach(function(item){
            item.classList.remove("active");
        });

        document.querySelectorAll(".transform-panel").forEach(function(panel){
            panel.style.display = "none";
        });

        tab.classList.add("active");

        document.getElementById(tab.dataset.transform).style.display = "block";

    });

});


/* =========================
   BUILDER OPTIONS
========================= */

const selections = {
    goal:null,
    problem:null,
    resource:null
};

document.querySelectorAll(".builder-option").forEach(function(option){

    option.addEventListener("click",function(){

        const group = option.dataset.group;

        document.querySelectorAll(
            '.builder-option[data-group="' + group + '"]'
        ).forEach(function(item){

            item.classList.remove("selected");

        });

        option.classList.add("selected");

        selections[group] = option.dataset.value;

    });

});


/* =========================
   BUILD INTERVENTION
========================= */

document.getElementById("buildPlan").addEventListener("click",function(){

    const plan = document.getElementById("plan");
    const title = document.getElementById("planTitle");
    const steps = document.getElementById("planSteps");

    if(!selections.goal ||
       !selections.problem ||
       !selections.resource){

        plan.classList.add("show");

        title.textContent = "Complete the three choices first.";

        steps.innerHTML = `
            <div class="plan-step">
                <div class="plan-number">!</div>
                <div>
                    <h3>One more step</h3>
                    <p>
                        Select what you want to make easier, identify the
                        environmental problem and choose what you can change.
                    </p>
                </div>
            </div>
        `;

        return;

    }


    let goalText = "";
    let problemText = "";
    let stepsHTML = "";

    if(selections.goal === "focus"){
        goalText = "focused work";
    }

    if(selections.goal === "study"){
        goalText = "studying";
    }

    if(selections.goal === "creation"){
        goalText = "creative production";
    }


    if(selections.problem === "clutter"){
        problemText = "reduce competing signals";
    }

    if(selections.problem === "access"){
        problemText = "reduce the effort required to begin";
    }

    if(selections.problem === "distraction"){
        problemText = "increase friction around distracting alternatives";
    }


    title.textContent =
    "A redesigned environment for " + goalText;


    stepsHTML += `
        <div class="plan-step">

            <div class="plan-number">1</div>

            <div>

                <h3>Define the default</h3>

                <p>
                    Before beginning ${goalText}, identify the current
                    environmental condition that repeatedly interferes with
                    the behavior.
                </p>

            </div>

        </div>
    `;


    stepsHTML += `
        <div class="plan-step">

            <div class="plan-number">2</div>

            <div>

                <h3>${capitalize(problemText)}</h3>

                <p>
                    Change the environment so the desired behavior requires
                    fewer unnecessary decisions and competing behaviors become
                    less automatic.
                </p>

            </div>

        </div>
    `;


    if(selections.resource === "space" ||
       selections.resource === "both"){

        stepsHTML += `
            <div class="plan-step">

                <div class="plan-number">3</div>

                <div>

                    <h3>Stage the physical environment</h3>

                    <p>
                        Put the materials needed for ${goalText} in their
                        intended location before the work begins. Remove one
                        visible object that competes for attention.
                    </p>

                </div>

            </div>
        `;

    }


    if(selections.resource === "device" ||
       selections.resource === "both"){

        stepsHTML += `
            <div class="plan-step">

                <div class="plan-number">4</div>

                <div>

                    <h3>Configure the digital environment</h3>

                    <p>
                        Close unrelated applications, remove unnecessary
                        notifications and establish one predictable digital
                        starting point for ${goalText}.
                    </p>

                </div>

            </div>
        `;

    }


    stepsHTML += `
        <div class="plan-step">

            <div class="plan-number">5</div>

            <div>

                <h3>Test the environment</h3>

                <p>
                    Use the redesigned environment for one real work session.
                    Do not judge it by how attractive it looks. Judge whether
                    the desired behavior became easier to begin and sustain.
                </p>

            </div>

        </div>
    `;


    steps.innerHTML = stepsHTML;

    plan.classList.add("show");

    plan.scrollIntoView({
        behavior:"smooth",
        block:"start"
    });

});


function capitalize(text){

    return text.charAt(0).toUpperCase() + text.slice(1);

}


/* =========================
   EVALUATION QUESTIONS
========================= */

document.querySelectorAll(".question button").forEach(function(button){

    button.addEventListener("click",function(){

        const answer =
        button.parentElement.querySelector(".answer");

        const isOpen =
        answer.style.maxHeight;

        document.querySelectorAll(".answer").forEach(function(item){

            item.style.maxHeight = null;

        });

        document.querySelectorAll(".question button span").forEach(function(item){

            item.textContent = "+";

        });

        if(!isOpen){

            answer.style.maxHeight =
            answer.scrollHeight + "px";

            button.querySelector("span").textContent = "−";

        }

    });

});

</script>

</body>
</html>
