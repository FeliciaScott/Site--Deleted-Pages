/* =========================================
   HUMAN CAPITAL CALCULATOR
========================================= */

function calculateHumanCapital(){

    const current =
        Number(document.getElementById("currentRate").value) || 0;

    const future =
        Number(document.getElementById("futureRate").value) || 0;

    const hours =
        Number(document.getElementById("learningHours").value) || 0;

    const weeks =
        Number(document.getElementById("weeks").value) || 0;

    const currentAnnual =
        current * 40 * weeks;

    const futureAnnual =
        future * 40 * weeks;

    const difference =
        futureAnnual - currentAnnual;

    const investment =
        hours * weeks;

    document.getElementById("currentAnnual").textContent =
        "$" + Math.round(currentAnnual).toLocaleString();

    document.getElementById("futureAnnual").textContent =
        "$" + Math.round(futureAnnual).toLocaleString();

    document.getElementById("annualDifference").textContent =
        "$" + Math.round(difference).toLocaleString();

    document.getElementById("learningInvestment").textContent =
        Math.round(investment).toLocaleString() + " hrs";

    document.getElementById("economicInsight").textContent =
        difference > 0
        ? "Potential annual value increase: $" +
          Math.round(difference).toLocaleString()
        : "The assumed future value is not higher.";

    document.getElementById("economicText").textContent =
        "This is not a salary prediction. It is a simple human-capital model showing why the value of learning depends on what the skill changes about your future earning capacity.";

    drawIncomeChart(currentAnnual,futureAnnual);

    addXP(10);

}


/* =========================================
   CHART
========================================= */

function drawIncomeChart(currentAnnual,futureAnnual){

    const canvas =
        document.getElementById("incomeChart");

    const ctx =
        canvas.getContext("2d");

    const width =
        canvas.clientWidth * window.devicePixelRatio;

    const height =
        canvas.clientHeight * window.devicePixelRatio;

    canvas.width = width;
    canvas.height = height;

    ctx.scale(
        window.devicePixelRatio,
        window.devicePixelRatio
    );

    const w = canvas.clientWidth;
    const h = canvas.clientHeight;

    ctx.clearRect(0,0,w,h);

    const max =
        Math.max(currentAnnual,futureAnnual,1);

    const values = [
        currentAnnual,
        futureAnnual
    ];

    const labels = [
        "Current",
        "Potential"
    ];

    const barWidth = 70;

    values.forEach((value,i)=>{

        const barHeight =
            (value/max) * (h-55);

        const x =
            70 + i*130;

        const y =
            h-30-barHeight;

        ctx.fillStyle =
            i === 0 ? "#65d8e8" : "#e4c477";

        ctx.fillRect(
            x,
            y,
            barWidth,
            barHeight
        );

        ctx.fillStyle =
            "#aebbc4";

        ctx.font =
            "12px Inter, sans-serif";

        ctx.fillText(
            labels[i],
            x+8,
            h-10
        );

        ctx.fillStyle =
            "#f5ecd9";

        ctx.fillText(
            "$"+Math.round(value/1000)+"k",
            x+8,
            y-8
        );

    });

}


