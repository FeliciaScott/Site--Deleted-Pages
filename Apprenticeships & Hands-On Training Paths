<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Apprenticeships & Hands-On Training Paths</title>

<style>
:root{
   --rust:#3D1C17;
   --rust-dark:#28110E;
   --rust-soft:#542B24;

   --blue:#B0C4DE;
   --blue-soft:#E7EDF5;
   --blue-deep:#8FA9C7;

   --alabaster:#F8F9FA;
   --white:#ffffff;

   --text:#292527;
   --muted:#625B59;

   --copper:#6B3E36;
   --copper-soft:#9A6B60;

   --shadow:0 5px 18px rgba(61,28,23,.10);
}

*{
   margin:0;
   padding:0;
   box-sizing:border-box;
}

html{
   scroll-behavior:smooth;
}

body{
   font-family:Arial,Helvetica,sans-serif;
   background:var(--alabaster);
   color:var(--text);
   line-height:1.6;
}

/* TOP NAV */

nav{
   background:var(--rust);
   color:var(--alabaster);
   padding:15px 5%;
   display:flex;
   justify-content:space-between;
   align-items:center;
   gap:20px;
   position:sticky;
   top:0;
   z-index:100;
   border-bottom:1px solid var(--copper);
}

.logo{
   font-weight:800;
   letter-spacing:.03em;
}

.logo span{
   color:var(--blue);
}

nav a{
   color:var(--alabaster);
   text-decoration:none;
   font-size:.85rem;
   margin-left:18px;
   transition:.2s;
}

nav a:hover{
   color:var(--blue);
}

/* INTRO */

.intro{
   max-width:1100px;
   margin:auto;
   padding:38px 5% 28px;
}

.intro-label{
   color:var(--copper);
   text-transform:uppercase;
   letter-spacing:.12em;
   font-size:.72rem;
   font-weight:800;
   margin-bottom:7px;
}

.intro h1{
   color:var(--rust);
   font-size:2.6rem;
   line-height:1.15;
   margin-bottom:10px;
}

.intro p{
   max-width:850px;
   color:var(--muted);
   font-size:1rem;
}

.notice{
   margin-top:18px;
   padding:14px 17px;
   background:var(--blue-soft);
   border-left:4px solid var(--blue);
   border-radius:6px;
   font-size:.88rem;
   color:var(--text);
}

/* MAIN */

.container{
   width:min(1100px,90%);
   margin:auto;
}

.section{
   margin-bottom:45px;
}

.section-heading{
   margin-bottom:18px;
}

.section-heading h2{
   color:var(--rust);
   font-size:1.8rem;
   margin-bottom:5px;
}

.section-heading p{
   color:var(--muted);
   font-size:.92rem;
}

/* OPPORTUNITY GRID */

.grid{
   display:grid;
   grid-template-columns:repeat(4,minmax(0,1fr));
   gap:14px;
}

.card{
   background:var(--white);
   border:1px solid var(--copper);
   border-radius:11px;
   padding:20px;
   box-shadow:var(--shadow);
   transition:.2s;
   display:flex;
   flex-direction:column;
}

.card:hover{
   transform:translateY(-3px);
   border-color:var(--blue);
   box-shadow:0 8px 24px rgba(61,28,23,.14);
}

.card-label{
   color:var(--copper);
   font-size:.67rem;
   font-weight:800;
   letter-spacing:.08em;
   text-transform:uppercase;
   margin-bottom:7px;
}

.card h3{
   color:var(--rust);
   font-size:1.08rem;
   margin-bottom:8px;
}

.card p{
   color:var(--muted);
   font-size:.84rem;
   margin-bottom:12px;
}

.card ul{
   padding-left:17px;
   color:#514A48;
   font-size:.8rem;
   margin-bottom:15px;
}

.card li{
   margin-bottom:4px;
}

.card-footer{
   margin-top:auto;
   padding-top:12px;
   border-top:1px solid var(--copper);
}

.card-footer strong{
   display:block;
   color:var(--rust);
   font-size:.72rem;
   margin-bottom:5px;
}

.card-footer a{
   color:#536F91;
   text-decoration:none;
   font-size:.76rem;
   font-weight:700;
}

.card-footer a:hover{
   color:var(--rust);
   text-decoration:underline;
}

/* FEATURED UNKNOWN */

.unknown{
   background:var(--rust);
   color:var(--alabaster);
   border:1px solid var(--copper);
   border-radius:13px;
   padding:25px;
   margin-bottom:16px;
}

.unknown h2{
   color:var(--alabaster);
   font-size:1.6rem;
   margin-bottom:6px;
}

.unknown p{
   color:#E4DAD7;
   font-size:.9rem;
}

.unknown-grid{
   display:grid;
   grid-template-columns:repeat(4,1fr);
   gap:12px;
   margin-top:18px;
}

.unknown-item{
   background:rgba(176,196,222,.10);
   border:1px solid rgba(176,196,222,.25);
   border-radius:9px;
   padding:16px;
   transition:.2s;
}

.unknown-item:hover{
   background:rgba(176,196,222,.17);
   border-color:var(--blue);
   transform:translateY(-2px);
}

.unknown-item strong{
   display:block;
   color:var(--blue);
   margin-bottom:6px;
}

.unknown-item span{
   color:#E1E5EA;
   font-size:.78rem;
}

/* CAREER CLUSTERS */

.cluster{
   background:var(--white);
   border:1px solid var(--copper);
   border-radius:12px;
   padding:22px;
   margin-bottom:16px;
   box-shadow:var(--shadow);
}

.cluster-header{
   display:flex;
   justify-content:space-between;
   align-items:flex-start;
   gap:15px;
   margin-bottom:15px;
}

.cluster h3{
   color:var(--rust);
   font-size:1.25rem;
}

.cluster-intro{
   color:var(--muted);
   font-size:.83rem;
   max-width:700px;
}

.badge{
   white-space:nowrap;
   background:var(--blue-soft);
   color:#536F91;
   padding:5px 9px;
   border-radius:20px;
   font-size:.65rem;
   font-weight:800;
   border:1px solid var(--blue);
}

.cluster-grid{
   display:grid;
   grid-template-columns:repeat(4,1fr);
   gap:10px;
}

.career{
   background:#F4F6F8;
   border:1px solid var(--copper);
   padding:14px;
   border-radius:8px;
   transition:.2s;
}

.career:hover{
   border-color:var(--blue);
   background:var(--blue-soft);
}

.career strong{
   display:block;
   color:var(--rust);
   font-size:.86rem;
   margin-bottom:4px;
}

.career span{
   display:block;
   color:var(--muted);
   font-size:.74rem;
}

/* SEARCH SYSTEM */

.search-box{
   background:var(--blue-soft);
   border:1px solid var(--blue);
   border-radius:12px;
   padding:24px;
}

.search-box h2{
   color:var(--rust);
   margin-bottom:5px;
}

.search-box p{
   color:var(--muted);
   font-size:.86rem;
   margin-bottom:15px;
}

.search-actions{
   display:flex;
   gap:10px;
   flex-wrap:wrap;
}

.button{
   display:inline-block;
   background:var(--rust);
   color:var(--alabaster);
   padding:10px 16px;
   border-radius:7px;
   text-decoration:none;
   font-size:.78rem;
   font-weight:700;
   border:1px solid var(--rust);
   transition:.2s;
}

.button:hover{
   background:var(--rust-dark);
   border-color:var(--rust-dark);
   transform:translateY(-1px);
}

.button.secondary{
   background:var(--white);
   color:var(--rust);
   border:1px solid var(--copper);
}

.button.secondary:hover{
   background:var(--rust);
   color:var(--alabaster);
   border-color:var(--rust);
}

/* REALITY CHECK */

.reality{
   display:grid;
   grid-template-columns:repeat(4,1fr);
   gap:12px;
}

.reality-card{
   background:var(--white);
   border:1px solid var(--copper);
   border-radius:10px;
   padding:18px;
   transition:.2s;
}

.reality-card:hover{
   border-color:var(--blue);
   transform:translateY(-2px);
}

.reality-card h3{
   color:var(--rust);
   font-size:.95rem;
   margin-bottom:7px;
}

.reality-card p{
   color:var(--muted);
   font-size:.78rem;
}

/* STEPS */

.steps{
   display:grid;
   grid-template-columns:repeat(4,1fr);
   gap:12px;
}

.step{
   background:var(--white);
   border:1px solid var(--copper);
   border-radius:10px;
   padding:18px;
   transition:.2s;
}

.step:hover{
   border-color:var(--blue);
   box-shadow:var(--shadow);
}

.step-number{
   color:#536F91;
   font-size:.7rem;
   font-weight:900;
}

.step h3{
   color:var(--rust);
   margin:6px 0;
   font-size:.95rem;
}

.step p{
   color:var(--muted);
   font-size:.78rem;
}

/* SOURCES */

.sources{
   background:#F0F3F6;
   border:1px solid var(--blue);
   border-radius:10px;
   padding:20px;
}

.sources h2{
   color:var(--rust);
   font-size:1.35rem;
   margin-bottom:8px;
}

.sources p{
   color:var(--muted);
   font-size:.84rem;
   margin-bottom:12px;
}

.source-grid{
   display:grid;
   grid-template-columns:repeat(4,1fr);
   gap:10px;
}

.source{
   background:var(--white);
   border:1px solid var(--copper);
   border-radius:7px;
   padding:12px;
   transition:.2s;
}

.source:hover{
   border-color:var(--blue);
}

.source strong{
   display:block;
   color:var(--rust);
   font-size:.8rem;
   margin-bottom:4px;
}

.source a{
   color:#536F91;
   font-size:.72rem;
   text-decoration:none;
}

.source a:hover{
   color:var(--rust);
   text-decoration:underline;
}

/* FINAL CTA */

.cta{
   background:var(--rust);
   color:var(--alabaster);
   padding:35px 5%;
   margin-top:35px;
   border-top:1px solid var(--copper);
   border-bottom:1px solid var(--copper);
}

.cta-inner{
   width:min(1000px,90%);
   margin:auto;
}

.cta h2{
   color:var(--alabaster);
   font-size:1.8rem;
   margin-bottom:6px;
}

.cta p{
   color:#E4DAD7;
   max-width:750px;
   font-size:.88rem;
}

footer{
   background:var(--rust-dark);
   color:#C8BCB8;
   text-align:center;
   padding:18px;
   font-size:.72rem;
}

/* RESPONSIVE */

@media(max-width:950px){

   .grid{
       grid-template-columns:repeat(2,1fr);
   }

   .unknown-grid,
   .cluster-grid,
   .reality,
   .steps,
   .source-grid{
       grid-template-columns:repeat(2,1fr);
   }

}

@media(max-width:650px){

   nav{
       padding:13px 5%;
   }

   nav div:last-child{
       display:none;
   }

   .intro{
       padding-top:28px;
   }

   .intro h1{
       font-size:2rem;
   }

   .grid{
       grid-template-columns:1fr;
   }

   .unknown-grid,
   .cluster-grid,
   .reality,
   .steps,
   .source-grid{
       grid-template-columns:1fr;
   }

   .cluster-header{
       flex-direction:column;
   }

}
</style>
</head>

