<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Elite Resource Matrix | Career Intelligence Hub</title>

<style>

:root{

--bg:#0f172a;
--surface:#1e293b;
--surface2:#111827;
--green:#10b981;
--green-dark:#059669;
--cyan:#06b6d4;
--white:#f8fafc;
--muted:#94a3b8;
--border:#334155;

}


*{

box-sizing:border-box;
margin:0;
padding:0;
font-family:
Inter,
Segoe UI,
Roboto,
Arial,
sans-serif;

}


body{

background:
radial-gradient(circle at top,#1e293b,transparent 40%),
var(--bg);

color:var(--white);

padding:30px;

}


.container{

max-width:1300px;
margin:auto;

}


/* HEADER */


header{

text-align:center;
padding:50px 20px;

}


header h1{

font-size:3rem;
font-weight:900;

}


header h1 span{

color:var(--green);

}


header p{

max-width:700px;
margin:20px auto;
color:var(--muted);
font-size:1.1rem;

}



/* STATS */


.stats{

display:grid;
grid-template-columns:
repeat(auto-fit,minmax(220px,1fr));

gap:20px;

margin-bottom:40px;

}


.stat-card{

background:var(--surface);

padding:30px;

border-radius:18px;

border:1px solid var(--border);

text-align:center;

transition:.3s;

}


.stat-card:hover{

transform:translateY(-8px);

border-color:var(--green);

}


.stat-card h2{

font-size:2.5rem;
color:var(--green);

}


.stat-card p{

color:var(--muted);

}



/* FEATURE BOX */


.feature{

background:var(--surface);

padding:30px;

border-radius:18px;

border:1px solid var(--border);

margin-bottom:35px;

}


.feature h2{

margin-bottom:20px;

}


.tag{

display:inline-block;

padding:8px 15px;

background:#064e3b;

color:#6ee7b7;

border-radius:30px;

margin:5px;

font-size:.85rem;

}



/* FILTER PANEL */


.filters{

background:var(--surface);

padding:25px;

border-radius:18px;

display:grid;

grid-template-columns:
repeat(auto-fit,minmax(220px,1fr));

gap:20px;

margin-bottom:40px;

border:1px solid var(--border);

}


label{

display:block;

text-transform:uppercase;

font-size:.8rem;

color:var(--muted);

margin-bottom:8px;

}


select{

width:100%;

padding:14px;

background:var(--surface2);

color:white;

border:1px solid var(--border);

border-radius:10px;

}



/* TABLE */


.table-box{

background:var(--surface);

border-radius:18px;

overflow:auto;

border:1px solid var(--border);

}



table{

width:100%;

border-collapse:collapse;

min-width:900px;

}



th{

background:#162033;

padding:20px;

text-align:left;

color:var(--green);

font-size:.85rem;

text-transform:uppercase;

}


td{

padding:20px;

border-bottom:1px solid var(--border);

}



tr:hover{

background:#ffffff05;

}




/* RESOURCE */


.name{

display:block;

font-weight:800;

font-size:1.1rem;

}


.platform{

color:var(--cyan);

font-size:.85rem;

}



/* BADGES */


.badge{

display:inline-block;

padding:7px 14px;

border-radius:30px;

font-size:.8rem;

font-weight:700;

}


.industry{

background:#083344;
color:#67e8f9;

}


.time{

background:#27272a;
color:#ddd;

}


.output{

background:#064e3b;
color:#6ee7b7;

}



/* BUTTON */


.button{

background:var(--green);

color:#022c22;

padding:10px 18px;

border-radius:8px;

text-decoration:none;

font-weight:800;

display:inline-block;

}


.button:hover{

background:var(--green-dark);

}



/* ROADMAP */


.roadmap{

display:grid;

grid-template-columns:
repeat(auto-fit,minmax(250px,1fr));

gap:20px;

margin-top:50px;

}



.path{

background:var(--surface);

padding:25px;

border-radius:15px;

border:1px solid var(--border);

}


.path h3{

color:var(--green);

margin-bottom:15px;

}


.path li{

margin:10px 0;

color:var(--muted);

}



/* FOOTER */


footer{

text-align:center;

padding:50px;

color:var(--muted);

}



@media(max-width:700px){

body{

padding:15px;

}


header h1{

font-size:2rem;

}

}


</style>

</head>


