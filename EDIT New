function buildChecklist(plan) {
  const lines = [];
  lines.push("PATHKEEPER — ACTION CHECKLIST");
  lines.push("Use this list to track implementation.");
  lines.push("=".repeat(48));
  lines.push("");

  plan.priorities.forEach((item, index) => {
    lines.push(`[ ] ${index + 1}. ${item.title} — ${item.priority}`);
    lines.push("    " + item.detail);
    lines.push("");
  });

  lines.push("BACKUP ACTIONS");
  lines.push("-".repeat(48));
  plan.backupSteps.forEach((step, index) => {
    lines.push(`[ ] B${index + 1}. ${step}`);
  });

  lines.push("");
  lines.push("WEEKLY REVIEW");
  lines.push("[ ] What did I complete?");
  lines.push("[ ] What did visitors find useful?");
  lines.push("[ ] What is still blocking progress?");
  lines.push("[ ] What is the next highest-priority task?");
  lines.push("[ ] Do I need to use the backup plan?");

  return lines.join("\n");
}

