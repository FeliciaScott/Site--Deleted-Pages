<title>PathKeeper | Strategy & Backup Planner</title>

<style>
:root {
  --forest: #173D2D;
  --green: #285B42;
  --sage: #DCE8DC;
  --cream: #F8F5EC;
  --paper: #FFFFFF;
  --brown: #79543A;
  --tan: #E7D3B8;
  --ink: #25342B;
  --muted: #65736A;
  --border: #D7DED5;
  --gold: #D9AD69;
  --danger: #8C4237;
  --radius: 16px;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  background: var(--cream);
  color: var(--ink);
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.6;
}

button, input, select, textarea { font: inherit; }

button { cursor: pointer; }

.hero {
  background: linear-gradient(135deg, #173D2D, #326448);
  color: white;
  padding: 42px 22px;
}

.hero-inner, main {
  max-width: 1100px;
  margin: auto;
}

.eyebrow {
  text-transform: uppercase;
  letter-spacing: 2px;
  font-size: 12px;
  font-weight: bold;
  color: var(--gold);
}

.hero h1 {
  font-size: clamp(30px, 5vw, 46px);
  line-height: 1.12;
  margin: 12px 0;
}

.hero p {
  max-width: 740px;
  color: #E7EEE7;
}

.hero-pill {
  display: inline-block;
  border: 1px solid #8CAB94;
  padding: 6px 12px;
  border-radius: 30px;
  font-size: 12px;
  margin-top: 8px;
}

main { padding: 24px 16px 55px; }

.intro, .section, .results, .progress-box {
  background: var(--paper);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 22px;
  margin-bottom: 20px;
}

h2 { color: var(--forest); margin-top: 0; }

h3 { color: var(--green); }

.small { color: var(--muted); font-size: 14px; }

.notice {
  background: #F3EBDD;
  border-left: 4px solid var(--brown);
  border-radius: 6px;
  padding: 12px 15px;
  font-size: 14px;
}

.section-heading {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  margin-bottom: 18px;
}

.number {
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  min-width: 36px;
  background: var(--sage);
  color: var(--forest);
  border-radius: 10px;
  font-weight: bold;
}

.section-heading h2 {
  margin: 0 0 3px;
  font-size: 21px;
}

.section-heading p {
  margin: 0;
  color: var(--muted);
  font-size: 14px;
}

.question-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 19px;
}

.field { min-width: 0; }

.field.full { grid-column: 1 / -1; }

.field label {
  display: block;
  font-weight: bold;
  font-size: 14px;
  margin-bottom: 7px;
}

.field label .qnum {
  color: var(--brown);
  margin-right: 5px;
}

.field input, .field select, .field textarea {
  width: 100%;
  padding: 12px;
  border: 1px solid #C9D3C8;
  background: #FCFDFB;
  border-radius: 9px;
  color: var(--ink);
}

.field textarea {
  min-height: 90px;
  resize: vertical;
}

.field input:focus, .field select:focus, .field textarea:focus {
  outline: 2px solid #83A98D;
  border-color: var(--green);
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 20px 0;
}

.btn {
  border: 0;
  border-radius: 9px;
  padding: 12px 17px;
  font-weight: bold;
  transition: opacity .15s ease;
}

.btn:hover { opacity: .88; }

.btn-primary {
  background: var(--forest);
  color: white;
}

.btn-secondary {
  background: var(--tan);
  color: #39291D;
}

.btn-outline {
  background: white;
  color: var(--forest);
  border: 1px solid var(--green);
}

.btn-danger {
  background: #F3E3DF;
  color: var(--danger);
}

.progress-track {
  height: 9px;
  background: #E8EDE7;
  border-radius: 20px;
  overflow: hidden;
  margin: 12px 0 7px;
}

.progress-fill {
  height: 100%;
  width: 0%;
  background: var(--green);
  transition: width .2s;
}

.progress-row {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  font-size: 13px;
  color: var(--muted);
}

.results { display: none; }

.results.show { display: block; }

.result-header {
  background: var(--forest);
  color: white;
  border-radius: 12px;
  padding: 22px;
  margin-bottom: 18px;
