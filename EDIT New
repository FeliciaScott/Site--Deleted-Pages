      <p><strong>Audience:</strong> ${escapeHTML(answers.audience || "Needs to be confirmed")}</p>
      <p><strong>Problem:</strong> ${escapeHTML(answers.problem || "Define the main problem PathKeeper solves")}</p>
      <p><strong>Desired outcome:</strong> ${escapeHTML(answers.outcome || "Define a concrete visitor result")}</p>
      <p><strong>Main obstacle:</strong> ${escapeHTML(answers.blocker || "Not specified")}</p>
      <p><strong>Success measure:</strong> ${escapeHTML(answers.metric || "Choose a measurable success indicator")}</p>
    </div>

    <h2>Priority action plan</h2>
    ${prioritiesHTML}

    <div class="result-block priority-backup">
      <h3>Backup plan</h3>
      <p class="small">Use these steps if the original plan becomes too expensive, complicated, slow, or ineffective.</p>
      <ol class="task-list">${backupHTML}</ol>
    </div>

    <div class="result-block">
      <h3>Risk controls</h3>
      <ul>${riskHTML}</ul>
    </div>

    <div class="result-block">
      <h3>Recommendations based on your answers</h3>
      <ul>${customHTML}</ul>
    </div>

    <div class="result-block">
      <h3>Suggested first milestone</h3>
      <p>Complete the highest-priority landing page or tool, confirm that its links work, and test whether a visitor can finish the intended action.</p>
      <p><strong>Review deadline:</strong> ${escapeHTML(answers.timeframe || "Choose a review date")}</p>
      <p><strong>Weekly time:</strong> ${escapeHTML(answers.time || "Not specified")}</p>
      <p><strong>Budget:</strong> ${escapeHTML(answers.budget || "Not specified")}</p>
    </div>

    <div class="notice">
      <strong>Before acting:</strong> These are recommendations generated from your
      responses, not verified findings about every live page. Check the published
      site, confirm each proposed change, and keep a copy of your current content
      before making significant edits.
    </div>
  `;

  results.classList.add("show");
}

function downloadFile(filename, content, mimeType) {
  try {
    const blob = new Blob([content], { type: mimeType });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");

    link.href = url;
    link.download = filename;
    link.style.display = "none";

    document.body.appendChild(link);
    link.click();
    link.remove();

    setTimeout(() => URL.revokeObjectURL(url), 1500);

    statusMessage.textContent = "Your download was requested: " + filename;
  } catch (error) {
    statusMessage.textContent =
      "The browser could not start the download. Try opening this page directly in your browser rather than inside an embed.";
  }
}

function generateReport() {
  const answers = getAnswers();
  const plan = buildStrategy(answers);

  latestReport = buildReport(answers, plan);
  latestChecklist = buildChecklist(plan);
  latestChecklistItems = plan.priorities;

  renderReport(answers, plan);
  statusMessage.textContent =
    "Strategy generated. Review the recommendations below and download the report when ready.";

  results.scrollIntoView({ behavior: "smooth", block: "start" });
}

document.getElementById("generateBtn").addEventListener("click", generateReport);

document.getElementById("downloadBtn").addEventListener("click", () => {
  if (!latestReport) generateReport();

  downloadFile(
    "PathKeeper-Strategy-and-Backup-Plan.txt",
    latestReport,
    "text/plain;charset=utf-8"
  );
});

document.getElementById("jsonBtn").addEventListener("click", () => {
  const answers = getAnswers();
  const exportData = {
    project: "PathKeeper",
    exportDate: new Date().toISOString(),
    answers: answers
  };

  downloadFile(
    "PathKeeper-Questionnaire-Answers.json",
    JSON.stringify(exportData, null, 2),
    "application/json;charset=utf-8"
  );
});

document.getElementById("downloadReportAgain").addEventListener("click", () => {
  if (!latestReport) generateReport();

  downloadFile(
    "PathKeeper-Strategy-and-Backup-Plan.txt",
    latestReport,
    "text/plain;charset=utf-8"
  );
});

document.getElementById("downloadChecklist").addEventListener("click", () => {
  if (!latestChecklist) generateReport();

  downloadFile(
    "PathKeeper-Action-Checklist.txt",
    latestChecklist,
    "text/plain;charset=utf-8"
  );
});

document.getElementById("clearBtn").addEventListener("click", () => {
  const confirmed = window.confirm(
    "Clear all questionnaire answers? This cannot be undone."
  );

  if (!confirmed) return;

  form.reset();
  latestReport = "";
  latestChecklist = "";
  results.classList.remove("show");
  resultContent.innerHTML = "";
  updateProgress();

  statusMessage.textContent =
    "Answers cleared. You can begin a new strategy.";
  window.scrollTo({ top: 0, behavior: "smooth" });
});

renderQuestionnaire();
updateProgress();
</script>

