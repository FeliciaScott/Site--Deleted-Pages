function escapeHTML(value) {
  return String(value ?? "").replace(/[&<>"']/g, function(char) {
    return {
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#039;"
    }[char];
  });
}

function renderQuestionnaire() {
  questionnaire.innerHTML = "";

  questions.forEach((section, sectionIndex) => {
    const sectionElement = document.createElement("section");
    sectionElement.className = "section";

    const heading = document.createElement("div");
    heading.className = "section-heading";
    heading.innerHTML = `
      <div class="number">${String(sectionIndex + 1).padStart(2, "0")}</div>
      <div>
        <h2>${escapeHTML(section.section)}</h2>
        <p>${escapeHTML(section.description)}</p>
      </div>
    `;

    const grid = document.createElement("div");
    grid.className = "question-grid";

    section.items.forEach((question) => {
      const wrapper = document.createElement("div");
      wrapper.className = "field";
      if (question.type === "textarea") wrapper.classList.add("full");

      const label = document.createElement("label");
      label.htmlFor = question.id;
      label.innerHTML =
        `<span class="qnum">${questionNumber(question.id)}.</span> ` +
        escapeHTML(question.label);

      let input;

      if (question.type === "select") {
        input = document.createElement("select");

        const emptyOption = document.createElement("option");
        emptyOption.value = "";
        emptyOption.textContent = "Select an answer (optional)";
        input.appendChild(emptyOption);

        question.options.forEach((optionText) => {
          const option = document.createElement("option");
          option.value = optionText;
          option.textContent = optionText;
          input.appendChild(option);
        });
      } else if (question.type === "textarea") {
        input = document.createElement("textarea");
        input.placeholder = question.placeholder || "";
      } else {
        input = document.createElement("input");
        input.type = "text";
        input.placeholder = question.placeholder || "";
      }

      input.id = question.id;
      input.name = question.id;
      input.addEventListener("input", updateProgress);
      input.addEventListener("change", updateProgress);

      wrapper.appendChild(label);
      wrapper.appendChild(input);
      grid.appendChild(wrapper);
    });

    sectionElement.appendChild(heading);
    sectionElement.appendChild(grid);
    questionnaire.appendChild(sectionElement);
  });
}

function questionNumber(id) {
  let count = 0;

  for (const section of questions) {
    for (const question of section.items) {
      count++;
      if (question.id === id) return count;
    }
  }

  return count;
}

function getAnswers() {
  const answers = {};

  questions.forEach((section) => {
    section.items.forEach((question) => {
      const element = document.getElementById(question.id);
      answers[question.id] = element ? element.value.trim() : "";
    });
  });

  return answers;
}

function updateProgress() {
  const answers = getAnswers();
  const total = Object.keys(answers).length;
  const answered = Object.values(answers).filter(value => value !== "").length;
  const percent = total ? (answered / total) * 100 : 0;

  document.getElementById("progressFill").style.width = percent + "%";
  document.getElementById("answeredCount").textContent =
    `${answered} of ${total} questions answered`;
}

function hasAnswer(value) {
  return Boolean(value && value.trim());
}

function containsAny(text, words) {
  const lower = String(text || "").toLowerCase();
  return words.some(word => lower.includes(word.toLowerCase()));
}

function addUnique(list, value) {
  if (value && !list.includes(value)) list.push(value);
}

function buildStrategy(answers) {
  const priorities = [];
  const backupSteps = [];
  const riskControls = [];
  const recommendations = [];
  const checklist = [];

  function task(priority, title, detail) {
    priorities.push({ priority, title, detail });
    checklist.push(`[ ] ${title}\n    ${detail}`);
  }

  // 1. Establish the mission and audience.
  if (
    answers.mission === "Still developing the mission" ||
    answers.audience === "I have not decided yet" ||
    !hasAnswer(answers.audience)
  ) {
    task(
      "HIGH",
      "Clarify the primary audience and mission",
      "Choose the main visitor group, define the problem PathKeeper solves, and state one concrete result visitors should achieve."
    );
  } else {
    task(
      "HIGH",
      "Write one consistent mission statement",
      `Center the site on helping ${answers.audience.toLowerCase()} achieve a useful result. Use the stated problem and outcome to make the mission specific.`
    );
  }

  // 2. Landing page.
  const landingChoice = answers.homepage;

  if (
    !hasAnswer(landingChoice) ||
    containsAny(landingChoice, ["replace the current", "new homepage"])
  ) {
    task(
      "HIGH",
      "Create a focused landing page",
      "Use a clear mission, a brief explanation of how PathKeeper works, and direct routes to the core tools. Avoid trying to explain every page on the homepage."
    );
  } else {
    task(
      "HIGH",
      "Improve the current homepage",
      "Make the mission, main audience, primary visitor action, and links to core sections immediately understandable."
    );
  }

  // 3. Navigation and page structure.
  task(
    "HIGH",
    "Audit the page structure",
    "Create a simple page map. Mark each page Keep, Edit, Merge, or Remove. Check that every retained page has a clear purpose and a useful destination."
  );

  if (
    answers.duplicates === "Some pages repeat the same information" ||
    answers.duplicates === "Many pages overlap or are difficult to navigate" ||
    answers.duplicates === "I need to audit the site first"
  ) {
    task(
      "HIGH",
      "Resolve duplicate and overlapping content",
      "Keep the strongest version of each topic, merge genuinely overlapping material, and redirect visitors through working internal links where possible."
    );
  }

  task(
    "HIGH",
    "Connect the core PathKeeper sections",
    "Review Home, Intelligence Center, Opportunity Atlas, Mobility & Location, Career Planning, and Resource Vault. Use only sections that are ready and relevant; make their relationships clear."
  );

  // 4. Visitor actions.
  const primary = answers.primaryCTA || "Explore Opportunities";

  task(
    "HIGH",
    "Make the main visitor action obvious",
    `Prioritize "${primary}". Give it a descriptive button label, a working destination, and a short explanation of what the visitor will get.`
  );

  task(
    "HIGH",
    "Review the core buttons and links",
    "Give Our Core Mission and Free Library clear destinations. Test every visible button and internal link. Remove decorative buttons that do not lead anywhere useful."
  );

  if (
    answers.links === "Some links are missing" ||
    answers.links === "Many buttons or links need destinations" ||
    answers.links === "I have not tested the links"
  ) {
    task(
      "HIGH",
      "Complete an internal-link test",
      "Test each button in the published site, confirm its destination, and verify that visitors can return to the main navigation without getting stuck."
    );
  }

  // 5. Content quality.
  if (
    answers.contentStatus === "Titles and buttons exist but content is missing" ||
    answers.contentStatus === "Some content is outdated or repetitive" ||
    answers.contentStatus === "I need to review every important page"
  ) {
    task(
      "HIGH",
      "Finish the most important page content",
      "For each priority page, explain its purpose, who it helps, what action to take, what resources are available, and what the visitor should do next."
    );
  }

  // 6. Visual design.
  if (
    answers.images === "Remove decorative pictures unless they help the visitor"
  ) {
    task(
      "MEDIUM",
      "Simplify unnecessary images",
      "Remove decorative pictures that do not explain, support, or prove something. Retain useful diagrams, instructional visuals, and evidence."
    );
  } else if (
    answers.images === "Use images as evidence of completed work" ||
    containsAny(answers.evidence, ["upload images", "portfolios"])
  ) {
    task(
      "MEDIUM",
      "Define a proof-of-work process",
      "Specify what evidence visitors can provide, what each image or file demonstrates, and how it connects to a task, skill, or milestone. Do not imply that a Google Sites page can accept file uploads unless that capability has been implemented."
    );
  }

  if (
    answers.mobile === "Buttons, text, or layouts need work" ||
    answers.mobile === "Not tested yet"
  ) {
    task(
      "HIGH",
      "Test the site on a phone",
      "Preview the published pages at mobile width. Check readable text, button spacing, menus, embedded content, and whether the main action is easy to find."
    );
  }

  // 7. Business and offerings.
  if (hasAnswer(answers.offer) &&
      answers.freePaid !== "Mostly free resources" &&
      answers.freePaid !== "I am not planning paid offers yet") {
    task(
      "MEDIUM",
      "Validate one paid offer before expanding",
      `Start with one clearly defined offer based on: ${answers.offer}. Specify the deliverable, who it helps, delivery time, boundaries, and how the result will be evaluated.`
    );

    task(
      "MEDIUM",
      "Test pricing against real demand",
      "Compare similar services and test interest with a small audience before committing to a price. Do not treat hypothetical interest as proof of sales."
    );
  } else {
    task(
      "MEDIUM",
      "Prove usefulness before expanding monetization",
      "Choose one free tool or resource, make it genuinely useful, and observe whether people complete it or request a next step. Develop paid offers when there is evidence of a need."
    );
  }

  // 8. SEO and publishing.
  if (
    answers.publishing === "Published but access needs checking" ||
    answers.publishing === "Some pages are unpublished" ||
    answers.publishing === "Search indexing needs checking" ||
    answers.publishing === "I need to verify the whole publishing setup"
  ) {
    task(
      "HIGH",
      "Verify publishing and public access",
      "Check the published version of the site, page visibility, access permissions, and whether the pages intended for search indexing can be indexed."
    );
  }

  if (
    answers.seo === "Some pages are optimized" ||
    answers.seo === "Headings, alt text, and URLs need review" ||
    answers.seo === "SEO has not been checked"
  ) {
    task(
      "MEDIUM",
      "Complete an SEO and accessibility review",
      "Use descriptive page titles, a logical H1/H2/H3 hierarchy, meaningful image alt text, and concise page URLs where supported. Confirm that important text is not hidden inside images."
    );
  }

  if (
    answers.analytics === "I need to set it up" ||
    answers.analytics === "I am unsure"
  ) {
    task(
      "MEDIUM",
      "Establish a measurement baseline",
      "Check what analytics and search-performance tools are available. Record a starting baseline before making major changes so later results can be compared."
    );
  }

  if (answers.brand && answers.brand !== "No changes needed" &&
      answers.brand !== "Not a current priority") {
    task(
      "LOW",
      "Standardize the site's identity",
      `Review this selected branding need: ${answers.brand}. Keep the logo, color palette, page titles, and any domain changes consistent with the site mission.`
    );
  }

  // 9. Time and resources.
  if (
    answers.time === "Less than 2 hours" ||
    answers.time === "2–4 hours" ||
    answers.time === "My availability changes each week"
  ) {
    task(
      "HIGH",
      "Limit active work to a small weekly scope",
      "Choose one high-priority deliverable per work session. Keep new ideas in a later list instead of expanding the current task."
    );
  } else {
    task(
      "MEDIUM",
      "Use focused work blocks",
      "Separate content editing, link testing, design, and publishing checks into different work blocks. Finish and verify one section before starting several others."
    );
  }

  if (
    answers.budget === "$0 — free tools only" ||
    answers.budget === "Under $50"
  ) {
    task(
      "HIGH",
      "Use a low-cost implementation path",
      "Prioritize Google Sites features, free research, manual testing, and simple downloadable resources. Delay paid software, domains, and other purchases until their value is clear."
    );
  }

  // 10. Risk controls.
  if (hasAnswer(answers.risk)) {
    addUnique(
      riskControls,
      `Main identified risk: ${answers.risk}. Add an early warning sign and review it weekly.`
    );
  }

  if (
    answers.blocker === "Too many pages or ideas" ||
    answers.blocker === "Unclear priorities"
  ) {
    addUnique(
      riskControls,
      "Scope control: do not add a new page until the current priority page has a defined purpose, complete core content, and working links."
    );
  }

  if (
    answers.blocker === "Finding visitors" ||
    answers.traffic === "I have not decided" ||
    !hasAnswer(answers.traffic)
  ) {
    addUnique(
      riskControls,
      "Discovery risk: do not assume that publishing automatically produces visitors. Choose a relevant audience and a repeatable way to reach them."
    );
  }

  if (
    answers.blocker === "Technical limitations" ||
    answers.blocker === "Missing or broken links"
  ) {
    addUnique(
      riskControls,
      "Technical risk: test a small prototype in the published environment before building many pages around a feature."
    );
  }

  // 11. Backup route.
  const chosenFallback = answers.fallback;

  if (
    !hasAnswer(chosenFallback) ||
    chosenFallback === "I need a recommendation"
  ) {
    backupSteps.push(
      "Reduce the project to a minimum useful version: one landing page, one primary tool or resource, and working links between them."
    );
    backupSteps.push(
      "Ask a few people from the intended audience to try the main action and describe where they get confused."
    );
    backupSteps.push(
      "Use the feedback to improve the main path before expanding the site."
    );
  } else {
    backupSteps.push(`Primary fallback preference: ${chosenFallback}.`);

    if (chosenFallback === "Launch a smaller version of the site") {
      backupSteps.push(
        "Keep only the landing page, one valuable resource or tool, and essential supporting pages."
      );
    } else if (chosenFallback === "Focus on one useful tool or resource") {
      backupSteps.push(
        "Select the tool with the clearest visitor benefit. Test whether people can complete it without assistance."
      );
    } else if (chosenFallback === "Focus on one audience") {
      backupSteps.push(
        "Rewrite the mission, examples, navigation, and first action for one audience before returning to other groups."
      );
    } else if (chosenFallback === "Test a paid service separately") {
      backupSteps.push(
        "Describe the service, deliverable, scope, and proposed price in a simple offer. Validate interest before investing in a large sales page."
      );
    } else if (chosenFallback === "Use existing pages and improve them gradually") {
      backupSteps.push(
        "Improve the highest-value existing pages instead of rebuilding the entire site. Preserve working material and test each change."
      );
    } else if (chosenFallback === "Seek partnerships or referrals") {
      backupSteps.push(
        "Identify relevant organizations or people who already serve the intended audience. Prepare a concise explanation of the resource and why it may help."
      );
    } else {
      backupSteps.push(
        "Collect feedback, compare it with the success metric, and adjust the smallest part of the visitor journey that is failing."
      );
    }
  }

  if (
    !hasAnswer(answers.noTraffic) ||
    answers.noTraffic === "I need a recommendation"
  ) {
    backupSteps.push(
      "If traffic is low, check page accessibility and indexing first, then share one genuinely useful resource directly with a relevant audience."
    );
  } else {
    backupSteps.push(
      `Low-traffic response: ${answers.noTraffic}. Set a review date and compare results before making further changes.`
    );
  }

  backupSteps.push(
    "If a feature or embed fails, use a simpler working page, document the limitation, and avoid making the whole site depend on an untested feature."
  );

  backupSteps.push(
    "If time or budget becomes constrained, pause optional design and branding changes. Protect the mission, core content, working links, and main visitor action."
  );

  // 12. Success measurement.
  task(
    "MEDIUM",
    "Choose a measurable milestone",
    `Use this preferred success measure: ${answers.metric || "A visitor completes a useful task"}. Define a starting point and a review date.`
  );

  // 13. User-specific inputs.
  if (hasAnswer(answers.opportunities)) {
    recommendations.push(
      `Opportunity priorities: ${answers.opportunities}. Organize these into clearly named categories, and connect each category to useful information and a next action.`
    );
  }

  if (hasAnswer(answers.contentFormats)) {
    recommendations.push(
      `Preferred content formats: ${answers.contentFormats}. Build the formats that directly help visitors complete their main task first.`
    );
  }

  if (hasAnswer(answers.proofPlan)) {
    recommendations.push(
      `Proposed evidence of progress: ${answers.proofPlan}. Make the evidence requirements specific and explain how users should protect sensitive personal information.`
    );
  }

  if (hasAnswer(answers.firstAction)) {
    recommendations.push(
      `Desired first-five-minute journey: ${answers.firstAction}. Use this as the test case for the landing page and navigation.`
    );
  }

  if (hasAnswer(answers.notes)) {
    recommendations.push(
      `Additional planning notes: ${answers.notes}. Keep these visible during implementation and resolve any conflicts with the main goal before proceeding.`
    );
  }

  // Adapt the order and focus of the plan to the biggest blocker.
  const blocker = answers.blocker;

  if (blocker === "Incomplete page content") {
    recommendations.unshift(
      "Focus order: complete the mission, purpose, useful content, and next action on the most important pages before polishing decorative details."
    );
  } else if (blocker === "Design and layout") {
    recommendations.unshift(
      "Focus order: establish a consistent layout and readable color palette, then verify mobile behavior and button visibility."
    );
  } else if (blocker === "Finding visitors") {
    recommendations.unshift(
      "Focus order: make one useful resource easy to understand, identify a relevant audience, and test one discovery channel consistently."
    );
  } else if (blocker === "Choosing a sustainable offer") {
    recommendations.unshift(
      "Focus order: validate the problem and the offer before creating multiple paid products or investing in new tools."
    );
  } else if (blocker === "Lack of time") {
    recommendations.unshift(
      "Focus order: define one weekly deliverable and pause optional work until the deliverable is complete and tested."
    );
  }

  return {
    priorities,
    backupSteps,
    riskControls,
    recommendations,
    checklist,
    chosenFallback
  };
}

