<script>
(function () {
  "use strict";

  const $ = id => document.getElementById(id);

  // -----------------------------
  // Claim decomposition dossier
  // -----------------------------
  const dossierFields = [
    ["Original claim", "claimText"],
    ["Observable or verifiable claims", "factText"],
    ["Hidden assumptions", "assumptionText"],
    ["Interpretation or inference", "inferenceText"],
    ["Alternative explanations", "alternativeText"],
    ["Missing evidence", "missingText"],
    ["Potential falsification", "falsifyText"]
  ];

  let latestDossier = "";

  $("buildDossier").addEventListener("click", function () {
    const lines = [
      "PATHKEEPER — CLAIM DOSSIER",
      "Created: " + new Date().toLocaleString(),
      ""
    ];

    dossierFields.forEach(function (entry) {
      lines.push(entry[0].toUpperCase());
      lines.push($(entry[1]).value.trim() || "[Not supplied]");
      lines.push("");
    });

    latestDossier = lines.join("\n");
    const out = $("dossierOutput");
    out.replaceChildren();

    const heading = document.createElement("strong");
    heading.textContent = "Dossier generated";
    out.appendChild(heading);

    const pre = document.createElement("pre");
    pre.style.whiteSpace = "pre-wrap";
    pre.style.overflowWrap = "anywhere";
    pre.textContent = latestDossier;
    out.appendChild(pre);
  });

  $("clearDossier").addEventListener("click", function () {
    dossierFields.forEach(entry => $(entry[1]).value = "");
    latestDossier = "";
    $("dossierOutput").replaceChildren();
  });

  $("downloadDossier").addEventListener("click", function () {
    if (!latestDossier) {
      $("buildDossier").click();
    }
    downloadText("pathkeeper-claim-dossier.txt", latestDossier);
  });

  function downloadText(filename, content) {
    const blob = new Blob([content], {type:"text/plain;charset=utf-8"});
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  }

  // -----------------------------
  // Source comparison matrix
  // -----------------------------
  const comparisonDimensions = [
    ["Publisher / author", "Who is responsible for the source?"],
    ["Original evidence", "What primary evidence does it provide?"],
    ["Method / sample", "How was the information obtained?"],
    ["Publication / data date", "When was the underlying information collected?"],
    ["Incentives / conflicts", "What interests might affect the presentation?"],
    ["Limitations / counterevidence", "What weaknesses or contrary findings exist?"],
    ["Independence", "Does this source rely on another source in the matrix?"],
    ["Actual conclusion", "What does the source support, narrowly stated?"]
  ];

  const sourceRows = $("sourceRows");

  comparisonDimensions.forEach(function (dimension, i) {
    const tr = document.createElement("tr");
    const th = document.createElement("th");
    th.textContent = dimension[0];
    th.title = dimension[1];
    tr.appendChild(th);

    ["A", "B", "C"].forEach(function (letter) {
      const td = document.createElement("td");
      const input = document.createElement("textarea");
      input.id = "src" + letter + "_" + i;
      input.rows = 2;
      input.setAttribute("aria-label", "Source " + letter + ": " + dimension[0]);
      input.placeholder = dimension[1];
      td.appendChild(input);
      tr.appendChild(td);
    });

    sourceRows.appendChild(tr);
  });

  $("analyzeSources").addEventListener("click", function () {
    const out = $("sourceOutput");
    out.replaceChildren();

    const notes = [];
    const question = $("question").value.trim();
    if (question) notes.push("Question: " + question);

    ["A", "B", "C"].forEach(function (letter) {
      const filled = comparisonDimensions.filter((_, i) =>
        $("src" + letter + "_" + i).value.trim() !== ""
      ).length;

      notes.push(
        "Source " + letter + ": " + filled + " of " +
        comparisonDimensions.length + " dimensions documented."
      );
    });

    const independence = ["A", "B", "C"].map(letter =>
      $("src" + letter + "_6").value.trim()
    );

    const summary = document.createElement("p");
    summary.textContent = notes.join(" ");
    out.appendChild(summary);

    const advice = document.createElement("p");
    const allIndependent = independence.every(v =>
      /independent|different original|separate data/i.test(v)
    );

    advice.textContent = allIndependent
      ? "The notes describe the sources as independent. Verify those relationships rather than relying on labels alone."
      : "Independence has not been clearly established for every source. Trace citations and shared data before counting sources as separate confirmation.";

    out.appendChild(advice);

    const warning = document.createElement("p");
    warning.textContent =
      "This matrix organizes your own notes; it does not automatically verify the sources or determine which one is correct. Resolve differences in methods, definitions, populations, dates, and actual claims.";
    out.appendChild(warning);
  });

  $("clearSources").addEventListener("click", function () {
    $("question").value = "";
    comparisonDimensions.forEach((_, i) =>
      ["A", "B", "C"].forEach(letter => $("src" + letter + "_" + i).value = "")
    );
    $("sourceOutput").replaceChildren();
  });

  // -----------------------------
  // Scenario-based learning
  // -----------------------------
  function bindScenario(name, correct, feedbackId, explanation) {
    $(name === "scenario" ? "checkScenario" :
      name === "scenario2" ? "checkScenario2" : "checkScenario3"
    ).addEventListener("click", function () {
      const selected = document.querySelector('input[name="' + name + '"]:checked');
      const output = $(feedbackId);
      output.replaceChildren();

      const p = document.createElement("p");
      if (!selected) {
        p.textContent = "Choose an answer before checking your reasoning.";
      } else {
        p.textContent = (selected.value === correct ? "Correct reasoning. " : "Not quite. ") + explanation;
      }
      output.appendChild(p);
    });
  }

  bindScenario(
    "scenario", "c", "scenarioFeedback",
    "The percentage is not interpretable enough without its denominator, response rate, timeframe, outcome definition, and verification method. Commercial incentives justify scrutiny, not automatic rejection."
  );

  bindScenario(
    "scenario2", "b", "scenario2Feedback",
    "Five repetitions of one press release remain dependent on that original source. Locate the underlying evidence and seek independent corroboration."
  );

  bindScenario(
    "scenario3", "b", "scenario3Feedback",
    "A change from 2% to 4% is a two-percentage-point absolute increase and a 100% relative increase. Its practical meaning depends on sample sizes, uncertainty, study design, and the outcome."
  );

  // -----------------------------
  // Confidence calibration records
  // -----------------------------
  const predictions = [];

  $("savePrediction").addEventListener("click", function () {
    const claim = $("prediction").value.trim();
    if (!claim) {
      $("prediction").focus();
      return;
    }

    predictions.push({
      claim: claim,
      confidence: Number($("confidence").value),
      basis: $("evidenceBasis").value.trim(),
      result: "Not yet resolved",
      created: new Date().toLocaleDateString()
    });

    $("prediction").value = "";
    $("evidenceBasis").value = "";
    renderPredictions();
  });

  function renderPredictions() {
    const container = $("predictionLog");
    container.replaceChildren();

    if (!predictions.length) {
      const empty = document.createElement("div");
      empty.className = "empty";
      empty.textContent = "No predictions recorded yet.";
      container.appendChild(empty);
      return;
    }

    predictions.forEach(function (prediction, index) {
      const card = document.createElement("article");
      card.className = "log-card";

      const title = document.createElement("h4");
      title.textContent = prediction.claim;
      card.appendChild(title);

      const confidence = document.createElement("p");
      confidence.textContent = "Confidence: " + prediction.confidence +
        "% · Recorded: " + prediction.created;
      card.appendChild(confidence);

      if (prediction.basis) {
        const basis = document.createElement("p");
        basis.textContent = "Reasoning: " + prediction.basis;
        card.appendChild(basis);
      }

      const status = document.createElement("p");
      status.textContent = "Outcome: " + prediction.result;
      card.appendChild(status);

      const controls = document.createElement("div");
      controls.className = "actions";

      ["Correct", "Incorrect", "Unresolved"].forEach(function (value) {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "btn light";
        button.textContent = value;
        button.addEventListener("click", function () {
          prediction.result = value;
          renderPredictions();
        });
        controls.appendChild(button);
      });

      const remove = document.createElement("button");
      remove.type = "button";
      remove.className = "btn light";
      remove.textContent = "Delete";
      remove.addEventListener("click", function () {
        predictions.splice(index, 1);
        renderPredictions();
      });
      controls.appendChild(remove);
      card.appendChild(controls);
      container.appendChild(card);
    });
  }

  // -----------------------------
  // Weighted evaluation engine
  // -----------------------------
  const criteria = [
    {
      name:"Source transparency and expertise",
      weight:15,
      description:"Is the author identifiable and appropriately qualified?"
    },
    {
      name:"Evidence quality",
      weight:30,
      description:"Is relevant, traceable evidence available?"
    },
    {
      name:"Independent corroboration",
      weight:20,
      description:"Do independent sources support the claim?"
    },
    {
      name:"Recency and contextual accuracy",
      weight:15,
      description:"Is the information current and applicable?"
    },
    {
      name:"Fairness and incentive transparency",
      weight:10,
      description:"Are limitations, conflicts, and contrary evidence addressed?"
    },
    {
      name:"Relevance to the question",
      weight:10,
      description:"Does the evidence answer the exact question?"
    }
  ];

  const ratingsContainer = $("ratings");

  criteria.forEach(function (criterion, index) {
    const wrapper = document.createElement("div");
    wrapper.className = "rating";

    const head = document.createElement("div");
    head.className = "rating-head";

    const label = document.createElement("label");
    label.htmlFor = "rating" + index;
    label.textContent = criterion.name;

    const hint = document.createElement("small");
    hint.textContent = criterion.description;
    label.appendChild(hint);

    const value = document.createElement("span");
    value.className = "rating-value";
    value.id = "ratingValue" + index;
    value.textContent = "0/4";

    head.appendChild(label);
    head.appendChild(value);

    const range = document.createElement("input");
    range.type = "range";
    range.id = "rating" + index;
    range.min = "0";
    range.max = "4";
    range.step = "1";
    range.value = "0";
    range.setAttribute("aria-label", criterion.name + " rating");

    range.addEventListener("input", updateScore);
    wrapper.appendChild(head);
    wrapper.appendChild(range);
    ratingsContainer.appendChild(wrapper);
  });

  function getRatings() {
    return criteria.map((_, index) => Number($("rating" + index).value));
  }

  function calculateScore(values) {
    return Math.round(values.reduce((total, value, index) =>
      total + value / 4 * criteria[index].weight, 0
    ));
  }

  function assessmentFor(score, values) {
    if (values.every(value => value === 0)) {
      return {
        status:"Not assessed",
        interpretation:"No positive ratings have been supplied. Zero can mean unknown, not necessarily false.",
        next:"Find the original source and inspect its supporting evidence."
      };
    }
    if (score >= 80) {
      return {
        status:"Promising — verify",
        interpretation:"Your ratings indicate comparatively strong quality signals. They do not establish that the claim is true.",
        next:"Independently verify the most consequential part of the claim."
      };
    }
    if (score >= 60) {
      return {
        status:"Partially supported",
        interpretation:"Some quality signals are favorable, but further investigation may be necessary.",
        next:"Investigate the weakest criteria and resolve important uncertainties."
      };
    }
    if (score >= 35) {
      return {
        status:"Insufficient confidence",
        interpretation:"The current ratings indicate meaningful weaknesses or gaps.",
        next:"Find stronger evidence and compare independent sources."
      };
    }
    return {
      status:"High uncertainty",
      interpretation:"The current ratings do not provide a strong basis for relying on this information. That does not prove the claim false.",
      next:"Pause reliance until the source and evidence can be checked."
    };
  }

  function updateScore() {
    const values = getRatings();
    const score = calculateScore(values);
    const assessment = assessmentFor(score, values);

    values.forEach((value, index) => {
      $("ratingValue" + index).textContent = value + "/4";
    });

    $("score").textContent = score;
    $("meterFill").style.width = score + "%";
    $("status").textContent = assessment.status;
    $("interpretation").textContent = assessment.interpretation;
    $("recommendation").textContent = $("nextstep").value || assessment.next;

    const issues = $("issues");
    issues.replaceChildren();

    const weak = values.map((value, index) => ({value, index}))
      .filter(item => item.value <= 1);

    if (!weak.length) {
      const li = document.createElement("li");
      li.textContent = "No criterion received a rating of 0 or 1. Independent verification is still necessary.";
      issues.appendChild(li);
    } else {
      weak.forEach(function (item) {
        const li = document.createElement("li");
        li.textContent = criteria[item.index].name +
          (item.value === 0 ? ": unknown or unverified." : ": weak evidence.");
        issues.appendChild(li);
      });
    }
  }

  $("nextstep").addEventListener("change", updateScore);

  const reviews = [];
  const form = $("evaluationForm");

  form.addEventListener("submit", function (event) {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const values = getRatings();
    const score = calculateScore(values);
    const assessment = assessmentFor(score, values);

    reviews.unshift({
      claim:$("claim").value.trim(),
      source:$("source").value.trim(),
      url:$("url").value.trim(),
      purpose:$("purpose").value,
      score:score,
      status:assessment.status,
      ratings:values,
      concerns:$("redflags").value.trim(),
      next:$("nextstep").value,
      created:new Date().toLocaleString()
    });

    renderReviews();
    $("status").textContent = assessment.status + " — saved";
  });

  function renderReviews() {
    const container = $("reviewLog");
    container.replaceChildren();

    if (!reviews.length) {
      const empty = document.createElement("div");
      empty.className = "empty";
      empty.textContent = "No evaluations saved yet.";
      container.appendChild(empty);
      return;
    }

    reviews.forEach(function (review, index) {
      const card = document.createElement("article");
      card.className = "log-card";

      const title = document.createElement("h4");
      title.textContent = review.claim;
      card.appendChild(title);

      const meta = document.createElement("p");
      meta.className = "muted small";
      meta.textContent = review.source + " · " + review.created;
      card.appendChild(meta);

      const result = document.createElement("p");
      result.textContent = review.score + "/100 — " + review.status;
      card.appendChild(result);

      const next = document.createElement("p");
      next.textContent = "Next action: " + review.next;
      card.appendChild(next);

      if (review.concerns) {
        const concerns = document.createElement("p");
        concerns.textContent = "Concerns: " + review.concerns;
        card.appendChild(concerns);
      }

      if (review.url) {
        const link = document.createElement("a");
        link.href = review.url;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.textContent = "Open source";
        card.appendChild(link);
      }

      const actions = document.createElement("div");
      actions.className = "actions";

      const reassess = document.createElement("button");
      reassess.type = "button";
      reassess.className = "btn light";
      reassess.textContent = "Reassess";
      reassess.addEventListener("click", function () {
        $("claim").value = review.claim;
        $("source").value = review.source;
        $("url").value = review.url;
        $("purpose").value = review.purpose;
        $("redflags").value = review.concerns;
        $("nextstep").value = review.next;

        review.ratings.forEach((value, i) => $("rating" + i).value = value);
        updateScore();
        $("evaluator").scrollIntoView({behavior:"smooth"});
      });

      const remove = document.createElement("button");
      remove.type = "button";
      remove.className = "btn light";
      remove.textContent = "Delete";
      remove.addEventListener("click", function () {
        reviews.splice(index, 1);
        renderReviews();
      });

      actions.appendChild(reassess);
      actions.appendChild(remove);
      card.appendChild(actions);
      container.appendChild(card);
    });
  }

  $("resetEvaluator").addEventListener("click", function () {
    form.reset();
    criteria.forEach((_, index) => $("rating" + index).value = 0);
    updateScore();
  });

  $("printReview").addEventListener("click", function () {
    window.print();
  });

  $("clearLog").addEventListener("click", function () {
    if (!reviews.length) return;
    if (window.confirm("Clear all evaluation records from this session?")) {
      reviews.length = 0;
      renderReviews();
    }
  });

  $("exportLog").addEventListener("click", function () {
    if (!reviews.length) {
      window.alert("Save an evaluation before exporting.");
      return;
    }

    const columns = [
      "Claim","Source","URL","Purpose","Score","Assessment",
      "Ratings","Concerns","Next Action","Reviewed At"
    ];

    function csvCell(value) {
      let text = String(value == null ? "" : value);
      if (/^[\s]*[=+\-@]/.test(text)) text = "'" + text;
      return '"' + text.replace(/"/g, '""') + '"';
    }

    const rows = reviews.map(review => [
      review.claim,review.source,review.url,review.purpose,
      review.score,review.status,review.ratings.join("; "),
      review.concerns,review.next,review.created
    ].map(csvCell).join(","));

    downloadText(
      "pathkeeper-information-reviews.csv",
      "\uFEFF" + columns.map(csvCell).join(",") + "\r\n" + rows.join("\r\n")
    );
  });

  // -----------------------------
  // Verification checklist
  // -----------------------------
  const checkboxes = Array.from(
    document.querySelectorAll("#checklist input[type=checkbox]")
  );

  function updateChecklist() {
    const count = checkboxes.filter(box => box.checked).length;
    $("checkProgress").textContent =
      count + " of " + checkboxes.length + " checks completed";

    $("checkAdvice").textContent =
      count === checkboxes.length
        ? "All checks marked complete. Confirm the underlying evidence and ensure the process is appropriate for the stakes."
        : "Complete the remaining applicable checks before relying on the claim.";
  }

  checkboxes.forEach(box => box.addEventListener("change", updateChecklist));

  updateScore();
  updateChecklist();
})();
</script>

</body>
</html>
