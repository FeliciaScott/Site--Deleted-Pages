}

.link-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:25px;
}

.link-card{
    background:white;
    padding:25px;
    border-radius:15px;
    box-shadow:var(--shadow);
}

.link-card h3{
    color:var(--green);
    margin-bottom:10px;
}

.link-card a{
    text-decoration:none;
    color:var(--dark);
    font-weight:600;
}

.intro{
    padding:40px 8%;
    text-align:center;
}

.intro h2{
    color:var(--dark);
    margin-bottom:20px;
