.categories{
    padding:80px 8%;
}

.categories h2{
    text-align:center;
    margin-bottom:50px;
    color:var(--dark);
}

.grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(340px,1fr));
    gap:30px;
}

.card{
    background:white;
    border-radius:20px;
    overflow:hidden;
    box-shadow:var(--shadow);
    transition:.3s;
}

.card:hover{
    transform:translateY(-8px);
}

.card img{
    width:100%;
    height:230px;
    object-fit:cover;
}

.card-header{
    background:var(--green);
    color:white;
    padding:20px;
}

.card-body{
    padding:25px;
}

.card-body p{
    margin-bottom:15px;
}

.card-body ul{
    padding-left:20px;
    margin-bottom:20px;
}

.card-body li{
    margin-bottom:8px;
}

.sources{
    background:var(--accent);
    padding:15px;
    border-radius:10px;
}

.sources h4{
    color:var(--dark);
    margin-bottom:10px;
}

.sources a{
    display:block;
    text-decoration:none;
    color:var(--dark);
    margin-bottom:8px;
    font-weight:500;
}

.cta{
    background:var(--dark);
    color:white;
    text-align:center;
    padding:90px 8%;
}

.cta h2{
    margin-bottom:20px;
}

footer{
    background:#102634;
    color:white;
    text-align:center;
    padding:30px;
}

</style>
