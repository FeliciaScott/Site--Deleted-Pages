<!-- =========================================================
     FOOTER
========================================================= -->

<footer>

    <div class="container footer-content">

        <div>

            <strong>
                TECH LAUNCH
            </strong>

            <p>
                A practical roadmap for building technology skills
                through evidence.
            </p>

