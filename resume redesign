<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Tech Launch | Build Before You Need It</title>

<style>

/* =========================================================
   PALETTE
========================================================= */

:root{
    --burgundy:#2D0C13;
    --gold:#EED7A1;
    --rose:#F9ECEC;
    --wine:#4A1B24;

    --wine-dark:#371019;
    --wine-light:#5B2731;
    --gold-dark:#C9AD72;

    --muted:#D7C4C5;
    --border:rgba(238,215,161,.20);
    --border-strong:rgba(238,215,161,.45);

    --paper:#FFF8F2;
    --paper-text:#35191F;

    --max:1180px;
}


/* =========================================================
   GLOBAL
========================================================= */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    background:var(--burgundy);
    color:var(--rose);
    font-family:Arial,Helvetica,sans-serif;
    line-height:1.7;
}

body.no-scroll{
    overflow:hidden;
}

a{
    color:inherit;
    text-decoration:none;
}

button{
    font-family:inherit;
}

.container{
    width:min(calc(100% - 40px),var(--max));
    margin:auto;
}

.section{
    padding:110px 0;
    border-bottom:1px solid var(--border);
}

.section-label{
    color:var(--gold);
    font-size:11px;
    font-weight:700;
    letter-spacing:2.5px;
    text-transform:uppercase;
    margin-bottom:20px;
}

.section-title{
    font-size:clamp(38px,6vw,72px);
    line-height:1;
    letter-spacing:-2px;
    max-width:850px;
    margin-bottom:22px;
}

.section-intro{
    max-width:720px;
    color:var(--muted);
    font-size:18px;
}

.gold{
    color:var(--gold);
}


/* =========================================================
   NAVIGATION
========================================================= */

.navbar{
    position:sticky;
    top:0;
    z-index:1000;
    background:rgba(45,12,19,.94);
    backdrop-filter:blur(16px);
    border-bottom:1px solid var(--border);
}

.nav-container{
    width:min(calc(100% - 40px),var(--max));
    min-height:70px;
    margin:auto;

    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:30px;
}

.brand{
    display:flex;
    align-items:center;
    gap:10px;

    color:var(--rose);
    font-size:12px;
    font-weight:800;
    letter-spacing:1.5px;
}

.brand-mark{
    width:35px;
    height:35px;

    display:grid;
    place-items:center;

    background:var(--gold);
    color:var(--burgundy);

    font-weight:900;
}

.nav-links{
    display:flex;
    gap:22px;
}

.nav-links a{
    color:var(--muted);
    font-size:12px;
    transition:.2s;
}

.nav-links a:hover{
    color:var(--gold);
}

.mobile-menu{
    display:none;
    background:none;
    border:1px solid var(--border);
    color:var(--gold);
    padding:8px 11px;
    cursor:pointer;
}


/* =========================================================
   HERO
========================================================= */

.hero{
    min-height:800px;
    display:flex;
    align-items:center;

    position:relative;
    overflow:hidden;

    background:
        radial-gradient(
            circle at 15% 30%,
            rgba(238,215,161,.10),
            transparent 28%
        ),
        radial-gradient(
            circle at 85% 70%,
            rgba(238,215,161,.07),
            transparent 28%
        ),
        var(--burgundy);
}

.hero:before{
    content:"";

    position:absolute;
    inset:0;

    background-image:
        linear-gradient(
            rgba(238,215,161,.035) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(238,215,161,.035) 1px,
            transparent 1px
        );

    background-size:55px 55px;
    pointer-events:none;
}

.hero-content{
    position:relative;
    z-index:2;
}

.eyebrow{
    display:inline-block;

    padding:8px 12px;
    margin-bottom:30px;

    border:1px solid var(--border);
    color:var(--gold);

    font-size:10px;
    letter-spacing:2px;
    font-weight:700;
}

.hero h1{
    max-width:950px;

    font-size:clamp(52px,9vw,105px);
    line-height:.94;
    letter-spacing:-5px;

    margin-bottom:30px;
}

.hero h1 span{
    display:block;
    color:var(--gold);
}

.hero-text{
    max-width:730px;

    color:var(--muted);
    font-size:20px;

    margin-bottom:35px;
}

.hero-actions{
    display:flex;
    gap:12px;
    flex-wrap:wrap;
}

.btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;

    padding:14px 21px;

    border:1px solid var(--border);

    font-size:13px;
    font-weight:700;

    cursor:pointer;

    transition:.2s;
}

.btn:hover{
    transform:translateY(-2px);
}

.btn-primary{
    background:var(--gold);
    color:var(--burgundy);
    border-color:var(--gold);
}

.btn-secondary{
    background:transparent;
    color:var(--rose);
}

.hero-process{
    margin-top:75px;

    display:flex;
    flex-wrap:wrap;
    gap:0;
}

.process-step{
    padding-right:30px;
    margin-right:30px;

    border-right:1px solid var(--border);
}

.process-step:last-child{
    border-right:none;
}

.process-step strong{
    display:block;

    color:var(--gold);

    font-size:18px;
}

.process-step span{
    color:var(--muted);
    font-size:11px;
}


/* =========================================================
   MISSION
========================================================= */

.mission-section{
    background:var(--wine-dark);
}

.mission-grid{
    display:grid;
    grid-template-columns:.9fr 1.1fr;
    gap:100px;
    align-items:start;
}

.mission-grid h2{
    font-size:clamp(42px,6vw,76px);
    line-height:1;
    letter-spacing:-3px;
}

.mission-copy p{
    color:var(--muted);
    margin-bottom:20px;
}

.mission-copy .large-text{
    color:var(--rose);
    font-size:25px;
}


/* =========================================================
   RESUME
========================================================= */

.resume-section{
    background:#240A10;
}

.resume-tools{
    display:flex;
    justify-content:flex-end;
    gap:10px;
    margin-bottom:15px;
}

.resume-tool{
    padding:9px 13px;

    border:1px solid var(--border);
    background:transparent;
    color:var(--gold);

    font-size:11px;
    cursor:pointer;
}

.resume-tool:hover{
    background:var(--wine);
}

.resume-paper{
    max-width:960px;
    margin:30px auto 0;

    background:var(--paper);
    color:var(--paper-text);

    padding:65px;

    box-shadow:
        0 35px 90px rgba(0,0,0,.35);
}

.resume-header{
    display:flex;
    justify-content:space-between;
    gap:40px;

    padding-bottom:28px;

    border-bottom:2px solid var(--paper-text);
}

.resume-header h2{
    font-size:34px;
    line-height:1;
}

.resume-title{
    color:#72545A;
    font-size:13px;
    margin-top:7px;
}

.resume-contact{
    display:flex;
    flex-direction:column;
    align-items:flex-end;

    color:#765E63;
    font-size:11px;
}

.resume-block{
    padding:27px 0;
    border-bottom:1px solid #E2D5D2;
}

.resume-block:last-child{
    border-bottom:none;
}

.resume-block > h3{
    color:var(--paper-text);

    font-size:11px;
    letter-spacing:1.5px;

    margin-bottom:15px;
}

.resume-block p,
.resume-block li{
    font-size:13px;
    line-height:1.7;
}

.instruction-note{
    margin-top:17px;
    padding:12px 15px;

    background:#F5E9DD;
    border-left:3px solid var(--gold-dark);

    color:#63474D;
    font-size:11px;
}

.resume-skills{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:8px 30px;
}

.experience-item{
    margin-bottom:30px;
}

.experience-item:last-child{
    margin-bottom:0;
}

.experience-heading{
    display:flex;
    justify-content:space-between;
    gap:20px;

    margin-bottom:10px;
}

.experience-heading h4{
    font-size:15px;
}

.experience-heading span{
    color:#806B70;
    font-size:10px;
}

.experience-item ul{
    padding-left:20px;
}

.cert-list{
    list-style:none;
}

.cert-list li{
    display:flex;
    justify-content:space-between;

    padding:9px 0;

    border-bottom:1px solid #E5DAD7;
}

.cert-list small{
    color:#8C797D;
}

.project-resume-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:14px;
}

.mini-project{
    padding:15px;
    border:1px solid #DDD0CC;
}

.mini-project p{
    color:#725E63;
    margin-top:6px;
}


/* =========================================================
   ROADMAP
========================================================= */

.roadmap-section{
    background:var(--burgundy);
}

.roadmap-intro-row{
    display:flex;
    justify-content:space-between;
    gap:30px;
    align-items:end;
}

.roadmap-progress{
    min-width:230px;
}

.progress-text{
    display:flex;
    justify-content:space-between;

    color:var(--muted);
    font-size:11px;

    margin-bottom:8px;
}

.progress-track{
    height:5px;
    background:var(--wine);
}

.progress-fill{
    height:100%;
    width:0;

    background:var(--gold);

    transition:width .4s ease;
}

.roadmap{
    margin-top:50px;

    display:grid;
    gap:12px;
}

.roadmap-card{
    border:1px solid var(--border);
    background:var(--wine-dark);
}

.roadmap-head{
    width:100%;

    display:grid;
    grid-template-columns:70px 1fr 40px;
    gap:20px;
    align-items:center;

    padding:25px;

    background:none;
    border:none;

    color:var(--rose);
    text-align:left;

    cursor:pointer;
}

.roadmap-number{
    color:var(--gold);
    font-size:26px;
    font-weight:700;
}

.roadmap-category{
    color:var(--gold);

    font-size:9px;
    letter-spacing:2px;
    font-weight:700;
}

.roadmap-head h3{
    font-size:23px;
    margin:4px 0;
}

.roadmap-head p{
    color:var(--muted);
    font-size:13px;
}

.roadmap-icon{
    color:var(--gold);
    font-size:24px;

    transition:.25s;
}

.roadmap-card.open .roadmap-icon{
    transform:rotate(45deg);
}

.roadmap-body{
    max-height:0;
    overflow:hidden;

    transition:max-height .4s ease;
}

.roadmap-inner{
    padding:0 25px 30px 115px;

    border-top:1px solid var(--border);
}

.roadmap-inner > p{
    color:var(--muted);
    margin:22px 0;
}

.task-list{
    list-style:none;
    display:grid;
    gap:8px;
}

.task-list li{
    display:flex;
    align-items:flex-start;
    gap:10px;

    padding:10px;

    background:rgba(255,255,255,.025);

    color:var(--muted);
    font-size:13px;

    transition:.2s;
}

.task-list li:hover{
    background:var(--wine);
}

.task-list input{
    margin-top:5px;

    width:15px;
    height:15px;

    accent-color:var(--gold);
}

.task-list li.complete{
    color:#A99A9C;
    text-decoration:line-through;
}

.stage-completion{
    margin-top:20px;

    color:var(--gold);

    font-size:10px;
    letter-spacing:1px;
}


/* =========================================================
   PROJECTS
========================================================= */

.projects-section{
    background:var(--wine-dark);
}

.project-filters{
    display:flex;
    gap:8px;
    flex-wrap:wrap;

    margin-top:35px;
}

.filter-btn{
    padding:9px 14px;

    border:1px solid var(--border);
    background:transparent;
    color:var(--muted);

    cursor:pointer;
    font-size:11px;
}

.filter-btn.active,
.filter-btn:hover{
    background:var(--gold);
    border-color:var(--gold);
    color:var(--burgundy);
}

.project-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:14px;

    margin-top:25px;
}

.project-card{
    display:flex;
    flex-direction:column;

    padding:27px;

    border:1px solid var(--border);
    background:var(--burgundy);

    transition:.25s;
}

.project-card:hover{
    border-color:var(--border-strong);
    transform:translateY(-3px);
}

.project-card.hidden{
    display:none;
}

.project-number{
    color:var(--gold);

    font-size:9px;
    letter-spacing:2px;
}

.project-card h3{
    font-size:21px;
    margin:20px 0 10px;
}

.project-card p{
    color:var(--muted);
    font-size:13px;
}

.project-proof{
    margin-top:auto;
    padding-top:20px;

    color:var(--rose);
    font-size:12px;
}

.project-open{
    margin-top:20px;

    background:transparent;
    border:1px solid var(--border);

    color:var(--gold);

    padding:10px;

    cursor:pointer;
}

.project-open:hover{
    background:var(--wine);
}


/* =========================================================
   PROJECT MODAL
========================================================= */

.modal{
    position:fixed;
    inset:0;
    z-index:2000;

    display:none;
    align-items:center;
    justify-content:center;

    padding:20px;

    background:rgba(20,4,8,.86);
}

.modal.show{
    display:flex;
}

.modal-box{
    width:min(650px,100%);
    max-height:90vh;
    overflow:auto;

    background:var(--burgundy);
    border:1px solid var(--border-strong);

    padding:35px;
}

.modal-close{
    float:right;

    background:none;
    border:none;

    color:var(--gold);
    font-size:25px;
    cursor:pointer;
}

.modal-label{
    color:var(--gold);

    font-size:10px;
    letter-spacing:2px;
    text-transform:uppercase;
}

.modal-box h2{
    font-size:38px;
    line-height:1.05;
    margin:15px 0;
}

.modal-box p{
    color:var(--muted);
}

.modal-proof{
    margin-top:25px;
    padding:20px;

    background:var(--wine);

    border-left:3px solid var(--gold);
}


/* =========================================================
   CERTIFICATIONS
========================================================= */

.certification-section{
    background:var(--burgundy);
}

.certification-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:12px;
    margin-top:45px;
}

.cert-card{
    padding:25px;

    border:1px solid var(--border);
    background:var(--wine-dark);

    cursor:pointer;
    transition:.2s;
}

.cert-card:hover,
.cert-card.active{
    border-color:var(--gold);
}

.cert-number{
    color:var(--gold);
    font-size:11px;
}

.cert-card h3{
    margin:20px 0 10px;
}

.cert-card p{
    color:var(--muted);
    font-size:13px;
}

.cert-status{
    display:inline-block;

    margin-top:20px;
    padding:5px 8px;

    border:1px solid var(--border);

    color:var(--gold);

    font-size:9px;
    letter-spacing:1px;
}

.cert-detail{
    display:none;

    margin-top:15px;
    padding-top:15px;

    border-top:1px solid var(--border);

    color:var(--muted);
    font-size:12px;
}

.cert-card.active .cert-detail{
    display:block;
}


/* =========================================================
   PROFESSIONAL OPERATING SYSTEM
========================================================= */

.operating-section{
    background:#240A10;
}

.operating-grid{
    display:grid;
    grid-template-columns:.8fr 1.2fr;
    gap:100px;
}

.operating-grid h2{
    font-size:clamp(40px,6vw,75px);
    line-height:1;
}

.principle{
    border-bottom:1px solid var(--border);
}

.principle button{
    width:100%;

    display:grid;
    grid-template-columns:45px 1fr 25px;
    gap:15px;

    padding:24px 0;

    background:none;
    border:none;

    color:var(--rose);
    text-align:left;

    cursor:pointer;
}

.principle-number{
    color:var(--gold);
}

.principle h3{
    font-size:17px;
    margin-bottom:4px;
}

.principle-arrow{
    color:var(--gold);
    font-size:20px;
    transition:.2s;
}

.principle.open .principle-arrow{
    transform:rotate(45deg);
}

.principle-body{
    max-height:0;
    overflow:hidden;
    transition:max-height .3s ease;
}

.principle-body p{
    color:var(--muted);
    padding:0 40px 22px 60px;
    font-size:13px;
}


/* =========================================================
   DAILY SYSTEM
========================================================= */

.daily-section{
    background:var(--wine-dark);
}

.daily-builder{
    max-width:850px;
    margin-top:45px;
}

.daily-option{
    width:100%;

    display:grid;
    grid-template-columns:90px 1fr 35px;
    gap:20px;
    align-items:center;

    padding:20px;

    margin-bottom:8px;

    border:1px solid var(--border);
    background:var(--burgundy);

    color:var(--rose);
    text-align:left;

    cursor:pointer;
}

.daily-option:hover{
    border-color:var(--gold);
}

.daily-option.selected{
    border-color:var(--gold);
    background:#39121A;
}

.daily-time{
    color:var(--gold);
    font-size:11px;
    font-weight:bold;
}

.daily-option h3{
    margin-bottom:3px;
    font-size:17px;
}

.daily-option p{
    color:var(--muted);
    font-size:12px;
}

.daily-check{
    color:var(--gold);
    font-size:20px;
}

.daily-summary{
    display:none;

    margin-top:25px;
    padding:25px;

    border-left:3px solid var(--gold);
    background:var(--burgundy);
}

.daily-summary.show{
    display:block;
}

.daily-summary strong{
    color:var(--gold);
}


/* =========================================================
   INTERVIEW
========================================================= */

.interview-section{
    background:var(--burgundy);
}

.interview-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:12px;
    margin-top:45px;
}

.interview-card{
    border:1px solid var(--border);
    background:var(--wine-dark);
}

.interview-trigger{
    width:100%;

    padding:27px;

    background:none;
    border:none;

    color:var(--rose);
    text-align:left;

    cursor:pointer;
}

.interview-trigger > span{
    display:inline-grid;
    place-items:center;

    width:30px;
    height:30px;

    border:1px solid var(--gold);

    color:var(--gold);

    font-size:10px;
}

.interview-trigger h3{
    margin:17px 0 8px;
}

.interview-trigger p{
    color:var(--muted);
    font-size:13px;
}

.interview-answer{
    display:none;

    padding:0 27px 27px;
}

.interview-card.open .interview-answer{
    display:block;
}

.interview-answer-inner{
    padding:20px;

    background:var(--burgundy);
    border-left:3px solid var(--gold);
}

.interview-answer strong{
    color:var(--gold);
}

.prompt{
    margin-top:12px;
    color:var(--rose);
}


/* =========================================================
   JOB TARGETS
========================================================= */

.jobs-section{
    background:var(--wine-dark);
}

.job-selector{
    display:flex;
    gap:8px;
    flex-wrap:wrap;
    margin-top:35px;
}

.job-filter{
    padding:10px 15px;

    border:1px solid var(--border);
    background:transparent;

    color:var(--muted);

    cursor:pointer;
}

.job-filter.active,
.job-filter:hover{
    background:var(--gold);
    color:var(--burgundy);
    border-color:var(--gold);
}

.jobs-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:12px;
    margin-top:25px;
}

.job-target{
    padding:28px;

    border:1px solid var(--border);
    background:var(--burgundy);

    cursor:pointer;
    transition:.2s;
}

.job-target:hover,
.job-target.selected{
    border-color:var(--gold);
}

.job-target > span{
    color:var(--gold);
    font-size:10px;
    letter-spacing:2px;
}

.job-target h3{
    margin:20px 0 10px;
    font-size:20px;
}

.job-target p{
    color:var(--muted);
    font-size:13px;
}

.job-detail{
    display:none;

    margin-top:15px;
    padding-top:15px;

    border-top:1px solid var(--border);

    color:var(--muted);
    font-size:12px;
}

.job-target.selected .job-detail{
    display:block;
}


/* =========================================================
   90 DAY PLAN
========================================================= */

.ninety-section{
    background:#240A10;
}

.ninety-tabs{
    display:flex;
    gap:0;

    margin-top:45px;

    border-bottom:1px solid var(--border);
}

.ninety-tab{
    flex:1;

    padding:17px;

    border:none;
    border-bottom:3px solid transparent;

    background:transparent;

    color:var(--muted);

    cursor:pointer;
    font-weight:bold;
}

.ninety-tab.active{
    color:var(--gold);
    border-bottom-color:var(--gold);
}

.ninety-panel{
    display:none;

    padding:35px 0;
}

.ninety-panel.active{
    display:block;
}

.ninety-panel h3{
    font-size:30px;
    margin-bottom:20px;
}

.ninety-list{
    list-style:none;

    display:grid;
    grid-template-columns:1fr 1fr;
    gap:8px 15px;
}

.ninety-list li{
    padding:15px;

    border:1px solid var(--border);
    background:var(--burgundy);

    color:var(--muted);
}

.ninety-list li:before{
    content:"→";
    color:var(--gold);
    margin-right:9px;
}

.ninety-action{
    margin-top:25px;

    background:var(--gold);
    color:var(--burgundy);

    border:none;
    padding:13px 18px;

    font-weight:bold;
    cursor:pointer;
}

.ninety-note{
    display:none;

    margin-top:20px;
    padding:20px;

    border-left:3px solid var(--gold);
    background:var(--burgundy);

    color:var(--muted);
}

.ninety-note.show{
    display:block;
}


