<!-- =========================================================
     PROJECT MODAL
========================================================= -->

<div class="modal" id="projectModal">

    <div class="modal-box">

        <button class="modal-close" id="modalClose">
            ×
        </button>

        <div class="modal-label" id="modalType">
            PROJECT
        </div>

        <h2 id="modalTitle">
            Project
        </h2>

        <p id="modalDescription">
        </p>

        <div class="modal-proof">

            <strong>
                EVIDENCE TO PRODUCE
            </strong>

            <p id="modalProof">
            </p>

        </div>

    </div>

</div>



<!-- =========================================================
     TOAST
========================================================= -->

<div class="toast" id="toast">
    Saved
</div>



<script>

/* =========================================================
   MOBILE NAVIGATION
========================================================= */

const mobileMenu = document.getElementById("mobileMenu");
const navLinks = document.getElementById("navLinks");

mobileMenu.addEventListener("click", function(){

    navLinks.classList.toggle("mobile-open");

});

navLinks.querySelectorAll("a").forEach(function(link){

    link.addEventListener("click", function(){

        navLinks.classList.remove("mobile-open");

    });

});


/* =========================================================
   ROADMAP ACCORDIONS
========================================================= */

document.querySelectorAll(".roadmap-head").forEach(function(button){

    button.addEventListener("click", function(){

        const card = button.closest(".roadmap-card");
        const body = card.querySelector(".roadmap-body");

        document.querySelectorAll(".roadmap-card").forEach(function(other){

            if(other !== card){

                other.classList.remove("open");

                other.querySelector(".roadmap-body").style.maxHeight = null;

            }

        });

        card.classList.toggle("open");

        if(card.classList.contains("open")){

            body.style.maxHeight = body.scrollHeight + "px";

        }else{

            body.style.maxHeight = null;

        }

    });

});


/* =========================================================
   ROADMAP CHECKBOX PERSISTENCE
========================================================= */

const roadmapChecks =
document.querySelectorAll(".task-list input[type='checkbox']");

function updateRoadmap(){

    const total = roadmapChecks.length;

    let completed = 0;

    roadmapChecks.forEach(function(check,index){

        const saved =
        localStorage.getItem("techLaunchTask" + index);

        if(saved === "true"){

            check.checked = true;

        }

        const item = check.closest("li");

        if(check.checked){

            completed++;

            item.classList.add("complete");

        }else{

            item.classList.remove("complete");

        }

    });


    const percent =
    total === 0
    ? 0
    : Math.round((completed / total) * 100);


    document.getElementById("progressFill").style.width =
    percent + "%";

    document.getElementById("progressPercent").textContent =
    percent + "%";


    document.querySelectorAll(".roadmap-card").forEach(function(card){

        const checks =
        card.querySelectorAll(".task-list input");

        let done = 0;

        checks.forEach(function(check){

            if(check.checked){
                done++;
            }

        });

        const output =
        card.querySelector(".stage-completion span");

        if(output){

            output.textContent =
            done + " / " + checks.length;

        }

    });

}


roadmapChecks.forEach(function(check,index){

    check.addEventListener("change", function(){

        localStorage.setItem(
            "techLaunchTask" + index,
            check.checked
        );

        updateRoadmap();

        showToast(
            check.checked
            ? "Task completed and saved."
            : "Task reopened."
        );

    });

});

updateRoadmap();


/* =========================================================
   PROJECT FILTERS
========================================================= */

const filterButtons =
document.querySelectorAll(".filter-btn");

const projectCards =
document.querySelectorAll(".project-card");

filterButtons.forEach(function(button){

    button.addEventListener("click", function(){

        filterButtons.forEach(function(item){
            item.classList.remove("active");
        });

        button.classList.add("active");

        const filter = button.dataset.filter;

        projectCards.forEach(function(card){

            if(
                filter === "all" ||
                card.dataset.category === filter
            ){

                card.classList.remove("hidden");

            }else{

                card.classList.add("hidden");

            }

        });

    });

});


/* =========================================================
   PROJECT MODAL
========================================================= */

const projectModal =
document.getElementById("projectModal");

const modalClose =
document.getElementById("modalClose");

document.querySelectorAll(".project-open").forEach(function(button){

    button.addEventListener("click", function(){

        document.getElementById("modalTitle").textContent =
        button.dataset.title;

        document.getElementById("modalType").textContent =
        button.dataset.type;

        document.getElementById("modalDescription").textContent =
        button.dataset.description;

        document.getElementById("modalProof").textContent =
        button.dataset.proof;

        projectModal.classList.add("show");

    });

});


modalClose.addEventListener("click", function(){

    projectModal.classList.remove("show");

});


projectModal.addEventListener("click", function(event){

    if(event.target === projectModal){

        projectModal.classList.remove("show");

    }

});


document.addEventListener("keydown", function(event){

    if(event.key === "Escape"){

        projectModal.classList.remove("show");

    }

});


/* =========================================================
   CERTIFICATIONS
========================================================= */

document.querySelectorAll(".cert-card").forEach(function(card){

    card.addEventListener("click", function(){

        card.classList.toggle("active");

    });

});


/* =========================================================
   PROFESSIONAL PRINCIPLES
========================================================= */

document.querySelectorAll(".principle button").forEach(function(button){

    button.addEventListener("click", function(){

        const principle =
        button.closest(".principle");

        const body =
        principle.querySelector(".principle-body");

        document.querySelectorAll(".principle").forEach(function(other){

            if(other !== principle){

                other.classList.remove("open");

                other.querySelector(
                    ".principle-body"
                ).style.maxHeight = null;

            }

        });

        principle.classList.toggle("open");

        if(principle.classList.contains("open")){

            body.style.maxHeight =
            body.scrollHeight + "px";

        }else{

            body.style.maxHeight = null;

        }

    });

});


/* =========================================================
   DAILY SYSTEM
========================================================= */

const dailyOptions =
document.querySelectorAll(".daily-option");

const dailySummary =
document.getElementById("dailySummary");

const dailySummaryText =
document.getElementById("dailySummaryText");


function updateDailyPlan(){

    const selected = [];

    let minutes = 0;

    dailyOptions.forEach(function(option){

        if(option.classList.contains("selected")){

            const title =
            option.querySelector("h3").textContent;

            const time =
            parseInt(
                option.querySelector(".daily-time")
                .textContent
            );

            selected.push(title);

            minutes += time;

        }

    });


    if(selected.length === 0){

        dailySummary.classList.remove("show");

        return;

    }


    dailySummary.classList.add("show");

    dailySummaryText.innerHTML =
    selected.join(" + ") +
    " — <strong>" +
    minutes +
    " minutes selected.</strong>";

}


dailyOptions.forEach(function(option){

    option.addEventListener("click", function(){

        option.classList.toggle("selected");

        const check =
        option.querySelector(".daily-check");

        check.textContent =
        option.classList.contains("selected")
        ? "✓"
        : "+";

        updateDailyPlan();

    });

});


/* =========================================================
   INTERVIEW ACCORDIONS
========================================================= */

document.querySelectorAll(".interview-trigger").forEach(function(button){

    button.addEventListener("click", function(){

        const card =
        button.closest(".interview-card");

        document.querySelectorAll(".interview-card").forEach(function(other){

            if(other !== card){

                other.classList.remove("open");

            }

        });

        card.classList.toggle("open");

    });

});


/* =========================================================
   JOB FILTER
========================================================= */

const jobFilters =
document.querySelectorAll(".job-filter");

const jobCards =
document.querySelectorAll(".job-target");


jobFilters.forEach(function(button){

    button.addEventListener("click", function(){

        jobFilters.forEach(function(item){

            item.classList.remove("active");

        });

        button.classList.add("active");

        const filter =
        button.dataset.job;

        jobCards.forEach(function(card){

            if(
                filter === "all" ||
                card.dataset.jobType === filter
            ){

                card.style.display = "";

            }else{

                card.style.display = "none";

            }

        });

    });

});


/* =========================================================
   JOB CARD DETAILS
========================================================= */

jobCards.forEach(function(card){

    card.addEventListener("click", function(){

        card.classList.toggle("selected");

    });

});


/* =========================================================
   90 DAY TABS
========================================================= */

const ninetyTabs =
document.querySelectorAll(".ninety-tab");

const ninetyPanels =
document.querySelectorAll(".ninety-panel");


ninetyTabs.forEach(function(tab){

    tab.addEventListener("click", function(){

        ninetyTabs.forEach(function(item){

            item.classList.remove("active");

        });

        ninetyPanels.forEach(function(panel){

            panel.classList.remove("active");

        });

        tab.classList.add("active");

        document.getElementById(
            tab.dataset.month
        ).classList.add("active");

    });

});


/* =========================================================
   90 DAY ACTIONS
========================================================= */

document.querySelectorAll(".ninety-action").forEach(function(button){

    button.addEventListener("click", function(){

        const note =
        button.nextElementSibling;

        note.classList.toggle("show");

        button.textContent =
        note.classList.contains("show")
        ? "Phase Reviewed ✓"
        : "Mark Phase Reviewed";

    });

});


/* =========================================================
   TOAST
========================================================= */

let toastTimer;

function showToast(message){

    const toast =
    document.getElementById("toast");

    toast.textContent = message;

    toast.classList.add("show");

    clearTimeout(toastTimer);

    toastTimer = setTimeout(function(){

        toast.classList.remove("show");

    },2200);

}

</script>

</body>
</html>
