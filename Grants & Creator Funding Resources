<script>
/* =========================================
   STORAGE AND GENERAL HELPERS
========================================= */

const STORAGE_KEY = "pathkeeper_grant_opportunities_v1";

function getOpportunities(){
  try{
    const stored = localStorage.getItem(STORAGE_KEY);
    return stored ? JSON.parse(stored) : [];
  }catch(error){
    return [];
  }
}

function saveOpportunities(items){
  try{
    localStorage.setItem(STORAGE_KEY,JSON.stringify(items));
    return true;
  }catch(error){
    alert("Your browser could not save this record. Check browser storage settings.");
    return false;
  }
}

function money(value){
  return new Intl.NumberFormat("en-US",{
    style:"currency",
    currency:"USD",
    maximumFractionDigits:0
  }).format(Number(value)||0);
}

function safeText(value){
  return String(value || "").trim();
}

function makeId(){
  return "grant-" + Date.now() + "-" + Math.floor(Math.random()*100000);
}

function downloadFile(content,filename,type){
  const blob = new Blob([content],{type:type+";charset=utf-8"});
  const url = URL.createObjectURL(blob);
  const link = document.createElement("a");

  link.href = url;
  link.download = filename;
  document.body.appendChild(link);
  link.click();
  link.remove();

  setTimeout(()=>URL.revokeObjectURL(url),1000);
}

async function copyText(text,message){
  try{
    if(navigator.clipboard && window.isSecureContext){
      await navigator.clipboard.writeText(text);
    }else{
      const area = document.createElement("textarea");
      area.value = text;
      area.style.position = "fixed";
      area.style.opacity = "0";
      document.body.appendChild(area);
      area.select();

      const success = document.execCommand("copy");
      area.remove();

      if(!success) throw new Error("Copy unavailable");
    }

    const messageElement = document.getElementById("proposalMessage");

    if(messageElement){
      messageElement.textContent = message;
    }else{
      alert(message);
    }

  }catch(error){
    alert("Copying was blocked by the browser. Select the text and copy it manually.");
  }
}

/* =========================================
   OPPORTUNITY TRACKER AND RECEIPTS
========================================= */

function addOpportunity(){
  const name = safeText(document.getElementById("grantName").value);

  if(!name){
    alert("Enter a grant or funding opportunity name first.");
    return;
  }

  const linkValue = safeText(document.getElementById("grantLink").value);

  if(linkValue){
    try{
      const parsed = new URL(linkValue);
      if(!["http:","https:"].includes(parsed.protocol)){
        alert("Enter a valid website address beginning with http:// or https://");
        return;
      }
    }catch(error){
      alert("Enter a valid official grant website address.");
      return;
    }
  }

  const opportunity = {
    id:makeId(),
    name:name,
    funder:safeText(document.getElementById("grantFunder").value),
    category:safeText(document.getElementById("grantCategory").value),
    amount:Number(document.getElementById("grantAmountInput").value)||0,
    deadline:document.getElementById("grantDeadline").value,
    status:document.getElementById("grantStatus").value,
    eligibility:document.getElementById("grantEligibility").value,
    link:linkValue,
    purpose:safeText(document.getElementById("grantPurpose").value),
    requirements:safeText(document.getElementById("grantRequirements").value),
    dateAdded:new Date().toLocaleDateString()
  };

  const items = getOpportunities();
  items.push(opportunity);

  if(!saveOpportunities(items)) return;

  showReceipt(opportunity);
  renderOpportunities();
  updateCompareOptions();

  [
    "grantName",
    "grantFunder",
    "grantCategory",
    "grantAmountInput",
    "grantDeadline",
    "grantLink",
    "grantPurpose",
    "grantRequirements"
  ].forEach(id=>{
    document.getElementById(id).value = "";
  });

  document.getElementById("grantStatus").value = "Researching";
  document.getElementById("grantEligibility").value = "Not yet verified";
}

function showReceipt(item){
  const result = document.getElementById("receiptResult");
  result.style.display = "block";

  const receipt = document.createElement("div");
  receipt.className = "receipt";

  const title = document.createElement("div");
  title.className = "receipt-title";
  title.textContent = "PATHKEEPER OPPORTUNITY RECEIPT";
  receipt.appendChild(title);

  const fields = [
    ["Record",item.name],
    ["Funder",item.funder || "Not entered"],
    ["Category",item.category || "Not entered"],
    ["Potential award",money(item.amount)],
    ["Deadline",item.deadline || "Not entered"],
    ["Status",item.status],
    ["Eligibility",item.eligibility],
    ["Recorded",item.dateAdded],
    ["Record ID",item.id]
  ];

  fields.forEach(([label,value])=>{
    const p = document.createElement("p");
    const strong = document.createElement("strong");
    strong.textContent = label + ": ";
    p.appendChild(strong);
    p.appendChild(document.createTextNode(value));
    receipt.appendChild(p);
  });

  const reminder = document.createElement("p");
  reminder.style.marginTop = "10px";
  reminder.textContent = "Reminder: This is your personal research record, not a grantmaker confirmation.";
  receipt.appendChild(reminder);

  const actions = document.createElement("div");
  actions.className = "button-row";

  const copyButton = document.createElement("button");
  copyButton.className = "btn light-btn";
  copyButton.type = "button";
  copyButton.textContent = "Copy Receipt";
  copyButton.addEventListener("click",()=>copyReceipt(item.id));

  actions.appendChild(copyButton);
  receipt.appendChild(actions);

  result.replaceChildren(receipt);
  result.scrollIntoView({behavior:"smooth",block:"nearest"});
}

function receiptText(item){
  return [
    "PATHKEEPER OPPORTUNITY RECEIPT",
    "Opportunity: "+item.name,
    "Funder: "+item.funder,
    "Category: "+item.category,
    "Potential Award: "+money(item.amount),
    "Deadline: "+item.deadline,
    "Status: "+item.status,
    "Eligibility: "+item.eligibility,
    "Official Link: "+item.link,
    "Purpose: "+item.purpose,
    "Requirements: "+item.requirements,
    "Recorded: "+item.dateAdded,
    "Record ID: "+item.id,
    "This is a personal research record, not a grantmaker confirmation."
  ].join("\n");
}

function copyReceipt(id){
  const item = getOpportunities().find(entry=>entry.id===id);
  if(item) copyText(receiptText(item),"Receipt copied.");
}

function renderOpportunities(){
  const container = document.getElementById("opportunityList");
  const items = getOpportunities();

  container.replaceChildren();

  if(!items.length){
    const empty = document.createElement("div");
    empty.className = "empty";
    empty.textContent = "No opportunities have been added yet. Use the intake form to create your first record.";
    container.appendChild(empty);
    return;
  }

  items.forEach(item=>{
    const article = document.createElement("article");
    article.className = "opportunity";

    const top = document.createElement("div");
    top.className = "opportunity-top";

    const details = document.createElement("div");
    const heading = document.createElement("h3");
    heading.textContent = item.name;

    const funder = document.createElement("p");
    funder.textContent =
      (item.funder || "Funder not entered") +
      " · " +
      (item.category || "Category not entered");

    details.append(heading,funder);

    const tag = document.createElement("span");
    tag.className = "tag";
    tag.textContent = item.status;

    top.append(details,tag);
    article.appendChild(top);

    const amount = document.createElement("p");
    amount.textContent =
      "Potential award: " + money(item.amount) +
      " | Deadline: " + (item.deadline || "Not entered");

    const eligibility = document.createElement("p");
    eligibility.textContent = "Eligibility: " + item.eligibility;

    article.append(amount,eligibility);

    const actions = document.createElement("div");
    actions.className = "opportunity-actions";

    if(item.link){
      addActionButton(actions,"Open Official Link","light-btn",()=>openGrantLink(item.id));
    }

    addActionButton(actions,"View Receipt","outline",()=>showReceipt(item));
    addActionButton(actions,"Update Status","outline",()=>editOpportunity(item.id));
    addActionButton(actions,"Remove Record","outline",()=>removeOpportunity(item.id));

    article.appendChild(actions);
    container.appendChild(article);
  });
}

function addActionButton(container,label,className,action){
  const button = document.createElement("button");
  button.type = "button";
  button.className = "btn " + className;
  button.textContent = label;
  button.addEventListener("click",action);
  container.appendChild(button);
}

function openGrantLink(id){
  const item = getOpportunities().find(entry=>entry.id===id);
  if(!item || !item.link) return;

  try{
    const url = new URL(item.link);

    if(url.protocol==="https:" || url.protocol==="http:"){
      window.open(url.href,"_blank","noopener,noreferrer");
    }else{
      alert("Please enter a valid http or https URL.");
    }
  }catch(error){
    alert("This record does not contain a valid web address.");
  }
}

function editOpportunity(id){
  const items = getOpportunities();
  const item = items.find(entry=>entry.id===id);
  if(!item) return;

  const allowed = [
    "Researching",
    "Potential Match",
    "Preparing Application",
    "Submitted",
    "Awarded",
    "Not Eligible",
    "Closed"
  ];

  const nextStatus = prompt(
    "Enter a new status:\n"+allowed.join(", "),
    item.status
  );

  if(nextStatus===null) return;

  if(!allowed.includes(nextStatus.trim())){
    alert("Use one of the listed status options.");
    return;
  }

  item.status = nextStatus.trim();

  if(saveOpportunities(items)){
    renderOpportunities();
    updateCompareOptions();
  }
}

function removeOpportunity(id){
  if(!confirm("Remove this opportunity from your saved list?")) return;

  const items = getOpportunities().filter(entry=>entry.id!==id);

  if(saveOpportunities(items)){
    renderOpportunities();
    updateCompareOptions();
  }
}

function exportOpportunities(){
  const items = getOpportunities();

  if(!items.length){
    alert("There are no saved opportunities to export.");
    return;
  }

  const rows = [[
    "Opportunity","Funder","Category","Amount","Deadline",
    "Status","Eligibility","Official Link","Purpose",
    "Requirements","Date Added"
  ]];

  items.forEach(item=>{
    rows.push([
      item.name,
      item.funder,
      item.category,
      item.amount,
      item.deadline,
      item.status,
      item.eligibility,
      item.link,
      item.purpose,
      item.requirements,
      item.dateAdded
    ]);
  });

  const csv = rows.map(row=>
    row.map(value=>
      '"'+String(value??"").replace(/"/g,'""')+'"'
    ).join(",")
  ).join("\n");

  downloadFile(csv,"pathkeeper-grant-opportunities.csv","text/csv");
}

/* =========================================
   OPPORTUNITY COMPARISON
========================================= */

function updateCompareOptions(){
  const items = getOpportunities();

  ["compareOne","compareTwo"].forEach(id=>{
    const select = document.getElementById(id);
    const previous = select.value;

    select.replaceChildren();

    const placeholder = document.createElement("option");
    placeholder.value = "";
    placeholder.textContent = "Select an opportunity";
    select.appendChild(placeholder);

    items.forEach(item=>{
      const option = document.createElement("option");
      option.value = item.id;
      option.textContent = item.name;
      select.appendChild(option);
    });

    if(items.some(item=>item.id===previous)){
      select.value = previous;
    }
  });
}

function compareOpportunities(){
  const items = getOpportunities();

  const one = items.find(item=>
    item.id===document.getElementById("compareOne").value
  );

  const two = items.find(item=>
    item.id===document.getElementById("compareTwo").value
  );

  const output = document.getElementById("comparisonResult");
  output.replaceChildren();

  if(!one || !two){
    const message = document.createElement("div");
    message.className = "empty";
    message.textContent = "Choose two saved opportunities to compare.";
    output.appendChild(message);
    return;
  }

  if(one.id===two.id){
    const message = document.createElement("div");
    message.className = "empty";
    message.textContent = "Choose two different opportunities.";
    output.appendChild(message);
    return;
  }

  const fields = [
    ["Funder","funder"],
    ["Category","category"],
    ["Potential Award","amount"],
    ["Deadline","deadline"],
    ["Status","status"],
    ["Eligibility","eligibility"],
    ["Permitted Purpose","purpose"],
    ["Requirements","requirements"]
  ];

  const wrap = document.createElement("div");
  wrap.className = "compare-wrap";

  const table = document.createElement("table");
  const thead = document.createElement("thead");
  const header = document.createElement("tr");

  ["Comparison Factor",one.name,two.name].forEach(value=>{
    const th = document.createElement("th");
    th.textContent = value;
    header.appendChild(th);
  });

  thead.appendChild(header);

  const tbody = document.createElement("tbody");

  fields.forEach(([label,key])=>{
    const row = document.createElement("tr");

    const first = document.createElement("td");
    first.textContent = label;
    row.appendChild(first);

    [one,two].forEach(item=>{
      const cell = document.createElement("td");
      cell.textContent = key==="amount"
        ? money(item[key])
        : (item[key] || "Not recorded");
      row.appendChild(cell);
    });

    tbody.appendChild(row);
  });

  table.append(thead,tbody);
  wrap.appendChild(table);
  output.appendChild(wrap);

  const reminder = document.createElement("div");
  reminder.className = "callout";
  reminder.innerHTML =
    "<strong>Decision reminder:</strong> Confirm eligibility, funding restrictions, deadline, and application workload. This comparison displays your saved information; it does not independently verify either opportunity.";

  output.appendChild(reminder);
}

/* =========================================
   READINESS CHECKLIST
========================================= */

function updateChecklist(){
  const checks = [
    ...document.querySelectorAll("#readinessChecklist input[type=checkbox]")
  ];

  const completed = checks.filter(check=>check.checked).length;
  const total = checks.length;
  const percent = total ? (completed/total)*100 : 0;

  document.getElementById("checkProgress").textContent =
    `${completed} of ${total} complete`;

  document.getElementById("checkProgressFill").style.width =
    percent + "%";
}

/* =========================================
   FUNDING ALLOCATION CALCULATOR
========================================= */

const budgetItems = [
  {id:"percentLearning",value:"valueLearning"},
  {id:"percentTechnology",value:"valueTechnology"},
  {id:"percentProject",value:"valueProject"},
  {id:"percentSupport",value:"valueSupport"},
  {id:"percentOther",value:"valueOther"}
];

function calculateBudget(){
  const amount = Math.max(
    0,
    Number(document.getElementById("budgetAmount").value)||0
  );

  let total = 0;

  budgetItems.forEach(item=>{
    const percent = Math.max(
      0,
      Number(document.getElementById(item.id).value)||0
    );

    total += percent;

    document.getElementById(item.value).textContent =
      money(amount*percent/100);
  });

  document.getElementById("allocationTotal").textContent =
    "Total allocation: "+total+"%";

  const status = document.getElementById("budgetStatus");

  if(total===100){
    status.textContent = "Your allocation currently totals 100%.";
    status.style.color = "var(--green)";
  }else if(total<100){
    status.textContent =
      "Your allocation is "+(100-total)+"% below the full budget.";
    status.style.color = "var(--brown2)";
  }else{
    status.textContent =
      "Your allocation exceeds 100% by "+(total-100)+"%. Adjust the percentages.";
    status.style.color = "#A33B32";
  }
}

function getBudgetSummary(){
  const amount = Math.max(
    0,
    Number(document.getElementById("budgetAmount").value)||0
  );

  const names = [
    ["Education / Training","percentLearning"],
    ["Technology / Equipment","percentTechnology"],
    ["Project Materials","percentProject"],
    ["Support Services","percentSupport"],
    ["Other Approved Costs","percentOther"]
  ];

  return names.map(([name,id])=>{
    const percent = Math.max(
      0,
      Number(document.getElementById(id).value)||0
    );

    return `${name}: ${percent}% — ${money(amount*percent/100)}`;
  }).join("\n");
}

/* =========================================
   PROPOSAL BUILDER
========================================= */

function buildProposal(){
  const applicant = safeText(document.getElementById("applicant").value);
  const program = safeText(document.getElementById("programName").value);
  const project = safeText(document.getElementById("projectTitle").value);

  const fields = [
    ["Need or Barrier","needStatement"],
    ["Goal and Intended Result","goalStatement"],
    ["Activities and Use of Funds","activityStatement"],
    ["Expected Outcomes","outcomeStatement"],
    ["Readiness and Supporting Evidence","evidenceStatement"],
    ["Continuity and Next Steps","continuityStatement"],
    ["Grant-Specific Requirements","extraNotes"]
  ];

  const sections = fields.map(([title,id])=>{
    const value = safeText(document.getElementById(id).value);
    return `${title}\n${value || "[Add information for this section]"}`;
  }).join("\n\n");

  const amount = Number(document.getElementById("budgetAmount").value)||0;

  const budgetTotal = budgetItems.reduce((sum,item)=>{
    return sum + (
      Number(document.getElementById(item.id).value)||0
    );
  },0);

  const text = [
    "PATHKEEPER — GRANTS & CREATOR FUNDING RESOURCES",
    "",
    "Applicant: "+(applicant || "[Applicant name]"),
    "Grant Program: "+(program || "[Grant program]"),
    "Project / Education Goal: "+(project || "[Project goal]"),
    "Funding Amount Requested: "+money(amount),
    "",
    "PROPOSED BUDGET",
    getBudgetSummary(),
    "Total allocation: "+budgetTotal+"%",
    "",
    sections,
    "",
    "FINAL REVIEW REMINDERS",
    "- Verify all eligibility requirements against the official grant instructions.",
    "- Confirm every requested expense is permitted by the funder.",
    "- Replace placeholders and adapt responses to the actual application questions.",
    "- Check all amounts, supporting documents, word limits, and submission requirements.",
    "- Save the final submitted application and confirmation receipt.",
    "",
    "This is a working draft, not a submitted application or a guarantee of funding."
  ].join("\n");

  document.getElementById("proposalPreview").textContent = text;

  document.getElementById("proposalMessage").textContent =
    "Draft generated. Review and customize it before submission.";
}

function clearProposal(){
  const ids = [
    "applicant",
    "programName",
    "projectTitle",
    "needStatement",
    "goalStatement",
    "activityStatement",
    "outcomeStatement",
    "evidenceStatement",
    "continuityStatement",
    "extraNotes"
  ];

  ids.forEach(id=>{
    document.getElementById(id).value = "";
  });

  document.getElementById("proposalPreview").textContent =
    "Your application draft will appear here after you select “Generate Application Draft.”";

  document.getElementById("proposalMessage").textContent =
    "Answers cleared.";
}

function copyProposal(){
  const text = document.getElementById("proposalPreview").textContent;

  if(text.startsWith("Your application draft")){
    alert("Generate the application draft first.");
    return;
  }

  copyText(text,"Application draft copied.");
}

function downloadProposal(){
  const text = document.getElementById("proposalPreview").textContent;

  if(text.startsWith("Your application draft")){
    alert("Generate the application draft first.");
    return;
  }

  downloadFile(
    text,
    "pathkeeper-grant-application-draft.txt",
    "text/plain"
  );

  document.getElementById("proposalMessage").textContent =
    "Text file prepared for saving.";
}

/* =========================================
   FAQ
========================================= */

function toggleFAQ(button){
  const item = button.closest(".faq-item");
  const wasOpen = item.classList.contains("open");

  document.querySelectorAll(".faq-item").forEach(entry=>{
    entry.classList.remove("open");
    entry.querySelector(".faq-question span").textContent = "+";
  });

  if(!wasOpen){
    item.classList.add("open");
    item.querySelector(".faq-question span").textContent = "−";
  }
}

/* =========================================
   INITIALIZE PAGE
========================================= */

renderOpportunities();
updateCompareOptions();
updateChecklist();
calculateBudget();

</script>
