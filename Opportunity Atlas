<script>

/* =========================================================
   DECISION ENGINE
========================================================= */

function showResult(type){

const result=document.getElementById("result");

const messages={

speed:`
<strong>Optimize for speed.</strong><br>
Prioritize short training programs, entry-level employment,
apprenticeships, paid training, and opportunities with simple
application processes. Avoid spending months collecting credentials
before testing whether the career actually fits you.
`,

money:`
<strong>Optimize for low cost.</strong><br>
Look for scholarships, grants, free training, employer-paid training,
public programs, apprenticeships, community resources, and free
portfolio-building opportunities before paying for expensive programs.
`,

experience:`
<strong>Optimize for evidence.</strong><br>
Look for apprenticeships, internships, volunteer technical work,
freelancing, personal projects, competitions, simulations, and
projects where another person can evaluate your work.
`,

credential:`
<strong>Optimize for recognized signals.</strong><br>
Identify the actual credential requested by employers in your target
role. Then choose the least expensive credible path toward it.
`,

remote:`
<strong>Optimize for geographic flexibility.</strong><br>
Focus on skills that can be delivered digitally: software,
technical support, cybersecurity, cloud, data, design, digital
marketing, writing, and other remote-capable work.
`,

income:`
<strong>Optimize for earning power.</strong><br>
Don't only ask which job pays more today. Compare the skill ceiling,
experience gained, advancement opportunities, portability of the
skill, and demand for the occupation.
`

};

result.innerHTML=messages[type];
result.classList.add("active");

}


/* =========================================================
   SEARCH ASSISTANT
========================================================= */

function searchOpportunity(event){

event.preventDefault();

const input=document
.getElementById("searchInput")
.value
.trim();

const result=document
.getElementById("searchResult");

if(!input){

result.innerHTML=
"<strong>Start with a search term.</strong><br>Try a career, constraint, location, funding type, or skill.";

result.classList.add("active");

return;

}

result.innerHTML=`
<strong>Opportunity search created.</strong><br>
Your search: <strong>${escapeHTML(input)}</strong><br><br>

Now search that phrase across several categories:
jobs, apprenticeships, scholarships, grants, certifications,
training programs, competitions, relocation programs, and
professional communities.

The goal is not to find one result. The goal is to discover
multiple routes toward the same outcome.
`;

result.classList.add("active");

}


/* =========================================================
   BASIC HTML ESCAPING
========================================================= */

function escapeHTML(value){

return value
.replace(/&/g,"&amp;")
.replace(/</g,"&lt;")
.replace(/>/g,"&gt;")
.replace(/"/g,"&quot;")
.replace(/'/g,"&#039;");

}

</script>

