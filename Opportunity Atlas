<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>PathKeeper | Opportunity Atlas</title>

<style>
:root{
--ink:#17251f;
--ink2:#24352e;
--cream:#f6f1e7;
--paper:#fffdf8;
--sand:#e8dcc7;
--sage:#667b68;
--green:#315844;
--gold:#b58a45;
--line:#d8cfbf;
--muted:#69746d;
--white:#ffffff;
--shadow:0 18px 50px rgba(35,45,38,.10);
}

*{
box-sizing:border-box;
margin:0;
padding:0;
}

html{
scroll-behavior:smooth;
}

body{
font-family:Arial,Helvetica,sans-serif;
background:var(--cream);
color:var(--ink);
line-height:1.6;
}

a{
text-decoration:none;
color:inherit;
}

.container{
width:min(1180px,calc(100% - 36px));
margin:auto;
}

nav{
background:var(--ink);
color:white;
position:sticky;
top:0;
z-index:1000;
border-bottom:1px solid rgba(255,255,255,.1);
}

.nav-inner{
min-height:70px;
display:flex;
align-items:center;
justify-content:space-between;
gap:25px;
}

.logo{
font-weight:900;
letter-spacing:1px;
font-size:18px;
}

.logo span{
color:#d9b56e;
}

.nav-links{
display:flex;
gap:22px;
font-size:13px;
font-weight:700;
}

.nav-links a{
opacity:.8;
transition:.2s;
}

.nav-links a:hover{
opacity:1;
color:#e7c77f;
}

/* HERO */

.hero{
background:
linear-gradient(135deg,rgba(23,37,31,.98),rgba(35,53,46,.96));
color:white;
position:relative;
overflow:hidden;
padding:105px 0 85px;
}

.hero:before{
content:"";
position:absolute;
width:480px;
height:480px;
border:1px solid rgba(255,255,255,.08);
border-radius:50%;
right:-180px;
top:-200px;
}

.hero:after{
content:"";
position:absolute;
width:300px;
height:300px;
border:1px solid rgba(255,255,255,.06);
border-radius:50%;
right:-80px;
top:-110px;
}

.hero-grid{
display:grid;
grid-template-columns:1.15fr .85fr;
gap:65px;
align-items:center;
position:relative;
z-index:2;
}

.kicker{
display:inline-block;
font-size:11px;
font-weight:900;
letter-spacing:2px;
text-transform:uppercase;
color:#e2c17c;
margin-bottom:20px;
}

.hero h1{
font-size:clamp(48px,7vw,88px);
line-height:.98;
letter-spacing:-3px;
max-width:850px;
margin-bottom:25px;
}

.hero h1 span{
color:#dfbc72;
}

.hero p{
font-size:19px;
color:#d3ddd6;
max-width:700px;
margin-bottom:32px;
}

.hero-buttons{
display:flex;
gap:12px;
flex-wrap:wrap;
}

.button{
padding:14px 21px;
border-radius:7px;
font-weight:800;
font-size:13px;
display:inline-block;
}

.button.primary{
background:#d7b46b;
color:var(--ink);
}

.button.secondary{
border:1px solid rgba(255,255,255,.25);
color:white;
}

.hero-panel{
background:#f8f3e9;
color:var(--ink);
padding:28px;
border-radius:14px;
box-shadow:var(--shadow);
}

.hero-panel-title{
font-size:12px;
font-weight:900;
letter-spacing:1.5px;
text-transform:uppercase;
color:var(--sage);
margin-bottom:18px;
}

.path-line{
display:flex;
align-items:center;
gap:10px;
padding:12px 0;
border-bottom:1px solid #ded6c9;
font-weight:800;
font-size:14px;
}

.path-line:last-child{
border-bottom:0;
}

.path-number{
width:27px;
height:27px;
border-radius:50%;
display:grid;
place-items:center;
background:var(--green);
color:white;
font-size:11px;
}

/* SECTION */

section{
padding:95px 0;
}

.section-header{
max-width:750px;
margin-bottom:45px;
}

.section-label{
font-size:11px;
font-weight:900;
letter-spacing:2px;
color:var(--gold);
text-transform:uppercase;
margin-bottom:12px;
}

.section-header h2{
font-size:clamp(35px,5vw,58px);
line-height:1.05;
letter-spacing:-2px;
margin-bottom:16px;
}

.section-header p{
color:var(--muted);
font-size:17px;
}

/* SECTION 1 */

.navigator{
background:var(--paper);
}

.navigator-grid{
display:grid;
grid-template-columns:1fr 1fr 1fr;
gap:18px;
}

.navigator-card{
border:1px solid var(--line);
padding:27px;
background:white;
transition:.25s;
}

.navigator-card:hover{
transform:translateY(-5px);
box-shadow:var(--shadow);
}

.card-icon{
font-size:25px;
margin-bottom:18px;
}

.navigator-card h3{
font-size:21px;
margin-bottom:8px;
}

.navigator-card p{
font-size:14px;
color:var(--muted);
margin-bottom:18px;
}

.question{
font-weight:800;
font-size:12px;
color:var(--green);
text-transform:uppercase;
letter-spacing:.7px;
}

/* SECTION 2 */

.ladder-section{
background:#e8dfcf;
}

.ladder{
display:grid;
grid-template-columns:repeat(6,1fr);
gap:0;
position:relative;
}

.ladder-step{
background:white;
padding:25px 18px;
border-right:1px solid var(--line);
min-height:240px;
position:relative;
}

.ladder-step:first-child{
border-radius:12px 0 0 12px;
}

.ladder-step:last-child{
border-radius:0 12px 12px 0;
border-right:0;
}

.ladder-number{
font-size:12px;
font-weight:900;
color:var(--gold);
letter-spacing:1px;
}

.ladder-step h3{
font-size:17px;
line-height:1.15;
margin:18px 0 10px;
}

.ladder-step p{
font-size:12px;
color:var(--muted);
}

.ladder-arrow{
font-size:22px;
position:absolute;
right:-10px;
top:50%;
transform:translateY(-50%);
z-index:3;
width:20px;
height:20px;
border-radius:50%;
background:var(--green);
color:white;
display:grid;
place-items:center;
font-size:12px;
}

/* OPPORTUNITY MAP */

.map-section{
background:var(--ink);
color:white;
}

.map-section .section-header p{
color:#bfcac2;
}

.map-grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:16px;
}

.map-card{
padding:27px;
background:#22372d;
border:1px solid rgba(255,255,255,.08);
border-radius:12px;
}

.map-card h3{
font-size:22px;
margin-bottom:10px;
}

.map-card p{
color:#c3cec6;
font-size:13px;
margin-bottom:18px;
}

.map-links{
display:flex;
flex-wrap:wrap;
gap:7px;
}

.map-links span{
padding:6px 9px;
background:rgba(255,255,255,.07);
border-radius:4px;
font-size:10px;
color:#dfe7e1;
}

/* DECISION TOOL */

.decision{
background:var(--paper);
}

.decision-box{
background:white;
border:1px solid var(--line);
border-radius:14px;
padding:35px;
box-shadow:var(--shadow);
}

.decision-title{
font-size:25px;
margin-bottom:25px;
}

.choice-grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:12px;
}

.choice{
border:1px solid var(--line);
padding:18px;
cursor:pointer;
background:#fcfaf5;
transition:.2s;
}

.choice:hover{
border-color:var(--gold);
background:#f8f0df;
}

.choice strong{
display:block;
font-size:14px;
margin-bottom:5px;
}

.choice small{
font-size:11px;
color:var(--muted);
}

.result{
margin-top:25px;
padding:22px;
background:#edf2ed;
border-left:4px solid var(--green);
display:none;
}

.result.active{
display:block;
}

/* OPPORTUNITY TYPES */

.opportunities{
background:#f1ebdf;
}

.opportunity-grid{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:15px;
}

.opportunity-card{
background:white;
border:1px solid var(--line);
padding:24px;
min-height:220px;
}

.opportunity-card h3{
font-size:18px;
margin:15px 0 8px;
}

.opportunity-card p{
font-size:12px;
color:var(--muted);
}

.tag{
font-size:9px;
font-weight:900;
letter-spacing:1px;
color:var(--gold);
}

/* EVIDENCE */

.evidence{
background:var(--paper);
}

.evidence-grid{
display:grid;
grid-template-columns:1fr 1fr;
gap:20px;
}

.evidence-card{
border:1px solid var(--line);
padding:28px;
background:white;
}

.evidence-card h3{
margin-bottom:14px;
font-size:20px;
}

.evidence-card ul{
list-style:none;
}

.evidence-card li{
font-size:13px;
padding:9px 0;
border-bottom:1px solid #eee7dc;
}

.evidence-card li:before{
content:"✓";
font-weight:900;
color:var(--green);
margin-right:8px;
}

/* SEARCH SYSTEM */

.search-section{
background:#dcd1bf;
}

.search-box{
background:var(--ink);
padding:35px;
border-radius:14px;
color:white;
}

.search-box h2{
font-size:30px;
margin-bottom:10px;
}

.search-box p{
color:#c6d0ca;
margin-bottom:25px;
}

.search-form{
display:flex;
gap:10px;
}

.search-form input{
flex:1;
padding:15px;
border:0;
border-radius:6px;
font-size:14px;
}

.search-form button{
padding:15px 22px;
border:0;
border-radius:6px;
background:#d6b36b;
font-weight:900;
cursor:pointer;
}

/* WEEKLY */

.weekly{
background:var(--paper);
}

.week-grid{
display:grid;
grid-template-columns:repeat(5,1fr);
gap:12px;
}

.week-card{
padding:22px;
background:#f4efe6;
border:1px solid var(--line);
}

.week-card strong{
display:block;
color:var(--gold);
font-size:11px;
letter-spacing:1px;
margin-bottom:10px;
}

.week-card h3{
font-size:17px;
margin-bottom:8px;
}

.week-card p{
font-size:12px;
color:var(--muted);
}

/* RULE */

.rule-section{
background:var(--green);
color:white;
padding:85px 0;
}

.rule{
max-width:850px;
margin:auto;
text-align:center;
}

.rule h2{
font-size:clamp(36px,6vw,70px);
line-height:1;
letter-spacing:-2px;
margin-bottom:22px;
}

.rule p{
color:#dbe7de;
font-size:17px;
}

.rule-line{
margin-top:30px;
font-weight:900;
letter-spacing:1px;
font-size:14px;
}

/* FOOTER */

footer{
background:#101b16;
color:white;
padding:45px 0;
}

.footer-inner{
display:flex;
justify-content:space-between;
gap:30px;
align-items:center;
}

.footer-inner p{
font-size:12px;
color:#9eaaa2;
}

.footer-mark{
font-size:12px;
font-weight:900;
letter-spacing:1px;
color:#d7b66f;
}

/* RESPONSIVE */

@media(max-width:1000px){

.hero-grid{
grid-template-columns:1fr;
}

.ladder{
grid-template-columns:repeat(3,1fr);
gap:12px;
}

.ladder-step,
.ladder-step:first-child,
.ladder-step:last-child{
border-radius:10px;
border:1px solid var(--line);
}

.ladder-arrow{
display:none;
}

.opportunity-grid{
grid-template-columns:repeat(2,1fr);
}

.week-grid{
grid-template-columns:repeat(3,1fr);
}

}

@media(max-width:750px){

.nav-links{
display:none;
}

.hero{
padding:75px 0;
}

.hero h1{
letter-spacing:-2px;
}

section{
padding:70px 0;
}

.navigator-grid,
.map-grid,
.choice-grid,
.evidence-grid{
grid-template-columns:1fr;
}

.ladder{
grid-template-columns:1fr 1fr;
}

.opportunity-grid{
grid-template-columns:1fr;
}

.week-grid{
grid-template-columns:1fr;
}

.search-form{
flex-direction:column;
}

.footer-inner{
flex-direction:column;
align-items:flex-start;
}

}

@media(max-width:480px){

.container{
width:min(100% - 26px,1180px);
}

.hero h1{
font-size:47px;
}

.hero p{
font-size:16px;
}

.ladder{
grid-template-columns:1fr;
}

.resume-paper{
padding:20px;
}

}
</style>
</head>

<body>

<!-- NAVIGATION -->

<nav>
<div class="container nav-inner">

<div class="logo">
PATH<span>KEEPER</span>
</div>

<div class="nav-links">
<a href="#navigator">START</a>
<a href="#ladder">PATHWAYS</a>
<a href="#atlas">ATLAS</a>
<a href="#decision">DECISION</a>
<a href="#evidence">EVIDENCE</a>
<a href="#search">SEARCH</a>
</div>

</div>
</nav>


<!-- HERO -->

<header class="hero">

<div class="container hero-grid">

<div>

<div class="kicker">
PathKeeper / Opportunity Atlas
</div>

<h1>
Don't wait for an opportunity.
<span>Build a path to one.</span>
</h1>

<p>
The Opportunity Atlas helps you navigate education, employment,
credentials, funding, entrepreneurship, apprenticeships, relocation,
and alternative career paths without depending on a single opportunity
to change your life.
</p>

<div class="hero-buttons">

<a href="#navigator" class="button primary">
Find Your Starting Point
</a>

<a href="#ladder" class="button secondary">
Understand the Path
</a>

</div>

</div>


<div class="hero-panel">

<div class="hero-panel-title">
The PathKeeper Method
</div>

<div class="path-line">
<div class="path-number">1</div>
Identify your current position
</div>

<div class="path-line">
<div class="path-number">2</div>
Identify the gap
</div>

<div class="path-line">
<div class="path-number">3</div>
Find multiple routes
</div>

<div class="path-line">
<div class="path-number">4</div>
Build evidence
</div>

<div class="path-line">
<div class="path-number">5</div>
Take the next opportunity
</div>

</div>

</div>

</header>


<!-- SECTION 1 -->

<section id="navigator" class="navigator">

<div class="container">

<div class="section-header">

<div class="section-label">
01 / START HERE
</div>

<h2>
Your next opportunity depends on what you need.
</h2>

<p>
Don't begin by asking "What opportunities are available?"
Begin by identifying the problem you need your next opportunity to solve.
</p>

</div>


<div class="navigator-grid">

<div class="navigator-card">

<div class="card-icon">💰</div>

<h3>I Need Income</h3>

<p>
Prioritize routes that can produce earnings quickly while building
skills that increase your future earning power.
</p>

<div class="question">
Ask: How quickly can this produce income?
</div>

</div>


<div class="navigator-card">

<div class="card-icon">🎓</div>

<h3>I Need Credentials</h3>

<p>
Look for certifications, licenses, training programs, employer
credentials, and other signals that can open a specific door.
</p>

<div class="question">
Ask: What credential does the target job actually value?
</div>

</div>


<div class="navigator-card">

<div class="card-icon">🛠️</div>

<h3>I Need Experience</h3>

<p>
Target apprenticeships, internships, volunteer projects, freelancing,
labs, simulations, and real-world projects.
</p>

<div class="question">
Ask: Where can I demonstrate the skill?
</div>

</div>


<div class="navigator-card">

<div class="card-icon">🌎</div>

<h3>I Need Location Freedom</h3>

<p>
Explore remote work, relocation programs, international opportunities,
digital careers, and mobility-focused programs.
</p>

<div class="question">
Ask: What geographic constraint am I solving?
</div>

</div>


<div class="navigator-card">

<div class="card-icon">🚀</div>

<h3>I Want to Build</h3>

<p>
Consider entrepreneurship, accelerators, grants, incubators,
maker programs, competitions, and startup communities.
</p>

<div class="question">
Ask: What can I create that has value?
</div>

</div>


<div class="navigator-card">

<div class="card-icon">🔄</div>

<h3>I Need a Reset</h3>

<p>
Don't assume your next move has to resemble your previous one.
Investigate completely different pathways.
</p>

<div class="question">
Ask: What constraints can I remove?
</div>

</div>

</div>

</div>

</section>


<!-- SECTION 2 -->

<section id="ladder" class="ladder-section">

<div class="container">

<div class="section-header">

<div class="section-label">
02 / THE OPPORTUNITY LADDER
</div>

<h2>
Turn where you are into where you want to be.
</h2>

<p>
You don't always need one giant breakthrough. Often the strongest
strategy is to deliberately move from one form of evidence to another.
</p>

</div>


<div class="ladder">

<div class="ladder-step">

<div class="ladder-number">01</div>

<h3>Starting Point</h3>

<p>
Identify your current skills, education, money, experience,
location, connections, and constraints.
</p>

<div class="ladder-arrow">→</div>

</div>


<div class="ladder-step">

<div class="ladder-number">02</div>

<h3>Evidence</h3>

<p>
Create projects, work samples, portfolios, documented results,
and demonstrations of ability.
</p>

<div class="ladder-arrow">→</div>

</div>


<div class="ladder-step">

<div class="ladder-number">03</div>

<h3>Experience</h3>

<p>
Use volunteering, apprenticeships, internships, freelancing,
projects, or entry-level work.
</p>

<div class="ladder-arrow">→</div>

</div>


<div class="ladder-step">

<div class="ladder-number">04</div>

<h3>Credential</h3>

<p>
Add certifications, licenses, training, or formal qualifications
where the market actually rewards them.
</p>

<div class="ladder-arrow">→</div>

</div>


<div class="ladder-step">

<div class="ladder-number">05</div>

<h3>Better Opportunity</h3>

<p>
Use your new evidence and experience to compete for stronger
roles, programs, funding, or education.
</p>

<div class="ladder-arrow">→</div>

</div>


<div class="ladder-step">

<div class="ladder-number">06</div>

<h3>Leverage</h3>

<p>
Repeat the process until your skills, network, income, and options
begin creating opportunities for you.
</p>

</div>

</div>

</div>

</section>


<!-- ATLAS -->

<section id="atlas" class="map-section">

<div class="container">

<div class="section-header">

<div class="section-label">
03 / THE ATLAS
</div>

<h2>
Don't search one category.
Search the entire opportunity ecosystem.
</h2>

<p>
The best route may come from a category you weren't considering.
Use the Atlas as a map rather than a list.
</p>

</div>


<div class="map-grid">

<div class="map-card">

<h3>Education</h3>

<p>
Routes for learning without assuming the traditional four-year
college pathway is the only option.
</p>

<div class="map-links">
<span>COMMUNITY COLLEGE</span>
<span>ONLINE</span>
<span>TRADE SCHOOL</span>
<span>OPEN COURSEWARE</span>
<span>BOOTCAMPS</span>
</div>

</div>


<div class="map-card">

<h3>Work</h3>

<p>
Routes that turn existing ability into employment and experience.
</p>

<div class="map-links">
<span>ENTRY LEVEL</span>
<span>REMOTE</span>
<span>CONTRACT</span>
<span>TEMPORARY</span>
<span>APPRENTICESHIP</span>
</div>

</div>


<div class="map-card">

<h3>Funding</h3>

<p>
Money that can reduce the cost of education, training,
business development, or relocation.
</p>

<div class="map-links">
<span>SCHOLARSHIPS</span>
<span>GRANTS</span>
<span>FELLOWSHIPS</span>
<span>STIPENDS</span>
<span>COMPETITIONS</span>
</div>

</div>


<div class="map-card">

<h3>Credentials</h3>

<p>
Signals that can help employers evaluate your capabilities.
</p>

<div class="map-links">
<span>CERTIFICATIONS</span>
<span>LICENSES</span>
<span>BADGES</span>
<span>PORTFOLIOS</span>
<span>ASSESSMENTS</span>
</div>

</div>


<div class="map-card">

<h3>Entrepreneurship</h3>

<p>
Routes for people who want to create products, services,
companies, or independent income.
</p>

<div class="map-links">
<span>INCUBATORS</span>
<span>ACCELERATORS</span>
<span>STARTUP PROGRAMS</span>
<span>MICROGRANTS</span>
</div>

</div>


<div class="map-card">

<h3>Mobility</h3>

<p>
Programs that can change where you live, work, study, or build
your career.
</p>

<div class="map-links">
<span>RELOCATION</span>
<span>GLOBAL TALENT</span>
<span>VISA PROGRAMS</span>
<span>RESIDENCY</span>
</div>

</div>

</div>

</div>

</section>


<!-- DECISION ENGINE -->

<section id="decision" class="decision">

<div class="container">

<div class="section-header">

<div class="section-label">
04 / DECISION ENGINE
</div>

<h2>
Choose your constraint before choosing your opportunity.
</h2>

<p>
Click the factor that currently matters most. Your search should
change depending on your situation.
</p>

</div>


<div class="decision-box">

<div class="decision-title">
What are you optimizing for?
</div>

<div class="choice-grid">

<div class="choice" onclick="showResult('speed')">

<strong>Speed</strong>

<small>I need progress quickly.</small>

</div>


<div class="choice" onclick="showResult('money')">

<strong>Low Cost</strong>

