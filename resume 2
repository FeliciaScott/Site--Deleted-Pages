<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tech Launch Resume | No-Degree Professional Roadmap</title>
    <style>
        /* =========================================================
           GLOBAL (LIGHT MODE)
        ========================================================= */
        :root {
            --background: #f8fafc;
            --background-light: #ffffff;
            --surface: #ffffff;
            --surface-light: #f1f5f9;
            --border: #e2e8f0;
            --text: #0f172a;
            --muted: #475569;
            --accent: #0284c7;
            --accent-dark: #0369a1;
            --green: #16a34a;
            --paper: #ffffff;
            --paper-text: #0f172a;
            --radius: 18px;
            --max-width: 1180px;
        }
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        html {
            scroll-behavior: smooth;
        }
        body {
            background: var(--background);
            color: var(--text);
            font-family: "Inter", Arial, sans-serif;
            line-height: 1.6;
        }
        a {
            color: inherit;
            text-decoration: none;
        }
        .container {
            width: min(calc(100% - 40px), var(--max-width));
            margin: auto;
        }
        .section {
            padding: 60px 0;
        }
        .section-label {
            color: var(--accent);
            font-family: "JetBrains Mono", monospace;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 2px;
            margin-bottom: 12px;
        }
        .section-title {
            font-size: clamp(32px, 4vw, 52px);
            line-height: 1.1;
            max-width: 800px;
            margin-bottom: 16px;
        }
        .section-intro {
            max-width: 650px;
            color: var(--muted);
            font-size: 16px;
        }
        /* =========================================================
           NAVIGATION
        ========================================================= */
        .navbar {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border);
        }
        .nav-container {
            width: min(calc(100% - 40px), var(--max-width));
            margin: auto;
            min-height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 13px;
            font-weight: 800;
            letter-spacing: 1.5px;
        }
        .brand-mark {
            width: 32px;
            height: 32px;
            display: grid;
            place-items: center;
            border-radius: 8px;
            background: var(--accent);
            color: #ffffff;
            font-family: "JetBrains Mono", monospace;
            font-weight: 800;
        }
        .nav-links {
            display: flex;
            gap: 25px;
        }
        .nav-links a {
            color: var(--muted);
            font-size: 13px;
            font-weight: 500;
            transition: color .2s ease;
        }
        .nav-links a:hover {
            color: var(--accent);
        }
        /* =========================================================
           HERO
        ========================================================= */
        .hero {
            padding: 70px 0 50px;
            display: flex;
            align-items: center;
            position: relative;
            overflow: hidden;
            background:
                radial-gradient(circle at 15% 25%, rgba(2, 132, 199, 0.08), transparent 30%),
                radial-gradient(circle at 85% 75%, rgba(22, 163, 74, 0.06), transparent 30%);
        }
        .hero::after {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            background-image:
                linear-gradient(rgba(0, 0, 0, .03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 0, 0, .03) 1px, transparent 1px);
            background-size: 50px 50px;
        }
        .hero-content {
            width: min(calc(100% - 40px), var(--max-width));
            margin: auto;
            position: relative;
            z-index: 2;
        }
        .eyebrow {
            display: inline-block;
            padding: 6px 12px;
            border: 1px solid rgba(2, 132, 199, 0.25);
            background: rgba(2, 132, 199, 0.08);
            border-radius: 999px;
            color: var(--accent-dark);
            font-family: "JetBrains Mono", monospace;
            font-size: 11px;
            letter-spacing: 1.5px;
            margin-bottom: 20px;
        }
        .hero h1 {
            max-width: 850px;
            font-size: clamp(44px, 7vw, 84px);
            line-height: 1;
            letter-spacing: -3px;
            margin-bottom: 20px;
        }
        .hero h1 span {
            display: block;
            color: var(--accent);
        }
        .hero-text {
            max-width: 720px;
            color: var(--muted);
            font-size: 18px;
            margin-bottom: 25px;
        }
        .hero-buttons {
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
        }
        .btn {
            padding: 12px 20px;
            border-radius: 10px;
            font-weight: 700;
            font-size: 14px;
            transition: transform .2s ease, background .2s ease;
        }
        .btn:hover {
            transform: translateY(-2px);
        }
        .btn-primary {
            background: var(--accent);
            color: #ffffff;
        }
        .btn-secondary {
            border: 1px solid var(--border);
            background: #ffffff;
            color: var(--text);
        }
        .hero-stats {
            display: flex;
            gap: 45px;
            margin-top: 40px;
            flex-wrap: wrap;
        }
        .hero-stats div {
            display: flex;
            flex-direction: column;
        }
        .hero-stats strong {
            color: var(--accent);
            font-family: "JetBrains Mono", monospace;
            font-size: 20px;
        }
        .hero-stats span {
            color: var(--muted);
            font-size: 12px;
        }
        /* =========================================================
           MISSION
        ========================================================= */
        .mission-section {
            background: var(--background-light);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }
        .mission-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 50px;
        }
        .mission-grid h2 {
            font-size: clamp(34px, 4vw, 56px);
            line-height: 1.05;
            letter-spacing: -2px;
        }
        .mission-grid p {
            color: var(--muted);
            margin-bottom: 15px;
        }
        .mission-grid .large-text {
            color: var(--text);
            font-size: 20px;
        }
        /* =========================================================
           RESUME
        ========================================================= */
        .resume-section {
            background: var(--background);
        }
        .resume-paper {
            background: var(--paper);
            color: var(--paper-text);
            max-width: 950px;
            margin: 25px auto 0;
            padding: 40px;
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, .04);
        }
        .resume-header {
            display: flex;
            justify-content: space-between;
            gap: 40px;
            padding-bottom: 20px;
            border-bottom: 2px solid var(--border);
        }
        .resume-header h2 {
            font-size: 28px;
            letter-spacing: -1px;
        }
        .resume-title {
            color: var(--muted);
            font-size: 14px;
            margin-top: 4px;
        }
        .resume-contact {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            color: var(--muted);
            font-size: 12px;
        }
        .resume-block {
            padding: 20px 0;
            border-bottom: 1px solid var(--border);
        }
        .resume-block:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }
        .resume-block > h3 {
            font-size: 12px;
            letter-spacing: 1.5px;
            color: var(--text);
            margin-bottom: 12px;
        }
        .resume-block p {
            font-size: 13px;
            line-height: 1.6;
        }
        .resume-skills {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px 30px;
            font-size: 13px;
        }
        .project-resume-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }
        .mini-project {
            padding: 15px;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: var(--surface-light);
        }
        .mini-project strong {
            font-size: 13px;
        }
        .mini-project p {
            margin-top: 4px;
            color: var(--muted);
            font-size: 12px;
        }
        /* =========================================================
           ROADMAP
        ========================================================= */
        .roadmap-section {
            background: var(--background-light);
            border-top: 1px solid var(--border);
        }
        .roadmap {
            margin-top: 30px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }
        .roadmap-card {
            display: grid;
            grid-template-columns: 70px 1fr;
            gap: 20px;
            padding: 24px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            transition: transform .25s ease, border-color .25s ease;
        }
        .roadmap-card:hover {
            transform: translateY(-4px);
            border-color: var(--accent);
        }
        .roadmap-number {
            font-family: "JetBrains Mono", monospace;
            font-size: 24px;
            color: var(--accent);
        }
        .roadmap-category {
            color: var(--accent-dark);
            font-family: "JetBrains Mono", monospace;
            font-size: 10px;
            letter-spacing: 1.5px;
        }
        .roadmap-card h3 {
            margin: 4px 0 6px;
            font-size: 20px;
        }
        .roadmap-card p {
            color: var(--muted);
            font-size: 13px;
            margin-bottom: 15px;
        }
        .task-list {
            list-style: none;
        }
        .task-list li {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            color: var(--muted);
            font-size: 13px;
            margin-bottom: 6px;
        }
        .task-list input {
            margin-top: 4px;
            accent-color: var(--accent);
        }
        /* =========================================================
           FOOTER
        ========================================================= */
        footer {
            border-top: 1px solid var(--border);
            background: var(--background-light);
            padding: 30px 0;
        }
        .footer-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }
        .footer-content strong {
            font-size: 13px;
            letter-spacing: 1px;
        }
        .footer-content p {
            color: var(--muted);
            font-size: 12px;
            margin-top: 3px;
        }
        .footer-code {
            color: var(--accent);
            font-family: "JetBrains Mono", monospace;
            font-size: 12px;
        }
        /* =========================================================
           RESPONSIVE
        ========================================================= */
        @media (max-width: 950px) {
            .nav-links {
                display: none;
            }
            .mission-grid {
                grid-template-columns: 1fr;
                gap: 25px;
            }
            .roadmap {
                grid-template-columns: 1fr;
            }
        }
        @media (max-width: 700px) {
            .section {
                padding: 45px 0;
            }
            .hero {
                padding: 45px 0 35px;
            }
            .hero h1 {
                letter-spacing: -1.5px;
            }
            .hero-text {
                font-size: 16px;
            }
            .hero-stats {
                gap: 20px;
                margin-top: 30px;
            }
            .resume-paper {
                padding: 24px 16px;
            }
            .resume-header {
                flex-direction: column;
                gap: 15px;
            }
            .resume-contact {
                align-items: flex-start;
            }
            .resume-skills,
            .project-resume-grid {
                grid-template-columns: 1fr;
            }
            .roadmap-card {
                grid-template-columns: 40px 1fr;
                padding: 18px;
            }
            .roadmap-number {
                font-size: 18px;
            }
            .footer-content {
                flex-direction: column;
                align-items: flex-start;
            }
        }
        /* =========================================================
           PRINT
        ========================================================= */
        @media print {
            body {
                background: white;
                color: black;
            }
            .navbar,
            .hero,
            .mission-section,
            .roadmap-section,
            footer {
                display: none;
            }
            .resume-section {
                padding: 0;
                background: white;
            }
            .container {
                width: 100%;
            }
            .resume-paper {
                box-shadow: none;
                border: none;
                max-width: none;
                padding: 0;
            }
        }
    </style>
</head>
<body>

<nav class="navbar">
    <div class="nav-container">
        <div class="brand">
            <span class="brand-mark">TX</span>
            <span>TECH LAUNCH</span>
        </div>
        <div class="nav-links">
            <a href="#mission">Mission</a>
