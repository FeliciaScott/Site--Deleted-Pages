<div class="toast" id="toast">
Evidence copied.
</div>


<script>

/* =========================================================
   ANATOMY INTERACTION
   ========================================================= */

const anatomyData = [

{
title:"Diagnostic Focus",
text:"Identify the specific objective, process gap, decision problem, or operational challenge you attempted to solve.",
example:"Example: Customer follow-up was inconsistent, creating delays between inquiry and response."
},

{
title:"Core Deliverable",
text:"Show the actual work. This could be code, a workflow, report, financial model, audit, strategy brief, template, or other artifact.",
example:"Example: Built a standardized follow-up workflow with defined stages, response rules, and tracking fields."
},

{
title:"Measurable Outcome",
text:"Explain what changed or what the solution is designed to improve. Use measurements when they exist, but do not invent results.",
example:"Example: Creates a repeatable process that makes response activity easier to track and evaluate."
},

{
title:"Verification",
text:"Give another person a way to inspect the claim. Evidence becomes stronger when the underlying artifact can actually be reviewed.",
example:"Example: Provide a live demonstration, repository, report, screenshots, documentation, or before-and-after comparison."
}

];


function showAnatomy(index,button){

document.querySelectorAll(".anatomy-btn")
.forEach(btn => btn.classList.remove("active"));

button.classList.add("active");

const item = anatomyData[index];

document.getElementById("anatomyDisplay").innerHTML = `

<h3>${item.title}</h3>

<p>${item.text}</p>

<div class="example-box">

<strong>${item.example.split(":")[0]}:</strong>

${item.example.split(":").slice(1).join(":")}

</div>

`;

}


/* =========================================================
   BUILDER
   ========================================================= */

const fields = [
"title",
"problem",
"deliverable",
"outcome",
"verification"
];


fields.forEach(id => {

document.getElementById(id).addEventListener("input",updatePreview);

});


function updatePreview(){

const title =
document.getElementById("title").value.trim();

const problem =
document.getElementById("problem").value.trim();

const deliverable =
document.getElementById("deliverable").value.trim();

const outcome =
document.getElementById("outcome").value.trim();

const verification =
document.getElementById("verification").value;


document.getElementById("previewTitle").textContent =
title || "Untitled Evidence Block";

document.getElementById("previewProblem").textContent =
problem || "Your problem or objective will appear here.";

document.getElementById("previewDeliverable").textContent =
deliverable || "Your work sample will appear here.";

document.getElementById("previewOutcome").textContent =
outcome || "Your result or expected value will appear here.";

document.getElementById("previewVerification").textContent =
verification || "No verification method selected.";

calculateScore();

}


function calculateScore(){

let score = 0;

const title =
document.getElementById("title").value.trim();

const problem =
document.getElementById("problem").value.trim();

const deliverable =
document.getElementById("deliverable").value.trim();

const outcome =
document.getElementById("outcome").value.trim();

const verification =
document.getElementById("verification").value;


if(title.length >= 5) score += 15;

if(problem.length >= 30) score += 25;

if(deliverable.length >= 30) score += 25;

if(outcome.length >= 30) score += 20;

if(verification) score += 15;


document.getElementById("scoreNumber").textContent =
score + "%";

document.getElementById("topScore").textContent =
score + "%";

document.getElementById("scoreFill").style.width =
score + "%";


let message =
"Start filling the evidence fields.";

if(score >= 90){
message =
"Strong evidence structure. Your artifact is close to portfolio-ready.";
}
else if(score >= 70){
message =
"Good foundation. Strengthen the weaker fields with specific details.";
}
else if(score >= 40){
message =
"Useful beginning. Add more detail about the problem and actual work.";
}
else if(score > 0){
message =
"Your Evidence Block has started. Continue adding concrete information.";
}


document.getElementById("scoreMessage").textContent =
message;

}


/* =========================================================
   GENERATE
   ========================================================= */

let blockCount = 0;


function generateEvidence(){

updatePreview();

const score =
parseInt(document.getElementById("scoreNumber").textContent);

if(score === 0){

showToast("Add information before generating your Evidence Block.");

return;

}

blockCount++;

document.getElementById("blockCount").textContent =
blockCount;

document.getElementById("systemState").textContent =
"Evidence Built";

showToast("Evidence Block generated.");

}


/* =========================================================
   RESET
   ========================================================= */

function resetBuilder(){

fields.forEach(id => {

const element =
document.getElementById(id);

if(element.tagName === "SELECT"){
element.value = "";
}
else{
element.value = "";
}

});

updatePreview();

document.getElementById("systemState").textContent =
"Ready";

showToast("Builder reset.");

}


/* =========================================================
   COPY
   ========================================================= */

function copyEvidence(){

const title =
document.getElementById("previewTitle").textContent;

const problem =
document.getElementById("previewProblem").textContent;

const deliverable =
document.getElementById("previewDeliverable").textContent;

const outcome =
document.getElementById("previewOutcome").textContent;

const verification =
document.getElementById("previewVerification").textContent;


const text =

`WORKPROOF EVIDENCE BLOCK

${title}

DIAGNOSTIC FOCUS
${problem}

CORE DELIVERABLE
${deliverable}

OUTCOME
${outcome}

VERIFICATION
${verification}`;


navigator.clipboard.writeText(text)
.then(() => showToast("Evidence Block copied."))
.catch(() => showToast("Copy unavailable in this browser."));

}


/* =========================================================
   CONVERSION LAB
   ========================================================= */

const conversions = [

{
beforeTitle:"I am organized.",
before:"I am organized and good at managing competing responsibilities.",
afterTitle:"Show the system.",
after:"Designed a priority-tracking workflow that separated urgent requests from scheduled work and created a repeatable process for managing competing responsibilities."
},

{
beforeTitle:"I am a leader.",
before:"I am a strong leader who motivates people.",
afterTitle:"Show the intervention.",
after:"Coordinated competing priorities, established clearer responsibilities, and created a repeatable communication process for moving work forward."
},

{
beforeTitle:"I solve problems.",
before:"I am a creative problem solver.",
afterTitle:"Show the diagnosis.",
after:"Analyzed the recurring bottleneck, separated the contributing factors, tested alternative solutions, and documented a repeatable response process."
},

{
beforeTitle:"I communicate well.",
before:"I have excellent communication skills.",
afterTitle:"Show the communication artifact.",
after:"Created structured communication materials that translated complex information into clear actions, expectations, and follow-up points."
},

{
beforeTitle:"I have technical skills.",
before:"I am technically capable.",
afterTitle:"Show the working artifact.",
after:"Built and documented a functional technical solution, explaining the design decisions, implementation process, limitations, and intended use."
}

];


function conversion(index){

const item = conversions[index];

document.getElementById("conversionBeforeTitle")
.textContent = item.beforeTitle;

document.getElementById("conversionBefore")
.textContent = item.before;

document.getElementById("conversionAfterTitle")
.textContent = item.afterTitle;

document.getElementById("conversionAfter")
.textContent = item.after;

}


/* =========================================================
   MATRIX FILTER
   ========================================================= */

function filterMatrix(category,button){

document.querySelectorAll(".filter-btn")
.forEach(btn => btn.classList.remove("active"));

button.classList.add("active");


document.querySelectorAll(".matrix-item")
.forEach(row => {

if(category === "all" ||
row.dataset.category === category){

row.style.display = "grid";

}
else{

row.style.display = "none";

}

});

}


/* =========================================================
   PROGRESSION ACCORDION
   ========================================================= */

function toggleLevel(button){

const level =
button.parentElement;

document.querySelectorAll(".level")
.forEach(item => {

if(item !== level){
item.classList.remove("open");
}

});

level.classList.toggle("open");

}


/* =========================================================
   NAVIGATION
   ========================================================= */

function scrollToBuilder(){

document.getElementById("builderSection")
.scrollIntoView({
behavior:"smooth"
});

}


function scrollToAnatomy(){

document.getElementById("anatomySection")
.scrollIntoView({
behavior:"smooth"
});

}


/* =========================================================
   TOAST
   ========================================================= */

let toastTimer;

function showToast(message){

const toast =
document.getElementById("toast");

toast.textContent = message;

toast.classList.add("show");

clearTimeout(toastTimer);

toastTimer =
setTimeout(() => {

toast.classList.remove("show");

},2500);

}


/* =========================================================
   INITIALIZE
   ========================================================= */

updatePreview();

</script>

</body>
</html>
