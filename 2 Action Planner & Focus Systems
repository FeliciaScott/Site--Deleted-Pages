    <!-- Analytics Panel -->
    <div class="panel">
      <div class="panel-title">Weekly Balance Analytics</div>

      <div class="analytics-card">

        <div>
          <div class="progress-label">
            <span>Study Load</span>
            <span id="studyHoursText">0 / 25 hrs</span>
          </div>
          <div class="progress-bar-bg">
            <div class="progress-bar-fill fill-study" id="studyProgressBar" style="width: 0%;"></div>
          </div>
        </div>

        <div>
          <div class="progress-label">
            <span>Work Load</span>
            <span id="workHoursText">0 / 20 hrs</span>
          </div>
          <div class="progress-bar-bg">
            <div class="progress-bar-fill fill-work" id="workProgressBar" style="width: 0%;"></div>
          </div>
        </div>

        <div>
          <div class="progress-label">
            <span>Academic Milestone Weight</span>
            <span id="weightText">0% total</span>
          </div>
          <div class="progress-bar-bg">
            <div class="progress-bar-fill fill-academic" id="weightProgressBar" style="width: 0%;"></div>
          </div>
        </div>

      </div>
    </div>

    <!-- Category Filters -->
    <div class="panel">
      <div class="panel-title">Filter Schedule</div>

      <div class="filter-group">
        <button class="filter-btn active" data-filter="all" onclick="setFilter('all', this)">All</button>
        <button class="filter-btn" data-filter="syllabus" onclick="setFilter('syllabus', this)">Syllabus</button>
        <button class="filter-btn" data-filter="study" onclick="setFilter('study', this)">Study</button>
        <button class="filter-btn" data-filter="work" onclick="setFilter('work', this)">Work</button>
        <button class="filter-btn" data-filter="personal" onclick="setFilter('personal', this)">Personal</button>
      </div>
    </div>

  </aside>

  <main class="main-content">

    <!-- Month Calendar View -->
    <div class="panel" id="viewMonth">

      <div class="calendar-header">
        <div class="calendar-title" id="calendarTitle">Month Year</div>

        <div class="nav-btns">
          <button class="btn btn-secondary" onclick="prevMonth()">← Prev</button>
          <button class="btn btn-secondary" onclick="todayMonth()">Today</button>
          <button class="btn btn-secondary" onclick="nextMonth()">Next →</button>
        </div>
      </div>

      <div class="calendar-grid">
        <div class="day-name">Sun</div>
        <div class="day-name">Mon</div>
        <div class="day-name">Tue</div>
        <div class="day-name">Wed</div>
        <div class="day-name">Thu</div>
        <div class="day-name">Fri</div>
        <div class="day-name">Sat</div>
      </div>

      <div class="calendar-grid" id="calendarDays">
        <!-- Generated Days -->
      </div>

    </div>

    <!-- Agenda View -->
    <div class="panel" id="viewAgenda" style="display: none;">
      <div class="panel-title">Upcoming Academic & Work Agenda</div>

      <div id="agendaList" style="display:flex; flex-direction:column; gap:10px;">
        <!-- Generated Agenda Items -->
      </div>
    </div>

    <!-- Grades & GPA View -->
    <div class="panel" id="viewGrades" style="display: none;">

      <div class="panel-title">
        <span>Grade & Course Tracker</span>
        <button class="btn btn-secondary" onclick="calculateGrades()">🔄 Recalculate</button>
      </div>

      <p style="font-size:0.85rem; color:var(--text-muted); margin-bottom:14px;">
        Log scores for your syllabus assignments to calculate your estimated weighted grade.
      </p>

      <table class="grade-table">
        <thead>
          <tr>
            <th>Course</th>
            <th>Assignment / Exam</th>
            <th>Weight (%)</th>
            <th>Score Received (%)</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody id="gradeTableBody">
          <!-- Rendered Grade Items -->
        </tbody>
      </table>

    </div>

    <!-- Goals & Milestones Dashboard -->
    <div class="dashboard-grid">

      <div class="panel">
        <div class="panel-title">
          <span>Weekly Goals</span>
          <button class="btn btn-secondary" style="padding:3px 10px; font-size:0.75rem;" onclick="addGoalPrompt()">+ Add Goal</button>
        </div>

        <ul class="checklist" id="goalsList">
          <!-- Rendered Goals -->
        </ul>
      </div>

      <div class="panel">
        <div class="panel-title">
          <span>Daily Action Steps</span>
          <button class="btn btn-secondary" style="padding:3px 10px; font-size:0.75rem;" onclick="addMilestonePrompt()">+ Add Step</button>
        </div>

        <ul class="checklist" id="milestonesList">
          <!-- Rendered Milestones -->
        </ul>
      </div>

    </div>

  </main>
</div>

<!-- Smart Syllabus Parser Modal -->
<div class="modal-overlay" id="syllabusModal">

  <div class="modal">

    <div class="modal-header">
      <div class="modal-title">📝 Smart Syllabus Parser</div>
      <button class="delete-btn" onclick="closeSyllabusModal()">✕</button>
    </div>

    <p style="font-size:0.85rem; color:var(--text-muted); margin-bottom:12px;">
      Paste raw text from a syllabus or course schedule below. The parser will extract assignment names, dates, and grade weight percentages automatically.
    </p>

    <div class="form-group">
      <label>Raw Syllabus Text</label>
      <textarea id="rawSyllabusText" class="form-control" style="min-height: 120px;" placeholder="Example:&#10;Oct 12 - Chapter 1 Quiz (5%)&#10;Nov 05: Midterm Research Paper due (20%)&#10;Dec 10 - Final Examination (30%)"></textarea>
    </div>

    <div class="form-group">
      <label>Course Name to Assign</label>
      <input type="text" id="sysCourseName" class="form-control" placeholder="e.g. BIOL 201">
    </div>

    <button class="btn btn-primary" onclick="parseSyllabusText()" style="width: 100%; margin-bottom:16px;">
      Parse Syllabus Items
    </button>

    <div id="parsedPreviewArea" style="display:none;">
      <div class="panel-title" style="font-size:0.95rem;">Extracted Preview</div>
      <div id="parsedItemsList"></div>

      <button class="btn btn-primary" onclick="confirmBatchImport()" style="width: 100%; margin-top:10px;">
        Confirm & Add to Calendar
      </button>
    </div>

  </div>
</div>

<footer>
  © 2026 PathKeeper • Designed to Help You Organize Academic and Career Success
</footer>

<script>
let currentDate = new Date();
let activeFilter = 'all';
let parsedTempItems = [];

let appData = {
  events: [],
  goals: [],
  milestones: []
};

// Initial Data Loader
function loadData() {
  const saved = localStorage.getItem('pathkeeper_academic_v2');

  if (saved) {
    try {
      appData = JSON.parse(saved);
    } catch(e) {
      console.error("Error reading saved state", e);
    }
  } else {
    // Standard Demo Seed
    const today = formatDate(new Date());

    appData = {
      events: [
        {
          id: '1',
          title: 'CS101 Midterm Exam',
          category: 'syllabus',
          date: today,
          hours: 2,
          weight: 20,
          score: 88,
          priority: 'high',
          course: 'CS101',
          notes: 'Chapters 1-5 review'
        },
        {
          id: '2',
          title: 'Library Shift',
          category: 'work',
          date: today,
          hours: 4,
          weight: 0,
          score: 0,
          priority: 'med',
          course: '',
          notes: 'Front desk'
        },
        {
          id: '3',
          title: 'Math Problem Set 4',
          category: 'study',
          date: today,
          hours: 1.5,
          weight: 5,
          score: 95,
          priority: 'med',
          course: 'MATH201',
          notes: 'Calculus derivatives'
        }
      ],

      goals: [
        {
          id: 'g1',
          text: 'Maintain 3.5+ GPA this semester',
          completed: false
        },
        {
          id: 'g2',
          text: 'Cap work shifts to under 20 hrs/week',
          completed: true
        }
      ],

      milestones: [
        {
          id: 'm1',
          text: 'Review CS101 lecture slides',
          completed: false
        }
      ]
    };

    saveData();
  }
}

function saveData() {
  localStorage.setItem('pathkeeper_academic_v2', JSON.stringify(appData));
  updateAnalytics();
}

function formatDate(d) {
  const year = d.getFullYear();
  const month = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');

  return `${year}-${month}-${day}`;
}

// View Switches
function switchMainView(viewName, btn) {
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));

  if (btn) btn.classList.add('active');

  document.getElementById('viewMonth').style.display =
    viewName === 'month' ? 'block' : 'none';

  document.getElementById('viewAgenda').style.display =
    viewName === 'agenda' ? 'block' : 'none';

  document.getElementById('viewGrades').style.display =
    viewName === 'grades' ? 'block' : 'none';

  if (viewName === 'month') renderCalendar();
  if (viewName === 'agenda') renderAgenda();
  if (viewName === 'grades') renderGrades();
}

// Render Month Calendar Grid
function renderCalendar() {
  const year = currentDate.getFullYear();
  const month = currentDate.getMonth();

  const monthNames = [
    "January", "February", "March", "April",
    "May", "June", "July", "August",
    "September", "October", "November", "December"
  ];

  document.getElementById('calendarTitle').innerText =
    `${monthNames[month]} ${year}`;

  const firstDay = new Date(year, month, 1).getDay();
  const daysInMonth = new Date(year, month + 1, 0).getDate();
  const daysInPrevMonth = new Date(year, month, 0).getDate();

  const grid = document.getElementById('calendarDays');
  grid.innerHTML = '';

  const todayStr = formatDate(new Date());

  // Filler days for preceding month
  for (let i = firstDay - 1; i >= 0; i--) {
    const dayDiv = document.createElement('div');

    dayDiv.className = 'calendar-day other-month';

    dayDiv.innerHTML = `
      <div class="day-header">
        <span class="day-number">${daysInPrevMonth - i}</span>
      </div>
    `;

    grid.appendChild(dayDiv);
  }

  // Active month days
  for (let day = 1; day <= daysInMonth; day++) {
    const monthStr = String(month + 1).padStart(2, '0');
    const dayStr = String(day).padStart(2, '0');
    const dateStr = `${year}-${monthStr}-${dayStr}`;

    const dayDiv = document.createElement('div');

    dayDiv.className =
      'calendar-day' + (dateStr === todayStr ? ' today' : '');

    dayDiv.onclick = () => selectDate(dateStr);

    let dayEvents = appData.events.filter(e => e.date === dateStr);

    if (activeFilter !== 'all') {
      dayEvents = dayEvents.filter(e => e.category === activeFilter);
    }

    let eventsHtml = '';

    dayEvents.forEach(evt => {
      eventsHtml += `
        <div
          class="event-item ${evt.category}"
          title="${evt.notes || evt.title}"
          onclick="event.stopPropagation(); deleteEvent('${evt.id}')">
          ${evt.title}
        </div>
      `;
    });

    dayDiv.innerHTML = `
      <div class="day-header">
        <span class="day-number">${day}</span>
      </div>
      ${eventsHtml}
    `;

    grid.appendChild(dayDiv);
  }

  renderChecklists();
  updateAnalytics();
}

function selectDate(dateStr) {
  document.getElementById('evtDate').value = dateStr;
}

function prevMonth() {
  currentDate.setMonth(currentDate.getMonth() - 1);
  renderCalendar();
}

function nextMonth() {
  currentDate.setMonth(currentDate.getMonth() + 1);
  renderCalendar();
}

function todayMonth() {
  currentDate = new Date();
  renderCalendar();
}

function setFilter(cat, btn) {
  activeFilter = cat;

  document.querySelectorAll('.filter-btn').forEach(b => {
    b.classList.remove('active');
  });

  btn.classList.add('active');
  renderCalendar();
}

function toggleCategoryFields() {
  const cat = document.getElementById('evtCategory').value;

  document.getElementById('syllabusExtraFields').style.display =
    cat === 'syllabus' ? 'flex' : 'none';
}

// Form Submission
function handleFormSubmit(e) {
  e.preventDefault();

  const newEvent = {
    id: Date.now().toString(),
    title: document.getElementById('evtTitle').value,
    category: document.getElementById('evtCategory').value,
    priority: document.getElementById('evtPriority').value,
    date: document.getElementById('evtDate').value,
    hours: parseFloat(document.getElementById('evtHours').value) || 1,
    course: document.getElementById('evtCourse').value || '',
    weight: parseFloat(document.getElementById('evtWeight').value) || 0,
    score: 0,
    notes: document.getElementById('evtNotes').value || ''
  };

  appData.events.push(newEvent);

  saveData();
  renderCalendar();

  document.getElementById('eventForm').reset();
  document.getElementById('evtDate').value = formatDate(new Date());
}

function deleteEvent(id) {
  if (confirm("Remove this item from your plan?")) {
    appData.events = appData.events.filter(e => e.id !== id);

    saveData();
    renderCalendar();

    if (document.getElementById('viewAgenda').style.display !== 'none') {
      renderAgenda();
    }

    if (document.getElementById('viewGrades').style.display !== 'none') {
      renderGrades();
    }
  }
}

// Render Agenda View
function renderAgenda() {
  const container = document.getElementById('agendaList');
  container.innerHTML = '';

  const sorted = [...appData.events].sort(
    (a, b) => new Date(a.date) - new Date(b.date)
  );

  if (sorted.length === 0) {
    container.innerHTML =
      '<p style="color:var(--text-muted);">No upcoming items scheduled.</p>';
    return;
  }

  sorted.forEach(evt => {
    container.innerHTML += `
      <div class="parsed-item-card">
        <div style="flex:1;">
          <div style="font-weight:700; color:var(--text-main);">
            ${evt.title}
          </div>

          <div style="font-size:0.78rem; color:var(--text-muted);">
            📅 ${evt.date} |
            ⏱️ ${evt.hours} hrs |
            🏷️ ${evt.category.toUpperCase()}
            ${evt.course ? ' | ' + evt.course : ''}
          </div>
        </div>

        <button class="delete-btn" onclick="deleteEvent('${evt.id}')">✕</button>
      </div>
    `;
  });
}

// Render Grades & Calculator
function renderGrades() {
  const tbody = document.getElementById('gradeTableBody');
  tbody.innerHTML = '';

  const syllabusItems = appData.events.filter(
    e => e.category === 'syllabus'
  );

  if (syllabusItems.length === 0) {
    tbody.innerHTML = `
      <tr>
        <td colspan="5" style="text-align:center; color:var(--text-muted);">
          No syllabus items with grade weights added.
        </td>
      </tr>
    `;
    return;
  }

  syllabusItems.forEach(item => {
    tbody.innerHTML += `
      <tr>
        <td>${item.course || 'N/A'}</td>
        <td>${item.title}</td>
        <td>${item.weight}%</td>

        <td>
          <input
            type="number"
            class="form-control"
            style="width:80px; padding:4px 8px;"
            value="${item.score || 0}"
            min="0"
            max="100"
            onchange="updateGradeScore('${item.id}', this.value)">
        </td>

        <td>
          <button class="delete-btn" onclick="deleteEvent('${item.id}')">✕</button>
        </td>
      </tr>
    `;
  });
}

function updateGradeScore(id, val) {
  const item = appData.events.find(e => e.id === id);

  if (item) {
    item.score = parseFloat(val) || 0;
    saveData();
  }
}

function calculateGrades() {
  renderGrades();
  alert("Grades updated and saved!");
}

// Render Goals & Milestones
function renderChecklists() {
  const goalsUl = document.getElementById('goalsList');
  goalsUl.innerHTML = '';

  appData.goals.forEach(g => {
    goalsUl.innerHTML += `
      <li class="check-item ${g.completed ? 'completed' : ''}">
        <input
          type="checkbox"
          ${g.completed ? 'checked' : ''}
          onchange="toggleGoal('${g.id}')">

        <span>${g.text}</span>

        <button class="delete-btn" onclick="deleteGoal('${g.id}')">✕</button>
      </li>
    `;
  });

  const mUl = document.getElementById('milestonesList');
  mUl.innerHTML = '';

  appData.milestones.forEach(m => {
    mUl.innerHTML += `
      <li class="check-item ${m.completed ? 'completed' : ''}">
        <input
          type="checkbox"
          ${m.completed ? 'checked' : ''}
          onchange="toggleMilestone('${m.id}')">

        <span>${m.text}</span>

        <button class="delete-btn" onclick="deleteMilestone('${m.id}')">✕</button>
      </li>
    `;
  });
}

function addGoalPrompt() {
  const text = prompt("Enter new academic goal:");

  if (text) {
    appData.goals.push({
      id: Date.now().toString(),
      text,
      completed: false
    });

    saveData();
    renderChecklists();
  }
}

function toggleGoal(id) {
  const item = appData.goals.find(g => g.id === id);

  if (item) item.completed = !item.completed;

  saveData();
  renderChecklists();
}

function deleteGoal(id) {
  appData.goals = appData.goals.filter(g => g.id !== id);

  saveData();
  renderChecklists();
}

function addMilestonePrompt() {
  const text = prompt("Enter today's action step:");

  if (text) {
    appData.milestones.push({
      id: Date.now().toString(),
      text,
      completed: false
    });

    saveData();
    renderChecklists();
  }
}

function toggleMilestone(id) {
  const item = appData.milestones.find(m => m.id === id);

  if (item) item.completed = !item.completed;

  saveData();
  renderChecklists();
}

function deleteMilestone(id) {
  appData.milestones = appData.milestones.filter(m => m.id !== id);

  saveData();
  renderChecklists();
}

// Update Workload Analytics
function updateAnalytics() {
  let studyHrs = 0;
  let workHrs = 0;
  let totalWeight = 0;

  appData.events.forEach(e => {
    if (e.category === 'study' || e.category === 'syllabus') {
      studyHrs += (e.hours || 0);
    }

    if (e.category === 'work') {
      workHrs += (e.hours || 0);
    }

    if (e.category === 'syllabus') {
      totalWeight += (e.weight || 0);
    }
  });

  document.getElementById('studyHoursText').innerText =
    `${studyHrs} / 25 hrs`;

  document.getElementById('studyProgressBar').style.width =
    `${Math.min((studyHrs / 25) * 100, 100)}%`;

  document.getElementById('workHoursText').innerText =
    `${workHrs} / 20 hrs`;

  document.getElementById('workProgressBar').style.width =
    `${Math.min((workHrs / 20) * 100, 100)}%`;

  document.getElementById('weightText').innerText =
    `${totalWeight}% tracked`;

  document.getElementById('weightProgressBar').style.width =
    `${Math.min(totalWeight, 100)}%`;
}

// Smart Syllabus Parser Logic
function openSyllabusModal() {
  document.getElementById('syllabusModal').classList.add('active');
}

function closeSyllabusModal() {
  document.getElementById('syllabusModal').classList.remove('active');
  document.getElementById('parsedPreviewArea').style.display = 'none';
}

function parseSyllabusText() {
  const rawText = document.getElementById('rawSyllabusText').value;
  const course = document.getElementById('sysCourseName').value || 'Course';

  if (!rawText.trim()) return;

  parsedTempItems = [];

  const lines = rawText.split('\n');

  lines.forEach(line => {
    if (!line.trim()) return;

    // Simple heuristic parser for dates and weights
    let weight = 0;

    const weightMatch = line.match(/(\d+)%/);

    if (weightMatch) {
      weight = parseFloat(weightMatch[1]);
    }

    const today = new Date();
    const dateStr = formatDate(today);

    parsedTempItems.push({
      id: Date.now().toString() + Math.random().toString().slice(2, 6),
      title: line.replace(/\(\d+%\)/, '').trim(),
      category: 'syllabus',
      priority: weight > 15 ? 'high' : 'med',
      date: dateStr,
      hours: 2,
      course: course,
      weight: weight,
      score: 0,
      notes: 'Parsed from Syllabus'
    });
  });

  renderParsedPreview();
}

function renderParsedPreview() {
  const container = document.getElementById('parsedItemsList');
  container.innerHTML = '';

  parsedTempItems.forEach((item, idx) => {
    container.innerHTML += `
      <div class="parsed-item-card">
        <div style="flex:1;">

          <input
            type="text"
            class="form-control"
            value="${item.title}"
            onchange="parsedTempItems[${idx}].title=this.value"
            style="margin-bottom:4px;">

          <div style="display:flex; gap:8px;">

            <input
              type="date"
              class="form-control"
              value="${item.date}"
              onchange="parsedTempItems[${idx}].date=this.value">

            <input
              type="number"
              class="form-control"
              placeholder="Weight %"
              value="${item.weight}"
              onchange="parsedTempItems[${idx}].weight=parseFloat(this.value)||0"
              style="width:100px;">

          </div>
        </div>
      </div>
    `;
  });

  document.getElementById('parsedPreviewArea').style.display = 'block';
}

function confirmBatchImport() {
  appData.events.push(...parsedTempItems);

  saveData();
  renderCalendar();
  closeSyllabusModal();

  alert(`Successfully imported ${parsedTempItems.length} items to your calendar!`);
}

// Data Import/Export
function exportData() {
  const dataStr =
    "data:text/json;charset=utf-8," +
    encodeURIComponent(JSON.stringify(appData, null, 2));

  const downloadAnchor = document.createElement('a');

  downloadAnchor.setAttribute("href", dataStr);

  downloadAnchor.setAttribute(
    "download",
    `pathkeeper_academic_plan_${formatDate(new Date())}.json`
  );

  document.body.appendChild(downloadAnchor);
  downloadAnchor.click();
  downloadAnchor.remove();
}

function triggerImport() {
  document.getElementById('importFileInput').click();
}

function importData(e) {
  const file = e.target.files[0];

  if (!file) return;

  const reader = new FileReader();

  reader.onload = function(evt) {
    try {
      appData = JSON.parse(evt.target.result);

      saveData();
      renderCalendar();

      alert("Plan data imported successfully!");
    } catch(err) {
      alert("Error reading backup file.");
    }
  };

  reader.readAsText(file);
}

// Initialization
window.onload = function() {
  loadData();

  document.getElementById('evtDate').value = formatDate(new Date());

  renderCalendar();
};
</script>

