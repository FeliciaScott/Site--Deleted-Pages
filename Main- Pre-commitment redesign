<script>

/* =====================================================
   SCROLL
===================================================== */

function pcdmScroll(id) {

    var element = document.getElementById(id);

    if (element) {

        element.scrollIntoView({
            behavior: "smooth",
            block: "start"
        });

    }

}


/* =====================================================
   ARCHITECTURE CARD INTERACTION
===================================================== */

function pcdmToggleCard(card) {

    var cards = document.querySelectorAll(
        ".pcdm-architecture-card"
    );

    cards.forEach(function(item) {

        if (item !== card) {
            item.classList.remove("active");
        }

    });

    card.classList.toggle("active");

    var clickText = card.querySelector(
        ".pcdm-click"
    );

    if (card.classList.contains("active")) {

        clickText.textContent =
            "CLICK TO COLLAPSE −";

    } else {

        clickText.textContent =
            "CLICK TO EXPLORE +";

    }

}


/* =====================================================
   DECISION RULE BUILDER
===================================================== */

function pcdmGenerateRule() {

    var situation =
        document.getElementById(
            "pcdm-situation"
        ).value.trim();

    var risk =
        document.getElementById(
            "pcdm-risk"
        ).value.trim();

    var commitment =
        document.getElementById(
            "pcdm-commitment"
        ).value.trim();

    var action =
        document.getElementById(
            "pcdm-action"
        ).value.trim();

    var review =
        document.getElementById(
            "pcdm-review"
        ).value;


    if (
        situation === "" ||
        commitment === "" ||
        action === ""
    ) {

        alert(
            "Please complete the Future Situation, Pre-Commitment, and Required Action fields."
        );

        return;

    }


    if (risk === "") {

        risk =
            "an identified risk or failure pattern";

    }


    var output =

        "<div class='pcdm-rule-line'>" +
        "<strong>WHEN:</strong> " +
        pcdmSafe(situation) +
        "</div>" +

        "<div class='pcdm-rule-line'>" +
        "<strong>WATCH FOR:</strong> " +
        pcdmSafe(risk) +
        "</div>" +

        "<div class='pcdm-rule-line'>" +
        "<strong>PRE-COMMITMENT:</strong> " +
        pcdmSafe(commitment) +
        "</div>" +

        "<div class='pcdm-rule-line'>" +
        "<strong>ACTION:</strong> " +
        pcdmSafe(action) +
        "</div>" +

        "<div class='pcdm-rule-line'>" +
        "<strong>REVIEW:</strong> Reassess this rule after " +
        pcdmSafe(review) +
        "." +
        "</div>";


    document.getElementById(
        "pcdm-rule-output"
    ).innerHTML = output;


    document.getElementById(
        "pcdm-result"
    ).classList.add("visible");


    document.getElementById(
        "pcdm-result"
    ).scrollIntoView({
        behavior: "smooth",
        block: "nearest"
    });

}


/* =====================================================
   SECURITY FOR USER INPUT
===================================================== */

function pcdmSafe(text) {

    return text
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

}


/* =====================================================
   FLOW INTERACTION
===================================================== */

function pcdmFlow(number, element) {

    var steps = document.querySelectorAll(
        ".pcdm-flow-step"
    );

    steps.forEach(function(step) {

        step.classList.remove("active");

    });


    element.classList.add("active");


    var messages = {

        1:
        "A predictable situation activates the architecture. The trigger tells the system that it is time to use the predefined decision process.",

        2:
        "The pause creates distance between the event and the reaction. This is where automatic behavior can be interrupted.",

        3:
        "The predetermined rule is checked against the actual circumstances. The objective is to avoid changing the rule simply because pressure has appeared.",

        4:
        "The predefined response is executed when the criteria are satisfied. The decision becomes an implementation problem rather than a debate.",

        5:
        "The result is reviewed. If reality has changed, the architecture can be deliberately modified rather than randomly abandoned."
    };


    document.getElementById(
        "pcdm-flow-info"
    ).textContent = messages[number];

}


/* =====================================================
   AUDIT
===================================================== */

function pcdmAudit() {

    var checkboxes =
        document.querySelectorAll(
            ".pcdm-audit-item input"
        );

    var checked =
        document.querySelectorAll(
            ".pcdm-audit-item input:checked"
        );


    var total = checkboxes.length;

    var completed = checked.length;

    var percentage =
        Math.round(
            (completed / total) * 100
        );


    document.getElementById(
        "pcdm-score"
    ).textContent =
        percentage + "%";


    document.getElementById(
        "pcdm-progress-bar"
    ).style.width =
        percentage + "%";


    var items =
        document.querySelectorAll(
            ".pcdm-audit-item"
        );


    items.forEach(function(item) {

        var checkbox =
            item.querySelector("input");

        if (checkbox.checked) {

            item.classList.add("checked");

        } else {

            item.classList.remove("checked");

        }

    });


    var message;


    if (percentage === 0) {

        message =
            "Begin the audit by identifying the components your system needs.";

    } else if (percentage < 40) {

        message =
            "Early architecture. Several important decision variables remain undefined.";

    } else if (percentage < 70) {

        message =
            "Developing architecture. The system is becoming more explicit.";

    } else if (percentage < 100) {

        message =
            "Strong architecture. Close the remaining gaps.";

    } else {

        message =
            "Architecture complete. Review the system periodically as circumstances change.";

    }


    document.getElementById(
        "pcdm-score-message"
    ).textContent = message;

}

</script>

