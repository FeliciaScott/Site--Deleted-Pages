<script>

/* =========================
ENVIRONMENT AUDIT
========================= */

const auditRanges = document.querySelectorAll(".audit-range");

function updateAudit(){

    let total = 0;

    auditRanges.forEach(function(range){

        const value = Number(range.value);
        const target = document.getElementById(range.dataset.target);

        target.textContent = value;

        total += value;

    });

    const score = Math.round((total / 50) * 100);

    document.getElementById("environmentScore").textContent = score;

}

auditRanges.forEach(function(range){

    range.addEventListener("input", updateAudit);

});

updateAudit();


/* =========================
CYCLE SELECTION
========================= */

let selectedMinutes = 25;

const cycleOptions = document.querySelectorAll(".cycle-option");

cycleOptions.forEach(function(option){

    option.addEventListener("click", function(){

        cycleOptions.forEach(function(item){
            item.classList.remove("active");
        });

        option.classList.add("active");

        selectedMinutes = Number(option.dataset.minutes);

        if(!isRunning && !hasStarted){
            secondsLeft = selectedMinutes * 60;
            updateTimer();
        }

    });

});


/* =========================
TIMER STATE
========================= */

let timerInterval = null;
let secondsLeft = 25 * 60;
let isRunning = false;
let hasStarted = false;

let completedCycles = 0;
let totalDeepMinutes = 0;


/* =========================
TIMER DISPLAY
========================= */

function updateTimer(){

    const minutes = Math.floor(secondsLeft / 60);
    const seconds = secondsLeft % 60;

    document.getElementById("timer").textContent =
        String(minutes).padStart(2,"0") +
        ":" +
        String(seconds).padStart(2,"0");

}


/* =========================
START
========================= */

document.getElementById("startSession").addEventListener("click",function(){

    const task =
        document.getElementById("taskName").value.trim();

    const definition =
        document.getElementById("definition").value.trim();

    if(!task){

        document.getElementById("taskName").focus();

        document.getElementById("timerStatus").textContent =
            "Define your objective first";

        return;

    }

    hasStarted = true;

    secondsLeft = selectedMinutes * 60;

    document.getElementById("timerTask").textContent =
        task;

    document.getElementById("timerStatus").textContent =
        definition ?
        "Deep work active • Definition established" :
        "Deep work active • Define your stopping condition";

    updateTimer();

    startTimer();

});


/* =========================
START TIMER
========================= */

function startTimer(){

    if(timerInterval){
        clearInterval(timerInterval);
    }

    isRunning = true;

    document.getElementById("pauseButton").textContent =
        "Pause";

    timerInterval = setInterval(function(){

        if(secondsLeft > 0){

            secondsLeft--;

            updateTimer();

        }else{

            completeCycle();

        }

    },1000);

}


/* =========================
PAUSE
========================= */

document.getElementById("pauseButton").addEventListener("click",function(){

    if(!hasStarted){
        return;
    }

    if(isRunning){

        clearInterval(timerInterval);

        isRunning = false;

        document.getElementById("pauseButton").textContent =
            "Resume";

        document.getElementById("timerStatus").textContent =
            "Paused";

    }else{

        startTimer();

        document.getElementById("timerStatus").textContent =
            "Deep work active";

    }

});


/* =========================
COMPLETE
========================= */

function completeCycle(){

    clearInterval(timerInterval);

    isRunning = false;

    completedCycles++;

    totalDeepMinutes += selectedMinutes;

    document.getElementById("cycleCount").textContent =
        completedCycles;

    document.getElementById("deepMinutes").textContent =
        totalDeepMinutes;

    document.getElementById("finalDeepMinutes").textContent =
        totalDeepMinutes;

    document.getElementById("timerStatus").textContent =
        "Cycle complete";

    document.getElementById("timer").textContent =
        "DONE";

    document.getElementById("pauseButton").textContent =
        "Start Again";

    updateDiagnosis();

}


/* =========================
FINISH EARLY
========================= */

document.getElementById("finishButton").addEventListener("click",function(){

    if(!hasStarted){
        return;
    }

    clearInterval(timerInterval);

    isRunning = false;

    const elapsed =
        selectedMinutes -
        Math.ceil(secondsLeft / 60);

    if(elapsed > 0){

        totalDeepMinutes += elapsed;

        document.getElementById("deepMinutes").textContent =
            totalDeepMinutes;

        document.getElementById("finalDeepMinutes").textContent =
            totalDeepMinutes;

    }

    document.getElementById("timerStatus").textContent =
        "Session recorded";

    updateDiagnosis();

});


/* =========================
RESET
========================= */

document.getElementById("resetButton").addEventListener("click",function(){

    clearInterval(timerInterval);

    isRunning = false;
    hasStarted = false;

    secondsLeft = selectedMinutes * 60;

    document.getElementById("timerStatus").textContent =
        "Ready";

    document.getElementById("timerTask").textContent =
        "Define the work before you begin.";

    document.getElementById("pauseButton").textContent =
        "Pause";

    updateTimer();

});


/* =========================
INTERRUPTION COUNTERS
========================= */

function increment(id){

    const element =
        document.getElementById(id);

    let value =
        Number(element.textContent);

    value++;

    element.textContent =
        value;

    updateInterruptionTotal();

}


function updateInterruptionTotal(){

    const ids = [
        "phoneCount",
        "researchCount",
        "taskCount",
        "environmentCount"
    ];

    let total = 0;

    ids.forEach(function(id){

        total +=
            Number(document.getElementById(id).textContent);

    });

    document.getElementById("switchCount").textContent =
        total;

    document.getElementById("finalInterruptions").textContent =
        total;

    updateDiagnosis();

}


/* =========================
DIAGNOSIS
========================= */

function updateDiagnosis(){

    const interruptionTotal =
        Number(document.getElementById("finalInterruptions").textContent);

    const deepMinutes =
        Number(document.getElementById("finalDeepMinutes").textContent);

    const diagnosis =
        document.getElementById("diagnosis");

    if(deepMinutes === 0 && interruptionTotal === 0){

        diagnosis.textContent =
            "Your baseline is not established yet. Complete a concentration cycle and record interruptions.";

        return;

    }

    if(interruptionTotal >= 8){

        diagnosis.textContent =
            "Your primary bottleneck appears to be attention leakage. Do not immediately demand more discipline. Redesign the environment by removing recurring interruption sources.";

    }else if(interruptionTotal >= 4){

        diagnosis.textContent =
            "Your environment has moderate attention leakage. Identify the most frequent interruption and create friction around that behavior before increasing workload.";

    }else if(deepMinutes >= 90){

        diagnosis.textContent =
            "Strong concentration capacity is being demonstrated. Your next optimization target is output quality: measure what meaningful work each deep-work block actually produces.";

    }else{

        diagnosis.textContent =
            "Your environment is relatively controlled. The next performance gain should come from improving task definition, reducing startup friction, and increasing the value of each focused cycle.";

    }

}


/* =========================
INITIALIZE
========================= */

updateTimer();
updateDiagnosis();

</script>

