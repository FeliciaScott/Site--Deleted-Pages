<script>
(function() {
  "use strict";

  const root = document.getElementById("pk-workproof");
  if (!root) return;

  const $ = (id) => document.getElementById(id);

  /* =====================================================
     EVIDENCE BUILDER — FIELD MAPPING
     ===================================================== */
  const fields = [
    { input: "wp-title",        preview: "wp-preview-title",       empty: "Your Evidence Block" },
    { input: "wp-category",     preview: "wp-preview-category",    empty: "Not selected" },
    { input: "wp-diagnostic",   preview: "wp-preview-diagnostic",  empty: "Your explanation will appear here." },
    { input: "wp-artifact",     preview: "wp-preview-artifact",    empty: "Your work description will appear here." },
    { input: "wp-output",       preview: "wp-preview-output",      empty: "Your output will appear here." },
    { input: "wp-evidence",     preview: "wp-preview-evidence",    empty: "Your evidence list will appear here." },
    { input: "wp-impact",       preview: "wp-preview-impact",      empty: "Your impact explanation will appear here." },
    { input: "wp-reflection",   preview: "wp-preview-reflection",  empty: "Your reflection will appear here." },
    { input: "wp-status",       preview: "wp-preview-status",      empty: "In progress" }
  ];

  const requiredForProgress = [
    "wp-title", "wp-category", "wp-diagnostic", "wp-artifact",
    "wp-evidence", "wp-reflection"
  ];

  function updatePreview() {
    fields.forEach((f) => {
      const input = $(f.input);
      const preview = $(f.preview);
      if (!input || !preview) return;

      const value = input.value.trim();

      if (value) {
        preview.textContent = value;
        preview.classList.remove("wp-empty");
      } else {
        preview.textContent = f.empty;
        preview.classList.add("wp-empty");
      }
    });

    updateProgress();
  }

  function updateProgress() {
    const completed = requiredForProgress.filter((id) => {
      const el = $(id);
      return el && el.value.trim() !== "";
    }).length;

    const percent = Math.round(
      (completed / requiredForProgress.length) * 100
    );

    const fill = $("wp-progress-fill");
    const score = $("wp-score");
    const track = fill ? fill.parentElement : null;

    if (fill) fill.style.width = percent + "%";
    if (score) score.textContent = percent + "% complete";
    if (track && track.getAttribute("role") === "progressbar") {
      track.setAttribute("aria-valuenow", percent);
    }
  }

  /* =====================================================
     COPY EVIDENCE BLOCK
     ===================================================== */
  function buildEvidenceText() {
    const title = $("wp-title").value.trim() || "Untitled Evidence Block";
    const category = $("wp-category").value || "Not selected";
    const diagnostic = $("wp-diagnostic").value.trim() || "Not provided";
    const artifact = $("wp-artifact").value.trim() || "Not provided";
    const output = $("wp-output").value.trim() || "Not provided";
    const evidence = $("wp-evidence").value.trim() || "Not provided";
    const impact = $("wp-impact").value.trim() || "Not provided";
    const reflection = $("wp-reflection").value.trim() || "Not provided";
    const status = $("wp-status").value;

    return [
      "WORKPROOF — EVIDENCE BLOCK",
      "====================================",
      "",
      "TITLE: " + title,
      "CATEGORY: " + category,
      "STATUS: " + status,
      "",
      "1. DIAGNOSTIC HOOK",
      diagnostic,
      "",
      "2. ARTIFACT CORE",
      artifact,
      "",
      "3. SCALABLE OUTPUT",
      output,
      "",
      "4. SUPPORTING EVIDENCE",
      evidence,
      "",
      "5. PRACTICAL IMPACT",
      impact,
      "",
      "6. REFLECTION",
      reflection,
      "",
      "====================================",
      "PathKeeper WorkProof · Evidence record"
    ].join("\n");
  }

  function copyText(text) {
    if (navigator.clipboard && window.isSecureContext) {
      return navigator.clipboard.writeText(text);
    }

    return new Promise((resolve, reject) => {
      const textarea = document.createElement("textarea");
      textarea.value = text;
      textarea.style.position = "fixed";
      textarea.style.opacity = "0";
      document.body.appendChild(textarea);
      textarea.select();
      try {
        document.execCommand("copy");
        resolve();
      } catch (error) {
        reject(error);
      } finally {
        textarea.remove();
      }
    });
  }

  const copyBtn = $("wp-copy");
  const copyStatus = $("wp-copy-status");

  if (copyBtn) {
    copyBtn.addEventListener("click", () => {
      copyText(buildEvidenceText())
        .then(() => {
          copyStatus.textContent = "Evidence block copied to clipboard.";
          setTimeout(() => { copyStatus.textContent = ""; }, 3000);
        })
        .catch(() => {
          copyStatus.textContent = "Copy unavailable. Select the text manually.";
        });
    });
  }

  /* =====================================================
     CLEAR BUILDER
     ===================================================== */
  const clearBtn = $("wp-clear");
  if (clearBtn) {
    clearBtn.addEventListener("click", () => {
      if (!confirm("Clear all Evidence Builder fields?")) return;

      ["wp-title", "wp-diagnostic", "wp-artifact", "wp-output",
       "wp-evidence", "wp-impact", "wp-reflection"].forEach((id) => {
        const el = $(id);
        if (el) el.value = "";
      });

      $("wp-category").value = "";
      $("wp-status").value = "In progress";

      updatePreview();
      if (copyStatus) copyStatus.textContent = "Builder cleared.";
      setTimeout(() => { if (copyStatus) copyStatus.textContent = ""; }, 2000);
    });
  }

  /* =====================================================
     LIVE BINDINGS
     ===================================================== */
  fields.forEach((f) => {
    const input = $(f.input);
    if (input) {
      input.addEventListener("input", updatePreview);
      input.addEventListener("change", updatePreview);
    }
  });

  /* =====================================================
     READINESS CHECKLIST
     ===================================================== */
  const checklistItems = root.querySelectorAll("#wp-checklist input[type='checkbox']");
  const checklistResult = $("wp-check-result");

  function updateChecklist() {
    const total = checklistItems.length;
    const checked = Array.from(checklistItems).filter((c) => c.checked).length;

    if (!checklistResult) return;

    if (checked === total) {
      checklistResult.textContent =
        total + " of " + total + " checks completed. Evidence is ready for review.";
    } else if (checked === 0) {
      checklistResult.textContent =
        "0 of " + total + " readiness checks completed.";
    } else {
      checklistResult.textContent =
        checked + " of " + total + " readiness checks completed.";
    }
  }

  checklistItems.forEach((item) => {
    item.addEventListener("change", updateChecklist);
  });

  /* =====================================================
     CLAIM CONVERSION
     ===================================================== */
  const convertBtn = $("wp-convert");
  const converted = $("wp-converted");
  const copyConvertedBtn = $("wp-copy-converted");
  const claimStatus = $("wp-claim-status");

  if (convertBtn) {
    convertBtn.addEventListener("click", () => {
      const claim = $("wp-claim").value.trim();
      const action = $("wp-action").value.trim();
      const result = $("wp-result").value.trim();

      if (!claim || !action || !result) {
        if (claimStatus) {
          claimStatus.textContent =
            "Complete the claim, action, and result fields first.";
        }
        return;
      }

      const statement =
        "I " + action.replace(/^I\s+/i, "").replace(/\.$/, "") +
        ", producing " + result.replace(/^I\s+/i, "").replace(/\.$/, "") +
        ". This addresses the claim: \"" + claim + "\"";

      converted.textContent = statement;
      if (claimStatus) claimStatus.textContent = "Statement generated.";
    });
  }

  if (copyConvertedBtn) {
    copyConvertedBtn.addEventListener("click", () => {
      const text = converted.textContent.trim();
      if (!text || text.startsWith("Your improved statement")) {
        if (claimStatus) claimStatus.textContent = "Generate a statement first.";
        return;
      }

      copyText(text)
        .then(() => {
          if (claimStatus) claimStatus.textContent = "Statement copied.";
          setTimeout(() => {
            if (claimStatus) claimStatus.textContent = "";
          }, 2000);
        })
        .catch(() => {
          if (claimStatus) claimStatus.textContent = "Copy unavailable.";
        });
    });
  }

  /* =====================================================
     ASSET LIBRARY SEARCH / FILTER
     ===================================================== */
  const librarySearch = $("wp-library-search");
  const libraryFilter = $("wp-library-filter");
  const assetList = $("wp-asset-list");
  const libraryStatus = $("wp-library-status");

  function filterAssets() {
    if (!assetList) return;

    const query = (librarySearch.value || "").toLowerCase().trim();
    const category = libraryFilter.value;
    const assets = assetList.querySelectorAll(".wp-asset");

    let visible = 0;

    assets.forEach((asset) => {
      const assetCategory = asset.getAttribute("data-category");
      const text = asset.textContent.toLowerCase();

      const matchesSearch = !query || text.includes(query);
      const matchesCategory = category === "all" || assetCategory === category;

      if (matchesSearch && matchesCategory) {
        asset.style.display = "";
        visible++;
      } else {
        asset.style.display = "none";
      }
    });

    if (libraryStatus) {
      libraryStatus.textContent =
        "Showing " + visible + " of " + assets.length + " evidence examples.";
    }
  }

  if (librarySearch) librarySearch.addEventListener("input", filterAssets);
  if (libraryFilter) libraryFilter.addEventListener("change", filterAssets);

  /* Asset "Use as example" buttons — populate the builder */
  if (assetList) {
    assetList.addEventListener("click", (event) => {
      const btn = event.target.closest("button[data-example]");
      if (!btn) return;

      const example = btn.getAttribute("data-example");
      const artifactField = $("wp-artifact");

      if (artifactField) {
        artifactField.value = example;
        updatePreview();
        artifactField.focus();

        const builder = $("wp-builder");
        if (builder) {
          builder.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      }
    });
  }

  /* =====================================================
     RETURN TO BUILDER BUTTON
     ===================================================== */
  const returnBtn = $("wp-return-builder");
  if (returnBtn) {
    returnBtn.addEventListener("click", () => {
      const builder = $("wp-builder");
      if (builder) builder.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  }

  /* =====================================================
     INITIALIZE
     ===================================================== */
  updatePreview();
  updateChecklist();
  filterAssets();
})();
</script>

</body>
</html>
