function getAnswers(){
 const ids=[
 "audience","mission","problem","homepage","mainBlocker","navPlan","pagePolicy",
 "newPages","contentNeeds","pageOrder","primaryAction","buttonNeeds","visitorFlow",
 "linksState","design","images","proof","resourceTypes","mobile","automation",
 "opportunities","offerings","monetization","traffic","time","budget","risk",
 "fallback","success","deadline","extraNotes"
 ];
 const out={};
 ids.forEach(id=>out[id]=val(id));
 return out;
}

function makeStrategy(a){
 const tasks=[];
 const backups=[];
 const risks=[];
 const recommendations=[];

 function task(priority,title,detail){
  tasks.push({priority,title,detail});
 }

 task("HIGH","Set the mission and visitor outcome",
  `Define who PathKeeper serves and what visitors should accomplish. Audience: ${a.audience||"to be confirmed"}. Desired result: ${a.mission||"define a concrete result"}.`);

 if(a.homepage.includes("focused landing page")||!a.homepage){
  task("HIGH","Finish the focused landing page",
   "State the mission, explain how to use the site, and route visitors to the main sections. Keep the homepage focused instead of duplicating every topic page.");
 }else{
  task("HIGH","Improve the selected homepage approach",
   `Follow the chosen approach: ${a.homepage}. Preserve useful content and test the visitor journey before publishing.`);
 }

 task("HIGH","Review the page inventory",
  "Use the current inventory decisions. Confirm the page name, purpose, parent, and unique content before moving or merging any page.");

 if(pages.some(p=>p.action==="Merge")){
  task("HIGH","Review merge candidates without losing useful content",
   "Compare every Merge candidate with its proposed destination. Preserve unique sections, useful links, code, images, and examples before changing the live site.");
 }

 if(pages.some(p=>p.action==="Create")){
  task("MEDIUM","Evaluate proposed new pages",
   "Check whether each Create candidate needs a separate page or belongs as a section on an existing page. Create pages only when they have a distinct visitor purpose.");
 }

 task("HIGH","Complete the core navigation",
  "Use Home as the entry point. Connect Our Core Mission to About & How to Use, Free Library to Resource Vault, Explore Opportunities to Opportunity Atlas, and Build a Career Plan to Career Planning.");

 task("HIGH","Connect the visitor journey",
  `Use this intended flow as a starting point: ${a.visitorFlow||"Home → Opportunity Atlas → Intelligence Center / Mobility & Location → Career Planning → Execution & Progress → WorkProof"}. Test each destination on the published site.`);

 if(a.linksState!=="Mostly complete and tested"){
  task("HIGH","Test all important buttons and links",
   "Verify the button label, destination, and published URL. Remove or fix placeholders and check mobile behavior.");
 }

 task("HIGH","Add useful content to each priority page",
  `Include the purpose, useful information, resources, decision or action, and next step. Missing information identified: ${a.contentNeeds||"review each page brief and fill gaps"}.`);

 if(a.images==="Remove decorative pictures unless useful"){
  task("MEDIUM","Remove unnecessary decorative pictures",
   "Keep only visuals that explain a concept, support navigation, or provide useful proof of work.");
 }

 task("MEDIUM","Review evidence-of-work connections",
  `Connect Create Evidence, WorkProof, Evidence Block, resume redesign, and Portfolio Operator / PortfolioOS where relevant. Evidence requirements: ${a.proof||"define what counts as credible proof"}.`);

 task("MEDIUM","Improve the resource system",
  `Organize the Resource Vault around: ${a.resourceTypes||"guides, templates, checklists, and trusted resources"}. Link resource evaluation guidance to Information Quality and Resource Intelligence Center.`);

 if(a.mobile==="Not tested yet"||a.mobile==="Needs improvement"){
  task("HIGH","Test mobile layouts and buttons",
   "Review text readability, navigation, button spacing, tables, embeds, and downloads on a phone-sized screen.");
 }

 task("MEDIUM","Check page quality and current information",
  "Use logical H1/H2/H3 headings, descriptive page titles, useful image alt text, working internal links, official sources for opportunity details, and a last-checked date for changing information.");

 task("MEDIUM","Limit work to available resources",
  `Available time: ${a.time||"not specified"}. Budget: ${a.budget||"not specified"}. Complete the most important visitor path before optional redesigns.`);

 if(a.offerings||a.monetization){
  task("MEDIUM","Validate one sustainable offering",
   `Potential offerings: ${a.offerings||"not specified"}. Approach: ${a.monetization||"research demand before deciding"}. Define the deliverable, intended audience, boundaries, and evidence of demand before expanding.`);
 }

 task("MEDIUM","Set a measurable milestone",
  `Preferred measure: ${a.success||"a visitor completes a useful task"}. Target: ${a.deadline||"set a review date"}. Record what was completed and what still blocks progress.`);

 if(a.newPages){
  recommendations.push("Additional pages requested: "+a.newPages);
 }
 if(a.pageOrder){
  recommendations.push("Pages to prioritize first: "+a.pageOrder);
 }
 if(a.buttonNeeds){
  recommendations.push("Button/link issues to resolve: "+a.buttonNeeds);
 }
 if(a.automation){
  recommendations.push("Interactive features requested: "+a.automation);
 }
 if(a.opportunities){
  recommendations.push("Opportunity categories to prioritize: "+a.opportunities);
 }
 if(a.extraNotes){
  recommendations.push("Additional requirements: "+a.extraNotes);
 }
 if(a.navPlan){
  recommendations.push("Preferred navigation: "+a.navPlan);
 }

 const mergePages=pages.filter(p=>p.action==="Merge");
 const createPages=pages.filter(p=>p.action==="Create");
 const movePages=pages.filter(p=>p.action==="Move");
 const reviewPages=pages.filter(p=>p.action==="Review");
 const removePages=pages.filter(p=>p.action==="Remove");

 if(mergePages.length){
  recommendations.push("Merge candidates ("+mergePages.length+"): "+
   mergePages.map(p=>p.name+" → "+p.parent).join("; "));
 }
 if(createPages.length){
  recommendations.push("Create candidates ("+createPages.length+"): "+
   createPages.map(p=>p.name+" → "+p.parent).join("; "));
 }
 if(movePages.length){
  recommendations.push("Move candidates ("+movePages.length+"): "+
   movePages.map(p=>p.name+" → "+p.parent).join("; "));
 }
 if(reviewPages.length){
  recommendations.push("Review candidates ("+reviewPages.length+"): "+
   reviewPages.map(p=>p.name).join("; "));
 }
 if(removePages.length){
  recommendations.push("Removal candidates ("+removePages.length+"): "+
   removePages.map(p=>p.name).join("; ")+
   ". Confirm that useful content, code, images, and links have been preserved before any live removal.");
 }

 if(a.risk)risks.push("Risk identified: "+a.risk);
 if(a.mainBlocker==="Too many pages or drafts"||a.mainBlocker==="Unclear priorities"){
  risks.push("Scope risk: do not add another page until the current priority page has a clear purpose, complete core content, and working links.");
 }
 if(a.mainBlocker==="Finding visitors"){
  risks.push("Discovery risk: publishing alone does not guarantee visitors. Test one relevant discovery channel and measure actual use.");
 }
 if(a.mainBlocker==="Technical problems"){
  risks.push("Technical risk: prototype and test a feature in the published environment before depending on it across multiple pages.");
 }
 if(a.pagePolicy){
  recommendations.push("Duplicate handling rule: "+a.pagePolicy+".");
 }

 const fallback=a.fallback;
 if(fallback==="Focus on one audience"){
  backups.push("Reduce the site to one main audience and tailor the landing page, examples, navigation, and first action to that group.");
 }else if(fallback==="Focus on one page or tool"){
  backups.push("Focus on one useful page or tool. Make it work end-to-end before adding more sections.");
 }else if(fallback==="Improve existing pages gradually"){
  backups.push("Pause broad restructuring. Improve the highest-value existing pages one at a time, testing each change before moving on.");
 }else if(fallback==="Test one paid service separately"){
  backups.push("Test one defined service with a small audience. Validate the problem and willingness to pay before investing in a large product system.");
 }else if(fallback==="Ask users for feedback and revise"){
  backups.push("Ask a few intended visitors to complete the main action. Record where they hesitate and revise the most confusing step.");
 }else{
  backups.push("Launch a minimum useful version: a focused Home page, one core tool or resource, and tested links to the next step.");
 }

 backups.push("If a duplicate is difficult to resolve, preserve both versions temporarily, compare unique content and links, and defer the merge until the destination is clear.");
 backups.push("If time or budget becomes constrained, pause optional branding and secondary tools. Protect the main visitor path, accurate content, and working links.");
 backups.push("If traffic is low, check public access and indexing settings, improve the page's usefulness, and share one relevant resource directly with the intended audience.");
 backups.push("If an embed, script, or download fails, provide a simpler alternative and document the limitation instead of allowing the entire visitor journey to fail.");

 if(!risks.length)risks.push("Review scope, time, budget, page overlap, link quality, and visitor usefulness weekly.");

 return {tasks,backups,risks,recommendations};
}

function buildReport(a,s){
 const out=[];
 const add=(x="")=>out.push(x);
 add("PATHKEEPER — STRATEGY, PAGE INVENTORY & BACKUP PLAN");
 add("Generated: "+new Date().toLocaleString());
 add("=".repeat(66));
 add("");
 add("1. STRATEGIC DIRECTION");
 add("Audience: "+(a.audience||"To be confirmed"));
 add("Mission/result: "+(a.mission||"Define a measurable visitor outcome"));
 add("Problem: "+(a.problem||"Clarify the main problem PathKeeper solves"));
 add("Homepage approach: "+(a.homepage||"Create or confirm a focused landing page"));
 add("Primary action: "+(a.primaryAction||"Choose the main visitor action"));
 add("Success measure: "+(a.success||"A visitor completes a useful task"));
 add("Target milestone: "+(a.deadline||"Set a review date"));
 add("");
 add("2. PRIORITY ACTION PLAN");
 s.tasks.forEach((t,i)=>{
  add(`${i+1}. [${t.priority}] ${t.title}`);
  add("   "+t.detail);
  add("");
 });
 add("3. CURRENT PAGE INVENTORY AND DECISIONS");
 add("-".repeat(40));
 pages.forEach((p,i)=>{
  add(`${i+1}. ${p.name}`);
  add("   Parent: "+(p.parent||"Unassigned"));
  add("   Decision: "+p.action+" | Status: "+p.status);
  add("   Purpose: "+(p.purpose||"Not defined"));
  add("   Suggested content: "+(p.content||"Not defined"));
  add("   Buttons / related pages: "+(p.buttons||"Not defined"));
  add("   Published URL: "+(p.url||"Not supplied"));
  add("   Notes / next action: "+(p.notes||"None"));
  add("");
 });
 add("4. ADDITIONAL PAGE AND CONTENT REQUESTS");
 add("Navigation: "+(a.navPlan||"Use the proposed core navigation and confirm it"));
 add("New pages requested: "+(a.newPages||"None specified in questionnaire"));
 add("Missing content: "+(a.contentNeeds||"Review page briefs for gaps"));
 add("Pages to prioritize: "+(a.pageOrder||"Start with Home and the core visitor path"));
 add("Buttons needing attention: "+(a.buttonNeeds||"Test all core buttons"));
 add("Desired visitor flow: "+(a.visitorFlow||"Home → Opportunity Atlas → Intelligence Center / Mobility → Career Planning → Execution & Progress → WorkProof"));
 add("");
 add("5. RECOMMENDED SITE-WIDE CONTENT STANDARD");
 add("- Every page states its purpose and who it helps.");
 add("- Each page provides useful information, relevant resources, and a next step.");
 add("- Use official sources for eligibility, deadlines, fees, and applications.");
 add("- Add last-checked dates where information changes frequently.");
 add("- Use descriptive buttons and connect them to correct destinations.");
 add("- Check mobile layout and test the published version.");
 add("- Preserve unique content before merging or removing drafts.");
 add("");
 add("6. BACKUP PLAN");
 s.backups.forEach((x,i)=>add((i+1)+". "+x));
 add("");
 add("7. RISK CONTROLS");
 s.risks.forEach((x,i)=>add((i+1)+". "+x));
 add("");
 add("8. ADDITIONAL RECOMMENDATIONS");
 s.recommendations.forEach((x,i)=>add((i+1)+". "+x));
 if(!s.recommendations.length)add("Use the prioritized actions and page notes above.");
 add("");
 add("9. RESOURCE AND CONSTRAINT NOTES");
 add("Main blocker: "+(a.mainBlocker||"Not specified"));
 add("Available time: "+(a.time||"Not specified"));
 add("Budget: "+(a.budget||"Not specified"));
 add("Design: "+(a.design||"Not specified"));
 add("Image approach: "+(a.images||"Review image usefulness"));
 add("Proof of work: "+(a.proof||"Define evidence requirements"));
 add("Resources: "+(a.resourceTypes||"Organize useful reusable resources"));
 add("Interactive features: "+(a.automation||"Prioritize only features that help the visitor"));
 add("Traffic approach: "+(a.traffic||"Choose and test a discovery channel"));
 add("Paid offerings: "+(a.offerings||"Not specified"));
 add("Monetization approach: "+(a.monetization||"Validate demand before committing"));
 add("Additional notes: "+(a.extraNotes||"None"));
 add("");
 add("10. IMPORTANT LIMITATIONS");
 add("This is a planning tool, not a live Google Sites connection.");
 add("It does not automatically change, publish, delete, or move live pages.");
 add("Page purposes and suggested content are recommendations to review.");
 add("Verify actual page URLs, unique content, and links before implementation.");
 return out.join("\n");
}

