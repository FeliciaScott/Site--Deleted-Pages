let pages = [];
let addedIds = 0;
let latestReport = "";
let latestChecklist = "";

function cloneStarter(){return starterPages.map(p=>({...p,addedByUser:false}))}
function esc(v){return String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
function val(id){return document.getElementById(id)?.value?.trim()||""}

function renderInventory(){
 const q=val("searchPages").toLowerCase();
 const action=val("filterAction");
 const rows=document.getElementById("pageRows");
 const filtered=pages.map((p,i)=>({...p,_i:i})).filter(p=>{
  const hay=[p.name,p.parent,p.purpose,p.content,p.buttons,p.notes,p.action,p.status].join(" ").toLowerCase();
  return (!q||hay.includes(q))&&(!action||p.action===action);
 });

 rows.innerHTML=filtered.map(p=>`
 <tr data-index="${p._i}">
  <td>
   <input data-field="name" aria-label="Page title" value="${esc(p.name)}">
   ${p.addedByUser?'<span class="tag">Added</span>':""}
  </td>
  <td><input data-field="parent" aria-label="Parent page" value="${esc(p.parent)}"></td>
  <td><select data-field="action" aria-label="Editing decision">
   ${["Keep","Review","Merge","Move","Create","Remove"].map(x=>`<option ${p.action===x?"selected":""}>${x}</option>`).join("")}
  </select></td>
  <td><select data-field="status" aria-label="Completion status">
   ${["Not started","Researching","Drafting","Ready to build","Built in Google Sites","Published and tested","Blocked"].map(x=>`<option ${p.status===x?"selected":""}>${x}</option>`).join("")}
  </select></td>
  <td>
   <textarea data-field="purpose" aria-label="Purpose">${esc(p.purpose)}</textarea>
   <textarea data-field="content" aria-label="Suggested content" placeholder="Suggested content">${esc(p.content)}</textarea>
  </td>
  <td>
   <textarea data-field="buttons" aria-label="Buttons and links">${esc(p.buttons)}</textarea>
  </td>
  <td><input data-field="url" aria-label="Published URL" placeholder="Paste real URL" value="${esc(p.url)}"></td>
  <td><textarea data-field="notes" aria-label="Notes and next action">${esc(p.notes)}</textarea></td>
 </tr>`).join("");

 const merges=pages.filter(p=>p.action==="Merge").length;
 const creates=pages.filter(p=>p.action==="Create").length;
 const added=pages.filter(p=>p.addedByUser).length;
 const complete=pages.filter(p=>p.status==="Published and tested").length;
 document.getElementById("pageCount").textContent=pages.length;
 document.getElementById("addedCount").textContent=added;
 document.getElementById("mergeCount").textContent=merges;
 document.getElementById("createCount").textContent=creates;
 const pct=pages.length?Math.round(complete/pages.length*100):0;
 document.getElementById("progressFill").style.width=pct+"%";
 document.getElementById("progressText").textContent=
 `${complete} of ${pages.length} entries marked Published and tested (${pct}%).`;
}

function syncInventoryField(e){
 const el=e.target;
 if(!el.matches("[data-field]"))return;
 const row=el.closest("tr");
 if(!row)return;
 const i=Number(row.dataset.index);
 const key=el.dataset.field;
 if(!pages[i])return;
 pages[i][key]=el.value;
 document.getElementById("inventoryStatus").textContent=
 "Inventory changed. Generate a new report to include the latest edits.";
 if(key==="name"||key==="parent"||key==="action"||key==="status")renderInventory();
}

document.getElementById("pageRows").addEventListener("change",syncInventoryField);
document.getElementById("pageRows").addEventListener("input",syncInventoryField);
document.getElementById("searchPages").addEventListener("input",renderInventory);
document.getElementById("filterAction").addEventListener("change",renderInventory);

document.getElementById("showAll").addEventListener("click",()=>{
 document.getElementById("searchPages").value="";
 document.getElementById("filterAction").value="";
 renderInventory();
});

