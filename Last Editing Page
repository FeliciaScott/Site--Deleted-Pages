 </div>
 <div class="note"><strong>Before implementation:</strong> Preserve unique content, confirm page destinations, and verify actual URLs. This tool does not change Google Sites automatically.</div>`;
 document.getElementById("results").classList.add("show");
}

function generate(){
 const a=getAnswers();
 const s=makeStrategy(a);
 latestReport=buildReport(a,s);
 latestChecklist=[
 "PATHKEEPER — ACTION CHECKLIST",
 "",
 ...s.tasks.map((t,i)=>`[ ] ${i+1}. ${t.title}\n    ${t.detail}`),
 "",
 "BACKUP PLAN",
 ...s.backups.map((x,i)=>`[ ] B${i+1}. ${x}`),
 "",
 "PAGE DECISIONS TO VERIFY",
 ...pages.map(p=>`[ ] ${p.name} | ${p.action} | Parent: ${p.parent} | Status: ${p.status}`),
 "",
 "WEEKLY REVIEW",
 "[ ] What did I complete?",
 "[ ] What is still blocking progress?",
 "[ ] Are important links working?",
 "[ ] What did visitors find useful?",
 "[ ] What is the next highest-priority action?"
 ].join("\n");
 renderReport(a,s);
 document.getElementById("status").textContent=
 "Strategy generated from the current questionnaire answers and edited page inventory.";
 document.getElementById("results").scrollIntoView({behavior:"smooth",block:"start"});
}

function downloadFile(name,content,type){
 try{
  const blob=new Blob([content],{type});
  const url=URL.createObjectURL(blob);
  const a=document.createElement("a");
  a.href=url;a.download=name;document.body.appendChild(a);a.click();a.remove();
  setTimeout(()=>URL.revokeObjectURL(url),1500);
  document.getElementById("status").textContent="Download requested: "+name;
 }catch(e){
  document.getElementById("status").textContent=
  "Download could not start. Open this page directly in a browser and try again.";
 }
}

function csvCell(v){return '"'+String(v??"").replace(/"/g,'""')+'"'}
function downloadCSV(){
 const fields=["name","parent","action","status","purpose","content","buttons","url","notes"];
 const rows=[fields,...pages.map(p=>fields.map(k=>p[k]||""))];
 downloadFile("PathKeeper-Page-Inventory.csv",
  rows.map(r=>r.map(csvCell).join(",")).join("\r\n"),
  "text/csv;charset=utf-8");
}

function downloadJSON(){
 const backup={
  project:"PathKeeper",
  exportedAt:new Date().toISOString(),
  questionnaire:getAnswers(),
  pages:pages
 };
 downloadFile("PathKeeper-Project-Backup.json",
  JSON.stringify(backup,null,2),"application/json;charset=utf-8");
}

document.getElementById("generate").addEventListener("click",generate);
document.getElementById("downloadReport").addEventListener("click",()=>{
 if(!latestReport)generate();
 downloadFile("PathKeeper-Strategy-and-Backup-Plan.txt",latestReport,"text/plain;charset=utf-8");
});
document.getElementById("downloadAgain").addEventListener("click",()=>{
 if(!latestReport)generate();
 downloadFile("PathKeeper-Strategy-and-Backup-Plan.txt",latestReport,"text/plain;charset=utf-8");
});
document.getElementById("downloadChecklist").addEventListener("click",()=>{
 if(!latestChecklist)generate();
 downloadFile("PathKeeper-Action-Checklist.txt",latestChecklist,"text/plain;charset=utf-8");
});
document.getElementById("downloadJSON").addEventListener("click",downloadJSON);
document.getElementById("downloadInventory").addEventListener("click",downloadCSV);

pages=cloneStarter();
renderInventory();
</script>
