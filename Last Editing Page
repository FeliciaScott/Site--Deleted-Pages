  <div class="eyebrow">Generated from your answers and edited inventory</div>
  <h2>PathKeeper Strategy & Backup Plan</h2>
  <p><strong>Audience:</strong> ${esc(a.audience||"To be confirmed")}</p>
  <p><strong>Primary action:</strong> ${esc(a.primaryAction||"Choose a main visitor action")}</p>
  <p><strong>Inventory:</strong> ${pages.length} entries · ${merges.length} Merge · ${moves.length} Move · ${creates.length} Create · ${reviews.length} Review · ${removes.length} Remove candidates</p>
 </div>
 <h2>Priority actions</h2>${tasks}
 <div class="result-card">
  <h3>Page decision summary</h3>
  <p><strong>Merge candidates:</strong> ${esc(merges.map(p=>p.name).join(", ")||"None")}</p>
  <p><strong>Move candidates:</strong> ${esc(moves.map(p=>p.name).join(", ")||"None")}</p>
  <p><strong>Create candidates:</strong> ${esc(creates.map(p=>p.name).join(", ")||"None")}</p>
  <p><strong>Review candidates:</strong> ${esc(reviews.map(p=>p.name).join(", ")||"None")}</p>
  <p><strong>Remove candidates:</strong> ${esc(removes.map(p=>p.name).join(", ")||"None")}</p>
  <p class="small">These are the current worksheet decisions, not instructions to delete or alter live Google Sites pages.</p>
 </div>
 <div class="result-card backup">
  <h3>Backup plan</h3><ol>${backups}</ol>
 </div>
 <div class="result-card"><h3>Risk controls</h3><ul>${risks}</ul></div>
 <div class="result-card"><h3>Suggestions based on your answers</h3>
  ${rec?`<ul>${rec}</ul>`:"<p>Use the page-specific recommendations and priority actions above.</p>"}
 </div>
 <div class="result-card">
  <h3>Next milestone</h3>
