        <p class="text-xs text-google-gray mt-1 line-clamp-2" id="q4Desc">Full case study compilation, polish, and public release.</p>
      </div>
    </section>

    <!-- Interactive Accordions for Quarters -->
    <main class="space-y-4" id="syllabusContainer">
      <!-- Dynamic Quarters render here via JS -->
    </main>

    <!-- Google Drive & Google Docs Resource Hub Section -->
    <section class="bg-white rounded-xl border border-google-border p-5 shadow-sm mt-6">
      <div class="flex items-center gap-2 mb-3">
        <span class="material-symbols-outlined text-google-blue">folder_shared</span>
        <h2 class="text-base font-bold text-gray-900">Google Sites Workspace & Quick Links</h2>
      </div>
      <p class="text-xs text-google-gray mb-4">Access external course materials, template files, or turn in weekly deliverables using these mock links.</p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <a href="javascript:void(0)" onclick="alert('Mock Link: Redirecting to shared Google Drive Folder for syllabus templates.')" class="flex items-center gap-3 p-3 rounded-lg border border-google-border hover:bg-google-bg transition-colors group">
          <div class="w-9 h-9 rounded-md bg-blue-50 text-google-blue flex items-center justify-center font-bold">
            <span class="material-symbols-outlined">folder</span>
          </div>
          <div>
            <div class="text-xs font-semibold text-gray-900 group-hover:text-google-blue">Google Drive Assets</div>
            <div class="text-[11px] text-google-gray">Templates & Readings</div>
