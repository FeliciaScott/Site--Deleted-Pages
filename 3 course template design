    };

    // Application State
    let currentDomainKey = "ux";
    let userState = {
      completedTasks: {} // e.g. { "ux_1": true, "ux_2": false }
    };

    // Load from localStorage
    function loadSavedState() {
      const saved = localStorage.getItem("gSitesCurriculumState");
      if (saved) {
        try {
          userState = JSON.parse(saved);
        } catch(e) {
          console.error("Could not parse saved state", e);
        }
      }
      const savedDomain = localStorage.getItem("gSitesCurriculumDomain");
      if (savedDomain && domainData[savedDomain]) {
        currentDomainKey = savedDomain;
        document.getElementById("domainSelect").value = currentDomainKey;
      }
    }

    // Save to localStorage
    function saveState() {
      localStorage.setItem("gSitesCurriculumState", JSON.stringify(userState));
      localStorage.setItem("gSitesCurriculumDomain", currentDomainKey);
    }

    // Switch Domain
    function switchDomain(newDomain) {
      currentDomainKey = newDomain;
      saveState();
      renderApp();
    }

    // Render Function
    function renderApp() {
      const domain = domainData[currentDomainKey];
      
      // Update Title
      document.getElementById("courseTitle").innerText = domain.title;

      // Update Summaries for Q1-Q4 Cards
      domain.quarters.forEach(q => {
        const descEl = document.getElementById(`${q.id}Desc`);
        if (descEl) descEl.innerText = q.desc;
      });

      // Render Syllabus Accordions
      const container = document.getElementById("syllabusContainer");
      container.innerHTML = "";

      let totalTasksCount = 0;
      let completedTasksCount = 0;
      let totalLoggedHours = 0;
      let totalMilestones = 0;
      let completedMilestones = 0;

      domain.quarters.forEach((quarter, qIdx) => {
        let qTotalTasks = 0;
        let qCompletedTasks = 0;

        // Build Quarter Accordion Box
        const quarterEl = document.createElement("div");
        quarterEl.id = `quarter-${quarter.id}`;
        quarterEl.className = "bg-white rounded-xl border border-google-border shadow-sm overflow-hidden transition-all";

        let modulesHTML = "";

        quarter.modules.forEach(mod => {
          let tasksHTML = "";

          mod.tasks.forEach(task => {
            totalTasksCount++;
            qTotalTasks++;
            if (task.milestone) totalMilestones++;

            const isChecked = !!userState.completedTasks[task.id];
            if (isChecked) {
              completedTasksCount++;
              qCompletedTasks++;
              totalLoggedHours += task.hours;
              if (task.milestone) completedMilestones++;
            }

            tasksHTML += `
              <label class="flex items-start gap-3 p-2.5 rounded-lg hover:bg-google-bg transition-colors cursor-pointer group">
                <input type="checkbox" 
                       onchange="toggleTask('${task.id}')" 
                       ${isChecked ? 'checked' : ''} 
                       class="mt-1 w-4 h-4 text-google-blue rounded border-google-border focus:ring-google-blue cursor-pointer">
                <div class="flex-1 text-xs">
                  <span class="${isChecked ? 'line-through text-google-gray' : 'text-gray-800 font-medium'}">
                    ${task.text}
                  </span>
                  ${task.milestone ? '<span class="ml-2 text-[10px] font-bold text-amber-800 bg-google-yellowLight px-1.5 py-0.5 rounded">Milestone</span>' : ''}
                </div>
                <span class="text-[11px] text-google-gray font-mono">${task.hours} hrs</span>
              </label>
            `;
          });

          modulesHTML += `
            <div class="border-t border-gray-100 first:border-t-0 pt-3 mt-3 first:pt-0 first:mt-0">
              <h4 class="text-xs font-bold text-google-gray uppercase tracking-wider mb-2">${mod.title}</h4>
              <div class="space-y-1">${tasksHTML}</div>
            </div>
          `;
        });

        const qPercent = qTotalTasks > 0 ? Math.round((qCompletedTasks / qTotalTasks) * 100) : 0;
        document.getElementById(`${quarter.id}Percent`).innerText = `${qPercent}%`;

        quarterEl.innerHTML = `
          <details ${qIdx === 0 ? 'open' : ''} class="group">
            <summary class="flex items-center justify-between p-4 cursor-pointer select-none bg-white hover:bg-google-bg transition-colors">
              <div class="flex items-center gap-3">
                <span class="material-symbols-outlined text-google-gray group-open:rotate-180 transition-transform">expand_more</span>
                <div>
                  <h3 class="text-base font-bold text-gray-900">${quarter.name}</h3>
                  <p class="text-xs text-google-gray">${quarter.months} &bull; ${quarter.desc}</p>
                </div>
              </div>
              <div class="flex items-center gap-3">
                <span class="text-xs font-semibold px-2.5 py-1 rounded-full ${qPercent === 100 ? 'bg-google-greenLight text-google-green' : 'bg-google-blueLight text-google-blue'}">
                  ${qPercent}% Complete
                </span>
              </div>
            </summary>
            <div class="p-4 pt-2 border-t border-google-border bg-white space-y-4">
              ${modulesHTML}
            </div>
          </details>
        `;

        container.appendChild(quarterEl);
      });

      // Update Overall Summary Stats
      const overallPercent = totalTasksCount > 0 ? Math.round((completedTasksCount / totalTasksCount) * 100) : 0;
      document.getElementById("completionPercent").innerText = `${overallPercent}%`;
      document.getElementById("progressBar").style.width = `${overallPercent}%`;
      document.getElementById("loggedHours").innerText = totalLoggedHours;
      document.getElementById("completedMilestonesCount").innerText = completedMilestones;
      document.getElementById("totalMilestonesCount").innerText = totalMilestones;
    }

    // Toggle Checkbox
    function toggleTask(taskId) {
      userState.completedTasks[taskId] = !userState.completedTasks[taskId];
      saveState();
      renderApp();
    }

    // Reset Progress
    function resetProgress() {
      if (confirm("Are you sure you want to reset all completed tasks for this curriculum?")) {
        userState.completedTasks = {};
        saveState();
        renderApp();
      }
    }

    // Smooth Scroll Helper
    function scrollToQuarter(qId) {
      const el = document.getElementById(`quarter-${qId}`);
      if (el) {
        const details = el.querySelector("details");
        if (details) details.open = true;
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    // Initialize on Load
    window.onload = function() {
      loadSavedState();
      renderApp();
    };
  </script>
</body>
</html>
