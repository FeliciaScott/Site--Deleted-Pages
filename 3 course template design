        <a href="javascript:void(0)" onclick="alert('Mock Link: Redirecting to Google Docs Case Study Worksheet.')" class="flex items-center gap-3 p-3 rounded-lg border border-google-border hover:bg-google-bg transition-colors group">
          <div class="w-9 h-9 rounded-md bg-blue-50 text-google-blue flex items-center justify-center font-bold">
            <span class="material-symbols-outlined">description</span>
          </div>
          <div>
            <div class="text-xs font-semibold text-gray-900 group-hover:text-google-blue">Case Study Doc</div>
            <div class="text-[11px] text-google-gray">Interactive Workbook</div>
          </div>
        </a>

        <a href="javascript:void(0)" onclick="alert('Mock Link: Redirecting to Google Form for weekly milestone submission.')" class="flex items-center gap-3 p-3 rounded-lg border border-google-border hover:bg-google-bg transition-colors group">
          <div class="w-9 h-9 rounded-md bg-green-50 text-google-green flex items-center justify-center font-bold">
            <span class="material-symbols-outlined">assignment_turned_in</span>
          </div>
          <div>
            <div class="text-xs font-semibold text-gray-900 group-hover:text-google-green">Submit Deliverable</div>
            <div class="text-[11px] text-google-gray">Google Forms Review</div>
          </div>
        </a>
      </div>
    </section>

    <!-- Footer Controls -->
    <footer class="flex flex-col sm:flex-row items-center justify-between text-xs text-google-gray pt-2 pb-6 px-1 gap-2">
      <div>Yearly Curriculum Engine &bull; Ready for Google Sites iFrame Embed</div>
      <button onclick="resetProgress()" class="text-google-red hover:underline flex items-center gap-1">
        <span class="material-symbols-outlined text-sm">restart_alt</span> Reset Progress Data
      </button>
    </footer>

  </div>

