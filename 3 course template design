      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 text-google-blue font-semibold text-sm mb-1">
            <span class="material-symbols-outlined">school</span>
            <span>Self-Directed Mastery Program</span>
          </div>
          <h1 class="text-2xl md:text-3xl font-bold text-gray-900 tracking-tight" id="courseTitle">UX Content Strategy Curriculum</h1>
          <p class="text-sm text-google-gray mt-1">Structured 52-Week Learning Plan & Dynamic Portfolio Builder</p>
        </div>

        <!-- Domain Switcher Dropdown -->
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-2 bg-google-bg p-2 rounded-lg border border-google-border">
          <label for="domainSelect" class="text-xs font-semibold text-google-gray uppercase tracking-wider pl-1">Track:</label>
          <select id="domainSelect" onchange="switchDomain(this.value)" class="bg-white text-gray-900 text-sm font-medium rounded-md px-3 py-1.5 border border-google-border focus:ring-2 focus:ring-google-blue focus:outline-none w-full sm:w-auto cursor-pointer">
            <option value="ux">UX Content Strategy</option>
            <option value="tech-writing">Technical & Business Writing</option>
            <option value="design">Graphic Design & Branding</option>
            <option value="audio">Audio Editing & Sound Design</option>
          </select>
        </div>
      </div>

      <!-- Overall Progress Metrics Bar -->
      <div class="mt-6 pt-4 border-t border-google-border grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-google-blueLight p-3 rounded-lg border border-blue-100">
          <div class="text-xs font-medium text-google-blue uppercase">Total Completed</div>
          <div class="text-xl md:text-2xl font-bold text-google-blue mt-0.5" id="completionPercent">0%</div>
          <div class="w-full bg-blue-200 h-1.5 rounded-full mt-2 overflow-hidden">
            <div id="progressBar" class="bg-google-blue h-full transition-all duration-500" style="width: 0%"></div>
          </div>
        </div>

        <div class="bg-google-greenLight p-3 rounded-lg border border-green-100">
          <div class="text-xs font-medium text-google-green uppercase">Target Hours</div>
          <div class="text-xl md:text-2xl font-bold text-google-green mt-0.5"><span id="loggedHours">0</span> / 520 hrs</div>
          <div class="text-xs text-green-700 mt-1">10 hrs/week target</div>
        </div>

        <div class="bg-google-yellowLight p-3 rounded-lg border border-yellow-200">
          <div class="text-xs font-medium text-amber-800 uppercase">Milestones</div>
          <div class="text-xl md:text-2xl font-bold text-amber-900 mt-0.5"><span id="completedMilestonesCount">0</span> / <span id="totalMilestonesCount">16</span></div>
          <div class="text-xs text-amber-800 mt-1">Key Deliverables</div>
        </div>

        <div class="bg-purple-50 p-3 rounded-lg border border-purple-100">
          <div class="text-xs font-medium text-purple-700 uppercase">Active Phase</div>
          <div class="text-base md:text-lg font-bold text-purple-900 mt-0.5 truncate" id="activeQuarterLabel">Q1: Foundations</div>
          <div class="text-xs text-purple-700 mt-1" id="activeQuarterMonths">Jan – Mar</div>
        </div>
      </div>
    </header>

    <!-- Yearly 4-Quarter Overview Cards -->
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      <!-- Q1 Card -->
      <div onclick="scrollToQuarter('q1')" class="bg-white p-4 rounded-xl border border-google-border shadow-sm hover:shadow-md cursor-pointer transition-all hover:border-google-blue group">
