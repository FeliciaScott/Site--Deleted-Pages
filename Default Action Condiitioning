<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Default Action Conditioning</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:Arial,Helvetica,sans-serif;background:#0F2D22;color:#F3EBDD;line-height:1.8;}
.hero{background:linear-gradient(180deg,#194936,#0F2D22);padding:80px 20px;text-align:center;}
.hero h1{font-size:3rem;color:#D8B08C;margin-bottom:20px;}
.hero p{max-width:850px;margin:auto;font-size:1.1rem;}
.container{max-width:1150px;margin:auto;padding:60px 20px;}
section{margin-bottom:65px;}
h2{color:#D8B08C;border-left:5px solid #4B2E1E;padding-left:15px;font-size:2rem;margin-bottom:25px;}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:25px;}
.card{background:#173A2B;border:1px solid rgba(216,176,140,.25);padding:25px;border-radius:15px;transition:.3s;}
.card:hover{transform:translateY(-6px);border-color:#D8B08C;}
.card h3{color:#D8B08C;margin-bottom:12px;}
