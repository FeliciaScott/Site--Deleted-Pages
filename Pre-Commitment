/* -----------------------
   GLOBAL STYLES
------------------------*/

*{
margin:0;
padding:0;
box-sizing:border-box;
}

body{
font-family:Arial,Helvetica,sans-serif;
background:#0F2D22;
color:#F3EBDD;
line-height:1.6;
}

/* -----------------------
   HERO
------------------------*/

.hero{
background:linear-gradient(180deg,#194936,#0F2D22);
padding:50px 20px;
text-align:center;
}

.hero h1{
font-size:2.6rem;
color:#D8B08C;
margin-bottom:12px;
}

.hero p{
max-width:850px;
margin:auto;
font-size:1.1rem;
}

/* -----------------------
   LAYOUT
------------------------*/

.container{
max-width:1150px;
margin:auto;
padding:30px 20px;
}

section{
margin-bottom:40px;
}

h2{
font-size:1.8rem;
color:#D8B08C;
border-left:5px solid #4B2E1E;
padding-left:12px;
margin-bottom:18px;
}

/* -----------------------
   CARDS
------------------------*/

.grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
gap:20px;
}

.card{
background:#173A2B;
padding:20px;
border-radius:12px;
border:1px solid rgba(216,176,140,.25);
transition:.3s;
}

.card:hover{
transform:translateY(-4px);
border-color:#D8B08C;
}

.card h3{
color:#D8B08C;
margin-bottom:10px;
font-size:1.2rem;
}

/* -----------------------
   EXPERT TRIAD CONTAINER
------------------------*/

.triad-grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:20px;
}

.triad-card{
background:#173A2B;
padding:22px;
border-radius:12px;
border:1px solid rgba(216,176,140,.4);
}

.triad-card h3{
color:#D8B08C;
margin-bottom:12px;
font-size:1.25rem;
}

.triad-card ul{
padding-left:18px;
}

.triad-card li{
margin-bottom:8px;
font-size:0.95rem;
}

@media(max-width:900px){
.triad-grid{
grid-template-columns:1fr;
}
}

/* -----------------------
   QUOTES
------------------------*/

.quote{
background:#4B2E1E;
padding:25px;
border-radius:12px;
text-align:center;
font-size:1.1rem;
font-style:italic;
}

/* -----------------------
   TABLE
------------------------*/

table{
width:100%;
border-collapse:collapse;
}

th{
background:#4B2E1E;
padding:12px;
text-align:left;
}

td{
padding:12px;
border:1px solid rgba(255,255,255,.15);
}

tr:nth-child(even){
background:#173A2B;
}

/* -----------------------
   CHECKLIST
------------------------*/

.checklist{
background:#173A2B;
padding:25px;
border-radius:12px;
}

.checklist ul{
padding-left:20px;
}

.checklist li{
margin:8px 0;
}

/* -----------------------
   FOOTER
------------------------*/

footer{
background:#081D15;
padding:40px 20px;
text-align:center;
}

footer h2{
border:none;
}

@media(max-width:700px){
.hero h1{
font-size:2rem;
}
}

</style>

