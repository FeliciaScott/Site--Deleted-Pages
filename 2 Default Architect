<script>
/* AUDIO ENGINE */
const AudioEngine = {
  ctx:null,

  init(){
    if(!this.ctx){
      this.ctx = new (
        window.AudioContext ||
        window.webkitAudioContext
      )();
    }
  },

  playTone(freq,type,duration){
    this.init();

    const osc = this.ctx.createOscillator();
    const gain = this.ctx.createGain();

    osc.type = type;
    osc.frequency.setValueAtTime(freq,this.ctx.currentTime);

    gain.gain.setValueAtTime(0.08,this.ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(
      0.0001,
      this.ctx.currentTime + duration
    );

    osc.connect(gain);
    gain.connect(this.ctx.destination);

    osc.start();
    osc.stop(this.ctx.currentTime + duration);
  },

  playStart(){
    this.playTone(440,'sine',.12);
    setTimeout(()=>this.playTone(660,'sine',.15),100);
  },

  playPause(){
    this.playTone(330,'sine',.12);
  },

  playComplete(){
    this.playTone(523.25,'sine',.15);
    setTimeout(()=>this.playTone(659.25,'sine',.15),140);
    setTimeout(()=>this.playTone(783.99,'sine',.2),280);
  }
};

/* ACTION LIBRARY */
const actionLibrary = {
  Learning:{
    High:"Complete one focused lesson or practice exercise. Write down the concept you learned and one way to apply it.",
    Medium:"Study one short lesson section and write three points you want to remember.",
    Low:"Open your current learning resource and review one concept or example."
  },
  Career:{
    High:"Review three job descriptions or career paths. Identify the skills and evidence that appear repeatedly.",
    Medium:"Improve one section of your resume, portfolio, or professional profile.",
    Low:"Find one role or career path that interests you and save its requirements."
  },
  Financial:{
    High:"Review your current financial picture. Categorize recent spending and identify one decision that could improve your position.",
    Medium:"Review one bill, account, or financial obligation and record the next action it requires.",
    Low:"Write down one financial question you need to answer and identify a reliable source."
  },
  Health:{
    High:"Complete a planned wellbeing activity and record how you felt before and after.",
    Medium:"Prepare one practical meal, recovery step, or wellbeing routine for later today.",
    Low:"Choose one small supportive action, such as preparing water or organizing what you need."
  },
  Business:{
    High:"Test one business assumption. Review potential customers, competing offers, and evidence of demand.",
    Medium:"Write a one-paragraph description of a problem your business idea could solve.",
    Low:"List one customer problem you want to understand better."
  },
  Relationships:{
    High:"Prepare for an important conversation. Identify the issue, the outcome you want, and questions you need to ask.",
    Medium:"Send a thoughtful follow-up or clarify one outstanding communication.",
    Low:"Identify one person you need to contact and the main point you want to communicate."
  },
  Personal:{
    High:"Review a current goal and identify the decisions, habits, and conditions affecting your progress.",
    Medium:"Write a short reflection about one decision you made and what you learned from it.",
    Low:"Write down one thing you want to improve and the smallest useful action."
  },
  Environment:{
    High:"Redesign one part of your environment to make an important behavior easier to begin and repeat.",
    Medium:"Prepare your workspace or materials for the next important task.",
    Low:"Remove one small obstacle from the place where you plan to work."
  }
};

/* TIMER STATE */
let timerInterval = null;
let secondsLeft = 0;
let totalSeconds = 0;
let isRunning = false;
let completedSprints = 0;

const circleCircumference = 2 * Math.PI * 90;

/* GENERATE ACTION */
function generateAction(){
  const layer = document.getElementById('layer').value;
  const energy = document.getElementById('energy').value;
  const time = document.getElementById('time').value;

  const action = actionLibrary[layer][energy];

  document.getElementById('actionText').innerText = action;

  document.getElementById('actionBadge').innerText =
    `${layer} • ${energy} energy • ${time} min`;

  totalSeconds = parseInt(time,10) * 60;
  secondsLeft = totalSeconds;

  updateTimerDisplay();
  updateProgressCircle();

  document.getElementById('selectorForm').style.display = 'none';
  document.getElementById('outputSection').classList.add('active');

  AudioEngine.playStart();
  startTimer();

  document.getElementById('outputSection').scrollIntoView({
    behavior:'smooth',
    block:'center'
  });
}

/* DISPLAY TIMER */
function updateTimerDisplay(){
  const mins = Math.floor(secondsLeft / 60);
  const secs = secondsLeft % 60;

  const formatted =
    `${String(mins).padStart(2,'0')}:${String(secs).padStart(2,'0')}`;

  document.getElementById('timerDisplay').innerText = formatted;

  if(isRunning){
    document.title = `${formatted} - Action Sprint`;
  }
}

/* PROGRESS CIRCLE */
function updateProgressCircle(){
  const circle = document.getElementById('timerProgress');

  if(!totalSeconds){
    circle.style.strokeDashoffset = circleCircumference;
    return;
  }

  const offset =
    circleCircumference -
    (secondsLeft / totalSeconds) * circleCircumference;

  circle.style.strokeDashoffset = offset;
}

/* START TIMER */
function startTimer(){
  if(timerInterval){
    clearInterval(timerInterval);
  }

  isRunning = true;
  document.getElementById('toggleBtn').innerText = 'Pause';

  timerInterval = setInterval(()=>{
    if(secondsLeft > 0){
      secondsLeft--;
      updateTimerDisplay();
      updateProgressCircle();
    }else{
      clearInterval(timerInterval);
      timerInterval = null;
      isRunning = false;

      document.getElementById('timerDisplay').innerText = "DONE!";
      document.getElementById('toggleBtn').innerText = 'Finished';
      document.title = "Sprint Completed!";

      AudioEngine.playComplete();

      completedSprints++;
      document.getElementById('streakCount').innerText = completedSprints;
    }
  },1000);
}

/* PAUSE / RESUME */
function toggleTimer(){
  if(isRunning){
    clearInterval(timerInterval);
    timerInterval = null;
    isRunning = false;

    document.getElementById('toggleBtn').innerText = 'Resume';
    document.title = "Paused";

    AudioEngine.playPause();
  }else if(secondsLeft > 0){
    AudioEngine.playStart();
    startTimer();
  }
}

/* COMPLETE / RESET */
function completeSprint(){
  if(timerInterval){
    clearInterval(timerInterval);
    timerInterval = null;
  }

  if(secondsLeft < totalSeconds && secondsLeft > 0){
    completedSprints++;
    document.getElementById('streakCount').innerText = completedSprints;
  }

  isRunning = false;
  secondsLeft = 0;
  totalSeconds = 0;

  document.title = "Life Velocity — Micro-Action Engine";

  document.getElementById('outputSection').classList.remove('active');
  document.getElementById('selectorForm').style.display = 'block';

  window.scrollTo({top:0,behavior:'smooth'});
}
</script>

