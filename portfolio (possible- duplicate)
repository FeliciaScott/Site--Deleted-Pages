<script>

/* =====================================================
   PORTFOLIO OPERATOR
   COMPLETE APPLICATION LOGIC
===================================================== */


/* =====================================================
   DEFAULT STATE
===================================================== */

const DEFAULT_STATE = {

    xp: 0,

    completed: 0,

    audit: [],

    streak: 0,

    challenge: [],

    missions: [],

    lastActivity: null,

    bossDefeated: false

};


/* =====================================================
   LOAD STATE
===================================================== */

function loadState(){

    try{

        const saved =
            localStorage.getItem(
                "portfolioOperator"
            );

        if(!saved){

            return {
                ...DEFAULT_STATE
            };

        }

        const parsed =
            JSON.parse(saved);

        return {

            ...DEFAULT_STATE,

            ...parsed,

            audit:
                Array.isArray(parsed.audit)
                ? parsed.audit
                : [],

            missions:
                Array.isArray(parsed.missions)
                ? parsed.missions
                : [],

            challenge:
                Array.isArray(parsed.challenge)
                ? parsed.challenge
                : []

        };

    }catch(error){

        console.error(
            "Could not load progress:",
            error
        );

        return {
            ...DEFAULT_STATE
        };

    }

}


let state = loadState();


/* =====================================================
   SAVE STATE
===================================================== */

function saveState(){

    localStorage.setItem(
        "portfolioOperator",
        JSON.stringify(state)
    );

}


/* =====================================================
   TOAST
===================================================== */

let toastTimer;

function showToast(
    title,
    message
){

    const box =
        document.getElementById(
            "toast"
        );

    document.getElementById(
        "toastTitle"
    ).textContent = title;

    document.getElementById(
        "toastMessage"
    ).textContent = message;

    box.classList.add("show");

    clearTimeout(toastTimer);

    toastTimer =
        setTimeout(
            function(){

                box.classList.remove(
                    "show"
                );

            },
            2800
        );

}


/* =====================================================
   SCROLL
===================================================== */

function scrollToSection(id){

    const element =
        document.getElementById(id);

    if(!element){

        return;

    }

    element.scrollIntoView({
        behavior:"smooth",
        block:"start"
    });

}


/* =====================================================
   LEVEL CALCULATION
===================================================== */

function getLevel(){

    return Math.min(
        Math.floor(
            state.xp / 200
        ) + 1,
        5
    );

}


/* =====================================================
   RANK
===================================================== */

function getRank(){

    if(state.xp >= 800){

        return "UNIGNORABLE";

    }

    if(state.xp >= 600){

        return "OPERATOR";

    }

    if(state.xp >= 400){

        return "BUILDER";

    }

    if(state.xp >= 200){

        return "APPRENTICE";

    }

    return "STARTER";

}


/* =====================================================
   UPDATE PLAYER BAR
===================================================== */

function updatePlayer(){

    const level =
        getLevel();

    document.getElementById("xp")
        .textContent =
        state.xp;

    document.getElementById("level")
        .textContent =
        level;

    document.getElementById("completed")
        .textContent =
        `${state.completed}/8`;

    document.getElementById("rank")
        .textContent =
        getRank();

    document.getElementById("streak")
        .textContent =
        state.streak;

}


/* =====================================================
   UPDATE XP PROGRESS
===================================================== */

function updateProgress(){

    const level =
        getLevel();

    const levelStart =
        (level - 1) * 200;

    const progress =
        Math.min(
            (
                (
                    state.xp -
                    levelStart
                ) / 200
            ) * 100,
            100
        );

    const nextXP =
        level === 5
        ? 1000
        : level * 200;

    document.getElementById(
        "currentLevel"
    ).textContent =
        level;

    document.getElementById(
        "xpProgress"
    ).textContent =
        state.xp;

    document.getElementById(
        "nextXP"
    ).textContent =
        nextXP;

    document.getElementById(
        "progressFill"
    ).style.width =
        progress + "%";

}


/* =====================================================
   OBJECTIVE
===================================================== */

function updateObjective(){

    const missions =
        document.querySelectorAll(
            ".mission"
        );

    let nextMission = null;

    missions.forEach(
        function(mission){

            if(
                !mission.classList.contains(
                    "complete"
                ) &&
                !nextMission
            ){

                const heading =
                    mission.querySelector(
                        "h3"
                    );

                if(heading){

                    nextMission =
                        heading.textContent;

                }

            }

        }
    );

    const objective =
        document.getElementById(
            "objective"
        );

    if(nextMission){

        objective.textContent =
            nextMission;

    }else{

        objective.textContent =
            state.bossDefeated
            ? "Portfolio Complete"
            : "Final Boss";

    }

}


/* =====================================================
   PORTFOLIO SCORE
===================================================== */

function calculateScore(){

    const missionScore =
        state.completed * 7.5;

    const auditScore =
        state.audit.length * 4;

    const challengeScore =
        state.challenge.length * 1.5;

    return Math.min(
        Math.round(
            missionScore +
            auditScore +
            challengeScore
        ),
        100
    );

}


/* =====================================================
   SCORE DISPLAY
===================================================== */

function updateScore(){

    const score =
        calculateScore();

    document.getElementById(
        "portfolioScore"
    ).textContent =
        score;

    document.getElementById(
        "dashboardScore"
    ).textContent =
        score;

    const degrees =
        score * 3.6;

    document.getElementById(
        "scoreCircle"
    ).style.background =
        `
        radial-gradient(
            circle,
            var(--surface) 62%,
            transparent 63%
        ),
        conic-gradient(
            var(--lime) ${degrees}deg,
            #1c2934 ${degrees}deg
        )
        `;


    let message =
        "Portfolio Under Construction";


    if(score >= 80){

        message =
            "Unignorable Portfolio";

    }else if(score >= 60){

        message =
            "Strong Evidence System";

    }else if(score >= 40){

        message =
            "Portfolio Taking Shape";

    }else if(score >= 20){

        message =
            "Evidence Emerging";

    }


    document.getElementById(
        "scoreMessage"
    ).textContent =
        message;


    /* Score dimensions */

    const context =
        Math.min(
            state.completed * 20,
            100
        );

    const execution =
        Math.min(
            state.completed * 15,
            100
        );

    const production =
        Math.min(
            Math.max(
                state.completed - 2,
                0
            ) * 20,
            100
        );

    const verification =
        Math.min(
            state.audit.length * 20,
            100
        );


    setBar(
        "contextBar",
        "contextValue",
        context
    );

    setBar(
        "executionBar",
        "executionValue",
        execution
    );

    setBar(
        "productionBar",
        "productionValue",
        production
    );

    setBar(
        "verificationBar",
        "verificationValue",
        verification
    );

}


/* =====================================================
   SCORE BAR
===================================================== */

function setBar(
    barId,
    valueId,
    amount
){

    document.getElementById(
        barId
    ).style.width =
        amount + "%";

    document.getElementById(
        valueId
    ).textContent =
        amount + "%";

}


/* =====================================================
   COMPLETE MISSION
===================================================== */

function completeMission(button){

    const mission =
        button.closest(
            ".mission"
        );

    if(!mission){

        return;

    }

    const missions =
        [
            ...document.querySelectorAll(
                ".mission"
            )
        ];

    const index =
        missions.indexOf(
            mission
        );


    if(
        state.missions.includes(
            index
        )
    ){

        return;

    }


    const reward =
        Number(
            mission.dataset.xp
        ) || 100;


    state.xp += reward;

    state.completed =
        state.missions.length + 1;

    state.missions.push(
        index
    );


    registerActivity();


    mission.classList.add(
        "complete"
    );


    button.textContent =
        "Mission Complete";

    button.disabled = true;


    showToast(
        `+${reward} XP`,
        "Mission completed. Evidence strength increased."
    );


    saveState();

    updateAll();

}


/* =====================================================
   REGISTER ACTIVITY
===================================================== */

function registerActivity(){

    const today =
        new Date()
        .toISOString()
        .split("T")[0];


    if(
        state.lastActivity ===
        today
    ){

        return;

    }


    if(
        state.lastActivity
    ){

        const previous =
            new Date(
                state.lastActivity
            );

        const current =
            new Date(
                today
            );

        const difference =
            Math.round(
                (
                    current -
                    previous
                ) /
                (
                    1000 *
                    60 *
                    60 *
                    24
                )
            );


        if(
            difference === 1
        ){

            state.streak++;

        }else{

            state.streak = 1;

        }

    }else{

        state.streak = 1;

    }


    state.lastActivity =
        today;

}


/* =====================================================
   UPDATE LEVEL ROADMAP
===================================================== */

function updateLevels(){

    const level =
        getLevel();

    for(
        let i = 1;
        i <= 5;
        i++
    ){

        const card =
            document.getElementById(
                "levelCard" + i
            );

        card.classList.remove(
            "current",
            "locked",
            "unlocked"
        );


        if(
            i < level
        ){

            card.classList.add(
                "unlocked"
            );

        }


        if(
            i === level
        ){

            card.classList.add(
                "current"
            );

        }


        if(
            i > level
        ){

            card.classList.add(
                "locked"
            );

        }

    }

}


/* =====================================================
   ACHIEVEMENTS
===================================================== */

function updateAchievements(){

    const score =
        calculateScore();


    unlockBadge(
        "badge1",
        state.completed >= 1
    );

    unlockBadge(
        "badge2",
        state.completed >= 4
    );

    unlockBadge(
        "badge3",
        score >= 50
    );

    unlockBadge(
        "badge4",
        state.completed >= 6
    );

    unlockBadge(
        "badge5",
        state.completed >= 8
    );

}


function unlockBadge(
    id,
    condition
){

    const badge =
        document.getElementById(id);

    if(!badge){

        return;

    }

    if(condition){

        badge.classList.add(
            "unlocked"
        );

    }else{

        badge.classList.remove(
            "unlocked"
        );

    }

}


/* =====================================================
   AUDIT SYSTEM
===================================================== */

function setupAudit(){

    const checks =
        document.querySelectorAll(
            ".auditCheck"
        );


    checks.forEach(
        function(check,index){

            check.addEventListener(
                "change",
                function(){

                    if(
                        this.checked
                    ){

                        if(
                            !state.audit.includes(
                                index
                            )
                        ){

                            state.audit.push(
                                index
                            );

                            state.xp += 25;

                            registerActivity();

                            showToast(
                                "+25 XP",
                                "Audit evidence verified."
                            );

                        }

                    }else{

                        const position =
                            state.audit.indexOf(
                                index
                            );

                        if(
                            position !== -1
                        ){

                            state.audit.splice(
                                position,
                                1
                            );

                            state.xp =
                                Math.max(
                                    state.xp - 25,
                                    0
                                );

                            showToast(
                                "Audit Updated",
                                "Verification item removed."
                            );

                        }

                    }


                    saveState();

                    updateAll();

                }
            );

        }
    );

}


/* =====================================================
   RESTORE AUDIT
===================================================== */

function restoreAudit(){

    const checks =
        document.querySelectorAll(
            ".auditCheck"
        );


    checks.forEach(
        function(check,index){

            check.checked =
                state.audit.includes(
                    index
                );

        }
    );

}


/* =====================================================
   7 DAY CHALLENGE
===================================================== */

function completeDay(day){

    const days =
        [
            ...document.querySelectorAll(
                ".challenge-day"
            )
        ];

    const index =
        days.indexOf(
            day
        );


    if(index === -1){

        return;

    }


    if(
        state.challenge.includes(
            index
        )
    ){

        return;

    }


    state.challenge.push(
        index
    );

    state.xp += 25;

    registerActivity();


    day.classList.add(
        "done"
    );


