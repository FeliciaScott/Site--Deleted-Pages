/* =====================================================
   FINAL BOSS
===================================================== */

function attemptBoss(){

    const score =
        calculateScore();


    const missionsComplete =
        state.completed >= 8;

    const auditComplete =
        state.audit.length >= 5;

    const scoreComplete =
        score >= 80;


    if(
        missionsComplete &&
        auditComplete &&
        scoreComplete
    ){

        state.bossDefeated =
            true;

        saveState();

        updateAll();


        showToast(
            "🏆 BOSS DEFEATED",
            "You built an Unignorable Portfolio."
        );


        setTimeout(
            function(){

                alert(
                    "FINAL BOSS DEFEATED!\n\n" +
                    "You completed all 8 missions, " +
                    "finished the readiness audit, " +
                    "and reached a portfolio strength of " +
                    score +
                    "/100."
                );

            },
            400
        );


        return;

    }


    const remaining = [];


    if(!missionsComplete){

        remaining.push(
            `${8 - state.completed} missions remaining`
        );

    }


    if(!auditComplete){

        remaining.push(
            `${5 - state.audit.length} audit items remaining`
        );

    }


    if(!scoreComplete){

        remaining.push(
            `${80 - score} score points remaining`
        );

    }


    showToast(
        "FINAL BOSS LOCKED",
        remaining.join(" • ")
    );

}


