/* =====================================================
   INDUSTRY DISPLAY
===================================================== */

function showIndustry(
    industry,
    button
){

    document
        .querySelectorAll(
            ".tab"
        )
        .forEach(
            function(tab){

                tab.classList.remove(
                    "active"
                );

            }
        );


    if(button){

        button.classList.add(
            "active"
        );

    }


    const container =
        document.getElementById(
            "industryContent"
        );


    if(
        !industries[industry]
    ){

        return;

    }


    container.innerHTML = "";


    industries[industry]
        .forEach(
            function(item){

                const card =
                    document.createElement(
                        "div"
                    );


                card.className =
                    "explorer-card";


                card.innerHTML = `

                    <small>
                        ${item.label}
                    </small>

                    <h3>
                        ${item.title}
                    </h3>

                    <p>
                        ${item.desc}
                    </p>

                    <div class="takeaway">
                        ${item.takeaway}
                    </div>

                `;


                container.appendChild(
                    card
                );

            }
        );

}


/* =====================================================
   RESTORE MISSIONS
===================================================== */

function restoreMissions(){

    const missions =
        document.querySelectorAll(
            ".mission"
        );


    missions.forEach(
        function(mission,index){

            const button =
                mission.querySelector(
                    "button"
                );


            if(
                state.missions.includes(
                    index
                )
            ){

                mission.classList.add(
                    "complete"
                );

                button.textContent =
                    "Mission Complete";

                button.disabled =
                    true;

            }else{

                mission.classList.remove(
                    "complete"
                );

                button.textContent =
                    "Complete Mission";

                button.disabled =
                    false;

            }

        }
    );


    state.completed =
        state.missions.length;

}


