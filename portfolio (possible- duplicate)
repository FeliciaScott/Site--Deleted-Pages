function resetProgress(){

    const confirmed =
        confirm(
            "Reset all Portfolio Operator progress?\n\n" +
            "This will remove XP, missions, badges, audit progress, " +
            "challenge progress, and your streak."
        );


    if(!confirmed){

        return;

    }


    state = {
        ...DEFAULT_STATE
    };


    saveState();

    location.reload();

}


