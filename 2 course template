<script>

/* =========================================================
   COURSE SELECTION
========================================================= */

const courseRecommendations = {

  "MDN Web Development":
    "Best starting point for a beginner who wants strong web fundamentals without paying. Pair it with original projects and GitHub.",

  "The Odin Project":
    "Best fit for a learner who wants a deeper project-heavy JavaScript/full-stack route and is willing to spend substantial independent study time.",

  "freeCodeCamp":
    "Best fit for a learner who likes interactive exercises and wants a broad, free curriculum with many project opportunities.",

  "Google IT Automation with Python":
    "Best fit when the target is Python, automation or IT operations rather than primarily front-end web development.",

  "Austin Community College Web Development":
    "Best fit when local structure, instructor support and a formal Austin-area curriculum are more important than minimizing tuition."
};


function selectCourse(courseName){

  const cards = document.querySelectorAll(".course-card");

  cards.forEach(card => {

    card.classList.remove("selected");

    if(card.dataset.course === courseName){
      card.classList.add("selected");
    }

  });

  document.getElementById("selected-course").textContent = courseName;

  document.getElementById("course-recommendation").textContent =
    courseRecommendations[courseName] ||
    "Build a plan around the selected course.";

  localStorage.setItem(
    "selectedCourse",
    courseName
  );

}


/* =========================================================
   COURSE FILTER
========================================================= */

function filterCourses(type,button){

  const cards =
    document.querySelectorAll(".course-card");

  const buttons =
    document.querySelectorAll(".filter-btn");

  buttons.forEach(btn =>
    btn.classList.remove("active")
  );

  button.classList.add("active");

  cards.forEach(card => {

    if(type === "all"){
      card.classList.remove("hidden");
      return;
    }

    const categories =
      card.dataset.type.split(" ");

    if(categories.includes(type)){
      card.classList.remove("hidden");
    }else{
      card.classList.add("hidden");
    }

  });

}


/* =========================================================
   SCROLL
========================================================= */

function scrollToSection(id){

  const element =
    document.getElementById(id);

  if(element){

    element.scrollIntoView({
      behavior:"smooth"
    });

  }

}


/* =========================================================
   WEEKLY SCHEDULE CALCULATOR
========================================================= */

function calculateSchedule(){

  const hours =
    Number(
      document.getElementById(
        "available-hours"
      ).value
    ) || 0;

  const stage =
    document.getElementById(
      "job-stage"
    ).value;

  const weeks =
    Number(
      document.getElementById(
        "target-weeks"
      ).value
    );

  document.getElementById(
    "weekly-total"
  ).textContent =
    hours + " hours";

  let learning;
  let practice;
  let building;
  let jobSearch;

  if(stage === "beginner"){

    learning = hours * .45;
    practice = hours * .25;
    building = hours * .25;
    jobSearch = hours * .05;

  }

  else if(stage === "building"){

    learning = hours * .30;
    practice = hours * .20;
    building = hours * .40;
    jobSearch = hours * .10;

  }

  else{

    learning = hours * .20;
    practice = hours * .15;
    building = hours * .30;
    jobSearch = hours * .35;

  }

  const totalLearning =
    Math.round(learning * weeks);

  const totalBuilding =
    Math.round(building * weeks);

  const totalApplications =
    Math.max(
      1,
      Math.round(
        (jobSearch / 0.5) * weeks
      )
    );

  document.getElementById(
    "schedule-explanation"
  ).innerHTML =

    "Suggested weekly allocation: " +

    "<strong>" +
    learning.toFixed(1) +
    "h learning</strong>, " +

    "<strong>" +
    practice.toFixed(1) +
    "h practice</strong>, " +

    "<strong>" +
    building.toFixed(1) +
    "h building</strong>, " +

    "<strong>" +
    jobSearch.toFixed(1) +
    "h employment preparation</strong>. " +

    "Over " +
    weeks +
    " weeks this creates approximately " +
    totalLearning +
    " hours of learning and " +
    totalBuilding +
    " hours of project building.";

  const dayNames =
    [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday",
      "Sunday"
    ];

  const activities = [

    "Learn new material",
    "Practice without copying",
    "Build portfolio project",
    "Review + fix mistakes",
    "Job research + skill gap analysis",
    "Deep project work",
    "Weekly review + planning"

  ];

  const grid =
    document.getElementById(
      "schedule-grid"
    );

  grid.innerHTML = "";

  dayNames.forEach((day,index) => {

    const div =
      document.createElement("div");

    div.className = "day";

    div.innerHTML =
      "<strong>" +
      day +
      "</strong>" +

      "<p>" +
      activities[index] +
      "</p>" +

      "<p>" +
      Math.max(
        .5,
        (hours / 7).toFixed(1)
      ) +
      " planned hours</p>";

    grid.appendChild(div);

  });

}


/* =========================================================
   PORTFOLIO CHECKLIST
========================================================= */

const portfolioChecks =
  document.querySelectorAll(
    ".portfolio-check"
  );

function updatePortfolioScore(){

  let completed = 0;

  portfolioChecks.forEach(
    (checkbox,index) => {

      if(checkbox.checked){
        completed++;
      }

      localStorage.setItem(
        "portfolio-" + index,
        checkbox.checked
      );

    }
  );

  const total =
    portfolioChecks.length;

  const percentage =
    Math.round(
      (completed / total) * 100
    );

  document.getElementById(
    "portfolio-score"
  ).textContent =
    percentage + "%";

  document.getElementById(
    "portfolio-bar"
  ).style.width =
    percentage + "%";


  let message;

  if(percentage < 20){

    message =
      "You are still creating the foundation. Focus on producing your first public project.";

  }

  else if(percentage < 50){

    message =
      "You have early evidence. Keep building original work rather than only completing lessons.";

  }

  else if(percentage < 80){

    message =
      "Your portfolio is becoming credible. Compare your projects directly against job descriptions.";

  }

  else{

    message =
      "Strong evidence base. Shift increasing time toward applications, interviews and closing remaining skill gaps.";

  }

  document.getElementById(
    "readiness-message"
  ).textContent =
    message;

}


portfolioChecks.forEach(
  checkbox => {

    checkbox.addEventListener(
      "change",
      updatePortfolioScore
    );

  }
);


/* =========================================================
   RESTORE SAVED DATA
========================================================= */

function restoreData(){

  const savedCourse =
    localStorage.getItem(
      "selectedCourse"
    );

  if(savedCourse){

    selectCourse(savedCourse);

  }


  portfolioChecks.forEach(
    (checkbox,index) => {

      const saved =
        localStorage.getItem(
          "portfolio-" + index
        );

      if(saved === "true"){

        checkbox.checked = true;

      }

    }
  );

  updatePortfolioScore();

  calculateSchedule();

}


/* =========================================================
   INITIALIZE
========================================================= */

restoreData();

</script>

