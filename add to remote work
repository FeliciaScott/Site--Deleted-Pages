<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Remote Career Programs & Strategy Guide</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>

:root{
    --green:#43a978;
    --green-dark:#24704e;
    --dark:#153243;
    --dark-2:#0f2633;
    --light:#f5fff9;
    --accent:#e8fff1;
    --cream:#fffdf7;
    --text:#333;
    --muted:#65727a;
    --white:#ffffff;
    --border:#dce9e2;
    --warning:#fff6dc;
    --warning-border:#e4c66d;
    --danger:#fff0ed;
    --danger-border:#e0a59a;
    --shadow:0 12px 30px rgba(0,0,0,.07);
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

html{
    scroll-behavior:smooth;
}

body{
    background:var(--light);
    color:var(--text);
    line-height:1.7;
}

a{
    color:inherit;
}

/* HERO */

header{
    background:linear-gradient(135deg,#153243,#24704e);
    color:white;
    text-align:center;
    padding:90px 8%;
}

header .eyebrow{
    display:inline-block;
    background:rgba(255,255,255,.12);
    padding:7px 16px;
    border-radius:30px;
    margin-bottom:20px;
    font-size:.85rem;
    font-weight:600;
    letter-spacing:.5px;
}

header h1{
    font-size:clamp(2.2rem,5vw,4rem);
    line-height:1.15;
    max-width:950px;
    margin:0 auto 20px;
}

header p{
    max-width:800px;
    margin:auto;
    font-size:1.08rem;
    opacity:.93;
}

/* INTRO */

.intro{
    padding:65px 8%;
    text-align:center;
    background:var(--white);
}

.intro h2{
    color:var(--dark);
    margin-bottom:15px;
    font-size:2rem;
}

.intro p{
    max-width:850px;
    margin:auto;
    color:var(--muted);
}

/* GENERAL */

.container{
    padding:70px 8%;
    max-width:1400px;
    margin:auto;
}

.section-title{
    text-align:center;
    color:var(--dark);
    margin-bottom:15px;
    font-size:2.2rem;
}

.section-description{
    text-align:center;
    max-width:850px;
    margin:0 auto 45px;
    color:var(--muted);
}

.grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(290px,1fr));
    gap:25px;
}

.card{
    background:white;
    border:1px solid var(--border);
    border-radius:18px;
    overflow:hidden;
    box-shadow:var(--shadow);
    transition:.25s;
}

.card:hover{
    transform:translateY(-5px);
    box-shadow:0 18px 40px rgba(0,0,0,.10);
}

.card-header{
    background:var(--green);
    color:white;
    padding:18px 20px;
    font-size:1.15rem;
    font-weight:600;
}

.card-body{
    padding:22px;
}

.card-body p{
    color:var(--muted);
    margin-bottom:12px;
}

.card-body ul{
    padding-left:20px;
    margin-bottom:18px;
}

.card-body li{
    margin-bottom:6px;
}

.tag{
    display:inline-block;
    background:var(--accent);
    color:var(--green-dark);
    padding:5px 10px;
    border-radius:20px;
    font-size:.75rem;
    font-weight:600;
    margin:3px;
}

.sources{
    margin-top:18px;
    background:var(--accent);
    padding:13px;
    border-radius:10px;
}

.sources h4{
    margin-bottom:8px;
    color:var(--dark);
}

.sources a{
    display:block;
    color:var(--dark);
    text-decoration:none;
    margin-bottom:6px;
    font-weight:500;
}

.sources a:hover{
    text-decoration:underline;
}

/* CAREER STRATEGY */

.strategy{
    background:var(--dark);
    color:white;
    max-width:none;
    padding-left:8%;
    padding-right:8%;
}

.strategy .section-title{
    color:white;
}

.strategy .section-description{
    color:#d9e7e1;
}

.strategy-introduction{
    max-width:950px;
    margin:0 auto 40px;
    background:#1c4050;
    border:1px solid rgba(255,255,255,.12);
    border-radius:18px;
    padding:28px;
}

.strategy-introduction strong{
    color:#70d59f;
}

.strategy-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(230px,1fr));
    gap:20px;
    max-width:1200px;
    margin:auto;
}

.strategy-card{
    background:#1c4050;
    border:1px solid rgba(255,255,255,.1);
    padding:25px;
    border-radius:16px;
}

.strategy-number{
    width:38px;
    height:38px;
    border-radius:50%;
    background:#62c994;
    color:#153243;
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:700;
    margin-bottom:15px;
}

.strategy-card h3{
    margin-bottom:10px;
}

.strategy-card p{
    color:#d9e7e1;
}

.strategy-card ul{
    padding-left:18px;
    margin-top:10px;
    color:#d9e7e1;
}

.strategy-card li{
    margin-bottom:5px;
}

/* DECISION RULE */

.rule-box{
    max-width:1000px;
    margin:40px auto 0;
    padding:25px;
    border-radius:16px;
    background:#102c3a;
    border-left:5px solid #69d49b;
}

.rule-box h3{
    margin-bottom:10px;
}

.rule-box p{
    color:#d9e7e1;
}

/* TIMELINE */

.timeline-section{
    background:var(--cream);
    max-width:none;
}

.timeline{
    max-width:950px;
    margin:auto;
    position:relative;
}

.timeline::before{
    content:"";
    position:absolute;
    left:22px;
    top:0;
    bottom:0;
    width:3px;
    background:#b9dcca;
}

.timeline-item{
    position:relative;
    padding-left:65px;
    margin-bottom:30px;
}

.timeline-dot{
    position:absolute;
    left:8px;
    top:4px;
    width:30px;
    height:30px;
    border-radius:50%;
    background:var(--green);
    border:5px solid var(--cream);
}

.timeline-content{
    background:white;
    border:1px solid var(--border);
    padding:23px;
    border-radius:14px;
    box-shadow:var(--shadow);
}

.timeline-content h3{
    color:var(--dark);
    margin-bottom:8px;
}

.timeline-content strong{
    color:var(--green-dark);
}

/* SCORECARD */

.score-section{
    background:white;
    max-width:none;
}

.scorecard{
    max-width:1050px;
    margin:auto;
    overflow-x:auto;
}

.scorecard table{
    width:100%;
    border-collapse:collapse;
    background:white;
}

.scorecard th,
.scorecard td{
    padding:15px;
    border:1px solid var(--border);
    text-align:left;
}

.scorecard th{
    background:var(--dark);
    color:white;
}

.scorecard tr:nth-child(even){
    background:#f8fcfa;
}

/* FAILURE STRATEGY */

.failure{
    background:#fffaf0;
    max-width:none;
}

.failure-box{
    max-width:1100px;
    margin:auto;
    background:white;
    border:1px solid var(--warning-border);
    border-radius:18px;
    padding:30px;
    box-shadow:var(--shadow);
}

.failure-box h3{
    color:#715719;
    margin-bottom:12px;
}

.failure-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:20px;
    margin-top:25px;
}

.failure-card{
    padding:20px;
    border-radius:12px;
    background:#fffdf7;
    border:1px solid #eadfbd;
}

.failure-card h4{
    color:var(--dark);
    margin-bottom:8px;
}

.failure-card p{
    color:var(--muted);
}

/* DECISION */

.decision{
    background:var(--light);
    max-width:none;
}

.decision-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
    gap:20px;
    max-width:1100px;
    margin:auto;
}

.decision-card{
    padding:25px;
    border-radius:16px;
    background:white;
    border:1px solid var(--border);
}

.decision-card h3{
    color:var(--dark);
    margin-bottom:10px;
}

.decision-card p{
    color:var(--muted);
}

.decision-card ul{
    padding-left:20px;
    margin-top:12px;
}

.keep{
    border-top:5px solid var(--green);
}

.pivot{
    border-top:5px solid #d5a72d;
}

.stop{
    border-top:5px solid #c55c4e;
}

/* CHECKLIST */

.checklist{
    background:var(--dark-2);
    color:white;
    max-width:none;
}

.checklist .section-title{
    color:white;
}

.checklist .section-description{
    color:#d9e7e1;
}

.checklist ul{
    max-width:850px;
    margin:auto;
    list-style:none;
}

.checklist li{
    background:#173545;
    margin-bottom:12px;
    padding:16px 20px;
    border-radius:10px;
}

.checklist li::before{
    content:"✓";
    color:#69d49b;
    font-weight:bold;
    margin-right:12px;
}

/* CTA */

.cta{
    background:linear-gradient(135deg,#43a978,#24704e);
    color:white;
    text-align:center;
    padding:80px 8%;
}

.cta h2{
    font-size:2.3rem;
    margin-bottom:15px;
}

.cta p{
    max-width:800px;
    margin:auto;
    opacity:.95;
}

/* FOOTER */

footer{
    background:#0b1d28;
    color:#d6e3df;
    text-align:center;
    padding:30px 8%;
}

footer p{
    margin-bottom:6px;
}

/* MOBILE */

@media(max-width:700px){

    header{
        padding:65px 6%;
    }

    .container{
        padding:55px 6%;
    }

    .strategy{
        padding-left:6%;
        padding-right:6%;
    }

    .timeline::before{
        left:15px;
    }

    .timeline-item{
        padding-left:48px;
    }

    .timeline-dot{
        left:1px;
    }

    .scorecard{
        font-size:.85rem;
    }

}

</style>
</head>

<body>


<!-- HERO -->

<header>

    <span class="eyebrow">REMOTE CAREER STRATEGY GUIDE</span>

    <h1>
        Don't Just Collect Certifications. Build Evidence That Gets You Hired.
    </h1>

    <p>
        Explore remote career paths, sample skills before spending money,
        build proof of ability, measure interview results, and know when to
        continue, pivot, or stop.
    </p>

</header>


<!-- INTRO -->

<section class="intro">

    <h2>A Certification Is Not the Career</h2>

    <p>
        A certificate can demonstrate that you completed training, but employers
        may still want experience, projects, communication skills, problem-solving
        ability, and evidence that you can perform the actual work.
        The better approach is:
        <strong>research → sample → build → apply → measure → adjust.</strong>
    </p>

</section>


<!-- STRATEGY -->

<section class="container strategy" id="strategy">

    <h2 class="section-title">
        The Career Testing Strategy
    </h2>

    <p class="section-description">
        Before spending months earning a credential, test whether the career
        actually fits you and whether employers are likely to value the skills
        you are building.
    </p>


    <div class="strategy-introduction">

        <h3>Think Like an Investor</h3>

        <p>
            Your time, money, attention, and energy are limited resources.
            Do not invest heavily in a career simply because a certification
            advertisement says it can lead to a high-paying job.
        </p>

        <p>
            First gather evidence. Then increase your investment.
            <strong>The size of your investment should increase only when
            the evidence gets stronger.</strong>
        </p>

    </div>


    <div class="strategy-grid">

        <div class="strategy-card">

            <div class="strategy-number">1</div>

            <h3>Research the Jobs</h3>

            <p>
                Start with the employer rather than the certification.
            </p>

            <ul>
                <li>Review 20–30 job postings.</li>
                <li>Record repeated skills.</li>
                <li>Record required tools.</li>
                <li>Look for common job titles.</li>
                <li>Notice experience requirements.</li>
            </ul>

        </div>


        <div class="strategy-card">

            <div class="strategy-number">2</div>

            <h3>Sample the Career</h3>

            <p>
                Spend 7–14 days learning the basics for free.
            </p>

            <ul>
                <li>Complete beginner lessons.</li>
                <li>Perform actual exercises.</li>
                <li>Try realistic tasks.</li>
                <li>Notice what feels difficult.</li>
                <li>Determine whether you dislike the work.</li>
            </ul>

        </div>


        <div class="strategy-card">

            <div class="strategy-number">3</div>

            <h3>Build Proof</h3>

            <p>
                Turn learning into something an employer can evaluate.
            </p>

            <ul>
                <li>Build a project.</li>
                <li>Create a case study.</li>
                <li>Document your process.</li>
                <li>Use realistic business problems.</li>
                <li>Publish appropriate work samples.</li>
            </ul>

        </div>


        <div class="strategy-card">

            <div class="strategy-number">4</div>

            <h3>Test the Market</h3>

            <p>
                Do not wait until you have collected every possible credential.
            </p>

            <ul>
                <li>Target appropriate entry-level jobs.</li>
                <li>Customize applications.</li>
                <li>Track employer responses.</li>
                <li>Practice interviews.</li>
                <li>Record recurring rejection patterns.</li>
            </ul>

        </div>


        <div class="strategy-card">

            <div class="strategy-number">5</div>

            <h3>Find the Bottleneck</h3>

            <p>
                Determine exactly where your job search is breaking down.
            </p>

            <ul>
                <li>No responses?</li>
                <li>No interviews?</li>
                <li>Failing technical assessments?</li>
                <li>Failing interviews?</li>
                <li>No offers?</li>
            </ul>

        </div>


        <div class="strategy-card">

            <div class="strategy-number">6</div>

            <h3>Invest Intelligently</h3>

            <p>
                Only increase spending when the evidence supports it.
            </p>

            <ul>
                <li>Buy targeted training.</li>
                <li>Earn relevant certifications.</li>
                <li>Build stronger projects.</li>
                <li>Gain practical experience.</li>
                <li>Expand your professional network.</li>
            </ul>

        </div>

    </div>


    <div class="rule-box">

        <h3>The 3-Question Rule</h3>

        <p>
            Before paying for a certification, ask:
            <strong>Do target jobs request it?</strong>
            <strong>Will it teach a skill I actually need?</strong>
            <strong>What evidence will I have after completing it?</strong>
            If you cannot answer these questions, keep researching before spending money.
        </p>

    </div>

</section>


<!-- TIMELINE -->

<section class="container timeline-section">

    <h2 class="section-title">
        12-Week Sample Career Experiment
    </h2>

    <p class="section-description">
        Use this as a starting framework. The objective is to create enough
        evidence to make a rational career decision instead of guessing.
    </p>


    <div class="timeline">


        <div class="timeline-item">

            <div class="timeline-dot"></div>

            <div class="timeline-content">

                <h3>Week 1 — Investigate</h3>

                <p>
                    Choose two or three possible career paths.
                    Review real job postings and identify repeated requirements.
                </p>

                <p>
                    <strong>Deliverable:</strong>
                    A comparison sheet showing skills, tools, certifications,
                    experience requirements, and job titles.
                </p>

            </div>

        </div>


        <div class="timeline-item">

            <div class="timeline-dot"></div>

            <div class="timeline-content">

                <h3>Weeks 2–3 — Sample</h3>

                <p>
                    Use free resources to experience the actual work.
                    Avoid passive learning. Complete exercises and small tasks.
                </p>

                <p>
                    <strong>Deliverable:</strong>
                    One small completed project.
                </p>

            </div>

        </div>


        <div class="timeline-item">

            <div class="timeline-dot"></div>

            <div class="timeline-content">

                <h3>Weeks 4–5 — Build Evidence</h3>

                <p>
                    Create a more realistic project that demonstrates
                    the skills employers are requesting.
                </p>

                <p>
                    <strong>Deliverable:</strong>
                    Portfolio project, case study, GitHub repository,
                    dashboard, campaign, workflow, documentation,
                    or another appropriate work sample.
                </p>

            </div>

        </div>


        <div class="timeline-item">

            <div class="timeline-dot"></div>

            <div class="timeline-content">

                <h3>Weeks 6–7 — Begin Applying</h3>

                <p>
                    Start applying to realistic entry-level positions.
                    Do not apply randomly to hundreds of unrelated jobs.
                </p>

                <p>
                    <strong>Track:</strong>
                    Applications, responses, recruiter contacts,
                    assessments, interviews, and rejection reasons.
                </p>

            </div>

        </div>


        <div class="timeline-item">

            <div class="timeline-dot"></div>

            <div class="timeline-content">

                <h3>Weeks 8–9 — Diagnose</h3>

                <p>
                    Look at your application funnel.
                    If you have no interviews, investigate your application.
                    If you get interviews but no offers, investigate interviewing.
                </p>

                <p>
                    <strong>Deliverable:</strong>
                    A written list of the biggest bottleneck and the
                    specific change you will test next.
                </p>

            </div>

        </div>


        <div class="timeline-item">

            <div class="timeline-dot"></div>

            <div class="timeline-content">

                <h3>Weeks 10–12 — Validate</h3>

                <p>
                    Continue applying while improving your skills,
                    evidence, resume, and interview performance.
                </p>

                <p>
                    <strong>Final decision:</strong>
                    Continue, pivot, or stop investing heavily in this path.
                </p>

            </div>

        </div>


    </div>

</section>


<!-- SCORECARD -->

<section class="container score-section">

    <h2 class="section-title">
        Measure the Job Search Funnel
    </h2>

    <p class="section-description">
        Do not ask only, "Am I learning?"
        Ask whether the learning is producing better career outcomes.
    </p>


    <div class="scorecard">

        <table>

            <thead>

                <tr>
                    <th>Metric</th>
                    <th>What It Measures</th>
                    <th>Warning Sign</th>
                    <th>What To Investigate</th>
                </tr>

            </thead>

            <tbody>

                <tr>

                    <td>Applications</td>

                    <td>
                        Amount of effort entering the pipeline
                    </td>

                    <td>
                        Very few applications
                    </td>

                    <td>
                        Time management, job availability, targeting
                    </td>

                </tr>


                <tr>

                    <td>Employer Responses</td>

                    <td>
                        Whether your profile is attracting attention
                    </td>

                    <td>
                        Almost no responses
                    </td>

                    <td>
                        Resume, keywords, job fit, experience, portfolio
                    </td>

                </tr>


                <tr>

                    <td>Interviews</td>

                    <td>
                        Whether applications convert into conversations
                    </td>

                    <td>
                        Many applications but few interviews
                    </td>

                    <td>
                        Resume, qualifications, targeting, evidence
                    </td>

                </tr>


                <tr>

                    <td>Interview Progression</td>

                    <td>
                        Whether interviews turn into later stages
                    </td>

                    <td>
                        Repeated interview rejection
                    </td>

                    <td>
                        Interview preparation, communication, technical knowledge
                    </td>

                </tr>


                <tr>

                    <td>Offers</td>

                    <td>
                        Whether the complete strategy produces employment
                    </td>

                    <td>
                        No offers after meaningful testing
                    </td>

                    <td>
                        Overall positioning, skills, experience, market demand
                    </td>

                </tr>

            </tbody>

        </table>

    </div>

</section>


<!-- PROGRAMS -->

<section class="container" id="programs">

    <h2 class="section-title">
        Free & Low-Cost Starting Points
    </h2>

    <p class="section-description">
