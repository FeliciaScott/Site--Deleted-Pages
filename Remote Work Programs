                    <a href="https://grow.google/certificates/" target="_blank">
                        Google Career Certificates
                    </a>
                </div>

            </div>
        </div>


        <div class="card">
            <div class="card-header">Microsoft Learn</div>
            <div class="card-body">

                <p>
                    Free learning paths covering cloud, data, security,
                    Microsoft products, and technical fundamentals.
                </p>

                <span class="tag">Cloud</span>
                <span class="tag">IT</span>
