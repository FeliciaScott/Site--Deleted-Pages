<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Remote Career Programs & Strategy Guide</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>

:root{
    --green:#43a978;
    --green-dark:#24704e;
    --dark:#153243;
    --dark-2:#0f2633;
    --light:#f5fff9;
    --accent:#e8fff1;
    --cream:#fffdf7;
    --text:#333;
    --muted:#65727a;
    --white:#ffffff;
    --border:#dce9e2;
    --warning:#fff6dc;
    --warning-border:#e4c66d;
    --danger:#fff0ed;
    --danger-border:#e0a59a;
    --shadow:0 12px 30px rgba(0,0,0,.07);
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

html{
    scroll-behavior:smooth;
}

body{
    background:var(--light);
    color:var(--text);
    line-height:1.7;
}

a{
    color:inherit;
}

header{
    background:linear-gradient(135deg,#153243,#24704e);
    color:white;
    text-align:center;
    padding:90px 8%;
}

header .eyebrow{
    display:inline-block;
    background:rgba(255,255,255,.12);
    padding:7px 16px;
    border-radius:30px;
    margin-bottom:20px;
    font-size:.85rem;
    font-weight:600;
    letter-spacing:.5px;
}

header h1{
    font-size:clamp(2.2rem,5vw,4rem);
    line-height:1.15;
    max-width:950px;
    margin:0 auto 20px;
}

header p{
    max-width:800px;
    margin:auto;
    font-size:1.08rem;
    opacity:.93;
}

.hero-actions{
    margin-top:30px;
    display:flex;
    justify-content:center;
    gap:15px;
    flex-wrap:wrap;
}

.btn{
    display:inline-block;
    padding:13px 22px;
    border-radius:10px;
    text-decoration:none;
    font-weight:600;
    transition:.2s;
}

.btn-primary{
    background:white;
    color:var(--dark);
}

.btn-secondary{
    border:1px solid rgba(255,255,255,.5);
    color:white;
}

.btn:hover{
    transform:translateY(-2px);
}

.intro{
    padding:65px 8%;
    text-align:center;
    background:var(--white);
}

.intro h2{
    color:var(--dark);
    margin-bottom:15px;
    font-size:2rem;
}

.intro p{
    max-width:850px;
    margin:auto;
    color:var(--muted);
}

.container{
    padding:70px 8%;
    max-width:1400px;
    margin:auto;
}

.section-title{
    text-align:center;
    color:var(--dark);
    margin-bottom:15px;
    font-size:2.2rem;
}

.section-description{
    text-align:center;
    max-width:800px;
    margin:0 auto 45px;
    color:var(--muted);
}

.grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(290px,1fr));
    gap:25px;
}

.card{
    background:white;
    border:1px solid var(--border);
    border-radius:18px;
    overflow:hidden;
    box-shadow:var(--shadow);
    transition:.25s;
}

.card:hover{
    transform:translateY(-5px);
    box-shadow:0 18px 40px rgba(0,0,0,.10);
}

.card-header{
    background:var(--green);
    color:white;
    padding:18px 20px;
    font-size:1.15rem;
    font-weight:600;
}

.card-body{
    padding:22px;
}

.card-body p{
    color:var(--muted);
    margin-bottom:12px;
}

.card-body ul{
    padding-left:20px;
    margin-bottom:18px;
}

.card-body li{
    margin-bottom:6px;
}

.tag{
    display:inline-block;
    background:var(--accent);
    color:var(--green-dark);
    padding:5px 10px;
    border-radius:20px;
    font-size:.75rem;
    font-weight:600;
    margin:3px;
}

.sources{
    margin-top:18px;
    background:var(--accent);
    padding:13px;
    border-radius:10px;
}

.sources h4{
    margin-bottom:8px;
    color:var(--dark);
}

.sources a{
    display:block;
    color:var(--dark);
    text-decoration:none;
    margin-bottom:6px;
    font-weight:500;
}

.sources a:hover{
    text-decoration:underline;
}

/* STRATEGY */

.strategy{
    background:var(--dark);
    color:white;
}

.strategy .section-title{
    color:white;
}

.strategy .section-description{
    color:#d9e7e1;
}

.strategy-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
    gap:20px;
}

.strategy-card{
    background:#1c4050;
    border:1px solid rgba(255,255,255,.1);
    padding:25px;
    border-radius:16px;
}

.strategy-number{
    width:38px;
    height:38px;
    border-radius:50%;
    background:#62c994;
    color:#153243;
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:700;
    margin-bottom:15px;
}

.strategy-card h3{
    margin-bottom:10px;
}

.strategy-card p{
    color:#d9e7e1;
}

/* TIMELINE */

.timeline-section{
    background:var(--cream);
}

.timeline{
    max-width:950px;
    margin:auto;
    position:relative;
}

.timeline::before{
    content:"";
    position:absolute;
    left:22px;
    top:0;
    bottom:0;
    width:3px;
    background:#b9dcca;
}

.timeline-item{
    position:relative;
    padding-left:65px;
    margin-bottom:30px;
}

.timeline-dot{
    position:absolute;
    left:8px;
    top:4px;
    width:30px;
    height:30px;
    border-radius:50%;
    background:var(--green);
    border:5px solid var(--cream);
}

.timeline-content{
    background:white;
    border:1px solid var(--border);
    padding:23px;
    border-radius:14px;
    box-shadow:var(--shadow);
}

.timeline-content h3{
    color:var(--dark);
    margin-bottom:8px;
}

.timeline-content strong{
    color:var(--green-dark);
}

/* SCORECARD */

.score-section{
    background:white;
}

.scorecard{
    max-width:1000px;
    margin:auto;
    overflow-x:auto;
}

.scorecard table{
    width:100%;
    border-collapse:collapse;
    background:white;
}

.scorecard th,
.scorecard td{
    padding:15px;
    border:1px solid var(--border);
    text-align:left;
}

.scorecard th{
    background:var(--dark);
    color:white;
}

.scorecard tr:nth-child(even){
    background:#f8fcfa;
}

/* FAILURE PLAN */

.failure{
    background:#fffaf0;
}

.failure-box{
    max-width:1050px;
    margin:auto;
    background:white;
    border:1px solid var(--warning-border);
    border-radius:18px;
    padding:30px;
    box-shadow:var(--shadow);
}

.failure-box h3{
    color:#715719;
    margin-bottom:12px;
}

.failure-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:20px;
    margin-top:25px;
}

.failure-card{
    padding:20px;
    border-radius:12px;
    background:#fffdf7;
    border:1px solid #eadfbd;
}

.failure-card h4{
    color:var(--dark);
    margin-bottom:8px;
}

/* DECISION */

.decision{
    background:var(--light);
}

.decision-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
    gap:20px;
}

.decision-card{
    padding:25px;
    border-radius:16px;
    background:white;
    border:1px solid var(--border);
}

.decision-card h3{
    color:var(--dark);
    margin-bottom:10px;
}

.keep{
    border-top:5px solid var(--green);
}

.pivot{
    border-top:5px solid #d5a72d;
}

.stop{
    border-top:5px solid #c55c4e;
}

/* CHECKLIST */

.checklist{
    background:var(--dark-2);
    color:white;
}

.checklist .section-title{
    color:white;
}

.checklist ul{
    max-width:850px;
    margin:auto;
    list-style:none;
}

.checklist li{
    background:#173545;
    margin-bottom:12px;
    padding:16px 20px;
    border-radius:10px;
}

.checklist li::before{
    content:"✓";
    color:#69d49b;
    font-weight:bold;
    margin-right:12px;
}

/* CTA */

.cta{
    background:linear-gradient(135deg,#43a978,#24704e);
    color:white;
    text-align:center;
    padding:80px 8%;
}

.cta h2{
    font-size:2.3rem;
    margin-bottom:15px;
}

.cta p{
    max-width:750px;
    margin:auto;
    opacity:.95;
}

/* FOOTER */

footer{
    background:#0b1d28;
    color:#d6e3df;
    text-align:center;
    padding:30px 8%;
}

footer p{
    margin-bottom:6px;
}

@media(max-width:700px){

    header{
        padding:65px 6%;
    }

    .container{
        padding:55px 6%;
    }

    .timeline::before{
        left:15px;
    }

    .timeline-item{
        padding-left:48px;
    }

    .timeline-dot{
        left:1px;
    }

    .scorecard{
        font-size:.85rem;
    }

}

</style>
</head>

<body>

<!-- HERO -->

<header>

    <span class="eyebrow">REMOTE CAREER STRATEGY GUIDE</span>

    <h1>
        A Certification is Not the Career    </h1>

    <div class="hero-actions">
