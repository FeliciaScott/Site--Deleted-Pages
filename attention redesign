<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Attention Fragmentation Control | Attention Control Lab</title>

<style>

/* =========================================================
   ATTENTION CONTROL LAB
   COLOR SYSTEM
========================================================= */

:root{
    --midnight:#0D1B2A;
    --coral:#FEC89A;
    --ice:#E0E1DD;
    --steel:#1B263B;

    --steel-light:#263750;
    --steel-dark:#131F31;

    --success:#FEC89A;
    --muted:rgba(224,225,221,.68);
    --faint:rgba(224,225,221,.10);
    --border:rgba(254,200,154,.22);

    --shadow:0 25px 70px rgba(0,0,0,.30);
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

    background:var(--midnight);
    color:var(--ice);
    line-height:1.7;
    overflow-x:hidden;
}

button,
input,
select,
textarea{
    font:inherit;
}

button{
    cursor:pointer;
}

button:focus-visible,
input:focus-visible,
textarea:focus-visible,
select:focus-visible{
    outline:2px solid var(--coral);
    outline-offset:3px;
}

/* =========================================================
   GLOBAL
========================================================= */

.page{
    width:100%;
}

.container{
    width:min(1180px,calc(100% - 40px));
    margin:auto;
}

.section{
    padding:95px 0;
}

.eyebrow{
    display:inline-flex;
    align-items:center;
    gap:10px;
    color:var(--coral);
    font-size:.72rem;
    font-weight:900;
    text-transform:uppercase;
    letter-spacing:.18em;
    margin-bottom:18px;
}

.eyebrow::before{
    content:"";
    width:30px;
    height:1px;
    background:var(--coral);
}

h1,
h2,
h3{
    letter-spacing:-.035em;
}

h2{
    font-size:clamp(2rem,4vw,3.4rem);
    line-height:1.05;
    margin-bottom:18px;
}

h3{
    line-height:1.2;
}

.muted{
    color:var(--muted);
}

.small{
    font-size:.82rem;
}

/* =========================================================
   SCROLL PROGRESS
========================================================= */

.scroll-line{
    position:fixed;
    top:0;
    left:0;
    width:0%;
    height:4px;
    background:var(--coral);
    z-index:9999;
    box-shadow:0 0 20px rgba(254,200,154,.45);
}

/* =========================================================
   HEADER
========================================================= */

.header{
    position:sticky;
    top:0;
    z-index:900;

    background:rgba(13,27,42,.92);
    backdrop-filter:blur(16px);

    border-bottom:1px solid var(--faint);
}

.header-inner{
    width:min(1180px,calc(100% - 40px));
    min-height:72px;
    margin:auto;

    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
}

.logo{
    color:var(--ice);
    text-decoration:none;
    font-size:.82rem;
    font-weight:900;
    letter-spacing:.13em;
    text-transform:uppercase;
}

.logo span{
    color:var(--coral);
}

.header-nav{
    display:flex;
    gap:5px;
}

.header-nav button{
    border:1px solid transparent;
    background:none;
    color:var(--muted);
    padding:9px 12px;
    border-radius:999px;
    font-size:.76rem;
    transition:.2s;
}

.header-nav button:hover{
    color:var(--coral);
    border-color:var(--border);
    background:rgba(254,200,154,.04);
}

.header-xp{
    display:flex;
    align-items:center;
    gap:10px;
    border:1px solid var(--border);
    background:var(--steel);
    padding:8px 13px;
    border-radius:999px;
    color:var(--coral);
    font-size:.75rem;
    font-weight:900;
}

/* =========================================================
   HERO
========================================================= */

.hero{
    position:relative;
    min-height:760px;
    display:flex;
    align-items:center;
    overflow:hidden;

    background:
        radial-gradient(
            circle at 78% 35%,
            rgba(254,200,154,.08),
            transparent 25%
        ),
        radial-gradient(
            circle at 15% 15%,
            rgba(224,225,221,.035),
            transparent 28%
        ),
        var(--midnight);
}

.hero::before{
    content:"";
    position:absolute;
    width:650px;
    height:650px;
    right:-300px;
    top:60px;
    border:1px solid rgba(254,200,154,.12);
    border-radius:50%;
}

.hero::after{
    content:"";
    position:absolute;
    width:440px;
    height:440px;
    right:-190px;
    top:165px;
    border:1px dashed rgba(224,225,221,.12);
    border-radius:50%;
}

.hero-grid{
    width:min(1180px,calc(100% - 40px));
    margin:auto;

    display:grid;
    grid-template-columns:1.05fr .95fr;
    gap:70px;
    align-items:center;

    position:relative;
    z-index:2;
}

.hero h1{
    font-size:clamp(3.2rem,7vw,6.5rem);
    line-height:.93;
    max-width:760px;
}

.hero h1 span{
    color:var(--coral);
}

.hero-copy{
    max-width:650px;
    color:var(--muted);
    font-size:1.05rem;
    margin:25px 0 32px;
}

.hero-actions{
    display:flex;
    flex-wrap:wrap;
    gap:12px;
}

.primary{
    border:1px solid var(--coral);
    background:var(--coral);
    color:var(--midnight);

    padding:14px 22px;
    border-radius:999px;

    font-weight:900;
    transition:.25s;
}

.primary:hover{
    transform:translateY(-3px);
    box-shadow:0 15px 35px rgba(254,200,154,.15);
}

.secondary{
    border:1px solid var(--border);
    background:transparent;
    color:var(--ice);

    padding:14px 22px;
    border-radius:999px;

    font-weight:800;
    transition:.25s;
}

.secondary:hover{
    border-color:var(--coral);
    color:var(--coral);
}

/* =========================================================
   HERO CONTROL CORE
========================================================= */

.control-core{
    width:min(420px,90vw);
    height:420px;
    margin:auto;
    position:relative;

    display:grid;
    place-items:center;
}

.core-ring{
    position:absolute;
    border-radius:50%;
    border:1px solid var(--border);
}

.core-ring.one{
    width:100%;
    height:100%;
    animation:spin 25s linear infinite;
}

.core-ring.two{
    width:72%;
    height:72%;
    border-style:dashed;
    animation:spinReverse 18s linear infinite;
}

.core-ring.three{
    width:45%;
    height:45%;
    border-color:rgba(224,225,221,.15);
}

@keyframes spin{
    to{
        transform:rotate(360deg);
    }
}

@keyframes spinReverse{
    to{
        transform:rotate(-360deg);
    }
}

.core{
    width:150px;
    height:150px;

    border-radius:50%;
    background:var(--steel);

    border:2px solid var(--coral);

    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;

    box-shadow:
        0 0 0 20px rgba(254,200,154,.03),
        0 0 70px rgba(254,200,154,.10);

    text-align:center;
}

.core-number{
    color:var(--coral);
    font-size:2.7rem;
    font-weight:900;
    line-height:1;
}

.core-label{
    color:var(--muted);
    font-size:.7rem;
    letter-spacing:.12em;
    text-transform:uppercase;
    font-weight:800;
}

.core-node{
    position:absolute;

    width:112px;
    height:112px;

    border-radius:50%;
    background:var(--steel);

    border:1px solid var(--border);

    display:flex;
    align-items:center;
    justify-content:center;

    text-align:center;

    font-size:.75rem;
    font-weight:800;

    transition:.25s;
}

.core-node:hover{
    border-color:var(--coral);
    color:var(--coral);
    transform:scale(1.06);
}

.node-input{
    top:-5px;
    left:50%;
    transform:translateX(-50%);
}

.node-switch{
    right:-5px;
    top:50%;
    transform:translateY(-50%);
}

.node-recovery{
    bottom:-5px;
    left:50%;
    transform:translateX(-50%);
}

.node-output{
    left:-5px;
    top:50%;
    transform:translateY(-50%);
}

/* =========================================================
   QUOTE
========================================================= */

.quote{
    padding:35px 40px;

    border:1px solid var(--border);
    border-radius:24px;

    background:
        linear-gradient(
            135deg,
            rgba(254,200,154,.06),
            rgba(27,38,59,.65)
        );

    box-shadow:var(--shadow);
}

.quote p{
    font-size:clamp(1.3rem,3vw,2rem);
    font-style:italic;
    max-width:900px;
    margin:auto;
    text-align:center;
}

/* =========================================================
   DASHBOARD
========================================================= */

.dashboard{
    margin-top:-70px;
    position:relative;
    z-index:20;
}

.dashboard-grid{
    display:grid;
    grid-template-columns:1.25fr .75fr;
    gap:18px;
}

.dashboard-card{
    background:var(--steel);
    border:1px solid var(--border);
    border-radius:22px;
    padding:25px;
    box-shadow:var(--shadow);
}

.dashboard-title{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
    margin-bottom:20px;
}

.dashboard-title h3{
    font-size:1.1rem;
}

.status{
    color:var(--coral);
    font-size:.7rem;
    font-weight:900;
    text-transform:uppercase;
    letter-spacing:.1em;
}

.metric-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:10px;
}

.metric{
    background:rgba(13,27,42,.5);
    border:1px solid var(--faint);
    border-radius:14px;
    padding:17px;
}

.metric strong{
    display:block;
    color:var(--coral);
    font-size:1.5rem;
}

.metric span{
    color:var(--muted);
    font-size:.7rem;
}

.level{
    display:flex;
    align-items:center;
    gap:18px;
}

.level-badge{
    width:70px;
    height:70px;
    border-radius:50%;

    display:grid;
    place-items:center;

    border:2px solid var(--coral);
    color:var(--coral);

    font-weight:900;
}

.level-info{
    flex:1;
}

.level-info strong{
    display:block;
    margin-bottom:8px;
}

.xp-track{
    height:8px;
    background:var(--midnight);
    border-radius:999px;
    overflow:hidden;
}

.xp-fill{
    width:0%;
    height:100%;
    background:var(--coral);
    transition:.4s;
}

/* =========================================================
   SECTION HEADING
========================================================= */

.section-heading{
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
    gap:30px;
    margin-bottom:35px;
}

.section-heading p{
    max-width:520px;
    color:var(--muted);
}

/* =========================================================
   SYSTEM MODEL
========================================================= */

.model{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:12px;
}

.model-step{
    position:relative;
    background:var(--steel);
    border:1px solid var(--faint);
    border-radius:20px;
    padding:25px;
    min-height:230px;
    transition:.3s;
}

.model-step:hover{
    transform:translateY(-6px);
    border-color:var(--border);
}

.model-number{
    color:var(--coral);
    font-size:.7rem;
    font-weight:900;
    letter-spacing:.15em;
}

.model-step h3{
    margin:35px 0 12px;
}

.model-step p{
    color:var(--muted);
    font-size:.88rem;
}

.model-arrow{
    position:absolute;
    right:-18px;
    top:50%;
    transform:translateY(-50%);
    color:var(--coral);
    z-index:5;
}

/* =========================================================
   LEAK SCANNER
========================================================= */

.scanner{
    display:grid;
    grid-template-columns:.8fr 1.2fr;
    gap:20px;
}

.scanner-intro{
    background:
        linear-gradient(
            145deg,
            var(--steel),
            var(--steel-dark)
        );

    border:1px solid var(--border);
    border-radius:24px;
    padding:32px;
}

.scanner-intro h3{
    font-size:2rem;
    margin-bottom:15px;
}

.scanner-intro p{
    color:var(--muted);
}

.scanner-score{
    margin-top:35px;
    font-size:4rem;
    color:var(--coral);
    font-weight:900;
    line-height:1;
}

.scanner-score small{
    font-size:.75rem;
    color:var(--muted);
    display:block;
    margin-top:8px;
}

.leak-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:10px;
}

.leak-card{
    border:1px solid var(--faint);
    border-radius:18px;
    background:var(--steel);
    padding:22px;
    cursor:pointer;
    transition:.25s;
}

.leak-card:hover{
    border-color:var(--border);
}

.leak-card.selected{
    border-color:var(--coral);
    background:rgba(254,200,154,.06);
}

.leak-card strong{
    display:block;
    margin-bottom:8px;
}

.leak-card p{
    color:var(--muted);
    font-size:.8rem;
}

.leak-level{
    margin-top:14px;
    display:flex;
    gap:5px;
}

.leak-dot{
    width:8px;
    height:8px;
    border-radius:50%;
    background:var(--midnight);
    border:1px solid var(--coral);
}

.leak-card.selected .leak-dot{
    background:var(--coral);
}

/* =========================================================
   BOUNDARY BUILDER
========================================================= */

.boundary-builder{
    background:var(--steel);
    border:1px solid var(--border);
    border-radius:25px;
    overflow:hidden;
}

.boundary-tabs{
    display:flex;
    overflow-x:auto;
    border-bottom:1px solid var(--faint);
}

.boundary-tab{
    flex:1;
    min-width:150px;
    padding:18px;
    border:0;
    background:transparent;
    color:var(--muted);
    font-weight:800;
}

.boundary-tab.active{
    color:var(--coral);
    background:rgba(254,200,154,.05);
    box-shadow:inset 0 -2px var(--coral);
}

.boundary-panel{
    display:none;
    padding:30px;
}

.boundary-panel.active{
    display:block;
}

.boundary-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:18px;
}

.control-group{
    padding:22px;
    border:1px solid var(--faint);
    border-radius:17px;
    background:rgba(13,27,42,.35);
}

.control-group label{
    display:block;
    font-weight:800;
    margin-bottom:10px;
}

.control-group small{
    color:var(--muted);
    display:block;
    margin-bottom:15px;
}

select,
input[type="text"],
textarea{
    width:100%;
    border:1px solid var(--border);
    background:var(--midnight);
    color:var(--ice);
    padding:12px 14px;
    border-radius:10px;
}

textarea{
    min-height:120px;
    resize:vertical;
}

.boundary-save{
    margin-top:22px;
}

/* =========================================================
   MISSIONS
========================================================= */

.mission-board{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:15px;
}

.mission{
    position:relative;
    background:var(--steel);
    border:1px solid var(--faint);
    border-radius:20px;
    padding:25px;
    transition:.3s;
}

.mission:hover{
    border-color:var(--border);
    transform:translateY(-4px);
}

.mission.completed{
    border-color:var(--coral);
    opacity:.72;
}

.mission.completed::after{
    content:"COMPLETED";
    position:absolute;
    top:15px;
    right:15px;
    font-size:.58rem;
    color:var(--coral);
    font-weight:900;
    letter-spacing:.1em;
}

.mission-icon{
    width:42px;
    height:42px;
    border-radius:12px;
    background:var(--midnight);
    border:1px solid var(--border);
    display:grid;
    place-items:center;
    color:var(--coral);
    font-weight:900;
    margin-bottom:20px;
}

.mission h3{
    margin-bottom:10px;
}

.mission p{
    color:var(--muted);
    font-size:.85rem;
    min-height:80px;
}

.mission-footer{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    margin-top:20px;
}

.reward{
    color:var(--coral);
    font-size:.75rem;
    font-weight:900;
}

.complete-mission{
    border:1px solid var(--border);
    background:transparent;
    color:var(--ice);
    padding:8px 12px;
    border-radius:999px;
    font-size:.75rem;
}

.complete-mission:hover{
    background:var(--coral);
    color:var(--midnight);
}

/* =========================================================
   FOCUS TIMER
========================================================= */

.timer{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
}

.timer-display{
    background:
        radial-gradient(
            circle,
            rgba(254,200,154,.08),
            transparent 60%
        ),
        var(--steel);

    border:1px solid var(--border);
    border-radius:25px;
    padding:45px;
    text-align:center;
}

.timer-label{
    color:var(--muted);
    text-transform:uppercase;
    letter-spacing:.15em;
    font-size:.7rem;
}

.time{
    font-size:clamp(4rem,8vw,7rem);
    font-weight:900;
    color:var(--coral);
    line-height:1;
    margin:20px 0 25px;
    font-variant-numeric:tabular-nums;
}

.timer-controls{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:10px;
}

.timer-settings{
    background:var(--steel);
    border:1px solid var(--faint);
    border-radius:25px;
    padding:30px;
}

.timer-settings h3{
    margin-bottom:20px;
}

.duration-buttons{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:8px;
    margin-bottom:25px;
}

.duration-button{
    border:1px solid var(--faint);
    background:var(--midnight);
    color:var(--muted);
    padding:12px;
    border-radius:10px;
}

.duration-button.active{
    border-color:var(--coral);
    color:var(--coral);
}

/* =========================================================
   AUDIT
========================================================= */

.audit{
    background:var(--steel);
    border:1px solid var(--border);
    border-radius:25px;
    overflow:hidden;
}

.audit-progress{
    height:6px;
    background:var(--midnight);
}

.audit-progress-fill{
    width:0%;
    height:100%;
    background:var(--coral);
    transition:.3s;
}

.audit-content{
    padding:35px;
}

.audit-question{
    display:none;
}

.audit-question.active{
    display:block;
}

.audit-question h3{
    font-size:1.7rem;
    margin-bottom:25px;
}

.audit-options{
    display:grid;
    gap:9px;
}

.audit-option{
    width:100%;
    text-align:left;
    border:1px solid var(--faint);
    background:var(--midnight);
    color:var(--ice);
    padding:16px;
    border-radius:12px;
    transition:.2s;
}

.audit-option:hover{
    border-color:var(--coral);
}

.audit-option.selected{
    background:rgba(254,200,154,.08);
    border-color:var(--coral);
    color:var(--coral);
}

.audit-controls{
    display:flex;
    justify-content:space-between;
    gap:10px;
    margin-top:30px;
}

.audit-result{
    display:none;
    text-align:center;
    padding:30px;
}

.audit-result.show{
    display:block;
}

.audit-result-score{
    font-size:5rem;
    color:var(--coral);
    font-weight:900;
}

/* =========================================================
   ENVIRONMENT MATRIX
========================================================= */

.environment-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:15px;
}

.environment-card{
    background:var(--steel);
    border:1px solid var(--faint);
    border-radius:22px;
    padding:28px;
}

.environment-card h3{
    color:var(--coral);
    margin-bottom:12px;
}

.environment-card p{
    color:var(--muted);
    font-size:.88rem;
}

.environment-check{
    margin-top:20px;
}

.environment-check label{
    display:flex;
    align-items:center;
    gap:10px;
    color:var(--ice);
    font-size:.82rem;
    margin:9px 0;
    cursor:pointer;
}

.environment-check input{
    accent-color:var(--coral);
}

/* =========================================================
   INSIGHT PANEL
========================================================= */

.insight{
    border:1px solid var(--border);
    border-radius:26px;
    padding:40px;

    background:
        linear-gradient(
            135deg,
            rgba(254,200,154,.07),
            rgba(27,38,59,.8)
        );
}

.insight-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:40px;
}

.insight h3{
    font-size:1.4rem;
    color:var(--coral);
    margin-bottom:12px;
}

.insight p{
    color:var(--muted);
}

.insight-stat{
    border-left:2px solid var(--coral);
    padding-left:18px;
}

/* =========================================================
   FINAL CTA
========================================================= */

.final{
    text-align:center;
    padding:100px 20px;
    background:
        radial-gradient(
            circle at center,
            rgba(254,200,154,.08),
            transparent 45%
        );
}

.final h2{
    max-width:850px;
    margin:0 auto 20px;
}

.final h2 span{
    color:var(--coral);
}

.final p{
    max-width:700px;
    margin:0 auto 30px;
    color:var(--muted);
}

/* =========================================================
   FOOTER
========================================================= */

footer{
    border-top:1px solid var(--faint);
    background:var(--steel-dark);
    padding:45px 20px;
}

.footer-inner{
    width:min(1180px,100%);
    margin:auto;

    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:30px;
}

.footer-inner h3{
    color:var(--ice);
}

.footer-inner p{
    color:var(--muted);
    max-width:550px;
}

/* =========================================================
   RESET
========================================================= */

.reset-progress{
    margin-top:20px;
    border:0;
    background:none;
    color:var(--muted);
    text-decoration:underline;
    font-size:.75rem;
}

.reset-progress:hover{
    color:var(--coral);
}

/* =========================================================
   TOAST
========================================================= */

.toast{
    position:fixed;
    right:20px;
    bottom:20px;
    z-index:9999;

    background:var(--steel);
    border:1px solid var(--coral);
    color:var(--ice);

    padding:15px 20px;
    border-radius:12px;

    box-shadow:var(--shadow);

    transform:translateY(130px);
    opacity:0;

    transition:.3s;
}

.toast.show{
    transform:translateY(0);
    opacity:1;
}

/* =========================================================
   BACK TO TOP
========================================================= */

.back-top{
    position:fixed;
    right:20px;
    bottom:85px;

    width:45px;
    height:45px;

    border-radius:50%;
    border:1px solid var(--coral);

    background:var(--midnight);
    color:var(--coral);

    opacity:0;
    pointer-events:none;

    transition:.25s;

    z-index:800;
}

.back-top.show{
    opacity:1;
    pointer-events:auto;
}

/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width:1000px){

    .hero-grid{
        grid-template-columns:1fr;
        text-align:center;
    }

    .hero-copy{
        margin-left:auto;
        margin-right:auto;
    }

    .hero-actions{
        justify-content:center;
    }

    .dashboard-grid{
        grid-template-columns:1fr;
    }

    .model{
        grid-template-columns:repeat(2,1fr);
    }

    .model-arrow{
        display:none;
    }

    .scanner{
        grid-template-columns:1fr;
    }

    .mission-board{
        grid-template-columns:repeat(2,1fr);
    }

}

@media(max-width:750px){

    .header-nav{
        display:none;
    }

    .container,
    .header-inner,
    .hero-grid{
        width:min(100% - 28px,1180px);
    }

    .section{
        padding:65px 0;
    }

    .section-heading{
        display:block;
    }

    .section-heading p{
        margin-top:15px;
    }

    .model,
    .environment-grid,
    .mission-board,
    .timer,
    .insight-grid{
        grid-template-columns:1fr;
    }

    .boundary-grid{
        grid-template-columns:1fr;
    }

    .leak-grid{
        grid-template-columns:1fr;
    }

    .metric-grid{
        grid-template-columns:1fr 1fr 1fr;
    }

    .control-core{
        transform:scale(.82);
        margin:-25px auto;
    }

    .footer-inner{
        flex-direction:column;
        align-items:flex-start;
    }

}

@media(max-width:480px){

    .header-xp{
        display:none;
    }

    .hero{
        min-height:700px;
    }

    .control-core{
        transform:scale(.67);
        margin:-60px auto;
    }

    .metric-grid{
        grid-template-columns:1fr;
