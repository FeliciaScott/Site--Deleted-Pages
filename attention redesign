<script>

/* =========================================================
   ATTENTION CONTROL LAB ENGINE
========================================================= */

const STORAGE_KEY = "attentionControlLab";

/* =========================================================
   STATE
========================================================= */

let state = {

    xp:0,

    completedMissions:[],

    selectedLeaks:[],

    completedFocusSessions:0,

    boundariesSaved:0,

    auditScore:0,

    environmentChecks:0

};


/* =========================================================
   LOAD STATE
========================================================= */

function loadState(){

    const saved = localStorage.getItem(STORAGE_KEY);

    if(saved){

        try{

            const parsed = JSON.parse(saved);

            state = {
                ...state,
                ...parsed
            };

        }catch(error){

            console.log("Unable to load saved progress.");

        }

    }

    updateDashboard();

}


function saveState(){

    localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify(state)
    );

}


/* =========================================================
   TOAST
========================================================= */

const toast =
    document.getElementById("toast");


let toastTimer;


function showToast(message){

    toast.textContent = message;

    toast.classList.add("show");

    clearTimeout(toastTimer);

    toastTimer = setTimeout(function(){

        toast.classList.remove("show");

    },2800);

}


/* =========================================================
   NAVIGATION
========================================================= */

document.querySelectorAll("[data-target]")
.forEach(function(button){

    button.addEventListener("click",function(){

        const targetID =
            button.getAttribute("data-target");

        const target =
            document.getElementById(targetID);

        if(target){

            target.scrollIntoView({
                behavior:"smooth",
                block:"start"
            });

        }

    });

});


/* =========================================================
   SCROLL PROGRESS
========================================================= */

const scrollLine =
    document.getElementById("scrollLine");

const backTop =
    document.getElementById("backTop");


window.addEventListener("scroll",function(){

    const scrollTop =
        window.scrollY;

    const maxScroll =
        document.documentElement.scrollHeight
        - window.innerHeight;

    const percentage =
        maxScroll > 0
        ? (scrollTop / maxScroll) * 100
        : 0;

    scrollLine.style.width =
        percentage + "%";


    if(scrollTop > 600){

        backTop.classList.add("show");

    }else{

        backTop.classList.remove("show");

    }

});


backTop.addEventListener("click",function(){

    window.scrollTo({
        top:0,
        behavior:"smooth"
    });

});


/* =========================================================
   LEVEL SYSTEM
========================================================= */

function getLevel(xp){

    if(xp >= 1000) return {
        number:10,
        name:"Attention Architect",
        base:900
    };

    if(xp >= 800) return {
        number:9,
        name:"Cognitive Strategist",
        base:700
    };

    if(xp >= 650) return {
        number:8,
        name:"Boundary Engineer",
        base:550
    };

    if(xp >= 500) return {
        number:7,
        name:"Focus Operator",
        base:400
    };

    if(xp >= 350) return {
        number:6,
        name:"Environment Designer",
        base:275
    };

    if(xp >= 250) return {
        number:5,
        name:"Attention Protector",
        base:175
    };

    if(xp >= 150) return {
        number:4,
        name:"Pattern Recognizer",
        base:100
    };

    if(xp >= 75) return {
        number:3,
        name:"Boundary Builder",
        base:50
    };

    if(xp >= 25) return {
        number:2,
        name:"Signal Observer",
        base:25
    };

    return {
        number:1,
        name:"Observer",
        base:0
    };

}


function updateDashboard(){

    const level =
        getLevel(state.xp);


    document.getElementById("headerXP")
        .textContent = state.xp;


    document.getElementById("xpMetric")
        .textContent = state.xp;


    document.getElementById("missionMetric")
        .textContent =
        state.completedMissions.length;


    document.getElementById("boundaryMetric")
        .textContent =
        state.boundariesSaved;


    document.getElementById("levelNumber")
        .textContent =
        level.number;


    document.getElementById("levelName")
        .textContent =
        level.name;


    const nextLevelXP =
        level.number === 10
        ? 1000
        : (
            level.number === 1 ? 25 :
            level.number === 2 ? 75 :
            level.number === 3 ? 150 :
            level.number === 4 ? 250 :
            level.number === 5 ? 350 :
            level.number === 6 ? 500 :
            level.number === 7 ? 650 :
            level.number === 8 ? 800 :
            1000
        );


    const currentBase =
        level.base;


    const range =
        nextLevelXP - currentBase;


    const currentProgress =
        state.xp - currentBase;


    const percentage =
        level.number === 10
        ? 100
        : Math.min(
            100,
            Math.max(
                0,
                (currentProgress / range) * 100
            )
        );


    document.getElementById("xpFill")
        .style.width =
        percentage + "%";


    document.getElementById("xpLabel")
        .textContent =
        level.number === 10
        ? "Maximum level reached"
        : state.xp +
          " / " +
          nextLevelXP +
          " XP";


    updateControlScore();

}


/* =========================================================
   XP
========================================================= */

function addXP(amount,message){

    state.xp += amount;

    saveState();

    updateDashboard();

    showToast(
        "+" + amount + " XP — " + message
    );

}


/* =========================================================
   CONTROL SCORE
========================================================= */

function updateControlScore(){

    let score = 0;


    const leakPenalty =
        state.selectedLeaks.length * 7;


    const missionBonus =
        Math.min(
            30,
            state.completedMissions.length * 5
        );


    const boundaryBonus =
        Math.min(
            20,
            state.boundariesSaved * 5
        );


    const focusBonus =
        Math.min(
            15,
            state.completedFocusSessions * 5
        );


    const environmentBonus =
        Math.min(
            15,
            state.environmentChecks * 2
        );


    score =
        45
        - leakPenalty
        + missionBonus
        + boundaryBonus
        + focusBonus
        + environmentBonus;


    if(state.auditScore > 0){

        score +=
            Math.round(
                state.auditScore * .15
            );

    }


    score =
        Math.max(
            0,
            Math.min(100,Math.round(score))
        );


    document.getElementById("heroScore")
        .textContent = score;


    let status =
        "Reactive";


    if(score >= 80){

        status = "Controlled";

    }else if(score >= 60){

        status = "Stabilizing";

    }else if(score >= 40){

        status = "Developing";

    }


    document.getElementById("systemStatus")
        .textContent = status;

}


/* =========================================================
   LEAK SCANNER
========================================================= */

document.querySelectorAll(".leak-card")
.forEach(function(card){

    card.addEventListener("click",function(){

        const leak =
            card.getAttribute("data-leak");


        const index =
            state.selectedLeaks.indexOf(leak);


        if(index === -1){

            state.selectedLeaks.push(leak);

            card.classList.add("selected");

            addXP(
                5,
                "Attention leak identified"
            );

        }else{

            state.selectedLeaks.splice(
                index,
                1
            );

            card.classList.remove("selected");

        }


        document.getElementById("leakScore")
            .childNodes[0]
            .nodeValue =
            state.selectedLeaks.length;


        saveState();

        updateControlScore();

    });

});


/* Restore selected leaks */

state.selectedLeaks.forEach(function(leak){

    const card =
        document.querySelector(
            '[data-leak="' + leak + '"]'
        );

    if(card){
        card.classList.add("selected");
    }

});


/* =========================================================
   BOUNDARY TABS
========================================================= */

document.querySelectorAll(".boundary-tab")
.forEach(function(tab){

    tab.addEventListener("click",function(){

        document.querySelectorAll(".boundary-tab")
        .forEach(function(item){

            item.classList.remove("active");

        });


        document.querySelectorAll(".boundary-panel")
        .forEach(function(panel){

            panel.classList.remove("active");

        });


        tab.classList.add("active");


        const panelID =
            tab.getAttribute("data-panel");


        document.getElementById(panelID)
            .classList.add("active");

    });

});


/* =========================================================
   BOUNDARY STORAGE
========================================================= */

const boundaryFields = [

    "communicationWindow",
    "urgentRule",
    "informationWindow",
    "sourceRule",
    "digitalFriction",
    "openLoopRule",
    "workspaceRule",
    "priorityRule"

];


function saveBoundaries(){

    let count = 0;


    boundaryFields.forEach(function(id){

        const element =
            document.getElementById(id);


        if(
            element &&
            element.value.trim() !== ""
        ){

            count++;

        }

    });


    if(count === 0){

        showToast(
            "Create at least one boundary before saving."
        );

        return;

    }


    const previous =
        state.boundariesSaved;


    state.boundariesSaved =
        Math.min(4,Math.ceil(count / 2));


    if(previous === 0){

        addXP(
            30,
            "Boundary system created"
        );

    }else{

        saveState();

        updateDashboard();

        showToast(
            "Boundary system updated."
        );

    }

}


document.getElementById("saveBoundaries")
    .addEventListener(
        "click",
        saveBoundaries
    );


document.getElementById("clearBoundaries")
    .addEventListener("click",function(){

        boundaryFields.forEach(function(id){

            const element =
                document.getElementById(id);

            if(element){
                element.value = "";
            }

        });


        state.boundariesSaved = 0;

        saveState();

        updateDashboard();

        showToast(
            "Boundary rules cleared."
        );

    });


/* =========================================================
   MISSIONS
========================================================= */

const missionRewards = {

    notifications:40,
    "single-task":50,
    information:45,
    workspace:35,
    communication:50,
    priority:60

};


document.querySelectorAll(".mission")
.forEach(function(mission){

    const id =
        mission.getAttribute("data-mission");

    const button =
        mission.querySelector(
            ".complete-mission"
        );


    if(
        state.completedMissions.includes(id)
    ){

        mission.classList.add("completed");

        button.textContent = "Completed";

        button.disabled = true;

    }


    button.addEventListener("click",function(){

        if(
            state.completedMissions.includes(id)
        ){

            return;

        }


        state.completedMissions.push(id);

        mission.classList.add("completed");

        button.textContent = "Completed";

        button.disabled = true;


        addXP(
            missionRewards[id],
            "Mission completed"
        );

    });

});


/* =========================================================
   FOCUS TIMER
========================================================= */

let selectedMinutes = 25;

let remainingSeconds =
    selectedMinutes * 60;

let timerInterval = null;

let timerRunning = false;


const timeDisplay =
    document.getElementById("timeDisplay");


function renderTimer(){

    const minutes =
        Math.floor(
            remainingSeconds / 60
        );

    const seconds =
        remainingSeconds % 60;


    timeDisplay.textContent =
        String(minutes).padStart(2,"0")
        + ":" +
        String(seconds).padStart(2,"0");

}


function startTimer(){

    if(timerRunning){
        return;
    }


    timerRunning = true;


    timerInterval =
        setInterval(function(){

            remainingSeconds--;

            renderTimer();


            if(remainingSeconds <= 0){

                clearInterval(
                    timerInterval
                );

                timerInterval = null;

                timerRunning = false;

                remainingSeconds =
                    selectedMinutes * 60;

                renderTimer();


                state.completedFocusSessions++;

                addXP(
                    selectedMinutes >= 60
                    ? 75
                    : selectedMinutes >= 45
                    ? 55
                    : 35,
                    "Focus session completed"
                );

            }

        },1000);

}


function pauseTimer(){

    if(!timerRunning){
        return;
    }


    clearInterval(
        timerInterval
    );

    timerInterval = null;

    timerRunning = false;

    showToast(
        "Focus session paused."
    );

}


function resetTimer(){

    clearInterval(
        timerInterval
    );

    timerInterval = null;

    timerRunning = false;

    remainingSeconds =
        selectedMinutes * 60;

    renderTimer();

    showToast(
        "Focus session reset."
    );

}


document.getElementById("startTimer")
    .addEventListener(
        "click",
        startTimer
    );


document.getElementById("pauseTimer")
    .addEventListener(
        "click",
        pauseTimer
    );


document.getElementById("resetTimer")
    .addEventListener(
        "click",
        resetTimer
    );


document.querySelectorAll(".duration-button")
.forEach(function(button){

    button.addEventListener("click",function(){

        document.querySelectorAll(".duration-button")
        .forEach(function(item){

            item.classList.remove("active");

        });


        button.classList.add("active");


        selectedMinutes =
            Number(
                button.getAttribute(
                    "data-minutes"
                )
            );


        resetTimer();

    });

});


/* =========================================================
   AUDIT SYSTEM
========================================================= */

let auditIndex = 0;

let auditAnswers = [];

const auditQuestions =
    document.querySelectorAll(
        ".audit-question"
    );


function showAuditQuestion(){

    auditQuestions.forEach(function(question,index){

        question.classList.toggle(
            "active",
            index === auditIndex
        );

    });


    const percentage =
        ((auditIndex + 1) /
        auditQuestions.length) * 100;


    document.getElementById("auditProgress")
        .style.width =
        percentage + "%";


    document.getElementById("auditBack")
        .style.visibility =
        auditIndex === 0
        ? "hidden"
        : "visible";


    document.getElementById("auditNext")
        .textContent =
        auditIndex === auditQuestions.length - 1
        ? "Finish Audit"
        : "Next";

}


document.querySelectorAll(".audit-option")
.forEach(function(option){

    option.addEventListener("click",function(){

        const question =
            option.closest(
                ".audit-question"
            );


        question.querySelectorAll(
            ".audit-option"
        ).forEach(function(item){

            item.classList.remove(
                "selected"
            );

        });


        option.classList.add("selected");


        const questionIndex =
            Number(
                question.getAttribute(
                    "data-question"
                )
            );


        auditAnswers[questionIndex] =
            Number(
                option.getAttribute(
                    "data-score"
                )
            );

    });

});


document.getElementById("auditNext")
    .addEventListener("click",function(){

        if(
            typeof auditAnswers[auditIndex]
            === "undefined"
        ){

            showToast(
                "Choose an answer before continuing."
            );

            return;

        }


        if(
            auditIndex <
            auditQuestions.length - 1
        ){

            auditIndex++;

            showAuditQuestion();

            return;

        }


        completeAudit();

    });


document.getElementById("auditBack")
    .addEventListener("click",function(){

        if(auditIndex > 0){

            auditIndex--;

            showAuditQuestion();

        }

    });


function completeAudit(){

    const total =
        auditAnswers.reduce(
            function(sum,value){
                return sum + value;
            },
            0
        );


    const score =
        Math.round(
            (total / 24) * 100
        );


    state.auditScore = score;

    saveState();

    updateControlScore();


    document.querySelector(".audit-content")
        .querySelectorAll(".audit-question")
        .forEach(function(question){

            question.style.display = "none";

        });


    document.querySelector(".audit-controls")
        .style.display = "none";


    document.getElementById("auditProgress")
        .style.width = "100%";


    document.getElementById("auditResult")
        .classList.add("show");


    document.getElementById("auditScore")
        .textContent = score;


    let title =
        "Attention system needs redesign.";


    let description =
        "Your current structure leaves substantial room for environmental and behavioral improvements.";


    if(score >= 80){

        title =
            "Strong attention architecture.";

        description =
            "Your day already contains several protective mechanisms. Focus on maintaining them while improving the weakest remaining boundary.";

    }else if(score >= 60){

        title =
            "Your system is stabilizing.";

        description =
            "You have useful controls in place, but recurring inputs still appear capable of taking over portions of your attention.";

    }else if(score >= 40){

        title =
            "Your system is vulnerable.";

        description =
            "The largest opportunity is reducing the number of situations in which incoming signals automatically determine what happens next.";

    }


    document.getElementById("auditTitle")
        .textContent = title;


    document.getElementById("auditDescription")
        .textContent = description;


    addXP(
        25,
        "Attention audit completed"
    );

}


document.getElementById("auditRestart")
    .addEventListener("click",function(){

        auditIndex = 0;

        auditAnswers = [];

        document.getElementById("auditResult")
            .classList.remove("show");


        document.querySelector(".audit-controls")
            .style.display = "flex";


        document.querySelectorAll(
            ".audit-option"
        ).forEach(function(option){

            option.classList.remove(
                "selected"
            );

        });


        showAuditQuestion();

    });


/* =========================================================
   ENVIRONMENT CHECKS
========================================================= */

document.querySelectorAll(
    ".environment-check input"
)
.forEach(function(checkbox){

    const key =
        checkbox.getAttribute("data-env");


    const saved =
        localStorage.getItem(
            "attentionEnv_" + key
        );


    if(saved === "true"){

        checkbox.checked = true;

    }


    checkbox.addEventListener(
        "change",
        function(){

            localStorage.setItem(
                "attentionEnv_" + key,
                checkbox.checked
            );


            if(checkbox.checked){

                state.environmentChecks++;

                addXP(
                    3,
                    "Environment improvement logged"
                );

            }else{

                state.environmentChecks =
                    Math.max(
                        0,
                        state.environmentChecks - 1
                    );

                saveState();

                updateDashboard();

            }

        }
    );

});


/* =========================================================
   RESET EVERYTHING
========================================================= */

document.getElementById("resetAll")
    .addEventListener("click",function(){

        const confirmed =
            confirm(
                "Reset all Attention Control Lab progress?"
            );


        if(!confirmed){
            return;
        }


        localStorage.removeItem(
            STORAGE_KEY
        );


        Object.keys(localStorage)
        .forEach(function(key){

            if(
                key.indexOf(
                    "attentionEnv_"
                ) === 0
            ){

                localStorage.removeItem(key);

            }

        });


        location.reload();

    });


/* =========================================================
   INITIALIZATION
========================================================= */

loadState();

renderTimer();

showAuditQuestion();


/* Restore mission state */

state.completedMissions
.forEach(function(id){

    const mission =
        document.querySelector(
            '[data-mission="' + id + '"]'
        );


    if(mission){

        mission.classList.add(
            "completed"
        );


        const button =
            mission.querySelector(
                ".complete-mission"
            );


        button.textContent =
            "Completed";

        button.disabled = true;

    }

});


/* Restore environment count accurately */

let restoredEnvironmentCount = 0;


document.querySelectorAll(
    ".environment-check input"
)
.forEach(function(checkbox){

    if(checkbox.checked){

        restoredEnvironmentCount++;

    }

});


state.environmentChecks =
    restoredEnvironmentCount;


saveState();

updateDashboard();


</script>

</body>
</html>
