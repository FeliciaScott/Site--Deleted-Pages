    }

    .scanner-score{
        font-size:3.5rem;
    }

    .duration-buttons{
        grid-template-columns:1fr;
    }

}

</style>
</head>


<body>

<div class="page">

<div class="scroll-line" id="scrollLine"></div>


<!-- =====================================================
     HEADER
===================================================== -->

<header class="header">

    <div class="header-inner">

        <a href="#top" class="logo">
            ATTENTION <span>CONTROL</span>
        </a>

        <nav class="header-nav">

            <button data-target="diagnosis">
                Diagnosis
            </button>

            <button data-target="boundaries">
                Boundaries
            </button>

            <button data-target="missions">
                Missions
            </button>

            <button data-target="focus">
                Focus
            </button>

            <button data-target="audit">
                Audit
            </button>

        </nav>

        <div class="header-xp">
            XP <span id="headerXP">0</span>
        </div>

    </div>

</header>


<main id="top">


<!-- =====================================================
     HERO
===================================================== -->

<section class="hero">

    <div class="hero-grid">

        <div>

            <div class="eyebrow">
                Attention Control Lab
            </div>

            <h1>
                Stop letting your environment
                <span>choose your focus.</span>
            </h1>

            <p class="hero-copy">
                Attention becomes more reliable when the environment
                surrounding it becomes more deliberate. Instead of
                relying on willpower alone, design the flow of inputs,
                interruptions, recovery periods, and priorities.
            </p>

            <div class="hero-actions">

                <button class="primary" data-target="diagnosis">
                    Scan My Attention →
                </button>

                <button class="secondary" data-target="focus">
                    Start Focus Session
                </button>

            </div>

        </div>


        <div class="control-core">

            <div class="core-ring one"></div>
            <div class="core-ring two"></div>
            <div class="core-ring three"></div>

            <div class="core">

                <div class="core-number" id="heroScore">
                    0
                </div>

                <div class="core-label">
                    Control Score
                </div>

            </div>

            <div class="core-node node-input">
                INPUT
            </div>

            <div class="core-node node-switch">
                SWITCHING
            </div>

            <div class="core-node node-recovery">
                RECOVERY
            </div>

            <div class="core-node node-output">
                OUTPUT
            </div>

        </div>

    </div>

</section>


<!-- =====================================================
     DASHBOARD
===================================================== -->

<section class="dashboard">

    <div class="container">

        <div class="dashboard-grid">

            <div class="dashboard-card">

                <div class="dashboard-title">

                    <h3>
                        Attention Command Center
                    </h3>

                    <span class="status" id="systemStatus">
                        Initializing
                    </span>

                </div>

                <div class="metric-grid">

                    <div class="metric">
                        <strong id="xpMetric">0</strong>
                        <span>Total XP</span>
                    </div>

                    <div class="metric">
                        <strong id="missionMetric">0</strong>
                        <span>Missions</span>
                    </div>

                    <div class="metric">
                        <strong id="boundaryMetric">0</strong>
                        <span>Boundaries</span>
                    </div>

                </div>

            </div>


            <div class="dashboard-card">

                <div class="level">

                    <div class="level-badge">
                        <span id="levelNumber">1</span>
                    </div>

                    <div class="level-info">

                        <strong id="levelName">
                            Observer
                        </strong>

                        <div class="xp-track">
                            <div
                                class="xp-fill"
                                id="xpFill">
                            </div>
                        </div>

                        <div class="small muted" id="xpLabel">
                            0 / 100 XP
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =====================================================
     CORE MODEL
===================================================== -->

<section class="section" id="model">

<div class="container">

    <div class="section-heading">

        <div>

            <div class="eyebrow">
                The Operating Model
            </div>

            <h2>
                Attention Is a Flow System
            </h2>

        </div>

        <p>
            Fragmentation is easier to understand when attention is
            treated as a system rather than a character trait. Every
            input creates a demand, every switch creates a transition,
            and every transition has a recovery requirement.
        </p>

    </div>


    <div class="model">

        <article class="model-step">

            <div class="model-number">
                01 / INPUT
            </div>

            <h3>
                Information enters
            </h3>

            <p>
                Notifications, conversations, headlines, open tabs,
                requests, and environmental cues all compete to become
                the next object of attention.
            </p>

            <span class="model-arrow">→</span>

        </article>


        <article class="model-step">

            <div class="model-number">
                02 / SWITCH
            </div>

            <h3>
                Context changes
            </h3>

            <p>
                Moving between unrelated activities requires the mind
                to abandon one context and establish another.
            </p>

            <span class="model-arrow">→</span>

        </article>


        <article class="model-step">

            <div class="model-number">
                03 / RECOVER
            </div>

            <h3>
                Context rebuilds
            </h3>

            <p>
                Returning to the original task is not instantaneous.
                The mind must reconstruct what it was doing, why it
                mattered, and what comes next.
            </p>

            <span class="model-arrow">→</span>

        </article>


        <article class="model-step">

            <div class="model-number">
                04 / OUTPUT
            </div>

            <h3>
                Work quality emerges
            </h3>

            <p>
                The quality of learning, decisions, creativity, and
                execution depends partly on how much uninterrupted
                cognitive capacity remains.
            </p>

        </article>

    </div>

</div>

</section>


<!-- =====================================================
     DIAGNOSIS
===================================================== -->

<section class="section" id="diagnosis">

<div class="container">

    <div class="section-heading">

        <div>

            <div class="eyebrow">
                Attention Diagnosis
            </div>

            <h2>
                Find Your Largest Attention Leaks
            </h2>

        </div>

        <p>
            Select the conditions that currently interfere with your
            concentration. The scanner converts your selections into
            a simple intervention priority.
        </p>

    </div>


    <div class="scanner">

        <div class="scanner-intro">

            <h3>
                Fragmentation Scanner
            </h3>

            <p>
                Do not treat every distraction equally. The highest-value
                intervention is usually the boundary that removes a
                recurring source of interruption rather than the boundary
                that merely makes you feel more disciplined.
            </p>

            <div class="scanner-score" id="leakScore">
                0
                <small>
                    selected pressure points
                </small>
            </div>

        </div>


        <div class="leak-grid">


            <article class="leak-card" data-leak="notifications">

                <strong>
                    Notification Pressure
                </strong>

                <p>
                    Alerts repeatedly compete for immediate response.
                </p>

                <div class="leak-level">
                    <span class="leak-dot"></span>
                    <span class="leak-dot"></span>
                    <span class="leak-dot"></span>
                </div>

            </article>


            <article class="leak-card" data-leak="tasks">

                <strong>
                    Open-Loop Tasks
                </strong>

                <p>
                    Multiple unfinished obligations remain mentally active.
                </p>

                <div class="leak-level">
                    <span class="leak-dot"></span>
                    <span class="leak-dot"></span>
                    <span class="leak-dot"></span>
                </div>

            </article>


            <article class="leak-card" data-leak="news">

                <strong>
                    Information Checking
                </strong>

                <p>
                    News, feeds, and updates create repeated intake cycles.
                </p>

                <div class="leak-level">
                    <span class="leak-dot"></span>
                    <span class="leak-dot"></span>
                    <span class="leak-dot"></span>
                </div>

            </article>


            <article class="leak-card" data-leak="communication">

                <strong>
                    Availability Pressure
                </strong>

                <p>
                    Other people's requests frequently determine your
                    next activity.
                </p>

                <div class="leak-level">
                    <span class="leak-dot"></span>
                    <span class="leak-dot"></span>
                    <span class="leak-dot"></span>
                </div>

            </article>


            <article class="leak-card" data-leak="environment">

                <strong>
                    Environmental Noise
                </strong>

                <p>
                    Physical surroundings repeatedly pull attention away.
                </p>

                <div class="leak-level">
                    <span class="leak-dot"></span>
                    <span class="leak-dot"></span>
                    <span class="leak-dot"></span>
                </div>

            </article>


            <article class="leak-card" data-leak="digital">

                <strong>
                    Digital Clutter
                </strong>

                <p>
                    Too many applications, tabs, files, or tools increase
                    search and switching costs.
                </p>

                <div class="leak-level">
                    <span class="leak-dot"></span>
                    <span class="leak-dot"></span>
                    <span class="leak-dot"></span>
                </div>

            </article>


        </div>

    </div>

</div>

</section>


<!-- =====================================================
     BOUNDARY BUILDER
===================================================== -->

<section class="section" id="boundaries">

<div class="container">

    <div class="section-heading">

        <div>

            <div class="eyebrow">
                Boundary Engineering
            </div>

            <h2>
                Design Your Input Rules
            </h2>

        </div>

        <p>
            A boundary becomes useful when it converts an abstract
            intention into a repeatable operating rule.
        </p>

    </div>


    <div class="boundary-builder">

        <div class="boundary-tabs">

            <button
                class="boundary-tab active"
                data-panel="communicationPanel">
                Communication
            </button>

            <button
                class="boundary-tab"
                data-panel="informationPanel">
                Information
            </button>

            <button
                class="boundary-tab"
                data-panel="digitalPanel">
                Digital
            </button>

            <button
                class="boundary-tab"
                data-panel="workspacePanel">
                Workspace
            </button>

        </div>


        <!-- COMMUNICATION -->

        <div
            class="boundary-panel active"
            id="communicationPanel">

            <div class="boundary-grid">

                <div class="control-group">

                    <label>
                        Communication window
                    </label>

                    <small>
                        Decide when incoming communication receives
                        deliberate attention.
                    </small>

                    <select id="communicationWindow">

                        <option value="">
                            Choose a window
                        </option>

                        <option value="Morning review">
                            Morning review
                        </option>

                        <option value="Midday review">
                            Midday review
                        </option>

                        <option value="Afternoon review">
                            Afternoon review
                        </option>

                        <option value="Two scheduled reviews">
                            Two scheduled reviews
                        </option>

                    </select>

                </div>


                <div class="control-group">

                    <label>
                        Urgent-contact rule
                    </label>

                    <small>
                        Define what actually deserves immediate interruption.
                    </small>

                    <textarea
                        id="urgentRule"
                        placeholder="Example: Only active emergencies interrupt a focus block.">
                    </textarea>

                </div>

            </div>

        </div>


        <!-- INFORMATION -->

        <div
            class="boundary-panel"
            id="informationPanel">

            <div class="boundary-grid">

                <div class="control-group">

                    <label>
                        Information intake
                    </label>

                    <small>
                        Decide when research, news, and updates enter
                        your day.
                    </small>

                    <select id="informationWindow">

                        <option value="">
                            Choose a rule
                        </option>

                        <option value="Scheduled research block">
                            Scheduled research block
                        </option>

                        <option value="One daily information review">
                            One daily information review
                        </option>

                        <option value="Two weekly deep reviews">
                            Two weekly deep reviews
                        </option>

                        <option value="Project-specific intake">
                            Project-specific intake
                        </option>

                    </select>

                </div>


                <div class="control-group">

                    <label>
                        Source filter
                    </label>

                    <small>
                        Write the standard that determines whether a source
                        earns your attention.
                    </small>

                    <textarea
                        id="sourceRule"
                        placeholder="Example: Useful, credible, relevant to a current goal.">
                    </textarea>

                </div>

            </div>

        </div>


        <!-- DIGITAL -->

        <div
            class="boundary-panel"
            id="digitalPanel">

            <div class="boundary-grid">

                <div class="control-group">

                    <label>
                        Distraction friction
                    </label>

                    <small>
                        Make low-value actions require additional effort.
                    </small>

                    <select id="digitalFriction">

                        <option value="">
                            Choose a strategy
                        </option>

                        <option value="Remove unnecessary notifications">
                            Remove unnecessary notifications
                        </option>

                        <option value="Close unused applications">
                            Close unused applications
                        </option>

                        <option value="Remove distracting shortcuts">
                            Remove distracting shortcuts
                        </option>

                        <option value="Create a dedicated work environment">
                            Create a dedicated work environment
                        </option>

                    </select>

                </div>


                <div class="control-group">

                    <label>
                        Open-loop rule
                    </label>

                    <small>
                        Decide what happens to unfinished work.
                    </small>

                    <textarea
                        id="openLoopRule"
                        placeholder="Example: Capture it in one task system instead of keeping it open in my head.">
                    </textarea>

                </div>

            </div>

        </div>


        <!-- WORKSPACE -->

        <div
            class="boundary-panel"
            id="workspacePanel">

            <div class="boundary-grid">

                <div class="control-group">

                    <label>
                        Current work surface
                    </label>

                    <small>
                        Define what is allowed to remain visible.
                    </small>

                    <select id="workspaceRule">

                        <option value="">
                            Choose a rule
                        </option>

                        <option value="Only current project materials">
                            Only current project materials
                        </option>

                        <option value="One active task at a time">
                            One active task at a time
                        </option>

                        <option value="Clear desk before focus work">
                            Clear desk before focus work
                        </option>

                        <option value="Dedicated creation station">
                            Dedicated creation station
                        </option>

                    </select>

                </div>


                <div class="control-group">

                    <label>
                        Mental priority
                    </label>

                    <small>
                        State the question that should determine your
                        next meaningful action.
                    </small>

                    <textarea
                        id="priorityRule"
                        placeholder="Example: What action produces the greatest progress on my current objective?">
                    </textarea>

                </div>

            </div>

        </div>


        <div class="boundary-save">

            <div class="container" style="width:100%;">

                <button class="primary" id="saveBoundaries">
                    Save My Boundaries →
                </button>

                <button class="reset-progress" id="clearBoundaries">
                    Clear saved boundary rules
                </button>

            </div>

        </div>

    </div>

</div>

</section>


<!-- =====================================================
     MISSIONS
===================================================== -->

<section class="section" id="missions">

<div class="container">

    <div class="section-heading">

        <div>

            <div class="eyebrow">
                Progression System
            </div>

            <h2>
                Complete Attention Missions
            </h2>

        </div>

        <p>
            The objective is not perfect concentration. The objective
            is to repeatedly improve the conditions under which useful
            concentration becomes easier.
        </p>

    </div>


    <div class="mission-board">


        <article class="mission" data-mission="notifications">

            <div class="mission-icon">
                01
            </div>

            <h3>
                Silence the Noise
            </h3>

            <p>
                Remove or disable unnecessary alerts from the device
                you use most frequently.
            </p>

            <div class="mission-footer">

                <span class="reward">
                    +40 XP
                </span>

                <button class="complete-mission">
                    Complete
                </button>

            </div>

        </article>


        <article class="mission" data-mission="single-task">

            <div class="mission-icon">
                02
            </div>

            <h3>
                Single-Task Trial
            </h3>

            <p>
                Work on one meaningful task without opening an unrelated
                application or switching to another project.
            </p>

            <div class="mission-footer">

                <span class="reward">
                    +50 XP
                </span>

                <button class="complete-mission">
                    Complete
                </button>

            </div>

        </article>


        <article class="mission" data-mission="information">

            <div class="mission-icon">
                03
            </div>

            <h3>
                Information Gate
            </h3>

            <p>
                Choose one information source you can stop checking
                continuously and move it into a scheduled review.
            </p>

            <div class="mission-footer">

                <span class="reward">
                    +45 XP
                </span>

                <button class="complete-mission">
                    Complete
                </button>

            </div>

        </article>


        <article class="mission" data-mission="workspace">

            <div class="mission-icon">
                04
            </div>

            <h3>
                Clear the Launchpad
            </h3>

            <p>
                Remove visual objects, tabs, applications, and materials
                unrelated to your next important task.
            </p>

            <div class="mission-footer">

                <span class="reward">
                    +35 XP
                </span>

                <button class="complete-mission">
                    Complete
                </button>

            </div>

        </article>


        <article class="mission" data-mission="communication">

            <div class="mission-icon">
                05
            </div>

            <h3>
                Create a Response Window
            </h3>

            <p>
                Establish a defined period for messages and email so
                incoming communication does not automatically dictate
                your next action.
            </p>

            <div class="mission-footer">

                <span class="reward">
                    +50 XP
                </span>

                <button class="complete-mission">
                    Complete
                </button>

            </div>

        </article>


        <article class="mission" data-mission="priority">

            <div class="mission-icon">
                06
            </div>

            <h3>
                Protect the Highest-Value Task
            </h3>

            <p>
                Identify the task with the greatest consequence for your
                current objective and give it a protected work period.
            </p>

            <div class="mission-footer">

                <span class="reward">
                    +60 XP
                </span>

                <button class="complete-mission">
                    Complete
                </button>

            </div>

        </article>


    </div>

</div>

</section>


<!-- =====================================================
     FOCUS TIMER
===================================================== -->

<section class="section" id="focus">

<div class="container">

    <div class="section-heading">

        <div>

            <div class="eyebrow">
                Focus Protocol
            </div>

            <h2>
                Run a Protected Focus Session
            </h2>

        </div>

        <p>
            Use a timer as an environmental commitment device. The goal
            is to create a defined interval in which unnecessary inputs
            are deliberately excluded.
        </p>

    </div>


    <div class="timer">

        <div class="timer-display">

            <div class="timer-label">
                Protected Work Period
            </div>

            <div class="time" id="timeDisplay">
                25:00
            </div>

            <div class="timer-controls">

                <button class="primary" id="startTimer">
                    Start
                </button>

                <button class="secondary" id="pauseTimer">
                    Pause
                </button>

                <button class="secondary" id="resetTimer">
                    Reset
                </button>

            </div>

        </div>


        <div class="timer-settings">

            <h3>
                Select Duration
            </h3>

            <div class="duration-buttons">

                <button
                    class="duration-button active"
                    data-minutes="25">
                    25 min
                </button>

                <button
                    class="duration-button"
                    data-minutes="45">
                    45 min
                </button>

                <button
                    class="duration-button"
                    data-minutes="60">
                    60 min
                </button>

            </div>


            <p class="muted small">
                When the session reaches zero, you receive XP and the
                session is recorded in your dashboard.
            </p>

        </div>

    </div>

</div>

</section>


<!-- =====================================================
     AUDIT
===================================================== -->

<section class="section" id="audit">

<div class="container">

    <div class="section-heading">

        <div>

            <div class="eyebrow">
                Daily Diagnostic
            </div>

            <h2>
