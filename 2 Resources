<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pathkeeper | Opportunity Intelligence Center</title>

<style>

/* =========================================================
   PATHKEEPER
   OPPORTUNITY INTELLIGENCE CENTER
   ========================================================= */

:root{
    --forest:#17372A;
    --forest-2:#214C38;
    --forest-3:#2E6349;
    --cream:#F7F1E3;
    --paper:#FFFDF7;
    --sage:#BFD8C5;
    --mint:#DDEBDF;
    --gold:#D7B56D;
    --brown:#634B35;
    --ink:#17251E;
    --muted:#66756C;
    --line:#D8DED8;
    --red:#A85845;
    --blue:#52738C;
    --shadow:0 14px 40px rgba(16,43,31,.12);
    --radius:18px;
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    background:var(--cream);
    color:var(--ink);
    line-height:1.7;
}

/* =========================================================
   NAVIGATION
   ========================================================= */

.navbar{
    background:var(--forest);
    color:white;
    min-height:64px;
    padding:.8rem 4%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;
    position:relative;
    z-index:20;
}

.logo{
    font-size:1.15rem;
    font-weight:800;
    letter-spacing:.08em;
}

.nav-links{
    display:flex;
    flex-wrap:wrap;
    gap:18px;
}

.nav-links a{
    color:#F5F8F3;
    text-decoration:none;
    font-size:.88rem;
    transition:.2s;
}

.nav-links a:hover{
    color:var(--gold);
}

/* =========================================================
   HERO
   ========================================================= */

.hero{
    background:
        radial-gradient(circle at 85% 20%,rgba(215,181,109,.16),transparent 25%),
        linear-gradient(135deg,#17372A,#28533D);
    color:white;
    padding:4.5rem 5% 4rem;
    position:relative;
    overflow:hidden;
}

.hero:after{
    content:"";
    position:absolute;
    width:420px;
    height:420px;
    border:1px solid rgba(255,255,255,.08);
    border-radius:50%;
    right:-130px;
    bottom:-230px;
}

.hero-inner{
    max-width:1250px;
    margin:auto;
    position:relative;
    z-index:2;
}

.eyebrow{
    color:var(--gold);
    font-weight:800;
    letter-spacing:.12em;
    text-transform:uppercase;
    font-size:.75rem;
    margin-bottom:1rem;
}

.hero h1{
    max-width:950px;
    font-size:clamp(2.3rem,5vw,4.7rem);
    line-height:1.05;
    margin-bottom:1.3rem;
}

.hero p{
    max-width:850px;
    color:#E7EFE9;
    font-size:1.08rem;
}

.hero-grid{
    margin-top:2.5rem;
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:12px;
}

.hero-stat{
    border:1px solid rgba(255,255,255,.13);
    background:rgba(255,255,255,.055);
    padding:1rem;
    border-radius:12px;
}

.hero-stat strong{
    display:block;
    color:var(--gold);
    font-size:1.45rem;
}

/* =========================================================
   LAYOUT
   ========================================================= */

.container{
    width:min(1250px,92%);
    margin:auto;
}

section{
    padding:4rem 0;
}

.section-heading{
    display:flex;
    justify-content:space-between;
    align-items:end;
    gap:20px;
    margin-bottom:2rem;
}

.section-heading h2{
    color:var(--forest);
    font-size:clamp(1.7rem,3vw,2.5rem);
    line-height:1.15;
}

.section-heading p{
    max-width:650px;
    color:var(--muted);
}

/* =========================================================
   LESSON BOX
   ========================================================= */

.lesson{
    background:var(--paper);
    border:1px solid var(--line);
    border-left:6px solid var(--forest-3);
    padding:1.7rem;
    border-radius:0 var(--radius) var(--radius) 0;
    margin-bottom:2rem;
    box-shadow:var(--shadow);
}

.lesson-label{
    color:var(--forest-3);
    text-transform:uppercase;
    letter-spacing:.1em;
    font-size:.72rem;
    font-weight:900;
    margin-bottom:.5rem;
}

.lesson h3{
    color:var(--forest);
    margin-bottom:.5rem;
}

/* =========================================================
   PATHWAY CARDS
   ========================================================= */

.pathways{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:1rem;
}

.path{
    background:var(--forest);
    color:white;
    padding:1.5rem;
    min-height:250px;
    border-radius:var(--radius);
    position:relative;
    overflow:hidden;
    transition:.25s;
}

.path:hover{
    transform:translateY(-7px);
    box-shadow:var(--shadow);
}

.path:nth-child(2){
    background:#355E48;
}

.path:nth-child(3){
    background:#536B55;
}

.path:nth-child(4){
    background:#725A42;
}

.path-number{
    font-size:.72rem;
    letter-spacing:.12em;
    opacity:.7;
}

.path h3{
    margin:1.2rem 0 .6rem;
    font-size:1.35rem;
}

.path p{
    font-size:.9rem;
    color:#EDF4EE;
}

.path a{
    display:inline-block;
    margin-top:1.2rem;
    color:var(--gold);
    font-weight:700;
    text-decoration:none;
}

/* =========================================================
   COMPARISON MATRIX
   ========================================================= */

.matrix-wrap{
    overflow-x:auto;
    background:var(--paper);
    border-radius:var(--radius);
    box-shadow:var(--shadow);
}

.matrix{
    width:100%;
    min-width:850px;
    border-collapse:collapse;
}

.matrix th{
    background:var(--forest);
    color:white;
    padding:1rem;
    text-align:left;
}

.matrix td{
    padding:1rem;
    border-bottom:1px solid var(--line);
    vertical-align:top;
}

.matrix tr:last-child td{
    border-bottom:0;
}

.score{
    display:inline-block;
    padding:.2rem .55rem;
    border-radius:999px;
    font-size:.72rem;
    font-weight:800;
}

.high{
    background:#DCECDD;
    color:#235533;
}

.medium{
    background:#F2E5BF;
    color:#72551B;
}

.low{
    background:#F1D9D2;
    color:#77372B;
}

/* =========================================================
   BAR CHART
   ========================================================= */

.chart{
    background:var(--paper);
    padding:2rem;
    border:1px solid var(--line);
    border-radius:var(--radius);
    box-shadow:var(--shadow);
}

.chart-title{
    font-weight:800;
    color:var(--forest);
    margin-bottom:1.5rem;
}

.bar-row{
    display:grid;
    grid-template-columns:150px 1fr 50px;
    align-items:center;
    gap:12px;
    margin:1rem 0;
}

.bar-label{
    font-size:.86rem;
    font-weight:700;
}

.bar-track{
    height:15px;
    background:#E3E8E3;
    border-radius:20px;
    overflow:hidden;
}

.bar{
    height:100%;
    border-radius:20px;
    background:var(--forest-3);
}

.bar.gold{
    background:var(--gold);
}

.bar.blue{
    background:var(--blue);
}

.bar.brown{
    background:var(--brown);
}

.bar-value{
    font-size:.8rem;
    font-weight:800;
}

/* =========================================================
   TWO COLUMN
   ========================================================= */

.two-column{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:1.5rem;
}

/* =========================================================
   HIDDEN RESOURCES
   ========================================================= */

.resource-panel{
    background:var(--paper);
    border:1px solid var(--line);
    padding:1.5rem;
    border-radius:var(--radius);
    height:100%;
}

.resource-panel h3{
    color:var(--forest);
    margin-bottom:1rem;
}

.resource-panel ul{
    list-style:none;
}

.resource-panel li{
    padding:.75rem 0;
    border-bottom:1px solid var(--line);
    position:relative;
    padding-left:1.4rem;
}

.resource-panel li:last-child{
    border-bottom:0;
}

.resource-panel li:before{
    content:"→";
    position:absolute;
    left:0;
    color:var(--forest-3);
    font-weight:900;
}

/* =========================================================
   RESOURCE LINKS
   ========================================================= */

.link-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:1rem;
}

.resource-link{
    text-decoration:none;
    background:white;
    border:1px solid var(--line);
    color:var(--ink);
    padding:1.2rem;
    border-radius:14px;
    transition:.2s;
}

.resource-link:hover{
    border-color:var(--forest-3);
    transform:translateY(-3px);
    box-shadow:var(--shadow);
}

.resource-link span{
    display:block;
    color:var(--forest-3);
    font-weight:900;
    margin-bottom:.25rem;
}

/* =========================================================
   SYSTEM MAP
   ========================================================= */

.system{
    background:var(--forest);
    color:white;
    padding:2rem;
    border-radius:var(--radius);
}

.system h3{
    color:var(--gold);
    margin-bottom:1.5rem;
}

.system-flow{
    display:grid;
    grid-template-columns:repeat(5,1fr);
    gap:10px;
    align-items:center;
}

.node{
    background:rgba(255,255,255,.09);
    border:1px solid rgba(255,255,255,.12);
    padding:1rem;
    text-align:center;
    border-radius:12px;
    font-size:.82rem;
}

.arrow{
    text-align:center;
    color:var(--gold);
    font-size:1.4rem;
}

/* =========================================================
   PATHWAY RESOURCE SECTIONS
   ========================================================= */

.pathway-section{
    padding:4rem 0;
    border-top:1px solid var(--line);
}

.pathway-header{
    display:grid;
    grid-template-columns:130px 1fr;
    gap:2rem;
    margin-bottom:2rem;
}

.pathway-number{
    font-size:4rem;
    font-weight:900;
    color:var(--sage);
    line-height:1;
}

.pathway-header h2{
    color:var(--forest);
    font-size:2rem;
}

.pathway-header p{
    color:var(--muted);
    max-width:800px;
}

/* =========================================================
   RESOURCE CARDS
   ========================================================= */

.resource-cards{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:1rem;
}

.resource-card{
    background:white;
    padding:1.4rem;
    border:1px solid var(--line);
    border-radius:14px;
}

.resource-card:nth-child(3n+1){
    border-top:4px solid var(--forest-3);
}

.resource-card:nth-child(3n+2){
    border-top:4px solid var(--gold);
}

.resource-card:nth-child(3n+3){
    border-top:4px solid var(--blue);
}

.resource-card h4{
    color:var(--forest);
    margin-bottom:.5rem;
}

.resource-card p{
    color:var(--muted);
    font-size:.88rem;
}

/* =========================================================
   DECISION TREE
   ========================================================= */

.decision{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:1rem;
}

.decision-card{
    padding:1.5rem;
    border-radius:14px;
    background:var(--mint);
}

.decision-card:nth-child(2){
    background:#F3E8CD;
}

.decision-card:nth-child(3){
    background:#E1E8ED;
}

.decision-card strong{
    display:block;
    color:var(--forest);
    margin-bottom:.5rem;
}

/* =========================================================
   EXPERIMENT TABLE
   ========================================================= */

.experiment{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:1rem;
}

.experiment-card{
    background:var(--forest);
    color:white;
    padding:1.4rem;
    border-radius:14px;
}

.experiment-card small{
    color:var(--gold);
    font-weight:800;
}

.experiment-card h4{
    margin:.5rem 0;
}

/* =========================================================
   CHECKLIST
   ========================================================= */

.checklist{
    background:white;
    padding:1.5rem;
    border-radius:var(--radius);
    border:1px solid var(--line);
}

.check{
    display:flex;
    gap:12px;
    padding:.75rem 0;
    border-bottom:1px solid var(--line);
}

.check:last-child{
    border-bottom:0;
}

.checkbox{
    width:22px;
    height:22px;
    border:2px solid var(--forest-3);
    border-radius:5px;
    flex-shrink:0;
}

/* =========================================================
   RESOURCE INDEX
   ========================================================= */

.index{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:1rem;
}

.index-card{
    background:var(--forest);
    color:white;
    padding:1.5rem;
    border-radius:14px;
}

.index-card h3{
    color:var(--gold);
    margin-bottom:.5rem;
}

.index-card a{
    display:block;
    color:#E8F0E9;
    text-decoration:none;
    font-size:.85rem;
    margin:.45rem 0;
}

.index-card a:hover{
    color:var(--gold);
}

/* =========================================================
   FOOTER
   ========================================================= */

footer{
    background:#10291F;
    color:#DDE8DF;
    padding:3rem 5%;
    text-align:center;
}

footer strong{
    color:var(--gold);
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media(max-width:1000px){

    .pathways,
    .index{
        grid-template-columns:repeat(2,1fr);
    }

    .resource-cards,
    .link-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .hero-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .system-flow{
        grid-template-columns:1fr;
    }

    .arrow{
        transform:rotate(90deg);
    }

}

@media(max-width:700px){

    .navbar{
        align-items:flex-start;
        flex-direction:column;
    }

    .hero{
        padding-top:3rem;
    }

    .hero-grid,
    .pathways,
    .resource-cards,
    .link-grid,
    .two-column,
    .decision,
    .experiment,
    .index{
        grid-template-columns:1fr;
    }

    .bar-row{
        grid-template-columns:100px 1fr 35px;
    }

    .pathway-header{
        grid-template-columns:1fr;
        gap:.5rem;
    }

}

</style>
</head>

