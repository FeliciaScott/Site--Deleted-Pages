*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:Arial,Helvetica,sans-serif;background:#0F2D22;color:#F3EBDD;line-height:1.6;}
.hero{background:linear-gradient(180deg,#194936,#0F2D22);padding:70px 20px;text-align:center;}
