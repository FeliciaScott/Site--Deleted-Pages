<script>

/* ======================================================
NAVIGATION
====================================================== */

function goTo(id){
  const element=document.getElementById(id);

  if(element){
    element.scrollIntoView({
      behavior:"smooth",
      block:"start"
    });
  }
}


/* ======================================================
LOCAL STORAGE
====================================================== */

const STORAGE_KEY="grantIntelligencePlanner";

function saveData(){

  const data={};

  document.querySelectorAll("input, textarea, select").forEach((el,index)=>{

    if(el.type==="checkbox"){
      data["checkbox_"+index]=el.checked;
    }else{
      data["field_"+index]=el.value;
    }

  });

  localStorage.setItem(STORAGE_KEY,JSON.stringify(data));

  updateAll();
}


function loadData(){

  const saved=localStorage.getItem(STORAGE_KEY);

  if(!saved) return;

  try{

    const data=JSON.parse(saved);

    document.querySelectorAll("input, textarea, select").forEach((el,index)=>{

      if(el.type==="checkbox"){

        if(data["checkbox_"+index]!==undefined){
          el.checked=data["checkbox_"+index];
        }

      }else{

        if(data["field_"+index]!==undefined){
          el.value=data["field_"+index];
        }

      }

    });

  }catch(error){

    console.log("Saved planner data could not be loaded.");

  }

}


/* ======================================================
BUDGET CALCULATOR
====================================================== */

function calculateBudget(){

  let total=0;

  document.querySelectorAll(".grantCost").forEach(input=>{

    total += Number(input.value)||0;

  });

  const grantAmount=
    Number(document.getElementById("grantAmount").value)||0;

  const remaining=grantAmount-total;

  const percent=
    grantAmount>0
    ? Math.round((total/grantAmount)*100)
    : 0;

  document.getElementById("budgetTotal").textContent=
    money(total);

  document.getElementById("budgetRemaining").textContent=
    money(remaining);

  document.getElementById("budgetPercent").textContent=
    percent+"%";

}


/* ======================================================
MONEY
====================================================== */

function money(number){

  return new Intl.NumberFormat("en-US",{
    style:"currency",
    currency:"USD",
    maximumFractionDigits:0
  }).format(number);

}


/* ======================================================
REQUIREMENT SCORE
====================================================== */

function updateRequirements(){

  const items=
    document.querySelectorAll(".requirement");

  const completed=
    [...items].filter(item=>item.checked).length;

  const total=items.length;

  const percent=
    total
    ? Math.round((completed/total)*100)
    : 0;

  document.getElementById("requirementText").textContent=
    completed+" of "+total+" requirements completed";

  document.getElementById("requirementBar").style.width=
    percent+"%";

}


/* ======================================================
READINESS SCORE
====================================================== */

function calculateReadiness(){

  let score=0;

  let possible=0;


  /* Requirements */

  const requirements=
    document.querySelectorAll(".requirement");

  if(requirements.length){

    const completed=
      [...requirements].filter(item=>item.checked).length;

    score += completed;
    possible += requirements.length;

  }


  /* Grant information */

  const importantFields=[
    "grantName",
    "funder",
    "grantAmount",
    "deadline",
    "businessOverview",
    "fundingNeed",
    "problem",
    "change",
    "beneficiaries",
    "timing"
  ];

  importantFields.forEach(id=>{

    const el=document.getElementById(id);

    if(el && el.value.trim()!==""){
      score++;
    }

    possible++;

  });


  /* Budget */

  let budgetRows=
    document.querySelectorAll(".grantCost");

  if(budgetRows.length){

    let budgetTotal=0;

    budgetRows.forEach(input=>{
      budgetTotal+=Number(input.value)||0;
    });

    const grantAmount=
      Number(document.getElementById("grantAmount").value)||0;

    if(
      grantAmount>0 &&
      budgetTotal>0 &&
      budgetTotal<=grantAmount
    ){
      score++;
    }

    possible++;

  }


  const percent=
    possible
    ? Math.round((score/possible)*100)
    : 0;

  document.getElementById("readinessScore").textContent=
    percent+"%";

  document.getElementById("readinessBar").style.width=
    percent+"%";

}


/* ======================================================
GENERATE SUMMARY
====================================================== */

function generateSummary(){

  const grantName=
    document.getElementById("grantName").value;

  const funder=
    document.getElementById("funder").value;

  const grantAmount=
    Number(document.getElementById("grantAmount").value)||0;

  const deadline=
    document.getElementById("deadline").value ||
    "Not entered";

  const business=
    document.getElementById("businessOverview").value;

  const need=
    document.getElementById("fundingNeed").value;

  const problem=
    document.getElementById("problem").value;

  const change=
    document.getElementById("change").value;

  const beneficiaries=
    document.getElementById("beneficiaries").value;

  const timing=
    document.getElementById("timing").value;


  let budgetTotal=0;

  document.querySelectorAll(".grantCost").forEach(input=>{
    budgetTotal+=Number(input.value)||0;
  });


  const remaining=
    grantAmount-budgetTotal;


  const summary=

`${grantName.toUpperCase()}

FUNDER
${funder}

REQUESTED FUNDING
${money(grantAmount)}

APPLICATION DEADLINE
${deadline}

PROJECT OVERVIEW
${business}

PROBLEM / NEED
${problem}

WHY FUNDING IS NEEDED
${need}

WHAT FUNDING WILL CHANGE
${change}

INTENDED BENEFICIARIES
${beneficiaries}

WHY NOW
${timing}

PLANNED FUNDING USE
${money(budgetTotal)}

REMAINING / UNALLOCATED GRANT FUNDS
${money(remaining)}

PROJECT STRUCTURE
1. Conduct technical review and identify priority improvements.
2. Hire experienced development support for functionality and scalability.
3. Strengthen digital content and educational resources.
4. Hire or engage qualified marketing support.
5. Develop stronger audience and outreach strategies.
6. Measure platform usage, audience growth, engagement and business outcomes.

PRIMARY EXPECTED RESULTS
• Stronger digital functionality
• Improved scalability
• Expanded educational resources
• Stronger audience strategy
• Greater visibility
• Increased reach among entrepreneurs, students, parents and other intended beneficiaries
• More measurable and sustainable business activity

APPLICATION PRINCIPLE
The final proposal, budget and claims must be adjusted to the specific grant's eligibility rules, allowable expenses, application questions and evaluation criteria.`;


  document.getElementById("generatedSummary").textContent=
    summary;

  return summary;

}


/* ======================================================
COPY SUMMARY
====================================================== */

function copySummary(){

  const text=generateSummary();

  if(navigator.clipboard){

    navigator.clipboard.writeText(text)
      .then(()=>{
        alert("Grant summary copied to clipboard.");
      })
      .catch(()=>{
        fallbackCopy(text);
      });

  }else{

    fallbackCopy(text);

  }

}


function fallbackCopy(text){

  const textarea=document.createElement("textarea");

  textarea.value=text;

  document.body.appendChild(textarea);

  textarea.select();

  document.execCommand("copy");

  textarea.remove();

  alert("Grant summary copied to clipboard.");

}


/* ======================================================
STATUS
====================================================== */

function updateStatus(){

  const status=
    document.getElementById("applicationStatus").value;

  const element=
    document.getElementById("grantStatus");

  element.textContent=status;

  element.className="status";

  if(
    status==="Submitted" ||
    status==="Awarded"
  ){

    element.classList.add("status-green");

  }else if(
    status==="Preparing" ||
    status==="Ready to Submit"
  ){

    element.classList.add("status-yellow");

  }else{

    element.classList.add("status-yellow");

  }

}


/* ======================================================
UPDATE EVERYTHING
====================================================== */

function updateAll(){

  calculateBudget();

  updateRequirements();

  calculateReadiness();

  generateSummary();

  updateStatus();

}


/* ======================================================
RESET
====================================================== */

function resetPlanner(){

  const confirmed=
    confirm(
      "Reset the entire grant planner? Saved information will be removed."
    );

  if(!confirmed) return;

  localStorage.removeItem(STORAGE_KEY);

  location.reload();

}


/* ======================================================
AUTO-SAVE CHECKBOXES
====================================================== */

document.addEventListener("change",function(event){

  if(
    event.target.classList.contains("requirement")
  ){

    saveData();

  }

});


/* ======================================================
INITIALIZE
====================================================== */

loadData();

updateAll();

</script>

</body>
