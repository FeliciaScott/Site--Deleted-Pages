<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Grant Intelligence & Application Planner</title>

<style>
:root{
  --navy:#101827;
  --navy2:#172338;
  --blue:#2563eb;
  --blue2:#dbeafe;
  --green:#16805c;
  --green2:#dff7ec;
  --gold:#c58b18;
  --gold2:#fff4d2;
  --red:#b42318;
  --red2:#fee4e2;
  --cream:#f8f6f0;
  --white:#ffffff;
  --text:#263242;
  --muted:#687587;
  --border:#d9e0e8;
  --shadow:0 12px 30px rgba(16,24,39,.08);
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
}

html{
  scroll-behavior:smooth;
}

body{
  background:var(--cream);
  color:var(--text);
  line-height:1.5;
}

button,
input,
textarea,
select{
  font:inherit;
}

button{
  cursor:pointer;
}

.container{
  width:min(1180px,94%);
  margin:auto;
}

/* HEADER */

.hero{
  background:
    linear-gradient(135deg,var(--navy),var(--navy2));
  color:white;
  padding:46px 0 38px;
}

.hero-inner{
  display:grid;
  grid-template-columns:1.5fr .8fr;
  gap:30px;
  align-items:center;
}

.badge{
  display:inline-block;
  padding:6px 12px;
  border-radius:999px;
  background:#263754;
  color:#dbeafe;
  font-size:.75rem;
  font-weight:800;
  letter-spacing:.06em;
  text-transform:uppercase;
  margin-bottom:14px;
}

.hero h1{
  font-size:clamp(2rem,4vw,3.5rem);
  line-height:1.05;
  margin-bottom:14px;
}

.hero p{
  color:#d4dce8;
  max-width:760px;
  font-size:1.03rem;
}

.hero-score{
  background:#ffffff12;
  border:1px solid #ffffff20;
  border-radius:18px;
  padding:25px;
  text-align:center;
}

.score-number{
  font-size:3.5rem;
  font-weight:800;
  line-height:1;
}

.score-label{
  color:#cbd5e1;
  margin-top:7px;
}

/* NAV */

.nav{
  background:white;
  border-bottom:1px solid var(--border);
  position:sticky;
  top:0;
  z-index:50;
}

.nav-inner{
  display:flex;
  gap:7px;
  overflow-x:auto;
  padding:9px 0;
}

.nav button{
  border:0;
  background:transparent;
  padding:9px 13px;
  border-radius:8px;
  color:var(--muted);
  white-space:nowrap;
  font-weight:700;
}

.nav button:hover{
  background:#eef3f8;
  color:var(--navy);
}

/* MAIN */

main{
  padding:30px 0 70px;
}

.panel{
  background:white;
  border:1px solid var(--border);
  border-radius:16px;
  padding:25px;
  margin-bottom:24px;
  box-shadow:var(--shadow);
}

.panel-header{
  display:flex;
  justify-content:space-between;
  gap:20px;
  align-items:flex-start;
  margin-bottom:20px;
}

.panel-header h2{
  color:var(--navy);
  font-size:1.45rem;
}

.panel-header p{
  color:var(--muted);
  margin-top:4px;
}

/* GRID */

.grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:18px;
}

.grid-3{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:16px;
}

/* FORM */

.field{
  display:flex;
  flex-direction:column;
  gap:6px;
}

.field label{
  font-weight:750;
  color:var(--navy);
  font-size:.88rem;
}

.field input,
.field textarea,
.field select{
  width:100%;
  border:1px solid var(--border);
  border-radius:9px;
  padding:11px 12px;
  background:white;
  color:var(--text);
  outline:none;
}

.field input:focus,
.field textarea:focus,
.field select:focus{
  border-color:var(--blue);
  box-shadow:0 0 0 3px #2563eb18;
}

.field textarea{
  min-height:115px;
  resize:vertical;
}

/* CARDS */

.info-card{
  border:1px solid var(--border);
  border-radius:13px;
  padding:18px;
  background:#fbfcfd;
}

.info-card h3{
  font-size:1rem;
  color:var(--navy);
  margin-bottom:8px;
}

.info-card p{
  color:var(--muted);
  font-size:.92rem;
}

.fit-card{
  border-left:5px solid var(--green);
  background:var(--green2);
  padding:17px;
  border-radius:9px;
}

.warning-card{
  border-left:5px solid var(--gold);
  background:var(--gold2);
  padding:17px;
  border-radius:9px;
}

.danger-card{
  border-left:5px solid var(--red);
  background:var(--red2);
  padding:17px;
  border-radius:9px;
}

/* TABLE */

.table-wrap{
  overflow-x:auto;
}

table{
  width:100%;
  border-collapse:collapse;
}

th,
td{
  padding:12px 11px;
  border-bottom:1px solid var(--border);
  text-align:left;
  vertical-align:top;
  font-size:.9rem;
}

th{
  background:#f4f7fa;
  color:var(--navy);
  font-size:.8rem;
  text-transform:uppercase;
  letter-spacing:.03em;
}

td input{
  width:100%;
  min-width:100px;
  padding:8px;
  border:1px solid var(--border);
  border-radius:7px;
}

/* PROGRESS */

.progress{
  height:12px;
  background:#e9eef3;
  border-radius:999px;
  overflow:hidden;
}

.progress-bar{
  height:100%;
  width:0;
  background:var(--blue);
  transition:.3s;
}

/* CHECKLIST */

.checklist{
  display:grid;
  gap:9px;
}

.check-item{
  display:flex;
  align-items:center;
  gap:11px;
  padding:12px;
  border:1px solid var(--border);
  border-radius:9px;
  background:#fbfcfd;
}

.check-item input{
  width:18px;
  height:18px;
  accent-color:var(--green);
}

.check-item span{
  font-size:.92rem;
}

/* TIMELINE */

.timeline{
  display:grid;
  gap:12px;
}

.timeline-item{
  display:grid;
  grid-template-columns:130px 1fr;
  gap:15px;
  padding:15px;
  border:1px solid var(--border);
  border-radius:10px;
  background:#fbfcfd;
}

.timeline-date{
  font-weight:800;
  color:var(--blue);
}

/* BUTTONS */

.actions{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  margin-top:20px;
}

.btn{
  border:0;
  border-radius:9px;
  padding:11px 16px;
  font-weight:800;
}

.btn-primary{
  background:var(--blue);
  color:white;
}

.btn-primary:hover{
  background:#1d4ed8;
}

.btn-secondary{
  background:#e9eef4;
  color:var(--navy);
}

.btn-green{
  background:var(--green);
  color:white;
}

.btn-danger{
  background:#fee4e2;
  color:var(--red);
}

/* STATUS */

.status{
  display:inline-block;
  padding:5px 10px;
  border-radius:999px;
  font-size:.75rem;
  font-weight:800;
}

.status-green{
  background:var(--green2);
  color:var(--green);
}

.status-yellow{
  background:var(--gold2);
  color:#8a6200;
}

.status-red{
  background:var(--red2);
  color:var(--red);
}

/* METRICS */

.metric{
  padding:20px;
  background:#f7f9fb;
  border:1px solid var(--border);
  border-radius:12px;
}

.metric-number{
  font-size:1.8rem;
  font-weight:850;
  color:var(--navy);
}

.metric-label{
  color:var(--muted);
  font-size:.84rem;
}

/* FOOTER */

footer{
  text-align:center;
  color:var(--muted);
  padding:20px;
  font-size:.82rem;
}

/* RESPONSIVE */

@media(max-width:850px){
  .hero-inner,
  .grid{
    grid-template-columns:1fr;
  }

  .grid-3{
    grid-template-columns:1fr;
  }

  .timeline-item{
    grid-template-columns:1fr;
  }
}

@media(max-width:600px){
  body{
    padding:0;
  }

  .panel{
    padding:18px;
    border-radius:12px;
  }

  .hero{
    padding:32px 0;
  }
}
</style>
</head>

<body>

<header class="hero">
  <div class="container hero-inner">

    <div>
      <span class="badge">Grant Intelligence Template</span>

      <h1>Grant Application & Funding Planner</h1>

      <p>
        A reusable system for evaluating a grant, proving project fit,
        planning the use of funds, preparing the application, measuring
        outcomes, and tracking readiness from opportunity discovery
        through submission.
      </p>
    </div>

    <div class="hero-score">
      <div class="score-number" id="readinessScore">0%</div>
      <div class="score-label">Application Readiness</div>

      <div class="progress" style="margin-top:15px;">
        <div class="progress-bar" id="readinessBar"></div>
      </div>
    </div>

  </div>
</header>


<nav class="nav">
  <div class="container nav-inner">
    <button onclick="goTo('opportunity')">Opportunity</button>
    <button onclick="goTo('business')">Project</button>
    <button onclick="goTo('fit')">Grant Fit</button>
    <button onclick="goTo('budget')">Budget</button>
    <button onclick="goTo('plan')">Project Plan</button>
    <button onclick="goTo('outcomes')">Outcomes</button>
    <button onclick="goTo('requirements')">Requirements</button>
    <button onclick="goTo('timeline')">Timeline</button>
    <button onclick="goTo('summary')">Summary</button>
  </div>
</nav>


<main class="container">

<!-- ======================================================
OPPORTUNITY
====================================================== -->

<section class="panel" id="opportunity">

  <div class="panel-header">
    <div>
      <h2>1. Grant Opportunity Intelligence</h2>
      <p>
        Enter the information for each grant before investing significant
        time into an application.
      </p>
    </div>

    <span class="status status-yellow" id="grantStatus">
      Researching
    </span>
  </div>

  <div class="grid">

    <div class="field">
      <label>Grant Name</label>
      <input
        id="grantName"
        value="Sample Grant Opportunity"
        oninput="saveData();updateAll();">
    </div>

    <div class="field">
      <label>Funder / Organization</label>
      <input
        id="funder"
        value="Enter Funding Organization"
        oninput="saveData();updateAll();">
    </div>

    <div class="field">
      <label>Grant Amount Available</label>
      <input
        id="grantAmount"
        type="number"
        value="25000"
        oninput="calculateBudget();saveData();updateAll();">
    </div>

    <div class="field">
      <label>Application Deadline</label>
      <input
        id="deadline"
        type="date"
        oninput="saveData();updateAll();">
    </div>

    <div class="field">
      <label>Official Grant URL</label>
      <input
        id="grantUrl"
        placeholder="Paste official grant page here"
        oninput="saveData();">
    </div>

    <div class="field">
      <label>Application Status</label>
      <select id="applicationStatus" onchange="saveData();updateAll();">
        <option>Researching</option>
        <option>Potential Fit</option>
        <option>Preparing</option>
        <option>Ready to Submit</option>
        <option>Submitted</option>
        <option>Declined</option>
        <option>Awarded</option>
      </select>
    </div>

  </div>

  <div class="grid" style="margin-top:18px;">

    <div class="info-card">
      <h3>What this section answers</h3>
      <p>
        Who is providing the money? How much is available? When is it due?
        What are the eligibility rules? What documents are required?
      </p>
    </div>

    <div class="warning-card">
      <strong>Verification rule</strong>
      <p>
        Do not treat the sample grant amount, deadline, eligibility,
        or allowable expenses as confirmed until they are verified
        against the funder's current guidelines.
      </p>
    </div>

  </div>

</section>


<!-- ======================================================
BUSINESS / PROJECT
====================================================== -->

<section class="panel" id="business">

  <div class="panel-header">
    <div>
      <h2>2. Business & Project Definition</h2>
      <p>
        Define exactly what the grant would help build, improve, or scale.
      </p>
    </div>
  </div>

  <div class="field">
    <label>Business / Initiative Overview</label>

    <textarea
      id="businessOverview"
      oninput="saveData();updateAll();">A digital education and web-platform initiative focused on helping organizations replace overly subjective decision-making with structured, measurable, systemized approaches to hiring, retention, performance, operations, and growth.</textarea>
  </div>

  <div class="grid" style="margin-top:18px;">

    <div class="info-card">
      <h3>Primary Website</h3>
      <p>
        A business education platform teaching companies how to use
        structured systems and measurable approaches to improve
        profitability and organizational decision-making.
      </p>
    </div>

    <div class="info-card">
      <h3>Education Opportunity Platform</h3>
      <p>
        A planned website helping students and individuals navigate
        higher education, certificates, competitions, studying abroad,
        and other educational opportunities.
      </p>
    </div>

    <div class="info-card">
      <h3>Parent Resource Platform</h3>
      <p>
        A planned website providing useful products, resources,
        information, and practical tools for parents.
      </p>
    </div>

    <div class="info-card">
      <h3>Growth Infrastructure</h3>
      <p>
        The grant would help move existing projects from development
        toward stronger functionality, scalability, visibility,
        and audience reach.
      </p>
    </div>

  </div>

  <div class="field" style="margin-top:18px;">
    <label>Why Funding Is Needed</label>

    <textarea
      id="fundingNeed"
      oninput="saveData();updateAll();">Funding would accelerate the transition from developing concepts and digital assets to stronger, more functional, scalable platforms. Experienced developers can improve technical functionality and infrastructure, while marketing professionals can strengthen audience strategy, visibility, positioning, and reach.</textarea>
  </div>

</section>


<!-- ======================================================
FIT
====================================================== -->

<section class="panel" id="fit">

  <div class="panel-header">
    <div>
      <h2>3. Grant Fit Analysis</h2>
      <p>
        A grant should be evaluated against the actual project rather than
        forcing the project to become something it is not.
      </p>
    </div>
  </div>

  <div class="grid">

    <div class="fit-card">
      <strong>Strong Potential Fit</strong>
      <p>
        Grants supporting small-business growth, digital transformation,
        entrepreneurship, technology development, workforce development,
        education, community resources, or economic opportunity may
        potentially align with the project.
      </p>
    </div>

    <div class="danger-card">
      <strong>Potential Mismatch</strong>
      <p>
        A grant should not be treated as a fit merely because money is
        available. Restrictions on for-profit businesses, technology,
        contractor expenses, marketing, staffing, geography, or
        pre-existing projects can eliminate eligibility.
      </p>
    </div>

  </div>

  <div class="table-wrap" style="margin-top:20px;">

    <table>

      <thead>
        <tr>
          <th>Grant Requirement</th>
          <th>Project Evidence</th>
          <th>Fit</th>
          <th>Verification Needed</th>
        </tr>
      </thead>

      <tbody>

        <tr>
          <td>Business / Applicant Eligibility</td>
          <td>Existing digital business initiative</td>
          <td>
            <select onchange="saveData()">
              <option>Verify</option>
              <option>Strong</option>
              <option>Partial</option>
              <option>No</option>
            </select>
          </td>
          <td>Confirm funder's applicant rules</td>
        </tr>

        <tr>
          <td>Technology / Development</td>
          <td>Experienced developers to improve platforms</td>
          <td>
            <select onchange="saveData()">
              <option>Verify</option>
              <option>Strong</option>
              <option>Partial</option>
              <option>No</option>
            </select>
          </td>
          <td>Check whether contractor development is allowable</td>
        </tr>

        <tr>
          <td>Marketing / Outreach</td>
          <td>Audience strategy and visibility</td>
          <td>
            <select onchange="saveData()">
              <option>Verify</option>
              <option>Strong</option>
              <option>Partial</option>
              <option>No</option>
            </select>
          </td>
          <td>Check marketing restrictions</td>
        </tr>

        <tr>
          <td>Economic / Business Impact</td>
          <td>Improved systems, reach, products and operations</td>
          <td>
            <select onchange="saveData()">
              <option>Verify</option>
              <option>Strong</option>
              <option>Partial</option>
              <option>No</option>
            </select>
          </td>
          <td>Define measurable outcomes</td>
        </tr>

        <tr>
          <td>Community / Beneficiary Impact</td>
          <td>Entrepreneurs, students, parents and other users</td>
          <td>
            <select onchange="saveData()">
              <option>Verify</option>
              <option>Strong</option>
              <option>Partial</option>
              <option>No</option>
            </select>
          </td>
          <td>Define target beneficiaries</td>
        </tr>

      </tbody>

    </table>

  </div>

</section>


<!-- ======================================================
BUDGET
====================================================== -->

<section class="panel" id="budget">

  <div class="panel-header">
    <div>
      <h2>4. Funding Allocation & Budget Builder</h2>
      <p>
        Build the budget around actual project requirements rather than
        arbitrary percentages.
      </p>
    </div>
  </div>

  <div class="grid-3">

    <div class="metric">
      <div class="metric-number" id="budgetTotal">$0</div>
      <div class="metric-label">Planned Grant Spending</div>
    </div>

    <div class="metric">
      <div class="metric-number" id="budgetRemaining">$0</div>
      <div class="metric-label">Grant Funds Remaining</div>
    </div>

    <div class="metric">
      <div class="metric-number" id="budgetPercent">0%</div>
      <div class="metric-label">Budget Allocated</div>
    </div>

  </div>

  <div class="table-wrap" style="margin-top:20px;">

    <table id="budgetTable">

      <thead>
        <tr>
          <th>Expense</th>
          <th>Estimated Cost</th>
          <th>Grant Portion</th>
          <th>Purpose / Justification</th>
        </tr>
      </thead>

      <tbody>

        <tr>
          <td>
            <strong>Experienced Developers</strong>
          </td>

          <td>
            <input
              class="cost"
              type="number"
              value="10000"
              oninput="calculateBudget();saveData();">
          </td>

          <td>
            <input
              class="grantCost"
              type="number"
              value="10000"
              oninput="calculateBudget();saveData();">
          </td>

          <td>
            Improve functionality, infrastructure, usability,
            scalability and technical reliability.
          </td>
        </tr>

        <tr>
          <td>
            <strong>Marketing Professionals</strong>
          </td>

          <td>
            <input
              class="cost"
              type="number"
              value="6000"
              oninput="calculateBudget();saveData();">
          </td>

          <td>
            <input
              class="grantCost"
              type="number"
              value="6000"
              oninput="calculateBudget();saveData();">
          </td>

          <td>
            Develop audience strategies, positioning, outreach,
            visibility and marketing systems.
          </td>
        </tr>

        <tr>
          <td>
            <strong>Technology & Infrastructure</strong>
          </td>

          <td>
            <input
              class="cost"
              type="number"
              value="3500"
              oninput="calculateBudget();saveData();">
          </td>

          <td>
            <input
              class="grantCost"
              type="number"
              value="3500"
              oninput="calculateBudget();saveData();">
          </td>

          <td>
            Hosting, development infrastructure, testing,
            security and required digital services.
          </td>
        </tr>

        <tr>
          <td>
            <strong>Content & Digital Assets</strong>
          </td>

          <td>
            <input
              class="cost"
              type="number"
              value="2500"
              oninput="calculateBudget();saveData();">
          </td>

          <td>
            <input
              class="grantCost"
              type="number"
              value="2500"
              oninput="calculateBudget();saveData();">
          </td>

          <td>
            Educational resources, product assets,
            documentation and supporting materials.
          </td>
        </tr>

        <tr>
          <td>
            <strong>Other Approved Expenses</strong>
          </td>

          <td>
            <input
              class="cost"
              type="number"
              value="3000"
              oninput="calculateBudget();saveData();">
          </td>

          <td>
            <input
              class="grantCost"
              type="number"
              value="3000"
              oninput="calculateBudget();saveData();">
          </td>

          <td>
            Reserved for eligible project expenses identified
            by the specific grant guidelines.
          </td>
        </tr>

      </tbody>

    </table>

  </div>

  <div class="warning-card" style="margin-top:18px;">
    <strong>Important:</strong>
    The categories above are a planning model, not a claim that every
    grant permits these expenses. Replace, remove, or redistribute
    categories according to the actual grant rules.
  </div>

</section>


<!-- ======================================================
PROJECT PLAN
====================================================== -->

<section class="panel" id="plan">

  <div class="panel-header">
    <div>
      <h2>5. Grant-Funded Project Plan</h2>
      <p>
        Connect every major expense to a specific action and deliverable.
      </p>
    </div>
  </div>

  <div class="table-wrap">

    <table>

      <thead>
        <tr>
          <th>Phase</th>
          <th>Action</th>
          <th>Responsible Party</th>
          <th>Deliverable</th>
          <th>Evidence of Completion</th>
        </tr>
      </thead>

      <tbody>

        <tr>
          <td>1. Technical Audit</td>
          <td>Review existing websites, systems and technical weaknesses</td>
          <td>Developer</td>
          <td>Technical improvement plan</td>
          <td>Written audit + prioritized task list</td>
        </tr>

        <tr>
          <td>2. Development</td>
          <td>Improve functionality and infrastructure</td>
          <td>Developer</td>
          <td>Functional platform improvements</td>
          <td>Working features + testing results</td>
        </tr>

        <tr>
          <td>3. Content Systems</td>
          <td>Strengthen educational resources and digital products</td>
          <td>Project Owner / Contractors</td>
          <td>Expanded resource library</td>
          <td>Published resources and product inventory</td>
        </tr>

        <tr>
          <td>4. Marketing Strategy</td>
          <td>Develop audience segmentation and outreach systems</td>
          <td>Marketing Professional</td>
          <td>Marketing strategy</td>
          <td>Campaign plan + audience metrics</td>
        </tr>

        <tr>
