<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>LearningPath | Build Your Own Learning Strategy</title>

<meta name="description" content="Build a personalized learning path with curated resources, practical projects, skill development, financial planning, and measurable progress.">

<style>
:root{
  --black:#111310;
  --deep:#171b17;
  --forest:#20382d;
  --forest2:#294639;
  --cream:#f4f0e7;
  --ivory:#fbfaf6;
  --paper:#ffffff;
  --gold:#c8a96b;
  --goldlight:#e0ca96;
  --sage:#dce4db;
  --text:#1a211d;
  --soft:#59625c;
  --muted:#7a817c;
  --line:#dedfd8;
  --darkline:#39423c;
  --shadow:0 20px 55px rgba(15,20,16,.10);
}

*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  background:var(--cream);
  color:var(--text);
  font-family:Arial,Helvetica,sans-serif;
  line-height:1.65;
}
a{color:inherit;text-decoration:none}
button,select,input,textarea{font:inherit}
.container{width:min(1160px,90%);margin:auto}
section{scroll-margin-top:25px}

/* NAVIGATION */
.nav{
  background:var(--black);
  color:white;
  border-bottom:1px solid rgba(255,255,255,.1);
}
.nav-inner{
  min-height:76px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:25px;
}
.logo{
  display:flex;
  align-items:center;
  gap:12px;
  font-weight:800;
  letter-spacing:-.04em;
}
.logo-mark{
  width:31px;height:31px;
  border:1px solid var(--gold);
  display:grid;place-items:center;
}
.logo-mark:after{
  content:"";
  width:10px;height:10px;
  border:1px solid var(--goldlight);
  transform:rotate(45deg);
}
.logo-name span{color:var(--goldlight)}
.nav-links{
  display:flex;
  align-items:center;
  flex-wrap:wrap;
  gap:25px;
}
.nav-links a{
  color:#c3c9c4;
  font-size:.82rem;
  font-weight:700;
}
.nav-links a:hover{color:var(--goldlight)}
.nav-button{
  padding:9px 15px;
  border:1px solid rgba(255,255,255,.25);
  color:white!important;
}

/* BUTTONS */
.button{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:13px 21px;
  border:0;
  cursor:pointer;
  font-size:.85rem;
  font-weight:800;
  transition:.2s ease;
  text-align:center;
}
.button-gold{background:var(--gold);color:#151813}
.button-gold:hover{background:var(--goldlight);transform:translateY(-2px)}
.button-outline{border:1px solid rgba(255,255,255,.3);color:white;background:transparent}
.button-outline:hover{border-color:var(--gold);color:var(--goldlight)}
.button-dark{background:var(--forest);color:white}
.button-dark:hover{background:var(--forest2)}
.button-light{background:var(--ivory);color:var(--forest);border:1px solid var(--line)}
.button-light:hover{background:var(--sage)}

/* HERO */
.hero{
  background:var(--black);
  color:white;
  padding:95px 0 105px;
  position:relative;
  overflow:hidden;
}
.hero:after{
  content:"";
  position:absolute;
  width:520px;height:520px;
  border:1px solid rgba(200,169,107,.13);
  border-radius:50%;
  right:-230px;top:-210px;
}
.hero-grid{
  display:grid;
  grid-template-columns:1.1fr .9fr;
  gap:65px;
  align-items:center;
  position:relative;z-index:1;
}
.eyebrow,.overline{
  color:var(--goldlight);
  font-size:.7rem;
  font-weight:900;
  letter-spacing:.17em;
  text-transform:uppercase;
  margin-bottom:20px;
}
.hero h1{
  font-family:Georgia,serif;
  font-size:clamp(3rem,6vw,5.8rem);
  font-weight:400;
  line-height:.98;
  letter-spacing:-.06em;
}
.hero h1 em{color:var(--goldlight);font-style:normal}
.hero-description{
  max-width:620px;
  color:#bdc6bf;
  font-size:1.05rem;
  margin-top:26px;
}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:32px}
.hero-note{font-size:.75rem;color:#829087;margin-top:17px}

/* HERO STRATEGY CARD */
.strategy-card{
  background:#1a201b;
  border:1px solid #39433c;
  padding:28px;
  box-shadow:0 30px 70px rgba(0,0,0,.25);
}
.strategy-top{
  display:flex;justify-content:space-between;gap:10px;
  padding-bottom:18px;border-bottom:1px solid #39433c;
}
.strategy-label{
  font-size:.65rem;color:#9aa59d;
  text-transform:uppercase;letter-spacing:.14em;
}
.strategy-status{
  color:var(--goldlight);
  border:1px solid #64553a;
  padding:4px 8px;font-size:.63rem;
}
.strategy-title{
  font-family:Georgia,serif;
  font-size:1.7rem;
  line-height:1.2;
  margin:23px 0;
}
.strategy-row{
  display:grid;grid-template-columns:32px 1fr;
  gap:13px;padding:15px 0;
  border-top:1px solid #303832;
}
.strategy-number{color:var(--gold);font-weight:800;font-size:.75rem}
.strategy-row strong{font-size:.88rem}
.strategy-row p{color:#929d95;font-size:.76rem;margin-top:3px}

/* GENERAL SECTION STYLES */
.section{padding:85px 0}
.section-light{background:var(--ivory)}
.section-dark{background:var(--forest);color:white}
.section-heading{max-width:760px;margin-bottom:42px}
.section-heading .overline{color:var(--forest)}
.section-dark .section-heading .overline{color:var(--goldlight)}
.section-heading h2{
  font-family:Georgia,serif;
  font-size:clamp(2.3rem,4vw,3.8rem);
  font-weight:400;line-height:1.05;
  letter-spacing:-.045em;
}
.section-heading p{color:var(--soft);margin-top:16px;max-width:680px}
.section-dark .section-heading p{color:#c0cbc3}

/* INTRO */
.intro-grid{
  display:grid;grid-template-columns:.8fr 1.2fr;
  gap:75px;align-items:start;
}
.intro h2{
  font-family:Georgia,serif;
  font-size:clamp(2.3rem,4vw,3.7rem);
  line-height:1.05;font-weight:400;
}
.intro-copy{color:var(--soft);font-size:1rem}
.intro-copy p+p{margin-top:17px}
.highlight{
  margin-top:25px;padding:15px 18px;
  border-left:3px solid var(--gold);
  color:var(--text);font-weight:700;
  background:#f3eee3;
}

/* CHALLENGE GRID */
.challenge-grid{
  display:grid;grid-template-columns:repeat(3,1fr);
  border-top:1px solid var(--darkline);
  border-bottom:1px solid var(--darkline);
}
.challenge{
  padding:30px;
  border-right:1px solid var(--darkline);
}
.challenge:last-child{border-right:0}
.challenge-number{color:var(--gold);font-size:.7rem;font-weight:900;letter-spacing:.12em}
.challenge h3{margin:15px 0 8px;font-size:1.05rem}
.challenge p{color:#bac7be;font-size:.86rem}

/* LEARNING CYCLE */
.cycle-grid{
  display:grid;grid-template-columns:repeat(3,1fr);
  gap:16px;
}
.cycle-card{
  background:white;padding:25px;
  border:1px solid var(--line);
  border-top:4px solid var(--gold);
  box-shadow:0 8px 22px rgba(0,0,0,.04);
}
.cycle-card .number{
  font-size:.7rem;color:var(--forest);
  font-weight:900;letter-spacing:.12em;
}
.cycle-card h3{margin:10px 0 7px}
.cycle-card p{font-size:.86rem;color:var(--soft)}

/* NEEDS ASSESSMENT */
.assessment-section{
  background:#e9e5da;
  padding:90px 0;
}
.assessment-container{
  max-width:900px;margin:auto;
  background:white;padding:38px;
  box-shadow:var(--shadow);
  border:1px solid var(--line);
}
.assessment-container h2{
  font-family:Georgia,serif;
  font-size:2.5rem;font-weight:400;
  text-align:center;line-height:1.1;
}
.assessment-intro{
  text-align:center;max-width:690px;
  margin:15px auto 30px;color:var(--soft);
}
.assessment-question{
  margin:22px 0;padding-bottom:20px;
  border-bottom:1px solid var(--line);
}
.assessment-question label{
  display:block;font-weight:800;
  margin-bottom:9px;color:var(--forest);
}
.assessment-question select,
.assessment-question input,
.assessment-question textarea{
  width:100%;padding:13px;
  border:1px solid #c9c9bf;
  background:#fbfaf6;color:var(--text);
  border-radius:4px;
}
.assessment-question textarea{min-height:85px;resize:vertical}
.assessment-submit{
  width:100%;padding:15px;
  background:var(--forest);color:white;
  border:0;font-weight:900;cursor:pointer;
}
.assessment-submit:hover{background:var(--forest2)}
.assessment-result{
  display:none;margin-top:28px;padding:25px;
  background:#edf2eb;border-left:4px solid var(--forest);
}
.assessment-result h3{margin:12px 0 7px;color:var(--forest)}
.assessment-result ul{padding-left:22px;margin:12px 0}
.assessment-result li{margin:6px 0}
.assessment-result p{margin:8px 0}
.assessment-note{font-size:.76rem;color:var(--muted);margin-top:18px}
.reset-button{
  margin-top:18px;padding:10px 16px;
  border:1px solid var(--forest);background:transparent;
  color:var(--forest);cursor:pointer;font-weight:800;
}

/* PRODUCT CARDS */
.product-grid{
  display:grid;grid-template-columns:repeat(4,1fr);
  gap:20px;
}
.product-card{
  background:white;border:1px solid var(--line);
  box-shadow:0 8px 24px rgba(0,0,0,.05);
  overflow:hidden;
  display:flex;flex-direction:column;
}
.product-card img{
  width:100%;height:175px;object-fit:cover;
}
.product-content{padding:22px;display:flex;flex-direction:column;flex:1}
.product-content h3{font-size:1.05rem;margin-bottom:9px}
.product-content p{font-size:.84rem;color:var(--soft);margin-bottom:13px}
.product-content .button{margin-top:auto;width:100%}
.product-tag{
  font-size:.65rem;color:var(--forest);
  font-weight:900;letter-spacing:.12em;
  margin-bottom:8px;text-transform:uppercase;
}

/* SERVICE OFFER */
.offer-header{text-align:center;max-width:740px;margin:0 auto 42px}
.offer-header .overline{color:var(--forest)}
.offer-header h2{
  font-family:Georgia,serif;font-size:clamp(2.5rem,4vw,4rem);
  font-weight:400;line-height:1.05;
}
.offer-header p{color:var(--soft);margin-top:15px}
.offer-card{
  display:grid;grid-template-columns:1.25fr .75fr;
  box-shadow:var(--shadow);
}
.offer-content{background:white;padding:40px}
.offer-content h3{
  font-family:Georgia,serif;font-size:1.9rem;
  font-weight:400;margin-bottom:12px;
}
.offer-content>p{color:var(--soft)}
.feature-grid{
  display:grid;grid-template-columns:1fr 1fr;
  gap:1px;background:var(--line);
  border:1px solid var(--line);margin-top:25px;
}
.feature{background:#fbfbf8;padding:16px;font-size:.82rem;font-weight:800}
.feature span{display:block;color:var(--muted);font-size:.73rem;font-weight:400;margin-top:3px}
.offer-price{
  background:var(--forest);color:white;
  padding:40px;display:flex;flex-direction:column;justify-content:center;
}
.price-overline{
  color:var(--goldlight);font-size:.68rem;
  letter-spacing:.15em;text-transform:uppercase;font-weight:900;
}
.price{
  font-family:Georgia,serif;font-size:4.7rem;
  line-height:1.15;margin:8px 0;
}
.price-description{color:#c0cbc3;font-size:.8rem}
.price-details{list-style:none;margin:24px 0}
.price-details li{
  padding:9px 0;border-bottom:1px solid var(--darkline);
  color:#d4ddd6;font-size:.82rem;
}
.price-button{
  display:block;background:var(--gold);color:#151813;
  padding:14px;text-align:center;font-weight:900;
}
.price-button:hover{background:var(--goldlight)}

/* PROCESS */
.process-grid{
  display:grid;grid-template-columns:repeat(4,1fr);
  border-top:1px solid var(--line);
  border-bottom:1px solid var(--line);
}
.process-item{padding:28px 23px;border-right:1px solid var(--line)}
.process-item:last-child{border-right:0}
.process-number{font-family:Georgia,serif;font-size:1.8rem;color:var(--gold)}
.process-item h3{font-size:1rem;margin:12px 0 7px}
.process-item p{font-size:.82rem;color:var(--soft)}

/* FAQ */
.faq-list{max-width:900px;margin:auto}
.faq-item{
  background:white;padding:21px 23px;
  margin-bottom:13px;border-left:4px solid var(--gold);
}
.faq-item h3{font-size:.98rem;margin-bottom:7px}
.faq-item p{font-size:.86rem;color:var(--soft)}

/* FINAL CTA */
.final{
  background:var(--black);color:white;
  text-align:center;padding:100px 0;
}
.final .overline{color:var(--goldlight)}
.final h2{
  max-width:820px;margin:auto;
  font-family:Georgia,serif;
  font-size:clamp(2.7rem,5vw,4.7rem);
  font-weight:400;line-height:1;
}
.final p{max-width:620px;margin:20px auto;color:#bac4bd}
.final-note{font-size:.75rem!important;color:#879188!important}

/* FOOTER */
footer{
  background:#0b0d0b;color:#879188;
  padding:28px 0;font-size:.75rem;
}
.footer-inner{
  display:flex;justify-content:space-between;
  gap:20px;flex-wrap:wrap;
}

/* RESPONSIVE */
@media(max-width:950px){
  .hero-grid,.intro-grid,.offer-card{grid-template-columns:1fr}
  .hero-grid{gap:45px}
  .challenge-grid{grid-template-columns:1fr}
  .challenge{border-right:0;border-bottom:1px solid var(--darkline)}
  .challenge:last-child{border-bottom:0}
  .product-grid{grid-template-columns:repeat(2,1fr)}
  .process-grid{grid-template-columns:repeat(2,1fr)}
  .process-item:nth-child(2){border-right:0}
  .process-item:nth-child(-n+2){border-bottom:1px solid var(--line)}
}
@media(max-width:650px){
  .nav-inner{padding:16px 0;align-items:flex-start;flex-direction:column}
  .nav-links{gap:12px}
  .nav-links a{font-size:.75rem}
  .nav-button{display:none}
  .hero{padding:70px 0}
  .hero h1{font-size:3.2rem}
  .hero-actions{flex-direction:column}
  .hero-actions .button{width:100%}
  .section,.assessment-section{padding:65px 0}
  .cycle-grid,.product-grid,.process-grid{grid-template-columns:1fr}
  .process-item{border-right:0;border-bottom:1px solid var(--line)}
  .process-item:last-child{border-bottom:0}
  .feature-grid{grid-template-columns:1fr}
  .assessment-container{padding:23px}
  .offer-content,.offer-price{padding:27px}
  .footer-inner{flex-direction:column}
}
</style>
</head>

<body>

<!-- NAVIGATION -->
<nav class="nav">
  <div class="container nav-inner">
    <a href="#home" class="logo">
      <div class="logo-mark"></div>
      <div class="logo-name">Learning<span>Path</span></div>
    </a>

    <div class="nav-links">
      <a href="#approach">Our Approach</a>
      <a href="#assessment">Needs Assessment</a>
      <a href="#tools">Tools</a>
      <a href="#offer">Learning Roadmap</a>
      <a href="#questions">FAQs</a>
      <a href="#start" class="nav-button">Get Started</a>
    </div>
  </div>
</nav>

<!-- HERO -->
<header class="hero" id="home">
  <div class="container hero-grid">
    <div>
      <div class="eyebrow">Personalized learning and career development</div>

      <h1>Build a path.<br><em>Learn with direction.</em></h1>

      <p class="hero-description">
        You do not need another endless list of courses. You need a
        practical way to identify what to learn, where to begin,
        how to use your time, and what to produce as you develop new skills.
      </p>

      <div class="hero-actions">
        <a href="#assessment" class="button button-gold">Identify My Learning Needs</a>
        <a href="#offer" class="button button-outline">Explore the Learning Roadmap</a>
      </div>

      <p class="hero-note">Research · Learning · Practice · Projects · Evidence · Progress</p>
    </div>

    <div class="strategy-card">
      <div class="strategy-top">
        <div class="strategy-label">Your learning strategy</div>
        <div class="strategy-status">PERSONALIZED</div>
      </div>

      <div class="strategy-title">From an idea to a practical plan.</div>

      <div class="strategy-row">
        <div class="strategy-number">01</div>
        <div><strong>Define your destination</strong><p>Identify the outcome you want to achieve.</p></div>
      </div>

      <div class="strategy-row">
        <div class="strategy-number">02</div>
        <div><strong>Assess your starting point</strong><p>Identify existing skills, gaps, and resources.</p></div>
      </div>

      <div class="strategy-row">
        <div class="strategy-number">03</div>
        <div><strong>Choose your learning route</strong><p>Compare courses, credentials, and alternatives.</p></div>
      </div>

      <div class="strategy-row">
        <div class="strategy-number">04</div>
        <div><strong>Practice and demonstrate</strong><p>Create projects and evidence of your work.</p></div>
      </div>
    </div>
  </div>
</header>

<!-- INTRODUCTION -->
<section class="section section-light" id="approach">
  <div class="container intro-grid">
    <div>
      <div class="overline">The real challenge</div>
      <h2>Finding information is not the same as building a future.</h2>
    </div>

    <div class="intro-copy">
      <p>
        When you decide to learn a new skill, the internet gives you
        thousands of possible starting points: courses, videos,
        books, tutorials, certifications, apprenticeships, and communities.
      </p>
      <p>
        But choosing a resource is only one part of the process.
        You also need to understand the time involved, financial
        requirements, skill prerequisites, practice opportunities,
        and how the learning connects to a larger goal.
      </p>
      <p>
        LearningPath helps organize those decisions into a sequence
        you can actually follow.
      </p>
      <div class="highlight">
        The objective is not simply to finish a course. It is to develop
        useful skills and create evidence that you can apply them.
      </div>
    </div>
  </div>
</section>

<!-- CHALLENGES -->
<section class="section section-dark">
  <div class="container">
    <div class="section-heading">
      <div class="overline">Why learning plans stall</div>
      <h2>More information can create more uncertainty.</h2>
      <p>
        A learning plan should help you make decisions, not create
        another collection of unfinished research.
      </p>
    </div>

    <div class="challenge-grid">
      <div class="challenge">
        <div class="challenge-number">01 / CHOICES</div>
        <h3>Too many resources</h3>
        <p>
          You find multiple courses covering the same subject and
          have no clear way to compare cost, quality, relevance, or value.
        </p>
      </div>

      <div class="challenge">
        <div class="challenge-number">02 / SEQUENCE</div>
        <h3>No clear order</h3>
        <p>
          You study individual topics without knowing which skills
          should come first or how they connect to your larger objective.
        </p>
      </div>

      <div class="challenge">
        <div class="challenge-number">03 / APPLICATION</div>
        <h3>Nothing to demonstrate</h3>
        <p>
          You complete lessons but have few projects, work samples,
          or practical examples showing what you can actually do.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- LEARNING CYCLE -->
<section class="section">
  <div class="container">
    <div class="section-heading">
      <div class="overline">The LearningPath framework</div>
      <h2>Turn a learning goal into a repeatable process.</h2>
      <p>
        Every learning route should connect research, instruction,
        practice, application, and review.
      </p>
    </div>

    <div class="cycle-grid">
      <div class="cycle-card">
        <div class="number">01 / EXPLORE</div>
        <h3>Define the destination</h3>
        <p>Choose the career direction, skill, subject, or project you want to pursue.</p>
      </div>

      <div class="cycle-card">
        <div class="number">02 / ASSESS</div>
        <h3>Identify skill gaps</h3>
        <p>Determine what you already know and what you need to learn next.</p>
      </div>

      <div class="cycle-card">
        <div class="number">03 / SELECT</div>
        <h3>Choose learning resources</h3>
        <p>Compare courses, certifications, books, free resources, and training options.</p>
      </div>

      <div class="cycle-card">
        <div class="number">04 / PLAN</div>
        <h3>Organize your resources</h3>
        <p>Account for time, cost, equipment, prerequisites, and available support.</p>
      </div>

      <div class="cycle-card">
        <div class="number">05 / PRACTICE</div>
        <h3>Apply what you learn</h3>
        <p>Use exercises, assignments, simulations, and practical projects.</p>
      </div>

      <div class="cycle-card">
        <div class="number">06 / DEMONSTRATE</div>
        <h3>Create evidence</h3>
        <p>Build work samples, project records, portfolios, and measurable outcomes.</p>
      </div>
    </div>
  </div>
</section>

<!-- NEEDS ASSESSMENT -->
<section class="assessment-section" id="assessment">
  <div class="container">
    <div class="assessment-container">
      <h2>What Do You Actually Need?</h2>

      <p class="assessment-intro">
        Your starting point matters. Answer these questions to identify
        the type of learning support, planning tools, and next steps
        that may be most useful.
      </p>

      <form id="needsForm">
        <div class="assessment-question">
          <label for="mainProblem">1. What is your biggest current challenge?</label>
          <select id="mainProblem" required>
            <option value="">Choose your answer</option>
            <option value="ideas">I have too many ideas and cannot organize them.</option>
            <option value="direction">I do not know which career or skill to pursue.</option>
            <option value="resources">I cannot determine which courses or resources are worth using.</option>
            <option value="skills">I need to identify and develop missing skills.</option>
            <option value="focus">I struggle with focus, consistency, or completing work.</option>
            <option value="practice">I study but do not get enough practical experience.</option>
            <option value="evidence">I need projects or work samples to demonstrate my abilities.</option>
            <option value="finances">I need a learning option that fits my financial situation.</option>
          </select>
        </div>

        <div class="assessment-question">
