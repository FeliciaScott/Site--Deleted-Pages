<script>
/* =====================================================
   PERSONALIZED NEEDS ASSESSMENT
===================================================== */

const needsForm = document.getElementById("needsForm");
const result = document.getElementById("assessmentResult");

needsForm.addEventListener("submit", function(event){
  event.preventDefault();

  const problem = document.getElementById("mainProblem").value;
  const situation = document.getElementById("currentSituation").value;
  const goal = document.getElementById("goal").value;
  const time = document.getElementById("timeAvailable").value;
  const budget = document.getElementById("budget").value;
  const support = document.getElementById("preferredSupport").value;
  const experience = document.getElementById("experience").value.trim();
  const target = document.getElementById("target").value.trim();

  let recommendation = "";
  let explanation = "";
  let actions = [];

  if(problem === "direction" || goal === "explore"){
    recommendation = "Career and Learning Exploration";
    explanation = "Your first priority is to compare possible directions before committing to a specific course or training route.";
    actions = [
      "Identify three areas of interest.",
      "Research the work, skills, and qualifications associated with each area.",
      "Compare entry requirements and realistic learning costs.",
      "Try a beginner lesson or introductory project in your strongest option.",
      "Choose a direction to investigate further."
    ];
  }
  else if(problem === "resources" || budget === "funding"){
    recommendation = "Resource and Funding Research";
    explanation = "Your first priority is to identify appropriate learning options and understand their costs, requirements, and possible funding alternatives.";
    actions = [
      "List the skills or credential you want to pursue.",
      "Compare free, low-cost, and paid learning options.",
      "Check prerequisites and course completion requirements.",
      "Research scholarships, grants, employer support, and other eligible funding.",
      "Compare the total cost before committing."
    ];
  }
  else if(problem === "skills" || goal === "career" || goal === "promotion"){
    recommendation = "Skill Development Roadmap";
    explanation = "Your goal requires a clear understanding of the skills you need and how to develop them in a practical sequence.";
    actions = [
      "Identify the skills associated with your target direction.",
      "Compare those skills with your current experience.",
      "Choose learning resources for the most important gaps.",
      "Practice each skill through exercises or assignments.",
      "Create projects that demonstrate what you can do."
    ];
  }
  else if(problem === "practice" || problem === "evidence" || goal === "project"){
    recommendation = "Practice and Evidence Development";
    explanation = "Your next step is to turn learning into applied work that can be reviewed, improved, and demonstrated.";
    actions = [
      "Choose one skill to demonstrate.",
      "Find a practical exercise that uses the skill.",
      "Complete a small project.",
      "Document the process and final result.",
      "Review the work and identify what to improve."
    ];
  }
  else if(problem === "focus" || problem === "ideas"){
    recommendation = "Learning Organization and Focus System";
    explanation = "Your first priority is to reduce scattered activity and create a manageable learning process.";
    actions = [
      "Choose one main learning goal.",
      "Break it into smaller topics or milestones.",
      "Schedule realistic learning sessions.",
      "Keep a record of completed lessons and practice.",
      "Review progress once each week."
    ];
  }
  else{
    recommendation = "Personalized Learning Roadmap";
    explanation = "Your answers suggest that you would benefit from connecting your goal, resources, schedule, practice, and progress into one organized plan.";
    actions = [
      "Clarify the result you want to achieve.",
      "Identify your current knowledge and experience.",
      "Compare learning options and requirements.",
      "Create a realistic weekly schedule.",
      "Practice through assignments and projects.",
      "Record evidence of your progress."
    ];
  }

  let budgetAdvice = "";
  if(budget === "free"){
    budgetAdvice = "Prioritize free learning resources and avoid paying for a course until you have confirmed that it meets a specific need.";
  }else if(budget === "low"){
    budgetAdvice = "Compare low-cost resources and free alternatives before making a purchase.";
  }else if(budget === "funding"){
    budgetAdvice = "Include funding research in your plan. Check eligibility, deadlines, and covered expenses before applying.";
  }else{
    budgetAdvice = "Compare the total cost of each option with the skills, credential, or practical outcome it provides.";
  }

  let timeAdvice = "";
  if(time === "under3"){
    timeAdvice = "With fewer than three hours weekly, focus on one small learning target at a time.";
  }else if(time === "3to5"){
    timeAdvice = "A short weekly schedule with one learning session and one practice session may be a realistic starting structure.";
  }else if(time === "6to10"){
    timeAdvice = "You may be able to divide your time between instruction, practice, and weekly review.";
  }else if(time === "11to15" || time === "over15"){
    timeAdvice = "You have room to plan a more structured sequence with dedicated learning, practice, and project time.";
  }else{
    timeAdvice = "Use flexible weekly milestones rather than depending on the same study hours every week.";
  }

  let supportAdvice = "";
  if(support === "physical"){
    supportAdvice = "A physical journal or planner may help you organize tasks and review your progress.";
  }else if(support === "digital"){
    supportAdvice = "Digital templates and trackers may help you organize resources, milestones, and project evidence.";
  }else if(support === "research"){
    supportAdvice = "Prioritize comparing course quality, cost, prerequisites, time requirements, and practical outcomes.";
  }else if(support === "projects"){
    supportAdvice = "Build practical assignments into your learning plan from the beginning.";
  }else if(support === "stepbystep"){
    supportAdvice = "Use a sequenced plan with clear milestones and specific actions.";
  }else{
    supportAdvice = "Start with the recommended actions and choose additional tools only when you identify a specific need.";
  }

  const safeTarget = target
    ? target.replace(/[&<>"']/g, function(character){
        return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[character];
      })
    : "Not specified";

  const safeExperience = experience
    ? experience.replace(/[&<>"']/g, function(character){
        return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[character];
      })
    : "No prior experience details provided.";

  result.innerHTML = `
    <h3>Your Learning Needs Assessment</h3>
    <p><strong>Recommended starting point:</strong> ${recommendation}</p>
    <p>${explanation}</p>

    <h3>Your Starting Information</h3>
    <p><strong>Area of interest:</strong> ${safeTarget}</p>
    <p><strong>Current experience:</strong> ${safeExperience}</p>
    <p><strong>Weekly time:</strong> ${time}</p>
    <p><strong>Current situation:</strong> ${situation}</p>
    <p><strong>Desired outcome:</strong> ${goal}</p>

    <h3>Recommended Action Plan</h3>
    <ul>${actions.map(action => `<li>${action}</li>`).join("")}</ul>

    <h3>Financial Consideration</h3>
    <p>${budgetAdvice}</p>

    <h3>Time Consideration</h3>
    <p>${timeAdvice}</p>

    <h3>Suggested Support</h3>
    <p>${supportAdvice}</p>

    <p><strong>Your next move:</strong> Start with the first action. Do not add more courses or tools until you know what problem they will solve.</p>

    <p>
      <a class="button button-dark" href="#offer">Explore a Personalized Roadmap</a>
    </p>

    <button type="button" class="reset-button" id="resetAssessment">Retake Assessment</button>
  `;

  result.style.display = "block";
  result.focus();

  document.getElementById("resetAssessment").addEventListener("click",function(){
    needsForm.reset();
    result.style.display = "none";
    result.innerHTML = "";
    document.getElementById("assessment").scrollIntoView({behavior:"smooth"});
  });

  result.scrollIntoView({behavior:"smooth",block:"nearest"});
});
</script>

