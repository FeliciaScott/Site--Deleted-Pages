<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PathKeeper | Strategist Intelligence Hub</title>

<style>
:root {
  /* CREAM */
  --cream: #F7F2E8;
  --cream-light: #FCFAF5;
  --cream-dark: #EDE3D4;
  --cream-deep: #E2D2B9;

  /* BLUE */
  --blue: #294F6D;
  --blue-deep: #203E57;
  --blue-mid: #3D6F91;
  --blue-light: #729BB5;
  --blue-pale: #DCEAF1;

  /* BROWN */
  --brown: #49352A;
  --brown-mid: #765A45;
  --brown-light: #A18468;
  --brown-pale: #E8DDCD;

  /* SUPPORTING */
  --text: #342B26;
  --muted: #67594E;
  --border: #D7C9B7;
  --shadow: 0 15px 35px rgba(73,53,42,.09);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background:
    radial-gradient(circle at top right, var(--blue-pale), transparent 35%),
    var(--cream);
  color: var(--text);
  line-height: 1.6;
}

a {
  color: inherit;
}

button {
  font: inherit;
}

/* NAVIGATION */

.navbar {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--cream-light);
  border-bottom: 1px solid var(--border);
  padding: 15px 5%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

.brand {
  color: var(--blue);
  font-weight: 900;
  font-size: 1rem;
  letter-spacing: .06em;
}

.nav-links {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
}

.nav-links a {
  color: var(--brown);
  text-decoration: none;
  font-size: .82rem;
  font-weight: 700;
}

.nav-links a:hover {
  color: var(--blue-mid);
}

/* HERO */

.hero {
  position: relative;
  padding: 95px 6% 85px;
  background:
    radial-gradient(circle at 85% 20%, rgba(114,155,181,.25), transparent 30%),
    linear-gradient(125deg, var(--blue-deep), var(--blue) 60%, var(--brown));
  color: var(--cream);
  overflow: hidden;
}

.hero:before,
.hero:after {
  content: "";
  position: absolute;
  border: 1px solid rgba(247,242,232,.15);
  border-radius: 50%;
  pointer-events: none;
}

.hero:before {
  width: 420px;
  height: 420px;
  top: -190px;
  right: -100px;
}

.hero:after {
  width: 250px;
  height: 250px;
  top: -100px;
  right: -15px;
}

.hero-inner {
  max-width: 1150px;
  margin: auto;
  position: relative;
  z-index: 2;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  color: var(--cream-deep);
  font-size: .73rem;
  font-weight: 800;
  letter-spacing: .15em;
  text-transform: uppercase;
  margin-bottom: 20px;
}

.eyebrow span {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--cream-deep);
}

.hero h1 {
  font-size: clamp(2.7rem, 6vw, 5rem);
  line-height: 1.04;
  max-width: 900px;
  letter-spacing: -.045em;
}

.hero h1 strong {
  color: var(--blue-pale);
}

.hero p {
  max-width: 740px;
  margin-top: 24px;
  font-size: 1.08rem;
  color: var(--cream);
}

.hero-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 30px;
}

.meta {
  padding: 8px 14px;
  border: 1px solid rgba(247,242,232,.35);
  border-radius: 999px;
  font-size: .76rem;
  color: var(--cream);
  background: rgba(247,242,232,.07);
}

/* PAGE CONTAINER */

.container {
  max-width: 1150px;
  margin: auto;
  padding: 45px 24px 75px;
}

/* FEATURED PRINCIPLE */

.featured {
  margin-bottom: 65px;
  padding: 32px;
  background: var(--cream-light);
  border: 1px solid var(--border);
  border-left: 6px solid var(--blue);
  border-radius: 14px;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 25px;
  align-items: center;
  box-shadow: var(--shadow);
}

.featured-label {
  color: var(--brown-mid);
  font-size: .72rem;
  font-weight: 900;
  letter-spacing: .15em;
  text-transform: uppercase;
  margin-bottom: 10px;
}

.featured h2 {
  color: var(--blue);
  font-size: 1.55rem;
  margin-bottom: 9px;
}

.featured p {
  color: var(--muted);
  max-width: 750px;
}

.framework-number {
  width: 78px;
  height: 78px;
  border: 2px solid var(--blue-light);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.4rem;
  font-weight: 900;
  color: var(--brown);
  background: var(--blue-pale);
}

/* SECTIONS */

.section {
  margin-top: 65px;
  scroll-margin-top: 90px;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 20px;
  margin-bottom: 24px;
  padding-bottom: 13px;
  border-bottom: 2px solid var(--border);
}

.section-heading h2 {
  font-size: 1.4rem;
  color: var(--blue);
}

.section-heading p {
  font-size: .82rem;
  color: var(--muted);
  text-align: right;
}

/* CARD GRID */

.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

/* CARDS */

.card {
  position: relative;
  background: var(--cream-light);
  border: 1px solid var(--border);
  border-radius: 13px;
  padding: 24px;
  min-height: 260px;
  display: flex;
  flex-direction: column;
  box-shadow: var(--shadow);
  overflow: hidden;
  transition:
    transform .25s ease,
    border-color .25s ease,
    box-shadow .25s ease;
}

.card:before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 4px;
  height: 0;
  background: var(--blue);
  transition: height .3s ease;
}

.card:hover {
  transform: translateY(-5px);
  border-color: var(--blue-light);
  box-shadow: 0 18px 35px rgba(73,53,42,.14);
}

.card:hover:before {
  height: 100%;
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  margin-bottom: 20px;
}

.number {
  font-size: .73rem;
  font-weight: 900;
  color: var(--brown-mid);
  letter-spacing: .08em;
}

.badge {
  font-size: .64rem;
  font-weight: 800;
  letter-spacing: .07em;
  text-transform: uppercase;
  padding: 6px 10px;
  border-radius: 999px;
  background: var(--blue-pale);
  color: var(--blue);
  border: 1px solid var(--blue-light);
}

.card h3 {
  font-size: 1.12rem;
  line-height: 1.35;
  margin-bottom: 11px;
  color: var(--blue);
}

.card p {
  font-size: .88rem;
  color: var(--muted);
  line-height: 1.75;
}

/* WORKING PAGE LINKS */

.card-link {
  margin-top: auto;
  padding-top: 22px;
  font-size: .78rem;
  font-weight: 900;
  color: var(--brown-mid);
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition: color .2s ease;
}

.card-link span {
  transition: transform .2s ease;
  font-size: 1rem;
}

.card:hover .card-link span {
  transform: translateX(5px);
}

.card-link:hover {
  color: var(--blue);
  text-decoration: underline;
}

.card-resource {
  margin-top: auto;
  padding-top: 22px;
  font-size: .76rem;
  font-weight: 800;
  color: var(--blue-mid);
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

/* SECTION DIVIDER */

.divider {
  display: flex;
  align-items: center;
  gap: 15px;
  margin: 75px 0 15px;
  color: var(--brown-mid);
  font-size: .72rem;
  font-weight: 900;
  letter-spacing: .15em;
  text-transform: uppercase;
}

.divider:before,
.divider:after {
  content: "";
  height: 1px;
  background: var(--border);
  flex: 1;
}

/* BOTTOM PRINCIPLE */

.principle {
  margin-top: 80px;
  padding: 45px 30px;
  border: 1px solid var(--border);
  background: linear-gradient(125deg, var(--blue), var(--brown));
  border-radius: 16px;
  text-align: center;
}

.principle-label {
  font-size: .7rem;
  font-weight: 900;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--cream-deep);
  margin-bottom: 17px;
}

.principle h2 {
  max-width: 800px;
  margin: auto;
  font-size: clamp(1.5rem, 3vw, 2.3rem);
  line-height: 1.3;
  color: var(--cream);
}

.principle p {
  max-width: 700px;
  margin: 18px auto 0;
  font-size: .92rem;
  color: var(--cream);
}

/* FOOTER */

footer {
  border-top: 1px solid var(--border);
  padding: 28px 20px;
  text-align: center;
  color: var(--brown-mid);
  font-size: .76rem;
  background: var(--cream-dark);
}

/* RESPONSIVE */

@media(max-width:850px) {
  .grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .featured {
    grid-template-columns: 1fr;
  }

  .framework-number {
    display: none;
  }
}

@media(max-width:600px) {
  .navbar {
    align-items: flex-start;
    flex-direction: column;
  }

  .nav-links {
    gap: 10px 15px;
  }

  .hero {
    padding: 65px 22px 55px;
  }

  .container {
    padding-left: 18px;
    padding-right: 18px;
  }

  .grid {
    grid-template-columns: 1fr;
  }

  .section-heading {
    display: block;
  }

  .section-heading p {
    margin-top: 6px;
    text-align: left;
  }

  .card {
    min-height: 230px;
  }

  .featured {
    padding: 23px;
  }

  .principle {
    padding: 32px 20px;
  }
}
</style>
</head>

