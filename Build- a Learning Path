    return {
      title:"Skill Development Roadmap",
      summary:"Your first priority is to identify the capabilities required for your intended outcome and organize them into a learning sequence.",
      steps:[
        "Research the skills associated with your intended role or credential.",
        "Separate existing skills from missing skills.",
        "Identify courses and practice activities for each gap.",
        "Create a staged learning schedule."
      ]
    };
  }

  if(problem === "practice" || problem === "evidence" || goal === "project"){
    return {
      title:"Practice and Evidence Development",
      summary:"Your first priority is to turn learning into visible work that demonstrates what you can do.",
      steps:[
        "Identify a skill you want to demonstrate.",
        "Choose a small project or realistic practice assignment.",
        "Document the process and final result.",
        "Create a portfolio entry or organized work sample."
      ]
    };
  }

  if(problem === "focus"){
    return {
      title:"Learning Organization and Focus System",
      summary:"Your first priority is to establish a manageable structure for learning and maintaining progress.",
      steps:[
        "Choose one primary learning objective.",
        "Break it into small weekly activities.",
        "Create a consistent learning location and schedule.",
        "Review progress and adjust the plan each week."
      ]
    };
  }

  return {
    title:"Personalized Learning Roadmap",
    summary:"Your answers suggest that you need a coordinated plan connecting your current situation, learning resources, schedule, and intended outcome.",
    steps:[
      "Clarify your primary goal.",
      "Assess your existing skills and experience.",
      "Identify suitable learning resources.",
      "Organize a realistic schedule.",
      "Add practice activities and evidence milestones."
    ]
  };
}

function budgetIsFunding(){
  return document.getElementById("budget").value === "funding";
}

needsForm.addEventListener("submit",function(event){
  event.preventDefault();

  const problem = document.getElementById("mainProblem").value;
  const situation = document.getElementById("currentSituation").value;
  const goal = document.getElementById("goal").value;
  const time = document.getElementById("timeAvailable").value;
  const budget = document.getElementById("budget").value;
  const support = document.getElementById("support").value;
  const experience = document.getElementById("experience").value.trim();
  const target = document.getElementById("target").value.trim();

  if(!problem || !situation || !goal || !time || !budget || !support){
    alert("Please complete all six selection questions before generating your recommendation.");
    return;
  }

  const recommendation = getRecommendation(problem,goal);

  document.getElementById("resultTitle").textContent = recommendation.title;

  let summary = recommendation.summary;

  if(target){
    summary += " Your stated area of interest is: " + target + ".";
  }

  if(experience){
    summary += " Your existing experience should be reviewed before selecting beginner-level resources.";
  }

  document.getElementById("resultSummary").textContent = summary;

  const stepList = document.getElementById("resultSteps");
  stepList.replaceChildren();

  recommendation.steps.forEach(function(step){
    const li = document.createElement("li");
    li.textContent = step;
    stepList.appendChild(li);
  });

  const budgetAdvice = {
    free:"Prioritize free resources, open educational materials, public libraries, and free practice platforms. Verify whether any required examination or credential has separate fees.",
    low:"Compare free learning resources first and reserve spending for items that clearly fill a gap.",
    medium:"Compare programs based on curriculum, practice opportunities, support, total cost, and relevance.",
    high:"A larger budget creates more options, but evaluate the quality and practical value of each program before committing.",
    flexible:"Compare the expected value of each option against its total cost, time requirement, and practical outcomes.",
    funding:"Research scholarships, grants, workforce development programs, employer-sponsored training, and eligibility requirements."
  };

  const timeAdvice = {
    under3:"With under three hours per week, choose one small learning objective and a limited number of activities.",
    "3to5":"With three to five hours per week, use short learning sessions and one weekly practice activity.",
    "6to10":"With six to ten hours per week, combine structured instruction with regular hands-on practice.",
    "11to15":"With eleven to fifteen hours per week, you can organize multiple learning sessions and a larger project.",
    over15:"With more than fifteen hours per week, create a balanced schedule that includes instruction, practice, review, and rest.",
    variable:"With a changing schedule, use flexible weekly milestones rather than relying on fixed daily commitments."
  };

  const supportAdvice = {
    digital:"Prioritize accessible digital courses, interactive tools, online documentation, and digital practice environments.",
    physical:"Include books, printed workbooks, written exercises, and offline reference materials.",
    steps:"Break learning into clear stages with instructions, checkpoints, and examples.",
    research:"Compare resource quality, prerequisites, costs, credibility, and relevance before selecting programs.",
    projects:"Choose learning resources that include assignments, practical projects, and opportunities to demonstrate skills.",
    complete:"Connect research, learning, scheduling, practice, and evidence into one coordinated plan.",
    unsure:"Begin with a short exploration phase and test different learning formats before committing."
  };

  document.getElementById("resultBudget").textContent = "Financial planning: " + budgetAdvice[budget];
  document.getElementById("resultTime").textContent = "Time planning: " + timeAdvice[time];
  document.getElementById("resultSupport").textContent = "Learning support: " + supportAdvice[support];

  resultBox.style.display = "block";
  resultBox.scrollIntoView({behavior:"smooth",block:"nearest"});

  window.lastLearningResult = [
    "LEARNINGPATH ASSESSMENT RESULTS",
    "Recommendation: " + recommendation.title,
    "Summary: " + summary,
    "",
    "RECOMMENDED NEXT STEPS",
    ...recommendation.steps.map((step,index)=>(index+1)+". "+step),
    "",
    "PLANNING CONSIDERATIONS",
    "Financial planning: "+budgetAdvice[budget],
    "Time planning: "+timeAdvice[time],
    "Learning support: "+supportAdvice[support],
    "",
    "Current situation: "+situation,
    "Goal: "+goal,
    "Available time: "+time,
    "Budget: "+budget,
    "Preferred support: "+support,
    "Existing experience: "+(experience || "Not provided"),
    "Target area: "+(target || "Not provided")
  ].join("\n");
});

document.getElementById("copyResult").addEventListener("click",async function(){
  if(!window.lastLearningResult) return;
  try{
    await navigator.clipboard.writeText(window.lastLearningResult);
    this.textContent = "Copied!";
  }catch(error){
    alert("Copy is not available in this browser. You can use Print Results instead.");
  }
});

document.getElementById("printResult").addEventListener("click",function(){
  if(!window.lastLearningResult) return;
  const printWindow = window.open("","_blank");
  if(!printWindow){
    alert("Please allow pop-ups to print your results.");
    return;
  }
  const content = document.createElement("pre");
  content.textContent = window.lastLearningResult;
  content.style.cssText = "white-space:pre-wrap;font-family:Arial,sans-serif;line-height:1.7;padding:30px;color:#49352A";
  printWindow.document.body.appendChild(content);
  printWindow.document.title = "LearningPath Assessment Results";
  printWindow.document.close();
  printWindow.focus();
  printWindow.print();
});

document.getElementById("resetAssessment").addEventListener("click",function(){
  resultBox.style.display = "none";
  window.lastLearningResult = null;
});

