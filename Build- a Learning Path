/* SYSTEM AUDIT PROGRESS */
const auditCheckboxes = document.querySelectorAll("#auditList input[type='checkbox']");
const progressBar = document.getElementById("auditProgressBar");
const auditStatus = document.getElementById("auditStatus");

function updateAudit(){
  const checked = document.querySelectorAll("#auditList input:checked").length;
  const total = auditCheckboxes.length;
  const percentage = total ? (checked/total)*100 : 0;

  progressBar.style.width = percentage + "%";
  auditStatus.textContent = checked + " of " + total + " audit items completed.";

  if(checked === total){
    auditStatus.textContent = "All audit items completed. Review your evidence before considering the system ready.";
  }
}

auditCheckboxes.forEach(function(box){
  box.addEventListener("change",updateAudit);
});

document.getElementById("printAudit").addEventListener("click",function(){
  window.print();
});
