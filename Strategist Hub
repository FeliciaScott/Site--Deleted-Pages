<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Strategist Hub | Opportunities, Mobility & Decision Intelligence</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
}

:root{
--brown-dark:#24180f;
--brown:#5b3a1f;
--brown-soft:#79583a;
--cream:#f8f2e6;
--cream-2:#fcf7ef;
--sand:#eadcc8;
--sand-dark:#d7c2a5;
--gold:#b38b5d;
--green:#4f765e;
--green-soft:#e5eee7;
--text:#2c2118;
--muted:#675748;
--white:#ffffff;
--line:#dfcfb8;
}

body{
background:var(--brown-dark);
font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
color:var(--text);
line-height:1.6;
}

/* =========================
NAVIGATION
========================= */

.nav-bar{
max-width:1400px;
margin:1.2rem auto;
background:var(--cream);
border-radius:24px;
padding:1rem 2rem;
display:flex;
justify-content:space-between;
align-items:center;
box-shadow:0 10px 30px rgba(0,0,0,.25);
}

.logo{
font-weight:900;
font-size:1.25rem;
color:var(--brown);
text-decoration:none;
letter-spacing:-.5px;
}

.logo span{
background:var(--brown);
color:var(--cream);
padding:.25rem .6rem;
border-radius:8px;
margin-left:5px;
font-size:.65rem;
letter-spacing:.05em;
}

.nav-links{
display:flex;
gap:1.5rem;
}

.nav-links a{
text-decoration:none;
color:#4a321c;
font-weight:700;
font-size:.85rem;
}

.nav-links a:hover{
color:var(--green);
}

/* =========================
LAYOUT
========================= */

.container{
max-width:1400px;
margin:0 auto 4rem;
display:grid;
grid-template-columns:270px 1fr 270px;
gap:1.5rem;
padding:0 1rem;
}

/* =========================
SIDEBARS
========================= */

.sidebar{
background:rgba(248,242,230,.06);
border:1px solid rgba(226,210,188,.18);
border-radius:24px;
padding:1.4rem;
color:var(--cream);
height:max-content;
}

.sidebar h3{
font-size:.7rem;
text-transform:uppercase;
letter-spacing:.14em;
color:var(--gold);
margin-bottom:1rem;
}

.side-block{
padding:1rem 0;
border-bottom:1px solid rgba(255,255,255,.08);
}

.side-block:last-child{
border-bottom:0;
}

.side-title{
font-weight:800;
font-size:.9rem;
color:var(--cream);
margin-bottom:.25rem;
}

.side-text{
font-size:.78rem;
color:#c5b9aa;
}

.side-list{
list-style:none;
}

.side-list li{
padding:.55rem 0;
font-size:.8rem;
color:#d5cabb;
border-bottom:1px solid rgba(255,255,255,.05);
}

.side-list li:last-child{
border-bottom:0;
}

/* =========================
MAIN CONTENT
========================= */

.main-content{
background:var(--cream-2);
border-radius:30px;
padding:2.5rem;
box-shadow:0 20px 50px rgba(0,0,0,.2);
}

/* =========================
HEADER
========================= */

.intelligence-header{
border-bottom:1px solid var(--line);
padding-bottom:1.7rem;
margin-bottom:2rem;
}

.status-bar{
display:inline-flex;
align-items:center;
background:var(--green-soft);
color:var(--green);
padding:.4rem .75rem;
border-radius:999px;
font-size:.65rem;
font-weight:900;
letter-spacing:.08em;
text-transform:uppercase;
margin-bottom:1rem;
}

.intelligence-header h1{
font-size:clamp(2rem,4vw,3.2rem);
line-height:1.05;
letter-spacing:-.04em;
color:var(--brown-dark);
}

.intelligence-header p{
max-width:720px;
margin-top:.8rem;
color:var(--muted);
font-size:1rem;
}

/* =========================
ORIENTATION PANEL
========================= */

.orientation{
background:var(--brown-dark);
color:var(--cream);
border-radius:20px;
padding:1.5rem;
margin-bottom:2rem;
}

.orientation-label{
font-size:.65rem;
font-weight:900;
letter-spacing:.14em;
text-transform:uppercase;
color:var(--gold);
margin-bottom:.5rem;
}

.orientation h2{
font-size:1.25rem;
margin-bottom:.5rem;
}

.orientation p{
color:#d3c7b8;
font-size:.88rem;
margin:0;
}

/* =========================
SECTION
========================= */

.section{
margin-top:2.8rem;
}

.section:first-of-type{
margin-top:0;
}

.section-header{
display:flex;
justify-content:space-between;
align-items:end;
gap:1rem;
margin-bottom:1rem;
}

.section-header h2{
font-size:1.15rem;
color:var(--brown-dark);
}

.section-header p{
font-size:.75rem;
color:#887767;
}

/* =========================
CARD GRID
========================= */

.card-grid{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:1rem;
}

.strategy-card{
background:var(--white);
border:1px solid var(--line);
border-radius:18px;
padding:1.35rem;
transition:.25s ease;
}

.strategy-card:hover{
transform:translateY(-4px);
border-color:var(--gold);
box-shadow:0 12px 28px rgba(91,58,31,.09);
}

.tag{
display:inline-block;
font-size:.6rem;
font-weight:900;
letter-spacing:.08em;
text-transform:uppercase;
padding:.35rem .55rem;
border-radius:6px;
background:var(--sand);
color:var(--brown);
}

.strategy-card h3{
font-size:1.05rem;
line-height:1.3;
margin:.85rem 0 .45rem;
color:var(--brown-dark);
}

.strategy-card p{
font-size:.84rem;
color:var(--muted);
margin:0;
}

/* =========================
DECISION CARDS
========================= */

.decision-grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:.8rem;
}

.decision{
padding:1.1rem;
border-radius:15px;
background:#f2eadf;
border:1px solid var(--line);
}

.decision strong{
display:block;
font-size:.82rem;
color:var(--brown);
margin-bottom:.3rem;
}

.decision span{
font-size:.76rem;
color:var(--muted);
}

/* =========================
LOCATION RESEARCH
========================= */

.location-grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:.8rem;
}

.location{
background:#fff;
border:1px solid var(--line);
border-radius:16px;
padding:1.1rem;
}

.location-number{
font-size:.65rem;
font-weight:900;
color:var(--gold);
}

.location h3{
font-size:.95rem;
margin:.35rem 0;
color:var(--brown-dark);
}

.location p{
font-size:.76rem;
color:var(--muted);
margin:0;
}

/* =========================
CHECKLIST
========================= */

.checklist{
background:#f1e8dc;
border:1px solid var(--line);
border-radius:18px;
padding:1.4rem;
}

.checklist h3{
font-size:1rem;
margin-bottom:.8rem;
color:var(--brown-dark);
}

.checklist ul{
list-style:none;
display:grid;
grid-template-columns:1fr 1fr;
gap:.5rem 1rem;
}

.checklist li{
font-size:.8rem;
color:var(--muted);
padding-left:1.1rem;
position:relative;
}

.checklist li:before{
content:"";
position:absolute;
left:0;
top:.65rem;
width:6px;
height:6px;
border-radius:50%;
background:var(--green);
}

/* =========================
PRINCIPLE
========================= */

.principle{
margin-top:2.8rem;
padding:2rem;
border-radius:20px;
background:var(--green-soft);
border:1px solid #cbdccd;
}

.principle-label{
font-size:.65rem;
font-weight:900;
letter-spacing:.12em;
text-transform:uppercase;
color:var(--green);
margin-bottom:.5rem;
}

.principle h2{
font-size:1.3rem;
color:#294734;
margin-bottom:.5rem;
}

.principle p{
font-size:.85rem;
color:#587060;
margin:0;
}

/* =========================
RESPONSIVE
========================= */

@media(max-width:1100px){

.container{
grid-template-columns:1fr;
}

.sidebar{
display:none;
}

}

@media(max-width:760px){

.nav-bar{
margin:0;
border-radius:0;
padding:1rem;
}

.nav-links{
display:none;
}

.main-content{
padding:1.5rem;
border-radius:20px;
}

.card-grid{
grid-template-columns:1fr;
}

.decision-grid,
.location-grid{
grid-template-columns:1fr;
}

.checklist ul{
grid-template-columns:1fr;
}

.section-header{
display:block;
}

.section-header p{
margin-top:.25rem;
}

}

</style>
</head>

