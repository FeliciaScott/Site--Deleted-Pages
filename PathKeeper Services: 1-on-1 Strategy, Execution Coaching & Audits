  font-size: 19px;
  margin-bottom: 8px;
}

.pk-process-step p {
  font-size: 13px;
  margin: 0;
}

/* LEARNING VALUE */

.pk-value-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 20px;
}

.pk-value-card {
  background: white;
  padding: 25px;
  border-radius: 12px;
  border-left: 5px solid var(--blue);
}

.pk-value-card span {
  color: var(--brown-light);
  font-size: 12px;
