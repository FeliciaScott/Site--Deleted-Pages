<style>
:root {
  --cream: #F7F2E8;
  --cream-dark: #EEE3D1;
  --brown: #49352A;
  --brown-mid: #674C3B;
  --brown-light: #8B6A50;
  --blue: #294F6D;
  --blue-mid: #3D6F91;
  --blue-light: #729BB5;
  --blue-pale: #DCEAF1;
  --white: #FFFFFF;
  --text: #302C29;
  --muted: #665F58;
  --border: #D8CCBC;
  --shadow: 0 8px 24px rgba(49, 42, 34, .09);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background: var(--cream);
  color: var(--text);
  line-height: 1.65;
}

button, a {
  font: inherit;
}

a {
  color: inherit;
}

/* HEADER */

.pk-header {
  background: var(--brown);
  color: var(--white);
  padding: 19px 5%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
}

.pk-brand {
  font-size: 25px;
  font-weight: 800;
  letter-spacing: .5px;
}

.pk-brand span {
  color: #DCC4A7;
}

.pk-header-note {
  font-size: 12px;
  color: #E9DFD3;
  letter-spacing: 1px;
  text-transform: uppercase;
}

/* HERO */

.pk-hero {
  background: linear-gradient(125deg, var(--blue), var(--brown));
  color: white;
  text-align: center;
  padding: 75px 20px;
}

.pk-hero-inner {
  max-width: 850px;
  margin: auto;
}

.pk-eyebrow {
  color: #DCEAF1;
  font-size: 13px;
  font-weight: bold;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.pk-hero h1 {
  font-size: clamp(30px, 5vw, 49px);
  line-height: 1.17;
  margin: 15px 0;
}

.pk-hero p {
  max-width: 720px;
  margin: 0 auto 25px;
  color: #F0EAE2;
  font-size: 17px;
}

.pk-button {
  display: inline-block;
  padding: 12px 22px;
  border: 0;
  border-radius: 7px;
  background: var(--blue);
  color: white;
  text-decoration: none;
  font-weight: bold;
  cursor: pointer;
  transition: .2s ease;
}

.pk-button:hover {
  background: var(--brown-light);
  transform: translateY(-2px);
}

.pk-button-light {
  background: var(--cream);
  color: var(--brown);
}

.pk-button-light:hover {
  background: white;
}

.pk-button-outline {
  background: transparent;
  color: var(--blue);
  border: 1px solid var(--blue);
}

.pk-button-outline:hover {
  color: white;
}

/* GENERAL SECTIONS */

.pk-section {
  padding: 65px 5%;
}

.pk-section-inner {
  max-width: 1180px;
  margin: auto;
}

.pk-section-heading {
  text-align: center;
  max-width: 800px;
  margin: 0 auto 38px;
}

.pk-section-heading h2 {
  color: var(--brown);
  font-size: clamp(25px, 4vw, 34px);
  margin: 0 0 12px;
}

.pk-section-heading p {
  color: var(--muted);
  margin: 0;
}

.pk-blue-section {
  background: var(--blue-pale);
}

.pk-dark-section {
  background: var(--brown);
  color: white;
}

.pk-dark-section h2,
.pk-dark-section h3 {
  color: white;
}

/* INTRODUCTION */

.pk-intro-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 20px;
}

.pk-intro-card {
  padding: 25px;
  background: white;
  border-radius: 12px;
  border-top: 4px solid var(--blue);
  box-shadow: var(--shadow);
}

.pk-intro-card h3 {
  color: var(--brown);
  margin-top: 0;
}

.pk-intro-card p {
  color: var(--muted);
  font-size: 14px;
  margin-bottom: 0;
}

/* PRODUCT FILTERS */

.pk-filter-bar {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px;
  margin-bottom: 30px;
}

.pk-filter {
  padding: 9px 16px;
  border-radius: 30px;
  border: 1px solid var(--border);
  background: white;
  color: var(--brown);
  cursor: pointer;
  font-weight: bold;
  font-size: 13px;
}

.pk-filter.active,
.pk-filter:hover {
  background: var(--blue);
  color: white;
  border-color: var(--blue);
}

/* PRODUCTS */

.pk-products {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(245px, 1fr));
  gap: 24px;
}

.pk-product-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: 14px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: var(--shadow);
}

.pk-product-visual {
  min-height: 145px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 57px;
  background: var(--blue-pale);
}

.pk-product-card:nth-child(3n + 2) .pk-product-visual {
  background: var(--cream-dark);
}

.pk-product-card:nth-child(3n) .pk-product-visual {
  background: #E7E1DA;
}

.pk-product-content {
  padding: 22px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.pk-category {
  color: var(--blue-mid);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 1px;
  font-weight: bold;
}

.pk-product-content h3 {
  color: var(--brown);
  margin: 8px 0;
  font-size: 19px;
  line-height: 1.3;
}

.pk-product-content p {
  font-size: 14px;
  color: var(--muted);
}

.pk-includes {
  background: var(--cream);
  border-radius: 8px;
  padding: 12px;
  font-size: 13px;
  margin: 10px 0;
}

.pk-includes strong {
  color: var(--brown);
}

.pk-outcome {
  font-size: 13px;
  color: var(--blue);
  font-weight: bold;
  margin-top: auto;
  padding-top: 12px;
}

.pk-price {
  font-size: 23px;
  color: var(--brown);
  font-weight: bold;
  margin: 12px 0 5px;
}

.pk-product-content .pk-button {
  width: 100%;
  margin-top: 13px;
  text-align: center;
}

.pk-no-results {
  display: none;
  text-align: center;
  color: var(--muted);
  padding: 25px;
}

/* PROCESS */

.pk-process-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 14px;
}

.pk-process-step {
