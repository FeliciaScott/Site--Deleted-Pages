<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Systems Intelligence | Higher Education Learning Lab</title>

<style>

/* =========================================================
   SYSTEMS INTELLIGENCE
   HIGHER EDUCATION LEARNING LAB
========================================================= */

:root {

    --bg: #07100d;
    --bg-2: #091611;
    --surface: #0d1b15;
    --surface-2: #11231b;
    --surface-3: #172b22;

    --border: #29473a;
    --border-soft: #1c352a;

    --text: #edf5ef;
    --muted: #9eb2a6;
    --muted-2: #758c80;

    --green: #b9dc8d;
    --green-dark: #6e994f;

    --gold: #d9b56b;
    --gold-dark: #956f31;

    --blue: #83afd0;
    --red: #d77b70;
    --purple: #a893cf;

    --white: #ffffff;

    --shadow:
        0 25px 70px rgba(0,0,0,.32);

    --shadow-small:
        0 10px 30px rgba(0,0,0,.20);

    --radius: 20px;
    --radius-small: 12px;

    --max: 1180px;
}


/* =========================================================
   RESET
========================================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {

    background:

        radial-gradient(
            circle at 90% 0%,
            rgba(185,220,141,.08),
            transparent 25%
        ),

        radial-gradient(
            circle at 0% 35%,
            rgba(131,175,208,.045),
            transparent 28%
        ),

        var(--bg);

    color: var(--text);

    font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

    line-height: 1.7;
}


/* =========================================================
   GLOBAL
========================================================= */

.container {
    width: min(var(--max), 92%);
    margin: auto;
}

section {
    margin: 70px 0;
}

a {
    color: inherit;
}

p {
    color: var(--muted);
}

h1,
h2,
h3,
h4 {
    line-height: 1.15;
}

h1 {

    font-size:
        clamp(
            3rem,
            7vw,
            6rem
        );

    letter-spacing: -.065em;
}

h2 {

    font-size:
        clamp(
            2rem,
            4vw,
            3.4rem
        );

    letter-spacing: -.045em;

    margin-bottom: 20px;
}

h3 {
    font-size: 1.3rem;
    margin-bottom: 12px;
}

.lead {

    max-width: 850px;

    font-size: 1.15rem;

    color: #c5d3ca;
}

.eyebrow {

    color: var(--green);

    text-transform: uppercase;

    letter-spacing: .17em;

    font-size: .7rem;

    font-weight: 900;

    margin-bottom: 13px;
}

.section-number {

    color: var(--gold);

    font-size: .72rem;

    font-weight: 900;

    letter-spacing: .16em;

    text-transform: uppercase;

    margin-bottom: 12px;
}

.section-header {
    max-width: 900px;
    margin-bottom: 38px;
}


/* =========================================================
   HEADER
========================================================= */

header {

    position: sticky;

    top: 0;

    z-index: 100;

    border-bottom:
        1px solid var(--border-soft);

    background:
        rgba(7,16,13,.82);

    backdrop-filter:
        blur(18px);
}

.nav {

    min-height: 72px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;
}

.logo {

    font-weight: 950;

    letter-spacing: -.04em;
}

.logo span {
    color: var(--green);
}

nav {

    display: flex;

    flex-wrap: wrap;

    gap: 20px;
}

nav a {

    color: var(--muted);

    font-size: .78rem;

    transition:
        color .2s ease,
        transform .2s ease;
}

nav a:hover {

    color: var(--green);

    transform:
        translateY(-1px);
}


/* =========================================================
   HERO
========================================================= */

.hero {

    padding:
        55px 0
        30px;

    display: grid;

    grid-template-columns:
        minmax(0, 1.25fr)
        minmax(300px, .75fr);

    gap: 55px;

    align-items: start;
}

.hero h1 {
    margin-bottom: 25px;
}

.hero h1 span {
    color: var(--green);
}

.hero-description {

    font-size: 1.25rem;

    max-width: 790px;

    color: #c0cec5;
}

.hero-meta {

    display: flex;

    flex-wrap: wrap;

    gap: 9px;

    margin-top: 30px;
}

.badge {

    padding:
        7px
        12px;

    border:
        1px solid var(--border);

    border-radius: 999px;

    background:
        rgba(255,255,255,.015);

    color: var(--muted);

    font-size: .75rem;
}


/* =========================================================
   HERO MAP
========================================================= */

.hero-map {

    padding: 27px;

    border:
        1px solid var(--border);

    border-radius: var(--radius);

    background:

        linear-gradient(
            145deg,
            rgba(185,220,141,.08),
            transparent
        ),

        var(--surface);

    box-shadow: var(--shadow);
}

.map-title {

    color: var(--muted-2);

    text-transform: uppercase;

    letter-spacing: .13em;

    font-size: .68rem;

    margin-bottom: 20px;
}

.map-node {

    padding: 16px;

    border:
        1px solid var(--border);

    border-radius:
        var(--radius-small);

    background:
        rgba(255,255,255,.015);

    transition:
        transform .2s ease,
        border-color .2s ease;
}

.map-node:hover {

    transform:
        translateX(5px);

    border-color:
        var(--green-dark);
}

.map-node strong {

    display: block;

    color: var(--green);
}

.map-node small {
    color: var(--muted);
}

.map-arrow {

    text-align: center;

    color: var(--gold);

    margin: 5px 0;
}


/* =========================================================
   THEORY SPLIT
========================================================= */

.theory {

    display: grid;

    grid-template-columns:
        .75fr
        1.25fr;

    gap: 22px;
}

.theory-card {

    padding: 32px;

    border:
        1px solid var(--border);

    border-radius: var(--radius);

    background:
        var(--surface);
}

.theory-card.highlight {

    background:

        linear-gradient(
            145deg,
            rgba(185,220,141,.10),
            transparent
        ),

        var(--surface);

    border-color:
        #3c6049;
}

.quote {

    margin-top: 24px;

    padding-left: 20px;

    border-left:
        3px solid var(--gold);

    color: #d9e4dc;

    font-size: 1.05rem;
}


/* =========================================================
   RESOURCE STRIP
========================================================= */

.resource-strip {

    display: grid;

    grid-template-columns:
        1fr 1fr 1fr;

    gap: 14px;

    margin-top: 28px;
}

.resource {

    display: block;

    padding: 20px;

    border:
        1px solid var(--border);

    border-radius:
        var(--radius-small);

    background:
        var(--surface-2);

    transition:
        transform .2s ease,
        background .2s ease,
        border-color .2s ease;
}

.resource:hover {

    transform:
        translateY(-4px);

    border-color:
        var(--green-dark);

    background:
        var(--surface-3);
}

.resource small {

    display: block;

    color: var(--gold);

    font-size: .65rem;

    text-transform: uppercase;

    letter-spacing: .12em;

    margin-bottom: 7px;
}

.resource strong {

    display: block;

    margin-bottom: 6px;

    color: var(--green);
}

.resource p {
    font-size: .85rem;
}


/* =========================================================
   ACADEMIC SOURCE BAND
========================================================= */

.academic-band {

    padding: 30px;

    border:
        1px solid var(--border);

    border-left:
        4px solid var(--gold);

    border-radius:
        0
        var(--radius)
        var(--radius)
        0;

    background:
        linear-gradient(
            90deg,
            rgba(216,181,108,.08),
            transparent
        );
}

.academic-band h3 {
    color: var(--gold);
}

.source-links {

    display: flex;

    flex-wrap: wrap;

    gap: 10px;

    margin-top: 18px;
}

.source-links a {

    padding:
        9px
        13px;

    border:
        1px solid var(--border);

    border-radius: 999px;

    color: #c5d7cb;

    font-size: .78rem;

    background:
        rgba(255,255,255,.02);
}

.source-links a:hover {

    color: var(--green);

    border-color:
        var(--green-dark);
}


/* =========================================================
   COMPARISON TABLE
========================================================= */

.comparison {

    overflow-x: auto;

    border:
        1px solid var(--border);

    border-radius:
        var(--radius);

    box-shadow:
        var(--shadow-small);
}

table {

    width: 100%;

    min-width: 800px;

    border-collapse: collapse;
}

th,
td {

    padding: 19px;

    text-align: left;

    border-bottom:
        1px solid var(--border-soft);
}

th {

    background:
        var(--surface-3);

    color: var(--green);

    font-size: .72rem;

    text-transform: uppercase;

    letter-spacing: .08em;
}

td {
    color: var(--muted);
}

tr:hover td {
    background: rgba(255,255,255,.015);
}

tr:last-child td {
    border-bottom: none;
}


/* =========================================================
   ANALYSIS GRID
========================================================= */

.analysis-grid {

    display: grid;

    grid-template-columns:
        repeat(3,1fr);

    gap: 18px;
}

.analysis-card {

    position: relative;

    overflow: hidden;

    padding: 27px;

    min-height: 220px;

    border:
        1px solid var(--border);

    border-radius:
        var(--radius);

    background:
        var(--surface);

    box-shadow:
        var(--shadow-small);
}

.analysis-card::before {

    content: "";

    position: absolute;

    width: 120px;

    height: 120px;

    border-radius: 50%;

    right: -50px;

    top: -50px;

    background:
        rgba(185,220,141,.05);
}

.analysis-number {

    color: var(--gold);

    font-size: .68rem;

    letter-spacing: .12em;

    font-weight: 900;
}


/* =========================================================
   CHARTS
========================================================= */

.chart-grid {

    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 20px;
}

.chart-card {

    padding: 27px;

    border:
        1px solid var(--border);

    border-radius:
        var(--radius);

    background:
        var(--surface);
}

.chart-title {

    display: flex;

    justify-content:
        space-between;

    gap: 20px;

    margin-bottom: 25px;
}

.chart-title span {

    color: var(--gold);

    font-size: .65rem;

    text-transform: uppercase;

    letter-spacing: .12em;
}

.chart {

    height: 300px;

    display: flex;

    align-items: flex-end;

    gap: 14px;

    padding:
        20px
        5px
        0;

    border-top:
        1px dashed var(--border-soft);

    border-bottom:
        1px solid var(--border);
}

.bar-group {

    flex: 1;

    height: 100%;

    display: flex;

    flex-direction: column;

    justify-content: flex-end;

    align-items: center;

    gap: 7px;
}

.bar {

    width: 100%;

    max-width: 55px;

    border-radius:
        8px
        8px
        2px
        2px;

    background:
        linear-gradient(
            to top,
            var(--green-dark),
            var(--green)
        );
}

.bar.gold {

    background:
        linear-gradient(
            to top,
            var(--gold-dark),
            var(--gold)
        );
}

.bar.red {

    background:
        linear-gradient(
            to top,
            #743d38,
            var(--red)
        );
}

.bar-value {

    color: #e4ece7;

    font-size: .68rem;
}

.bar-label {

    color: var(--muted);

    font-size: .67rem;

    text-align: center;
}

.interpretation {

    margin-top: 20px;

    padding: 19px;

    border-radius:
        var(--radius-small);

    background:
        var(--surface-2);

    border-left:
        3px solid var(--green);
}

.interpretation strong {
    color: var(--green);
}


/* =========================================================
   CHART LEGEND
========================================================= */

.legend {

    display: flex;

    flex-wrap: wrap;

    gap: 16px;

    margin-top: 18px;
}

.legend-item {

    display: flex;

    align-items: center;

    gap: 7px;

    color: var(--muted);

    font-size: .75rem;
}

.legend-dot {

    width: 9px;

    height: 9px;

    border-radius: 50%;

    background: var(--green);
}

.legend-dot.gold {
    background: var(--gold);
}

.legend-dot.red {
    background: var(--red);
}


/* =========================================================
   SYSTEM MODEL
========================================================= */

.system-model {

    display: grid;

    grid-template-columns:
        repeat(5,1fr);

    gap: 12px;
}

.system-node {

    position: relative;

    padding: 24px 15px;

    text-align: center;

    border:
        1px solid var(--border);

    border-radius:
        var(--radius-small);

    background:
        var(--surface);
}

.system-node strong {

    display: block;

    color: var(--green);

    margin-bottom: 7px;
}

.system-node span {

    color: var(--muted);

    font-size: .76rem;
}

.system-node:not(:last-child)::after {

    content: "→";

    position: absolute;

    right: -17px;

    top: 50%;

    color: var(--gold);

    font-size: 1.5rem;
}


/* =========================================================
   SYSTEM DIAGRAM
========================================================= */

.diagram {

    margin-top: 25px;

    padding: 30px;

    border:
        1px solid var(--border);

    border-radius:
        var(--radius);

    background:
        #08130f;
}

.diagram-row {

    display: flex;

    justify-content:
        center;

    align-items: center;

    flex-wrap: wrap;

    gap: 12px;
}

.diagram-box {

    padding:
        15px
        20px;

    border:
        1px solid var(--border);

    border-radius:
        var(--radius-small);

    background:
        var(--surface-2);

    color: var(--green);

    font-weight: 800;
}

.diagram-arrow {
    color: var(--gold);
    font-size: 1.3rem;
}


/* =========================================================
   FEEDBACK LOOP
========================================================= */

.loop {

    padding: 32px;

    border:
        1px solid var(--border);

    border-radius:
        var(--radius);

    background:
        linear-gradient(
            145deg,
            rgba(131,175,208,.06),
            transparent
        ),

        var(--surface);
}

.loop-grid {

    display: grid;

    grid-template-columns:
        repeat(4,1fr);

    gap: 15px;
}

.loop-node {

    padding: 20px;

    background:
        rgba(255,255,255,.025);

    border:
        1px solid var(--border-soft);

    border-radius:
        var(--radius-small);
}

.loop-node strong {

    display: block;

    color: var(--green);

    margin-bottom: 7px;
}


/* =========================================================
   CASE STUDY
========================================================= */

.case {

    display: grid;

    grid-template-columns:
        .75fr
        1.25fr;

    gap: 22px;
}

.case-intro,
.case-analysis {

    padding: 30px;

    border:
        1px solid var(--border);

    border-radius:
        var(--radius);

    background:
        var(--surface);
}

.case-intro {

    background:

        linear-gradient(
            150deg,
            rgba(216,181,108,.09),
            transparent
        ),

        var(--surface);
}

.case-question {

    margin-top: 22px;

    padding: 18px;

    border-radius:
        var(--radius-small);

    background:
        var(--surface-2);
}

.case-question strong {
    color: var(--gold);
}


/* =========================================================
   DECISION MATRIX
========================================================= */

.matrix {

    display: grid;

    grid-template-columns:
        1fr 1fr 1.4fr;

    border:
        1px solid var(--border);

    border-radius:
        var(--radius);

    overflow: hidden;
}

.matrix div {

    padding: 17px;

    border-right:
        1px solid var(--border-soft);

    border-bottom:
        1px solid var(--border-soft);

    color: var(--muted);
}

.matrix .head {

    background:
        var(--surface-3);

    color: var(--green);

    font-weight: 800;
}


/* =========================================================
   LEVERAGE CARDS
========================================================= */

.leverage-grid {

    display: grid;

    grid-template-columns:
        repeat(3,1fr);

    gap: 20px;
}

.leverage {

    padding: 30px;

    border-top:
        3px solid var(--green);

    border-radius:
        var(--radius);

    background:
        var(--surface);

    box-shadow:
        var(--shadow-small);
}

.leverage:nth-child(2) {
    border-top-color: var(--gold);
}

.leverage:nth-child(3) {
    border-top-color: var(--blue);
}

.leverage-number {

    font-size: 2.5rem;

    font-weight: 900;

    color: rgba(185,220,141,.18);

    line-height: 1;

    margin-bottom: 15px;
}


/* =========================================================
   SIMULATION
========================================================= */

.simulation {

    padding: 35px;

    border:
        1px solid var(--border);

    border-radius:
        var(--radius);

    background:

        linear-gradient(
            135deg,
            rgba(185,220,141,.08),
            transparent
        ),

        var(--surface);
}

.slider-group {
    margin: 27px 0;
}

.slider-top {

    display: flex;

    justify-content:
        space-between;

    margin-bottom: 9px;
}

.slider-top span:last-child {

    color: var(--green);

    font-weight: 900;
}

input[type="range"] {

    width: 100%;

    accent-color:
        var(--green);
}

.sim-result {

    display: grid;

    grid-template-columns:
        repeat(3,1fr);

    gap: 15px;

    margin-top: 28px;
}

.result {

    padding: 22px;

    border:
        1px solid var(--border-soft);

    border-radius:
        var(--radius-small);

    background:
        var(--surface-2);
}

.result strong {

    display: block;

    font-size: 2rem;

    color: var(--green);

    margin: 5px 0;
}


/* =========================================================
   QUESTIONS
========================================================= */

.questions {

    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 18px;
}

.question {

    padding: 27px;

    border:
        1px solid var(--border);

    border-radius:
        var(--radius);

    background:
        var(--surface);
}

.question:nth-child(2) {

    transform:
        translateY(12px);

    background:
        var(--surface-2);
}

.question:nth-child(3) {

    border-left:
        3px solid var(--gold);
}

.question:nth-child(4) {

    border-right:
        3px solid var(--blue);
}

.question-number {

    color: var(--gold);

    font-size: .68rem;

    font-weight: 900;

    text-transform: uppercase;

    letter-spacing: .12em;
}


/* =========================================================
   RESOURCE LIBRARY
========================================================= */

.resource-library {

    display: grid;

    grid-template-columns:
        repeat(2,1fr);

    gap: 18px;
}

.library-card {

    display: grid;

    grid-template-columns:
        auto 1fr auto;

    gap: 18px;

    align-items: center;

    padding: 23px;

    border:
        1px solid var(--border);

    border-radius:
        var(--radius);

    background:
        var(--surface);

    transition:
        transform .2s ease,
        border-color .2s ease;
}

.library-card:hover {

    transform:
        translateY(-3px);

    border-color:
        var(--green-dark);
}

.library-icon {

    width: 46px;

    height: 46px;

    display: grid;

    place-items: center;

    border-radius:
        12px;

    background:
        var(--surface-3);

    color: var(--green);

    font-weight: 900;
}

.library-card h3 {
    margin-bottom: 4px;
}

.library-card p {
    font-size: .82rem;
}

.library-arrow {

    color: var(--gold);

    font-size: 1.2rem;
}


/* =========================================================
   READING PATH
========================================================= */

.reading-path {

    position: relative;

    padding-left: 30px;

    border-left:
        1px solid var(--border);
}

.path-item {

    position: relative;

    padding:
        0
        0
        30px
        20px;
}

.path-item::before {

    content: "";

    position: absolute;

    left: -36px;

    top: 5px;

    width: 11px;

    height: 11px;

    border-radius: 50%;

    background:
        var(--green);

    box-shadow:
        0 0 0 5px var(--bg);
}

.path-item strong {

    color: var(--green);

    display: block;

    margin-bottom: 5px;
}

.path-item a {

    color: var(--gold);

    text-decoration:
        underline;

    text-decoration-color:
        rgba(216,181,108,.35);

    text-underline-offset: 3px;
}


/* =========================================================
   PROGRESS
========================================================= */

.progress {

    padding: 30px;

    border:
        1px solid var(--border);

    border-radius:
        var(--radius);

    background:
        var(--surface);
}

.progress-line {

    height: 10px;

    margin: 20px 0;

    overflow: hidden;

    border-radius: 999px;

    background:
        #172a22;
}

.progress-fill {

    width: 82%;

    height: 100%;

    background:
        linear-gradient(
            90deg,
            var(--gold),
            var(--green)
        );
}

.progress-labels {

    display: flex;

    justify-content:
        space-between;

    gap: 10px;
}

.progress-labels span {

    color: var(--muted);

    font-size: .72rem;
}


/* =========================================================
   FOOTER
========================================================= */

footer {

    margin-top: 100px;

    padding:
        55px 0;

    border-top:
        1px solid var(--border-soft);
}

.footer-grid {

    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 35px;
}

footer p {
    max-width: 650px;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 950px) {

    .hero,
    .theory,
    .case {

