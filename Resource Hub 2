<script>

const pressure =
    document.getElementById("pressure");

const clarity =
    document.getElementById("clarity");

const feedback =
    document.getElementById("feedback");


const pressureValue =
    document.getElementById("pressureValue");

const clarityValue =
    document.getElementById("clarityValue");

const feedbackValue =
    document.getElementById("feedbackValue");


const output =
    document.getElementById("output");

const health =
    document.getElementById("health");

const decision =
    document.getElementById("decision");


function clamp(value) {

    return Math.max(
        0,
        Math.min(
            100,
            Math.round(value)
        )
    );

}


function calculateSystem() {

    const p =
        Number(pressure.value);

    const c =
        Number(clarity.value);

    const f =
        Number(feedback.value);


    /*
       PRESSURE

       Moderate pressure can increase output.

       Excessive pressure eventually produces
       diminishing returns and system stress.
    */

    const pressureEffect =
        p <= 65

            ? p * .55

            : 35.75 -
              ((p - 65) * .65);


    /*
       OUTPUT
    */

    const calculatedOutput =

        25 +

        pressureEffect +

        c * .25 +

        f * .20;


    /*
       SYSTEM HEALTH

       Clarity and feedback increase sustainability.

       Excessive pressure reduces health.
    */

    const calculatedHealth =

        25 +

        c * .40 +

        f * .35 -

        p * .28;


    /*
       DECISION QUALITY
    */

    const calculatedDecision =

        20 +

        c * .35 +

        f * .50 -

        Math.max(
            0,
            p - 70
        ) * .20;


    pressureValue.textContent =
        p;

    clarityValue.textContent =
        c;

    feedbackValue.textContent =
        f;


    output.textContent =
        clamp(calculatedOutput);

    health.textContent =
        clamp(calculatedHealth);

    decision.textContent =
        clamp(calculatedDecision);

}


pressure.addEventListener(
    "input",
    calculateSystem
);

clarity.addEventListener(
    "input",
    calculateSystem
);

feedback.addEventListener(
    "input",
    calculateSystem
);


calculateSystem();

</script>

