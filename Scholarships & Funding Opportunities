<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Scholarships & Funding Opportunities | PathKeeper</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
