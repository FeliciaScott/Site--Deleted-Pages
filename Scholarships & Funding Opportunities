        .scholarship-card {
            transition: opacity 0.2s ease, transform 0.2s ease;
        }

        .scholarship-card:hover {
            transform: translateY(-3px);
        }

        .sch-tag-btn.active {
            background-color: #0a192f;
            color: #ffffff;
        }

        .drawer-open {
            transform: translateX(0) !important;
        }

        .modal-panel {
            max-height: 90vh;
            overflow-y: auto;
        }

        button:focus-visible,
        input:focus-visible,
        select:focus-visible,
        textarea:focus-visible,
        a:focus-visible {
            outline: 3px solid #c87d55;
            outline-offset: 3px;
        }
    </style>
</head>

<body class="bg-cream-100 text-navy-900 antialiased min-h-screen flex flex-col justify-between selection:bg-brown-500 selection:text-white">

    <!-- NAVIGATION HEADER -->

    <header class="sticky top-0 z-40 w-full bg-cream-100/95 backdrop-blur border-b border-cream-300 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-wrap items-center justify-between gap-3 min-h-20 py-3">

                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-lg bg-navy-900 flex items-center justify-center text-cream-100 shadow-md border border-brown-500">
                        <i class="fa-solid fa-compass text-brown-300"></i>
                    </div>

                    <div>
                        <span class="text-xl font-bold tracking-tight text-navy-900 serif-title">PathKeeper</span>
                        <span class="hidden sm:inline-block text-xs uppercase tracking-widest text-brown-700 font-semibold ml-2 px-2 py-0.5 bg-cream-300 rounded">
                            Funding Hub
                        </span>
                    </div>
                </div>

                <nav class="hidden md:flex flex-wrap gap-5 text-sm font-medium">
                    <a href="#core-opportunities" class="text-navy-800 hover:text-brown-700 transition">Overview</a>
                    <a href="#scholarship-directory" class="text-navy-800 hover:text-brown-700 transition">Scholarships</a>
                    <a href="#linking-text-matrix" class="text-navy-800 hover:text-brown-700 transition">Application Strategy</a>
                    <a href="#micro-funding" class="text-navy-800 hover:text-brown-700 transition">Micro-Funding</a>
                    <a href="#application-tracker" class="text-navy-800 hover:text-brown-700 transition">Tracker</a>
                </nav>

                <div class="flex items-center gap-2">
                    <button onclick="openWizardModal()" class="hidden sm:inline-flex items-center px-4 py-2 border border-brown-700 text-xs font-semibold uppercase tracking-wider rounded-md text-brown-800 bg-cream-200 hover:bg-brown-700 hover:text-white transition shadow-sm">
                        <i class="fa-solid fa-wand-magic-sparkles mr-2"></i>
                        Funding Guide
                    </button>

                    <button onclick="togglePackDrawer()" class="relative inline-flex items-center px-4 py-2 rounded-md bg-navy-900 text-cream-100 text-xs font-semibold uppercase tracking-wider hover:bg-navy-800 transition shadow">
                        <i class="fa-solid fa-vault mr-2 text-brown-300"></i>
                        Funding Pack
                        <span id="pack-count-badge" class="ml-2 bg-brown-500 text-white text-[10px] font-bold rounded-full h-5 w-5 flex items-center justify-center">0</span>
                    </button>
                </div>

            </div>
        </div>
    </header>

    <!-- HERO SECTION -->

    <section id="core-opportunities" class="relative bg-gradient-to-b from-cream-200 via-cream-100 to-cream-100 pt-12 pb-20 border-b border-cream-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

            <span class="inline-block px-3 py-1 bg-brown-100 border border-brown-300 text-brown-800 text-xs font-semibold uppercase tracking-widest rounded-full mb-4">
                PathKeeper Opportunity Atlas
            </span>

            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-navy-900 serif-title tracking-tight leading-tight">
                Scholarships & Funding Opportunities
            </h1>

            <p class="mt-4 max-w-3xl mx-auto text-lg text-navy-800/80 leading-relaxed">
                Discover scholarship pathways, grants, micro-funding, financial assistance, and practical tools for organizing applications and building a funding strategy around your education or career goals.
            </p>

            <div class="mt-8 max-w-2xl mx-auto relative">
                <div class="relative flex items-center">
                    <i class="fa-solid fa-magnifying-glass absolute left-4 text-brown-500 text-lg"></i>

                    <input
                        type="text"
                        id="globalSearch"
                        oninput="filterAllContent()"
                        placeholder="Search scholarships, grants, eligibility, or requirements..."
                        class="w-full pl-12 pr-28 py-4 bg-white rounded-xl border-2 border-cream-300 focus:border-brown-500 focus:outline-none text-navy-900 shadow-md placeholder-gray-400"
                    >

                    <button onclick="resetGlobalSearch()" class="absolute right-3 px-3 py-1.5 bg-cream-200 hover:bg-cream-300 text-navy-800 text-xs font-semibold rounded-lg transition">
                        Clear
                    </button>
                </div>

                <div class="flex flex-wrap justify-center gap-2 mt-3 text-xs text-navy-800">
                    <span class="font-semibold text-brown-700">Quick Filters:</span>
                    <button onclick="setQuickSearch('STEM')" class="hover:underline">STEM</button>
                    <span>•</span>
                    <button onclick="setQuickSearch('Need-Based')" class="hover:underline">Need-Based</button>
                    <span>•</span>
                    <button onclick="setQuickSearch('Merit')" class="hover:underline">Merit</button>
                    <span>•</span>
                    <button onclick="setQuickSearch('Micro-Grant')" class="hover:underline">Micro-Grants</button>
                </div>
            </div>
        </div>
    </section>

    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-24">

        <!-- MODULE 1: SCHOLARSHIP DIRECTORY -->

        <section id="scholarship-directory" class="searchable-section scroll-mt-28">

            <div class="border-l-4 border-brown-700 pl-4 mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                    <span class="text-xs font-bold text-brown-700 uppercase tracking-widest">Module 01</span>
                    <h2 class="text-3xl font-bold text-navy-900 serif-title">Scholarship Directory</h2>
                    <p class="text-navy-800/80 text-sm mt-1">
                        Organize academic, merit, STEM, and need-based scholarship targets.
                    </p>
                </div>

                <button onclick="openAddScholarshipModal()" class="self-start md:self-auto px-4 py-2 bg-navy-900 text-white rounded-lg text-xs font-bold hover:bg-navy-800 transition flex items-center">
                    <i class="fa-solid fa-plus mr-2 text-brown-300"></i>
                    Add Custom Target
                </button>
            </div>

            <div class="bg-white p-4 rounded-xl border border-cream-300 shadow-sm mb-8 flex flex-wrap items-center justify-between gap-4">

                <div class="flex flex-wrap items-center gap-2" id="directoryTagFilters">
                    <button onclick="filterScholarshipTag('All', this)" class="sch-tag-btn active px-3 py-1 bg-navy-900 text-white rounded text-xs font-medium">All</button>
                    <button onclick="filterScholarshipTag('STEM', this)" class="sch-tag-btn px-3 py-1 bg-cream-200 text-navy-800 hover:bg-cream-300 rounded text-xs font-medium">STEM</button>
                    <button onclick="filterScholarshipTag('Merit', this)" class="sch-tag-btn px-3 py-1 bg-cream-200 text-navy-800 hover:bg-cream-300 rounded text-xs font-medium">Merit-Based</button>
                    <button onclick="filterScholarshipTag('Need-Based', this)" class="sch-tag-btn px-3 py-1 bg-cream-200 text-navy-800 hover:bg-cream-300 rounded text-xs font-medium">Need-Based</button>
                    <button onclick="filterScholarshipTag('Undergraduate', this)" class="sch-tag-btn px-3 py-1 bg-cream-200 text-navy-800 hover:bg-cream-300 rounded text-xs font-medium">Undergraduate</button>
                    <button onclick="filterScholarshipTag('Postgraduate', this)" class="sch-tag-btn px-3 py-1 bg-cream-200 text-navy-800 hover:bg-cream-300 rounded text-xs font-medium">Postgraduate</button>
                </div>

                <div class="text-xs font-semibold text-navy-800">
                    Showing <span id="scholarship-count" class="text-brown-700 font-bold">4</span> Award Pathways
                </div>
            </div>

            <div id="scholarship-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">

                <!-- Scholarship 1 -->

                <div class="scholarship-card bg-white p-6 rounded-2xl border border-cream-300 shadow-sm hover:border-brown-500 transition flex flex-col justify-between" data-tags="STEM Undergraduate Merit">

                    <div>
                        <div class="flex justify-between items-start mb-3 gap-2">
                            <span class="px-2.5 py-1 bg-navy-50 text-navy-800 text-[10px] font-bold uppercase rounded border border-navy-100">STEM & Innovation</span>
                            <span class="px-2 py-0.5 bg-brown-100 text-brown-800 text-xs font-bold rounded">$10,000 / Yr</span>
                        </div>

                        <h3 class="text-xl font-bold text-navy-900 mb-2">PathKeeper Future Systems Fellowship</h3>

                        <p class="text-xs text-navy-800/80 mb-4">
                            Example award profile for students pursuing computing, automation, and systems engineering with demonstrated technical leadership.
                        </p>

                        <div class="space-y-1.5 text-xs text-navy-900 mb-6 bg-cream-50 p-3 rounded-lg border border-cream-200">
                            <div><strong class="text-brown-700">Example Deadline:</strong> Nov 30, 2026</div>
                            <div><strong class="text-brown-700">Example GPA:</strong> 3.50</div>
                            <div><strong class="text-brown-700">Requirements:</strong> Technical Essay, System Design Portfolio, Transcript</div>
                        </div>
                    </div>

                    <div class="flex items-center space-x-2">
                        <button onclick="toggleFundingPack('PathKeeper Future Systems Fellowship', 10000, '2026-11-30')" class="flex-1 py-2 px-3 bg-navy-900 hover:bg-navy-800 text-white rounded-lg text-xs font-bold transition flex items-center justify-center">
                            <i class="fa-solid fa-plus mr-2 text-brown-300"></i>
                            Add to Funding Pack
                        </button>

                        <button onclick="showDetailsModal('PathKeeper Future Systems Fellowship', 'This is an illustrative scholarship profile, not a verified active award. Use the requirements as a planning example and confirm real opportunities with the sponsoring organization.')" class="py-2 px-3 bg-cream-200 hover:bg-cream-300 text-navy-900 rounded-lg text-xs font-bold transition">
                            Details
                        </button>
                    </div>
                </div>

                <!-- Scholarship 2 -->

                <div class="scholarship-card bg-white p-6 rounded-2xl border border-cream-300 shadow-sm hover:border-brown-500 transition flex flex-col justify-between" data-tags="Need-Based Undergraduate Postgraduate">

                    <div>
                        <div class="flex justify-between items-start mb-3 gap-2">
                            <span class="px-2.5 py-1 bg-navy-50 text-navy-800 text-[10px] font-bold uppercase rounded border border-navy-100">Ecosystem Access</span>
                            <span class="px-2 py-0.5 bg-brown-100 text-brown-800 text-xs font-bold rounded">$7,500</span>
                        </div>

                        <h3 class="text-xl font-bold text-navy-900 mb-2">Global Opportunity Mobility Grant</h3>

                        <p class="text-xs text-navy-800/80 mb-4">
                            Example funding profile for students seeking assistance with educational access and career development.
                        </p>

                        <div class="space-y-1.5 text-xs text-navy-900 mb-6 bg-cream-50 p-3 rounded-lg border border-cream-200">
                            <div><strong class="text-brown-700">Example Deadline:</strong> Dec 15, 2026</div>
                            <div><strong class="text-brown-700">Example GPA:</strong> 3.00</div>
                            <div><strong class="text-brown-700">Requirements:</strong> Financial Need Form, Personal Narrative, Recommendation</div>
                        </div>
                    </div>

                    <div class="flex items-center space-x-2">
                        <button onclick="toggleFundingPack('Global Opportunity Mobility Grant', 7500, '2026-12-15')" class="flex-1 py-2 px-3 bg-navy-900 hover:bg-navy-800 text-white rounded-lg text-xs font-bold transition flex items-center justify-center">
                            <i class="fa-solid fa-plus mr-2 text-brown-300"></i>
                            Add to Funding Pack
                        </button>

                        <button onclick="showDetailsModal('Global Opportunity Mobility Grant', 'This is an illustrative funding profile, not a verified active grant. Confirm eligibility, award amount, and deadlines with the actual funding provider.')" class="py-2 px-3 bg-cream-200 hover:bg-cream-300 text-navy-900 rounded-lg text-xs font-bold transition">
                            Details
                        </button>
                    </div>
                </div>

                <!-- Scholarship 3 -->

                <div class="scholarship-card bg-white p-6 rounded-2xl border border-cream-300 shadow-sm hover:border-brown-500 transition flex flex-col justify-between" data-tags="Merit Postgraduate STEM">

                    <div>
                        <div class="flex justify-between items-start mb-3 gap-2">
                            <span class="px-2.5 py-1 bg-navy-50 text-navy-800 text-[10px] font-bold uppercase rounded border border-navy-100">Advanced Research</span>
                            <span class="px-2 py-0.5 bg-brown-100 text-brown-800 text-xs font-bold rounded">$15,000</span>
                        </div>

                        <h3 class="text-xl font-bold text-navy-900 mb-2">Algorithmic Governance Research Award</h3>

                        <p class="text-xs text-navy-800/80 mb-4">
                            Example award profile for postgraduate research into algorithmic decision frameworks, policy automation, and ethical technology.
                        </p>

                        <div class="space-y-1.5 text-xs text-navy-900 mb-6 bg-cream-50 p-3 rounded-lg border border-cream-200">
                            <div><strong class="text-brown-700">Example Deadline:</strong> Jan 20, 2027</div>
                            <div><strong class="text-brown-700">Example GPA:</strong> 3.70</div>
                            <div><strong class="text-brown-700">Requirements:</strong> Research Proposal, Published Works, References</div>
                        </div>
                    </div>

                    <div class="flex items-center space-x-2">
                        <button onclick="toggleFundingPack('Algorithmic Governance Research Award', 15000, '2027-01-20')" class="flex-1 py-2 px-3 bg-navy-900 hover:bg-navy-800 text-white rounded-lg text-xs font-bold transition flex items-center justify-center">
                            <i class="fa-solid fa-plus mr-2 text-brown-300"></i>
                            Add to Funding Pack
                        </button>

                        <button onclick="showDetailsModal('Algorithmic Governance Research Award', 'This is an illustrative research award profile. Verify whether an equivalent award exists and review its official requirements before applying.')" class="py-2 px-3 bg-cream-200 hover:bg-cream-300 text-navy-900 rounded-lg text-xs font-bold transition">
                            Details
                        </button>
                    </div>
                </div>

                <!-- Scholarship 4 -->

                <div class="scholarship-card bg-white p-6 rounded-2xl border border-cream-300 shadow-sm hover:border-brown-500 transition flex flex-col justify-between" data-tags="Merit Undergraduate">

                    <div>
                        <div class="flex justify-between items-start mb-3 gap-2">
                            <span class="px-2.5 py-1 bg-navy-50 text-navy-800 text-[10px] font-bold uppercase rounded border border-navy-100">Leadership</span>
                            <span class="px-2 py-0.5 bg-brown-100 text-brown-800 text-xs font-bold rounded">$5,000</span>
                        </div>

                        <h3 class="text-xl font-bold text-navy-900 mb-2">Civic Atlas Leadership Stipend</h3>

                        <p class="text-xs text-navy-800/80 mb-4">
                            Example funding profile recognizing community initiatives, local projects, and student leadership.
                        </p>

                        <div class="space-y-1.5 text-xs text-navy-900 mb-6 bg-cream-50 p-3 rounded-lg border border-cream-200">
                            <div><strong class="text-brown-700">Example Deadline:</strong> Feb 10, 2027</div>
                            <div><strong class="text-brown-700">Example GPA:</strong> 3.20</div>
                            <div><strong class="text-brown-700">Requirements:</strong> Community Impact Essay, Peer Endorsement</div>
                        </div>
                    </div>

                    <div class="flex items-center space-x-2">
                        <button onclick="toggleFundingPack('Civic Atlas Leadership Stipend', 5000, '2027-02-10')" class="flex-1 py-2 px-3 bg-navy-900 hover:bg-navy-800 text-white rounded-lg text-xs font-bold transition flex items-center justify-center">
                            <i class="fa-solid fa-plus mr-2 text-brown-300"></i>
                            Add to Funding Pack
                        </button>

                        <button onclick="showDetailsModal('Civic Atlas Leadership Stipend', 'This is an illustrative award profile. Confirm the sponsor, application availability, and eligibility requirements before treating it as a real opportunity.')" class="py-2 px-3 bg-cream-200 hover:bg-cream-300 text-navy-900 rounded-lg text-xs font-bold transition">
                            Details
                        </button>
                    </div>
                </div>

            </div>

            <p class="mt-5 text-xs text-brown-800 bg-cream-200 border border-cream-300 rounded-lg p-4">
                <strong>Important:</strong> The scholarship names, award values, GPA thresholds, and deadlines displayed in these sample cards are illustrative planning examples. They are not verified active scholarship listings. Always verify real awards through the sponsoring organization before applying.
            </p>

        </section>

        <!-- MODULE 2: APPLICATION STRATEGY -->

        <section id="linking-text-matrix" class="searchable-section scroll-mt-28">

            <div class="border-l-4 border-brown-700 pl-4 mb-8">
                <span class="text-xs font-bold text-brown-700 uppercase tracking-widest">Module 02</span>
                <h2 class="text-3xl font-bold text-navy-900 serif-title">Application Writing & Essay Strategy</h2>
                <p class="text-navy-800/80 text-sm mt-1">
                    Connect your experience, accomplishments, and evidence to the selection criteria.
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

                <div class="bg-white p-6 sm:p-8 rounded-2xl border border-cream-300 shadow-md">

                    <div class="flex items-center space-x-3 mb-4">
                        <div class="w-10 h-10 rounded-lg bg-brown-700 text-white flex items-center justify-center text-lg">
                            <i class="fa-solid fa-font"></i>
                        </div>

                        <div>
                            <h3 class="text-lg font-bold text-navy-900">Scholarship Keyword Review</h3>
                            <p class="text-xs text-navy-800/80">
                                Check whether your draft addresses common application themes.
                            </p>
                        </div>
                    </div>

                    <textarea
                        id="essayInput"
                        oninput="analyzeEssayText()"
                        rows="6"
                        placeholder="Paste your scholarship essay draft here..."
                        class="w-full p-4 text-xs bg-cream-50 border border-cream-300 rounded-xl focus:border-brown-500 focus:outline-none text-navy-900 placeholder-gray-400 mb-4"
                    ></textarea>

                    <div class="grid grid-cols-3 gap-3 text-center mb-4">

                        <div class="bg-cream-100 p-3 rounded-lg border border-cream-200">
                            <span class="text-[10px] uppercase font-bold text-navy-800 block">Word Count</span>
                            <span id="wordCount" class="text-lg font-bold text-brown-700 code-font">0</span>
                        </div>

                        <div class="bg-cream-100 p-3 rounded-lg border border-cream-200">
                            <span class="text-[10px] uppercase font-bold text-navy-800 block">Linked Terms</span>
                            <span id="linkedTermsCount" class="text-lg font-bold text-brown-700 code-font">0</span>
                        </div>

                        <div class="bg-cream-100 p-3 rounded-lg border border-cream-200">
                            <span class="text-[10px] uppercase font-bold text-navy-800 block">Term Coverage</span>
                            <span id="matchScore" class="text-lg font-bold text-brown-700 code-font">0%</span>
                        </div>

                    </div>

                    <p class="text-[10px] text-gray-500 mb-3">
                        This measures keyword coverage only. It does not predict an evaluator's score.
                    </p>

                    <div id="keywordBadges" class="flex flex-wrap gap-1.5 text-[11px]">
                        <span class="px-2 py-0.5 rounded bg-cream-200 text-navy-800 border border-cream-300" data-kw="leadership">leadership</span>
                        <span class="px-2 py-0.5 rounded bg-cream-200 text-navy-800 border border-cream-300" data-kw="impact">impact</span>
                        <span class="px-2 py-0.5 rounded bg-cream-200 text-navy-800 border border-cream-300" data-kw="innovation">innovation</span>
                        <span class="px-2 py-0.5 rounded bg-cream-200 text-navy-800 border border-cream-300" data-kw="research">research</span>
                        <span class="px-2 py-0.5 rounded bg-cream-200 text-navy-800 border border-cream-300" data-kw="community">community</span>
                        <span class="px-2 py-0.5 rounded bg-cream-200 text-navy-800 border border-cream-300" data-kw="systems">systems</span>
                        <span class="px-2 py-0.5 rounded bg-cream-200 text-navy-800 border border-cream-300" data-kw="sustainability">sustainability</span>
                    </div>
                </div>

                <div class="bg-navy-900 text-cream-100 p-6 sm:p-8 rounded-2xl border border-navy-800 shadow-md">

                    <span class="text-xs font-bold text-brown-300 uppercase tracking-widest block mb-2">
                        Application Strategy
                    </span>

                    <h3 class="text-2xl font-bold text-white serif-title mb-4">
                        Connecting Evidence to Criteria
                    </h3>

                    <p class="text-xs text-cream-300 leading-relaxed mb-6">
                        A strong application connects what you have done to what the funding organization is seeking. Use its published selection criteria to guide your examples.
                    </p>

                    <div class="space-y-4 text-xs">

                        <div class="p-3 bg-navy-950 rounded-xl border border-navy-800">
                            <div class="font-bold text-brown-300 mb-1">1. Explain Your Experience</div>
                            <p class="text-cream-400">
                                Describe the situation, your role, the action you took, and what happened as a result.
                            </p>
                        </div>

                        <div class="p-3 bg-navy-950 rounded-xl border border-navy-800">
                            <div class="font-bold text-brown-300 mb-1">2. Provide Evidence</div>
                            <p class="text-cream-400">
                                Support your claims with measurable results, completed projects, responsibilities, or documented achievements.
                            </p>
                        </div>

                        <div class="p-3 bg-navy-950 rounded-xl border border-navy-800">
