                </button>

                <div id="wizardResult" class="hidden mt-6 p-4 bg-cream-200 border border-brown-300 rounded-xl">
                    <span class="text-[10px] font-bold text-brown-700 uppercase tracking-widest block mb-1">
                        Suggested Starting Point
                    </span>

                    <h4 id="wizardResultTitle" class="text-base font-bold text-navy-900 mb-1"></h4>

                    <p id="wizardResultDesc" class="text-xs text-navy-800/80 leading-relaxed"></p>
                </div>

            </div>
        </div>
    </div>

    <!-- DETAILS MODAL -->

    <div id="detailsModal" class="fixed inset-0 bg-navy-950/70 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">

        <div class="modal-panel bg-white rounded-2xl border border-cream-300 max-w-lg w-full p-6 shadow-2xl relative">

            <button onclick="closeDetailsModal()" class="absolute top-4 right-4 text-navy-800 hover:text-brown-700 text-lg" aria-label="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <h3 id="detailsModalTitle" class="text-xl font-bold text-navy-900 serif-title mb-2"></h3>

            <p id="detailsModalBody" class="text-xs text-navy-800/80 leading-relaxed mb-6"></p>

            <div class="flex justify-end">
                <button onclick="closeDetailsModal()" class="px-4 py-2 bg-brown-700 text-white rounded-lg text-xs font-bold">
                    Close
                </button>
            </div>

        </div>
    </div>

    <!-- JAVASCRIPT -->

    <script>
        const STORAGE_KEY = 'pathkeeper_funding_pack';

        let fundingPack = [];

        try {
            fundingPack = JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
            if (!Array.isArray(fundingPack)) fundingPack = [];
        } catch (error) {
            fundingPack = [];
        }

        function saveFundingPack() {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(fundingPack));
            } catch (error) {
                console.warn('Funding pack could not be saved in this browser.');
            }
        }

        function escapeHTML(value) {
            return String(value).replace(/[&<>"']/g, char => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            })[char]);
        }

        function safeNumber(value) {
            const number = Number(value);
            return Number.isFinite(number) && number >= 0 ? number : 0;
        }

        window.addEventListener('DOMContentLoaded', () => {
            renderFundingPackUI();
            renderPipelineTracker();
            updateScholarshipCount();
        });

        // SCHOLARSHIP FILTERING

        let activeScholarshipTag = 'All';

        function filterScholarshipTag(tag, button) {
            activeScholarshipTag = tag;

            document.querySelectorAll('.sch-tag-btn').forEach(btn => {
                btn.classList.remove('active', 'bg-navy-900', 'text-white');
                btn.classList.add('bg-cream-200', 'text-navy-800');
            });

            if (button) {
                button.classList.add('active', 'bg-navy-900', 'text-white');
                button.classList.remove('bg-cream-200', 'text-navy-800');
            }

            filterScholarshipCards();
        }

        function filterScholarshipCards() {
            const query = document.getElementById('globalSearch').value.toLowerCase().trim();
            const cards = document.querySelectorAll('.scholarship-card');

            let visibleCount = 0;

            cards.forEach(card => {
                const tags = card.getAttribute('data-tags') || '';
                const content = card.innerText.toLowerCase();

                const matchesTag = activeScholarshipTag === 'All' || tags.includes(activeScholarshipTag);
                const matchesSearch = !query || content.includes(query);

                if (matchesTag && matchesSearch) {
                    card.classList.remove('hidden');
                    visibleCount++;
                } else {
                    card.classList.add('hidden');
                }
            });

            document.getElementById('scholarship-count').innerText = visibleCount;
        }

        function updateScholarshipCount() {
            filterScholarshipCards();
        }

        // FUNDING PACK

        function toggleFundingPack(title, amount, deadline) {
            const index = fundingPack.findIndex(item => item.title === title);

            if (index > -1) {
                fundingPack.splice(index, 1);
            } else {
                fundingPack.push({
                    title,
                    amount: safeNumber(amount),
                    deadline: deadline || 'TBD',
                    stage: 'saved'
                });
            }

            saveFundingPack();
            renderFundingPackUI();
            renderPipelineTracker();
        }

        function renderFundingPackUI() {
            document.getElementById('pack-count-badge').innerText = fundingPack.length;

            const container = document.getElementById('pack-items-list');

            const total = fundingPack.reduce((sum, item) => sum + safeNumber(item.amount), 0);

            document.getElementById('total-funding-amount').innerText =
                '$' + total.toLocaleString();

            if (fundingPack.length === 0) {
                container.innerHTML = `
                    <p class="text-xs italic text-gray-400">
                        No funding items saved yet. Explore the directory to add targets.
                    </p>
                `;
                return;
            }

            container.innerHTML = fundingPack.map((item, index) => `
                <div class="flex items-center justify-between gap-3 p-3 bg-white rounded-xl border border-cream-300 text-xs shadow-sm">
                    <div class="min-w-0">
                        <div class="font-bold text-navy-900 break-words">${escapeHTML(item.title)}</div>
                        <div class="text-[10px] text-brown-700 font-semibold">
                            $${safeNumber(item.amount).toLocaleString()} • Due: ${escapeHTML(item.deadline)}
                        </div>
                    </div>

                    <button onclick="removeFundingItem(${index})" class="text-red-500 hover:text-red-700 ml-2 shrink-0" aria-label="Remove funding item">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </div>
            `).join('');
        }

        function removeFundingItem(index) {
            fundingPack.splice(index, 1);
            saveFundingPack();
            renderFundingPackUI();
            renderPipelineTracker();
        }

        function exportFundingPackSchedule() {
            if (fundingPack.length === 0) {
                showDetailsModal(
                    'Funding Pack Empty',
                    'Add at least one funding opportunity to your pack before exporting your schedule.'
                );
                return;
            }

            const rows = [
                ['Opportunity Title', 'Amount', 'Deadline', 'Stage']
            ];

            fundingPack.forEach(item => {
                rows.push([
                    item.title,
                    item.amount,
                    item.deadline,
                    item.stage
                ]);
            });

            const csvContent = rows.map(row =>
                row.map(value =>
                    '"' + String(value).replace(/"/g, '""') + '"'
                ).join(',')
            ).join('\n');

            const blob = new Blob([csvContent], {
                type: 'text/csv;charset=utf-8;'
            });

            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');

            link.href = url;
            link.download = 'PathKeeper_Funding_Opportunities.csv';

            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            URL.revokeObjectURL(url);
        }

        // APPLICATION PIPELINE

        function renderPipelineTracker() {
            const stages = ['saved', 'draft', 'submitted', 'awarded'];

            stages.forEach(stage => {
                const col = document.getElementById(`col-${stage}`);
                const stageItems = fundingPack.filter(item => item.stage === stage);

                document.getElementById(`count-${stage}`).innerText = stageItems.length;

                if (stageItems.length === 0) {
                    col.innerHTML = `
                        <div class="text-[11px] text-gray-400 italic p-3 text-center border border-dashed border-cream-300 rounded-lg">
                            No items in this stage
                        </div>
                    `;
                    return;
                }

                col.innerHTML = stageItems.map(item => {
                    const index = fundingPack.indexOf(item);

                    return `
                        <div class="bg-white p-3 rounded-lg border border-cream-300 text-xs shadow-sm space-y-2">
                            <div class="font-bold text-navy-900 break-words">${escapeHTML(item.title)}</div>

                            <div class="text-[10px] text-brown-700">
                                $${safeNumber(item.amount).toLocaleString()}
                            </div>

                            <select onchange="updateItemStage(${index}, this.value)" class="w-full text-[10px] bg-cream-50 border border-cream-300 rounded p-1" aria-label="Update application status">
                                <option value="saved" ${item.stage === 'saved' ? 'selected' : ''}>1. Saved</option>
                                <option value="draft" ${item.stage === 'draft' ? 'selected' : ''}>2. Draft</option>
                                <option value="submitted" ${item.stage === 'submitted' ? 'selected' : ''}>3. Submitted</option>
                                <option value="awarded" ${item.stage === 'awarded' ? 'selected' : ''}>4. Awarded</option>
                            </select>
                        </div>
                    `;
                }).join('');
            });
        }

        function updateItemStage(index, newStage) {
            if (!fundingPack[index]) return;

            const allowedStages = ['saved', 'draft', 'submitted', 'awarded'];

            if (!allowedStages.includes(newStage)) return;

            fundingPack[index].stage = newStage;

            saveFundingPack();
            renderPipelineTracker();
        }

        // ESSAY KEYWORD REVIEW

        function analyzeEssayText() {
            const text = document.getElementById('essayInput').value.toLowerCase();

            const words = text.trim() ? text.trim().split(/\s+/).length : 0;

            document.getElementById('wordCount').innerText = words;

            const keywords = [
                'leadership',
                'impact',
                'innovation',
                'research',
                'community',
                'systems',
                'sustainability'
            ];

            let matched = 0;

            keywords.forEach(keyword => {
                const badge = document.querySelector(`[data-kw="${keyword}"]`);

                if (!badge) return;

                if (text.includes(keyword)) {
                    matched++;
                    badge.classList.remove('bg-cream-200', 'text-navy-800');
                    badge.classList.add('bg-brown-700', 'text-white', 'font-bold');
                } else {
                    badge.classList.remove('bg-brown-700', 'text-white', 'font-bold');
                    badge.classList.add('bg-cream-200', 'text-navy-800');
                }
            });

            document.getElementById('linkedTermsCount').innerText = matched;

            const score = Math.round((matched / keywords.length) * 100);

            document.getElementById('matchScore').innerText = score + '%';
        }

        // PROFILE STRENGTH REVIEW

        function calculateScholarshipOdds() {
            const gpaInput = document.getElementById('calcGpa').value;
            const hoursInput = document.getElementById('calcHours').value;

            const gpa = Number(gpaInput);
            const hours = Number(hoursInput);

            const essayMultiplier = Number(document.getElementById('calcEssay').value);

            const scoreEl = document.getElementById('oddsScore');
            const adviceEl = document.getElementById('oddsAdvice');

            if (
                gpaInput === '' ||
                hoursInput === '' ||
                !Number.isFinite(gpa) ||
                !Number.isFinite(hours) ||
                gpa < 0 ||
                gpa > 4 ||
                hours < 0
            ) {
                scoreEl.innerText = 'Check Your Entries';
                adviceEl.innerText = 'Enter a GPA between 0 and 4 and a non-negative number of hours.';
                return;
            }

            const baseScore =
                (gpa / 4) * 50 +
                Math.min((hours / 100) * 30, 30);

            const finalScore = Math.min(
                Math.round(baseScore * essayMultiplier),
                100
            );

            scoreEl.className = 'text-xl font-bold my-1';

            if (finalScore >= 75) {
                scoreEl.innerText = 'Strong Preparation (' + finalScore + '/100)';
                scoreEl.classList.add('text-green-700');

                adviceEl.innerText =
                    'Your selected factors indicate a developed starting profile. Compare your experience with each award’s actual eligibility requirements.';
            } else if (finalScore >= 55) {
                scoreEl.innerText = 'Developing Preparation (' + finalScore + '/100)';
                scoreEl.classList.add('text-brown-700');

                adviceEl.innerText =
                    'Review your application evidence, strengthen your essay, and investigate awards that match your current qualifications.';
            } else {
                scoreEl.innerText = 'Preparation in Progress (' + finalScore + '/100)';
                scoreEl.classList.add('text-red-600');

                adviceEl.innerText =
                    'Start by identifying realistic funding categories and building the experience or documents required for your target opportunities.';
            }
        }

        // CUSTOM SCHOLARSHIP

        function openAddScholarshipModal() {
            document.getElementById('addScholarshipModal').classList.remove('hidden');
        }

        function closeAddScholarshipModal() {
            document.getElementById('addScholarshipModal').classList.add('hidden');
        }

        function saveCustomScholarship() {
            const title = document.getElementById('custTitle').value.trim();

            const amountInput = document.getElementById('custAmount').value;
            const amount = amountInput === '' ? 0 : Number(amountInput);

            const deadline = document.getElementById('custDeadline').value || 'TBD';
            const tag = document.getElementById('custTag').value;

            if (!title) {
                showDetailsModal('Input Required', 'Please provide a title for your custom funding target.');
                return;
            }

            if (!Number.isFinite(amount) || amount < 0) {
                showDetailsModal('Invalid Amount', 'Enter a valid non-negative funding amount.');
                return;
            }

            const grid = document.getElementById('scholarship-grid');

            const newCard = document.createElement('div');

            newCard.className =
                'scholarship-card bg-white p-6 rounded-2xl border border-brown-300 shadow-sm flex flex-col justify-between';

            newCard.setAttribute('data-tags', `${tag} Custom`);

            const safeTitle = escapeHTML(title);
            const safeDeadline = escapeHTML(deadline);
            const safeTag = escapeHTML(tag);

            const details = document.createElement('div');

            details.innerHTML = `
                <div class="flex justify-between items-start mb-3 gap-2">
                    <span class="px-2.5 py-1 bg-brown-100 text-brown-800 text-[10px] font-bold uppercase rounded">
                        Custom Target
                    </span>

                    <span class="px-2 py-0.5 bg-brown-100 text-brown-800 text-xs font-bold rounded">
                        $${amount.toLocaleString()}
                    </span>
                </div>

                <h3 class="text-xl font-bold text-navy-900 mb-2">${safeTitle}</h3>

                <p class="text-xs text-navy-800/80 mb-4">
                    Personal funding target added to your directory.
                </p>

                <div class="space-y-1.5 text-xs text-navy-900 mb-6 bg-cream-50 p-3 rounded-lg border border-cream-200">
                    <div><strong class="text-brown-700">Deadline:</strong> ${safeDeadline}</div>
                    <div><strong class="text-brown-700">Category:</strong> ${safeTag}</div>
                </div>
            `;

            const addButton = document.createElement('button');

            addButton.className =
                'w-full py-2 px-3 bg-navy-900 hover:bg-navy-800 text-white rounded-lg text-xs font-bold transition';

            addButton.textContent = '+ Add to Funding Pack';

            addButton.addEventListener('click', () => {
                toggleFundingPack(title, amount, deadline);
            });

            newCard.appendChild(details);
            newCard.appendChild(addButton);

            grid.prepend(newCard);

            document.getElementById('custTitle').value = '';
            document.getElementById('custAmount').value = '';
            document.getElementById('custDeadline').value = '';

            closeAddScholarshipModal();

            toggleFundingPack(title, amount, deadline);

            updateScholarshipCount();
        }

        // DRAWER

        function togglePackDrawer() {
            document.getElementById('packDrawer').classList.toggle('drawer-open');
        }

        function togglePackItem(item) {
            toggleFundingPack(item, 0, 'TBD');
        }

        // GLOBAL SEARCH

        function filterAllContent() {
            const query = document.getElementById('globalSearch').value.toLowerCase().trim();

            const sections = document.querySelectorAll('.searchable-section');

            sections.forEach(section => {
                const sectionText = section.innerText.toLowerCase();

                const matchesSection = !query || sectionText.includes(query);

                section.classList.toggle('hidden', !matchesSection);
            });

            filterScholarshipCards();
        }

        function setQuickSearch(term) {
            document.getElementById('globalSearch').value = term;
            filterAllContent();
        }

        function resetGlobalSearch() {
            document.getElementById('globalSearch').value = '';

            document.querySelectorAll('.searchable-section').forEach(section => {
                section.classList.remove('hidden');
            });

            filterScholarshipCards();
        }

        // FUNDING GUIDE

        function openWizardModal() {
            document.getElementById('wizardModal').classList.remove('hidden');
        }

        function closeWizardModal() {
            document.getElementById('wizardModal').classList.add('hidden');
        }

        function calculateRecommendedPath() {
            const goal = document.getElementById('wizardGoal').value;
            const stage = document.getElementById('wizardStage').value;

            let title = '';
            let desc = '';

            if (stage === 'master') {
                title = 'Micro-Funding & Emergency Assistance';

                desc =
                    'Investigate smaller grants, emergency assistance, equipment programs, and short-term financial support. Check whether the funding can be used for your particular expense.';
            } else if (stage === 'advanced') {
                title = 'Need-Based Scholarships & Financial Assistance';

                desc =
                    'Start by reviewing need-based scholarships, institutional aid, local foundations, and programs that consider financial circumstances.';
            } else if (goal === 'coded') {
                title = 'Postgraduate & Research Funding';

                desc =
                    'Investigate research awards, graduate fellowships, academic department funding, and discipline-specific research grants.';
            } else if (goal === 'strategy') {
                title = 'Vocational & Certification Funding';

                desc =
                    'Investigate workforce development grants, employer-sponsored training, industry scholarships, and certification assistance.';
            } else {
                title = 'Undergraduate Scholarship Opportunities';

                desc =
                    'Investigate academic scholarships, merit awards, institutional scholarships, community foundations, and need-based programs.';
            }

            document.getElementById('wizardResultTitle').innerText = title;
            document.getElementById('wizardResultDesc').innerText = desc;

            document.getElementById('wizardResult').classList.remove('hidden');
        }

        // DETAILS MODAL

        function showDetailsModal(title, body) {
            document.getElementById('detailsModalTitle').innerText = title;
            document.getElementById('detailsModalBody').innerText = body;

            document.getElementById('detailsModal').classList.remove('hidden');
        }

        function closeDetailsModal() {
            document.getElementById('detailsModal').classList.add('hidden');
        }

        // CLOSE MODALS WHEN CLICKING OUTSIDE

        document.querySelectorAll('#addScholarshipModal, #wizardModal, #detailsModal').forEach(modal => {
            modal.addEventListener('click', event => {
                if (event.target === modal) {
                    modal.classList.add('hidden');
                }
            });
        });

    </script>

</body>
</html>
