              $3,500
            </span>

          </div>

          <div class="bar">
            <div
              id="hardwareBar"
              class="bar-fill"
              style="width:35%;">
            </div>
          </div>

        </div>


        <div class="allocation">

          <div class="allocation-top">

            <span class="allocation-name">
              Software & Tools
            </span>

            <span
              id="softwareValue"
              class="allocation-value">
              $2,500
            </span>

          </div>

          <div class="bar">
            <div
              id="softwareBar"
              class="bar-fill"
              style="width:25%;">
            </div>
          </div>

        </div>


        <div class="allocation">

          <div class="allocation-top">

            <span class="allocation-name">
              Targeted Marketing
            </span>

            <span
              id="marketingValue"
              class="allocation-value">
              $2,000
            </span>

          </div>

          <div class="bar">
            <div
              id="marketingBar"
              class="bar-fill"
              style="width:20%;">
            </div>
          </div>

        </div>


        <div class="allocation">

          <div class="allocation-top">

            <span class="allocation-name">
              Support Staffing
            </span>

            <span
              id="staffValue"
              class="allocation-value">
              $1,000
            </span>

          </div>

          <div class="bar">
            <div
              id="staffBar"
              class="bar-fill"
              style="width:10%;">
            </div>
          </div>

        </div>


        <div class="allocation">

          <div class="allocation-top">

            <span class="allocation-name">
              Operational Base
            </span>

            <span
              id="operationsValue"
              class="allocation-value">
              $1,000
            </span>

          </div>

          <div class="bar">
            <div
              id="operationsBar"
              class="bar-fill"
              style="width:10%;">
            </div>
          </div>

        </div>


      </div>

    </div>

  </div>

</section>



<!-- =====================================================
     PROPOSAL CHECKLIST
===================================================== -->

<section class="section">

  <div class="section-heading">

    <div class="kicker">
