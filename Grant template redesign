<script>

/* =====================================================
   FUNDING CALCULATOR
===================================================== */

function calculateFunding(){

  const amount =
    Number(
      document.getElementById(
        "grantAmount"
      ).value
    ) || 0;


  const allocations = [

    {
      value:amount * .35,
      valueId:"hardwareValue",
      barId:"hardwareBar",
      percent:35
    },

    {
      value:amount * .25,
      valueId:"softwareValue",
      barId:"softwareBar",
      percent:25
    },

    {
      value:amount * .20,
      valueId:"marketingValue",
      barId:"marketingBar",
      percent:20
    },

    {
      value:amount * .10,
      valueId:"staffValue",
      barId:"staffBar",
      percent:10
    },

    {
      value:amount * .10,
      valueId:"operationsValue",
      barId:"operationsBar",
      percent:10
    }

  ];


  allocations.forEach(item => {

    document.getElementById(
      item.valueId
    ).textContent =
      formatCurrency(item.value);


    document.getElementById(
      item.barId
    ).style.width =
      item.percent + "%";

  });

}


function formatCurrency(number){

  return new Intl.NumberFormat(
    "en-US",
    {
      style:"currency",
      currency:"USD",
      maximumFractionDigits:0
    }
  ).format(number);

}


/* =====================================================
   PROPOSAL CHECKLIST
===================================================== */

function toggleComponent(component){

  component.classList.toggle(
    "complete"
  );

  updateProgress();

}


function updateProgress(){

  const total =
    document.querySelectorAll(
      ".component"
    ).length;

  const completed =
    document.querySelectorAll(
      ".component.complete"
    ).length;


  const percentage =
    total
      ? (completed / total) * 100
      : 0;


  document.getElementById(
    "progressFill"
  ).style.width =
    percentage + "%";


  document.getElementById(
    "progressText"
  ).textContent =
    `${completed} / ${total} complete`;

}


/* =====================================================
   PROPOSAL PREVIEW
===================================================== */

function updateProposalPreview(){

  const organization =
    document.getElementById(
      "organization"
    ).value.trim();

  const grantProgram =
    document.getElementById(
      "grantProgram"
    ).value.trim();

  const requestedAmount =
    document.getElementById(
      "requestedAmount"
    ).value;

  const timeline =
    document.getElementById(
      "timeline"
    ).value;

  const notes =
    document.getElementById(
      "proposalNotes"
    ).value.trim();


  let text =
`LEAD WITH SPEAKING — GRANT SUMMARY

Applicant:
${organization || "[Applicant name]"}

Grant Program:
${grantProgram || "[Grant program]"}

Business Overview:
Digital content and web operations initiative providing responsive website builds, CMS maintenance, and media asset pipelines for independent speakers and service providers.

Funding Deployment:
- 35% Hardware & Technology
- 25% Software, Hosting & Security Tools
- 20% Targeted Marketing & Austin Outreach
- 10% Specialized Contractor Staffing
- 10% Working Capital & Base Operational Stability`;


  if(requestedAmount){

    text +=
      `\n\nRequested Amount:\n${formatCurrency(Number(requestedAmount))}`;

  }


  if(timeline){

    text +=
      `\n\nSubmission / Project Timing:\n${timeline}`;

  }


  if(notes){

    text +=
      `\n\nGrant-Specific Notes:\n${notes}`;

  }


  document.getElementById(
    "copyPreview"
  ).textContent =
    text;

}


/* =====================================================
   COPY PROPOSAL
===================================================== */

async function copyProposal(){

  const text =
    document.getElementById(
      "copyPreview"
    ).textContent;


  try{

    await navigator.clipboard.writeText(
      text
    );

    showSavedMessage(
      "Proposal summary copied to clipboard."
    );

  }catch(error){

    /*
      Fallback for environments where
      navigator.clipboard is unavailable.
    */

    const area =
      document.createElement("textarea");

    area.value = text;

    document.body.appendChild(area);

    area.select();

    document.execCommand("copy");

    area.remove();

    showSavedMessage(
      "Proposal summary copied."
    );

  }

}


function showSavedMessage(message){

  const element =
    document.getElementById(
      "savedMessage"
    );

  element.textContent =
    message;

  element.style.display =
    "block";


  setTimeout(() => {

    element.style.display =
      "none";

  },3500);

}


/* =====================================================
   FAQ
===================================================== */

function toggleFAQ(button){

  const item =
    button.closest(
      ".faq-item"
    );

  const wasOpen =
    item.classList.contains(
      "open"
    );


  document
    .querySelectorAll(".faq-item")
    .forEach(other => {

      other.classList.remove(
        "open"
      );

      const symbol =
        other.querySelector(
          ".faq-symbol"
        );

      if(symbol){
        symbol.textContent =
          "+";
      }

    });


  if(!wasOpen){

    item.classList.add(
      "open"
    );

    const symbol =
      item.querySelector(
        ".faq-symbol"
      );

    if(symbol){
      symbol.textContent =
        "−";
    }

  }

}


/* =====================================================
   SCROLLING
===================================================== */

function scrollToFunding(){

  document
    .getElementById("funding")
    .scrollIntoView({
      behavior:"smooth"
    });

}


function scrollToBuilder(){

  document
    .getElementById("builder")
    .scrollIntoView({
      behavior:"smooth"
    });

}


/* =====================================================
   INITIALIZE
===================================================== */

calculateFunding();
updateProgress();
updateProposalPreview();

</script>

