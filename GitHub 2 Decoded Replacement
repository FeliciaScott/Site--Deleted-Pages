<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Professional Leverage: Entry Blueprints</title>
    <style>
        :root {
            --bg-base: #0b0f12;
            --bg-surface: #141b1f;
            --primary-olive: #3f6212;
            --primary-light: #65a30d;
            --accent-acid: #eab308;
            --text-primary: #f8fafc;
            --text-muted: #8796a5;
            --border-grid: #222e35;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        body { background-color: var(--bg-base); color: var(--text-primary); padding: 3rem 1.5rem; line-height: 1.5; }
        .container { max-width: 1100px; margin: 0 auto; }
        
        header { border: 1px solid var(--border-grid); background-color: var(--bg-surface); padding: 2rem; border-radius: 8px; margin-bottom: 3rem; }
        header h1 { font-size: 2.2rem; font-weight: 700; margin-bottom: 0.75rem; }
        header h1 span { color: var(--accent-acid); }
        header p { color: var(--text-muted); font-size: 0.95rem; max-width: 800px; }

        .selector-strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 2.5rem; }
        .sector-card { background: var(--bg-surface); border: 1px solid var(--border-grid); border-radius: 6px; padding: 1.25rem; cursor: pointer; transition: all 0.2s; }
        .sector-card.active { border-color: var(--accent-acid); background: rgba(234, 179, 8, 0.05); }
        .sector-id { font-size: 0.7rem; color: var(--accent-acid); display: block; margin-bottom: 0.25rem; }
        .sector-title { font-weight: 600; }

        .blueprint-grid { display: grid; grid-template-columns: 1fr 2fr; gap: 2rem; }
        .vector-panel { background: var(--bg-surface); border: 1px solid var(--border-grid); border-radius: 8px; padding: 1.5rem; }
        .metric-label { font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; display: block; }
        .metric-value { font-size: 1rem; font-weight: bold; margin-bottom: 1.25rem; display: block; }

        .block-node { background: var(--bg-surface); border: 1px solid var(--border-grid); border-radius: 8px; padding: 1.75rem; margin-bottom: 1.5rem; }
        .node-tag { color: var(--accent-acid); font-size: 0.7rem; font-weight: 700; text-transform: uppercase; }
        .node-title { font-size: 1.2rem; margin: 0.5rem 0; }
        .node-body { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1rem; }
        
        @media (max-width: 768px) { .blueprint-grid, .selector-strip { grid-template-columns: 1fr; } }
    </style>
</head>
<body>

<div class="container">
    <header>
        <h1>Professional Leverage: <span>Entry Blueprints</span></h1>
 
    </header>

    <div class="selector-strip">
        <div class="sector-card active" id="btn-ops" onclick="loadBlueprint('ops')">
            <span class="sector-id">ROUTE_01</span>
            <span class="sector-title">Business & Operations</span>
        </div>
        <div class="sector-card" id="btn-creative" onclick="loadBlueprint('creative')">
            <span class="sector-id">ROUTE_02</span>
            <span class="sector-title">Creative & Communications</span>
        </div>
        <div class="sector-card" id="btn-admin" onclick="loadBlueprint('admin')">
            <span class="sector-id">ROUTE_03</span>
            <span class="sector-title">Admin & Strategy</span>
        </div>
    </div>

    <div class="blueprint-grid">
        <div class="vector-panel">
            <div class="metric-label">Target Destination</div>
            <span class="metric-value" id="spec-destination">Growth-Stage Teams</span>
            <div class="metric-label">Leverage Point</div>
            <span class="metric-value" id="spec-leverage">Operational Inefficiency</span>
        </div>
        <div id="execution-stack"></div>
    </div>
</div>

<script>
    const database = {
        ops: {
            destination: "Operations & Management",
            leverage: "Process Bottlenecks",
            steps: [
                { tag: "PHASE_01", title: "Audit the Workflow", desc: "Identify a repetitive, manual task or a broken process within the company. Don't look for a job, look for a friction point.", items: ["Map the existing process", "Document time or cost inefficiencies"] },
                { tag: "PHASE_02", title: "Build the Solution", desc: "Create a simple guide, automation script, or new template that solves the inefficiency you identified.", items: ["Develop a simplified workflow", "Create a clear 'Before vs After' document"] },
                { tag: "PHASE_03", title: "Direct Outreach", desc: "Send your solution directly to the department lead. 'I noticed your team struggles with [Task], so I built this [Solution] to save you time.'", items: ["Lead with the value, not the resume"] }
            ]
        },
        creative: {
            destination: "Marketing & Creative",
            leverage: "Content/Brand Gaps",
            steps: [
                { tag: "PHASE_01", title: "Brand Audit", desc: "Review their public output. Find an area where they are inconsistent or inactive.", items: ["Analyze their social or blog gaps", "Identify missed storytelling opportunities"] },
                { tag: "PHASE_02", title: "Execute a Sample", msg: "Produce a piece of work—a mock campaign, a better email sequence, or a redesigned asset—that shows you understand their brand voice.", items: ["Create a 'Value-Add' asset", "Ensure it is tailored to their exact style"] },
                { tag: "PHASE_03", title: "Submit for Feedback", desc: "Reach out to the Creative Director. 'I admire your recent campaign, so I put together a concept that fits your style. Here is the work.'", items: ["No request for an interview", "Focus entirely on the contribution"] }
            ]
        },
        admin: {
            destination: "Strategic Support",
            leverage: "Information Management",
            steps: [
                { tag: "PHASE_01", title: "Assess Information Needs", desc: "Research a company's public strategy and industry news. Find the 'noise' they are trying to manage.", items: ["Track their recent public press", "Identify key industry data they need to monitor"] },
                { tag: "PHASE_02", title: "Create a Digest", desc: "Build a weekly brief that aggregates vital industry info for them. Become an essential resource.", items: ["Create a clean, one-page report", "Format for quick decision-making"] },
                { tag: "PHASE_03", title: "Value-First Pitch", desc: "Email the lead with: 'I’ve been tracking this industry and created this brief to save you time. Let me know if you’d like me to keep sending it.'", items: ["Prove your worth by being useful", "Establish a recurring connection"] }
            ]
        }
    };

    function loadBlueprint(sector) {
        document.querySelectorAll('.sector-card').forEach(c => c.classList.remove('active'));
        document.getElementById(`btn-${sector}`).classList.add('active');
        const data = database[sector];
        document.getElementById('spec-destination').innerText = data.destination;
        document.getElementById('spec-leverage').innerText = data.leverage;
        const stack = document.getElementById('execution-stack');
        stack.innerHTML = data.steps.map(s => `
            <div class="block-node">
                <span class="node-tag">${s.tag}</span>
                <h3 class="node-title">${s.title}</h3>
                <p class="node-body">${s.desc}</p>
                <ul>${s.items.map(i => `<li>${i}</li>`).join('')}</ul>
            </div>
        `).join('');
    }
    loadBlueprint('ops');
</script>
</body>
</html>
