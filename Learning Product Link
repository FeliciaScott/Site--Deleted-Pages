<!-- PROCESS -->

<section class="process">

  <div class="container">

    <div class="section-header">

      <div class="section-label">
        How it works
      </div>

      <h2>
        Four simple steps.
      </h2>

      <p>
        You provide the destination. We handle the research and organization.
      </p>

    </div>


    <div class="process-grid">

      <div class="process-card">
        <div class="process-number">01</div>
        <h3>Tell us your goal</h3>
        <p>
          Complete a short intake form describing what you want to learn
          and why.
        </p>
      </div>

      <div class="process-card">
        <div class="process-number">02</div>
        <h3>We research</h3>
        <p>
          We identify useful resources, skills, practice opportunities
          and potential projects.
        </p>
      </div>

      <div class="process-card">
        <div class="process-number">03</div>
        <h3>We build your path</h3>
        <p>
          Everything is organized into a practical sequence based on
          your available time.
        </p>
      </div>

      <div class="process-card">
        <div class="process-number">04</div>
        <h3>You move forward</h3>
        <p>
          Follow the roadmap, complete the work and build evidence of
          what you're learning.
        </p>
      </div>

    </div>

  </div>

</section>


<!-- OBJECTIONS -->

