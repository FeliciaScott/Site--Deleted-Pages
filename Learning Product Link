<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Personalized Learning Roadmap | Learn With Direction</title>

<meta
  name="description"
  content="Stop searching through endless courses and tutorials. Get a personalized learning roadmap with resources, practice, projects, and clear next steps."
>

<style>
:root{
  --ink:#18221f;
  --ink-soft:#3f4c47;
  --cream:#f7f4ed;
  --paper:#ffffff;
  --sage:#dce8df;
  --green:#1f5c4b;
  --green-dark:#164538;
  --gold:#d8a84e;
  --line:#d9ded9;
  --muted:#68736e;
  --shadow:0 18px 50px rgba(24,34,31,.09);
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  background:var(--cream);
  color:var(--ink);
  line-height:1.6;
}

a{
  color:inherit;
  text-decoration:none;
}

.container{
  width:min(1120px,92%);
  margin:auto;
}

/* NAVIGATION */

nav{
  padding:22px 0;
  border-bottom:1px solid rgba(24,34,31,.08);
  background:rgba(247,244,237,.94);
}

.nav-inner{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:30px;
}

.logo{
  font-size:1.05rem;
  font-weight:800;
  letter-spacing:-.03em;
}

.logo span{
  color:var(--green);
}

.nav-link{
  font-size:.9rem;
  font-weight:700;
  color:var(--ink-soft);
}

.nav-cta{
  background:var(--green);
  color:white;
  padding:11px 18px;
  border-radius:7px;
  font-weight:800;
  font-size:.88rem;
}

/* HERO */

.hero{
  padding:92px 0 85px;
  overflow:hidden;
}

.hero-grid{
  display:grid;
  grid-template-columns:1.15fr .85fr;
  gap:70px;
  align-items:center;
}

.eyebrow{
  display:inline-flex;
  align-items:center;
  gap:8px;
  background:var(--sage);
  color:var(--green-dark);
  padding:7px 12px;
  border-radius:100px;
  font-size:.78rem;
  font-weight:800;
  text-transform:uppercase;
  letter-spacing:.08em;
  margin-bottom:22px;
}

.eyebrow:before{
  content:"";
  width:7px;
  height:7px;
  border-radius:50%;
  background:var(--gold);
}

h1{
  font-size:clamp(2.7rem,6vw,5rem);
  line-height:.98;
  letter-spacing:-.065em;
  max-width:760px;
}

.hero h1 span{
  color:var(--green);
}

.hero-text{
  margin-top:25px;
  max-width:650px;
  color:var(--ink-soft);
  font-size:1.12rem;
}

.hero-actions{
  display:flex;
  gap:13px;
  flex-wrap:wrap;
  margin-top:32px;
}

.primary-btn{
  display:inline-flex;
  justify-content:center;
  align-items:center;
  background:var(--green);
  color:white;
  padding:15px 24px;
  border-radius:7px;
  font-weight:800;
  transition:.2s ease;
}

.primary-btn:hover{
  background:var(--green-dark);
  transform:translateY(-2px);
}

.secondary-btn{
  display:inline-flex;
  justify-content:center;
  align-items:center;
  border:1px solid var(--line);
  padding:15px 24px;
  border-radius:7px;
  font-weight:800;
  background:white;
}

.hero-note{
  margin-top:17px;
  font-size:.83rem;
  color:var(--muted);
}

/* HERO CARD */

.route-card{
  background:var(--paper);
  border:1px solid var(--line);
  border-radius:18px;
  box-shadow:var(--shadow);
  padding:28px;
  position:relative;
}

.route-card:before{
  content:"";
  position:absolute;
  width:90px;
  height:90px;
  border-radius:50%;
  background:var(--gold);
  opacity:.16;
  right:-25px;
  top:-25px;
}

.card-label{
  font-size:.72rem;
  text-transform:uppercase;
  letter-spacing:.12em;
  font-weight:900;
  color:var(--muted);
}

.route-title{
  font-size:1.45rem;
  font-weight:850;
  margin:8px 0 22px;
}

.route-step{
  display:grid;
  grid-template-columns:36px 1fr;
  gap:13px;
  padding:14px 0;
  border-top:1px solid var(--line);
}

.step-number{
  width:31px;
  height:31px;
  display:grid;
  place-items:center;
  border-radius:50%;
  background:var(--sage);
  color:var(--green-dark);
  font-size:.8rem;
  font-weight:900;
}

.route-step strong{
  display:block;
  margin-bottom:2px;
}

.route-step p{
  color:var(--muted);
  font-size:.86rem;
}

/* SECTION */

section{
  padding:90px 0;
}

.section-header{
  max-width:710px;
  margin-bottom:48px;
}

.section-label{
  color:var(--green);
  text-transform:uppercase;
  letter-spacing:.12em;
  font-size:.75rem;
  font-weight:900;
  margin-bottom:12px;
}

h2{
  font-size:clamp(2rem,4vw,3.25rem);
  line-height:1.05;
  letter-spacing:-.045em;
}

.section-header p{
  color:var(--ink-soft);
  margin-top:17px;
  font-size:1.04rem;
}

/* PROBLEM */

.problem{
  background:var(--ink);
  color:white;
}

.problem .section-header p{
  color:#bdc8c3;
}

.problem-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:18px;
}

.problem-card{
  border:1px solid #34413c;
  border-radius:13px;
  padding:28px;
  background:#202c28;
}

.problem-card .number{
  color:var(--gold);
  font-size:.75rem;
  font-weight:900;
  letter-spacing:.1em;
}

.problem-card h3{
  margin:14px 0 8px;
  font-size:1.15rem;
}

.problem-card p{
  color:#b7c1bd;
  font-size:.92rem;
}

/* SHIFT */

.shift{
  background:white;
}

.shift-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:25px;
}

.shift-card{
  border:1px solid var(--line);
  border-radius:15px;
  padding:32px;
}

.shift-card.old{
  background:#f7f7f5;
}

.shift-card.new{
  background:var(--sage);
  border-color:#c5d6ca;
}

.shift-card h3{
  margin-bottom:20px;
}

.shift-list{
  list-style:none;
}

.shift-list li{
  padding:12px 0;
  border-top:1px solid rgba(24,34,31,.1);
  display:flex;
  gap:10px;
  font-size:.94rem;
}

.old .shift-list li:before{
  content:"—";
  color:#8c9691;
}

.new .shift-list li:before{
  content:"✓";
  color:var(--green);
  font-weight:900;
}

/* OFFER */

.offer{
  background:var(--cream);
}

.offer-box{
  background:var(--paper);
  border:1px solid var(--line);
  border-radius:20px;
  box-shadow:var(--shadow);
  overflow:hidden;
  display:grid;
  grid-template-columns:1.1fr .9fr;
}

.offer-main{
  padding:48px;
}

.offer-main h2{
  margin-bottom:17px;
}

.offer-main > p{
  color:var(--ink-soft);
  max-width:610px;
}

.included{
  margin-top:30px;
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
}

.included-item{
  padding:15px;
  background:#f4f5f1;
  border-radius:8px;
  font-size:.9rem;
  font-weight:700;
}

.included-item:before{
  content:"✓";
  color:var(--green);
  margin-right:8px;
}

.price-panel{
  background:var(--green);
  color:white;
  padding:48px 38px;
  display:flex;
  flex-direction:column;
  justify-content:center;
}

.price-label{
  text-transform:uppercase;
  letter-spacing:.12em;
  font-size:.72rem;
  font-weight:900;
  color:#c9ddd2;
}

.price{
  font-size:4rem;
  line-height:1;
  letter-spacing:-.06em;
  font-weight:900;
  margin:10px 0 5px;
}

.price-sub{
  color:#c9ddd2;
  font-size:.9rem;
}

.price-list{
  list-style:none;
  margin:27px 0;
}

.price-list li{
  padding:9px 0;
  border-bottom:1px solid rgba(255,255,255,.14);
  font-size:.9rem;
}

.price-panel .primary-btn{
  background:white;
  color:var(--green-dark);
}

.price-panel .primary-btn:hover{
  background:#f3f5f2;
}

/* PROCESS */

.process{
  background:white;
}

.process-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:15px;
}

.process-card{
  padding:25px;
  border:1px solid var(--line);
  border-radius:13px;
}

.process-number{
  font-size:.75rem;
  font-weight:900;
  color:var(--green);
}

.process-card h3{
  margin:13px 0 8px;
  font-size:1.05rem;
}

.process-card p{
  color:var(--muted);
  font-size:.87rem;
}

/* OBJECTIONS */

.objections{
  background:#eef1ed;
}

.objection-list{
  max-width:820px;
}

.objection{
  padding:25px 0;
  border-top:1px solid #cdd5cf;
}

.objection h3{
  font-size:1.05rem;
  margin-bottom:8px;
}

.objection p{
  color:var(--ink-soft);
  font-size:.94rem;
}

/* CTA */

.final-cta{
  background:var(--green-dark);
  color:white;
  text-align:center;
  padding:105px 0;
}

.final-cta h2{
  max-width:750px;
  margin:0 auto;
}

.final-cta p{
  max-width:600px;
  margin:20px auto 30px;
  color:#cbd9d2;
}

.final-cta .primary-btn{
  background:white;
  color:var(--green-dark);
}

.final-cta .primary-btn:hover{
  background:#f1f4f1;
}

/* FOOTER */

footer{
  background:#102e27;
  color:#aebdb6;
  padding:25px 0;
  font-size:.8rem;
}

.footer-inner{
  display:flex;
  justify-content:space-between;
  gap:20px;
}

/* RESPONSIVE */

@media(max-width:850px){

  .hero-grid,
  .offer-box,
  .shift-grid{
    grid-template-columns:1fr;
  }

  .problem-grid{
    grid-template-columns:1fr;
  }

  .process-grid{
    grid-template-columns:1fr 1fr;
  }

  .hero{
    padding-top:65px;
  }

  .hero-grid{
    gap:45px;
  }

  .offer-main{
    padding:32px;
  }

  .price-panel{
    padding:38px 32px;
  }
}

@media(max-width:600px){

  .nav-link{
    display:none;
  }

  h1{
    font-size:2.8rem;
  }

  section{
    padding:70px 0;
  }

  .included{
    grid-template-columns:1fr;
  }

  .process-grid{
    grid-template-columns:1fr;
  }

  .hero-actions{
    flex-direction:column;
  }

  .primary-btn,
  .secondary-btn{
    width:100%;
  }

  .footer-inner{
    flex-direction:column;
  }
}
</style>
</head>

