const strategyQuestions = {
  leverage: "Map the workflow or problem. Identify the bottleneck, the decision that influences the most outcomes, and one small change you can safely test.",
  overlooked: "List assumptions, missing stakeholders, hidden costs, dependencies, maintenance requirements, and evidence that could contradict your current view.",
  obsolete: "Identify which tasks, tools, skills, or assumptions depend on conditions that may change. Look for transferable skills and low-cost ways to test alternatives.",
  build: "Start with a specific user and problem. Define a small useful result, the evidence that would validate it, and the minimum version you can test.",
  stop: "Review activities that consume resources without producing meaningful progress. Pause or reduce one low-value activity and measure what changes."
};

function switchTab(panelId, button) {
  document.querySelectorAll("#core-pathways .tab-panel").forEach(panel => panel.classList.add("hidden"));
  document.querySelectorAll("#core-pathways .tab-button").forEach(btn => {
    btn.classList.remove("active");
    btn.setAttribute("aria-selected", "false");
  });
  document.getElementById(panelId).classList.remove("hidden");
  button.classList.add("active");
  button.setAttribute("aria-selected", "true");
}

function filterStrategy() {
  const focus = document.getElementById("strategyFocus").value;
  document.querySelectorAll("#strategyGrid .searchable-card").forEach(card => {
    const matchesFocus = focus === "all" || card.dataset.focus === focus;
    const matchesSearch = matchesGlobalSearch(card);
    card.classList.toggle("hidden", !(matchesFocus && matchesSearch));
  });
}

function showStrategicQuestion() {
  const value = document.getElementById("strategyQuestion").value;
  const box = document.getElementById("questionResult");
  if (!value) {
    box.classList.add("hidden");
    box.textContent = "";
    return;
  }
  box.textContent = strategyQuestions[value] || "";
  box.classList.remove("hidden");
}

function setDomain(domain, button) {
  activeDomain = domain;
  document.querySelectorAll("#domainButtons .filter-button").forEach(btn => btn.classList.remove("active"));
  button.classList.add("active");
  filterAtlas();
}

function filterAtlas() {
  const level = document.getElementById("atlasLevel").value;
  let visible = 0;
  document.querySelectorAll(".atlas-card").forEach(card => {
    const matchesDomain = activeDomain === "all" || card.dataset.domain === activeDomain;
    const matchesLevel = level === "all" || card.dataset.level === level;
    const matchesSearch = matchesGlobalSearch(card);
    const show = matchesDomain && matchesLevel && matchesSearch;
    card.classList.toggle("hidden", !show);
    if (show) visible++;
  });
  document.getElementById("atlasCount").textContent = visible + " pathway(s) match your filters.";
}

function matchesGlobalSearch(element) {
  const query = document.getElementById("globalSearch").value.trim().toLowerCase();
  if (!query) return true;
  return (element.innerText + " " + (element.dataset.search || "")).toLowerCase().includes(query);
}

function applyGlobalSearch() {
  filterStrategy();
  filterAtlas();

  document.querySelectorAll(".searchable-card").forEach(card => {
    if (card.closest("#strategyGrid") || card.classList.contains("atlas-card")) return;
    card.classList.toggle("hidden", !matchesGlobalSearch(card));
  });

  document.querySelectorAll(".searchable-section").forEach(section => {
    const cards = section.querySelectorAll(".searchable-card");
    if (!cards.length) {
      section.classList.toggle("hidden", !matchesGlobalSearch(section));
      return;
    }
    const anyVisible = Array.from(cards).some(card => !card.classList.contains("hidden"));
    section.classList.toggle("hidden", !anyVisible);
  });

  const query = document.getElementById("globalSearch").value.trim();
  document.getElementById("searchStatus").textContent = query
    ? 'Filtering content for "' + query + '". Use Clear search to restore everything.'
    : "Showing all available content.";
}

function quickSearch(term) {
  document.getElementById("globalSearch").value = term;
  applyGlobalSearch();
  document.getElementById("home").scrollIntoView({ behavior: "smooth" });
}

function clearSearch() {
  document.getElementById("globalSearch").value = "";
  applyGlobalSearch();
}

function recalculateSkills() {
  const selected = Array.from(document.querySelectorAll(".skill-check:checked")).map(input => input.value);
  document.getElementById("skillCount").textContent = selected.length + " / 4";

  document.querySelectorAll(".module").forEach(module => {
    const required = module.dataset.requires.split(" ");
    const unlocked = required.every(skill => selected.includes(skill));
    module.classList.toggle("unlocked", unlocked);
    module.classList.toggle("locked", !unlocked);
    module.querySelector(".module-status").textContent = unlocked ? "READY TO EXPLORE" : "MORE SKILLS NEEDED";
  });

  const advice = selected.length === 0
    ? "Start by selecting a skill you can demonstrate. If you are new to all four areas, begin with scripting and logic fundamentals."
    : selected.length === 4
      ? "All four competencies are selected. Consider a small integrated project with validation, error handling, documentation, and tests."
      : "Your next step is to build a small project that combines " + selected.join(", ") + ". Add a test and document what works and what remains incomplete.";

  document.getElementById("skillAdvice").textContent = advice;
}

function openWizard() {
  document.getElementById("wizardModal").classList.remove("hidden");
}
function closeWizard() {
  document.getElementById("wizardModal").classList.add("hidden");
}
function calculatePath() {
  const goal = document.getElementById("wizardGoal").value;
  const stage = document.getElementById("wizardStage").value;

  const routes = {
    career: {
      entry: ["Career Foundation & Evidence Path", "Identify a target role, compare its requirements with your current skills, and create one small project or work sample that demonstrates a needed capability."],
      advanced: ["Career Scaling & Project Ownership", "Choose a skill gap that limits progress, own a measurable project, and document the outcome to strengthen your portfolio or promotion case."],
      master: ["Leadership & Strategic Influence", "Improve a team-level system, clarify decision rights, and document how your changes affect quality, time, cost, or reliability."]
    },
    coded: {
      entry: ["Coding Fundamentals & Small Projects", "Start with HTML, CSS, JavaScript, data structures, and debugging. Build small working tools before adding complex automation."],
      advanced: ["Software Integration & Testing", "Connect components through clear interfaces. Add input validation, error handling, tests, and documentation."],
      master: ["Systems Architecture & Reliability", "Design system boundaries, data flows, security assumptions, monitoring, and recovery paths. Validate architecture through prototypes."]
    },
    business: {
      entry: ["Business Research & Customer Problems", "Choose a specific customer problem. Interview or research potential users, compare alternatives, and test demand before spending heavily."],
      advanced: ["Operations & Market Strategy", "Analyze customer needs, unit economics, workflow bottlenecks, and regional differences. Test one improvement with a defined measure."],
      master: ["Business Systems & Expansion", "Assess strategic fit, risk, operating capacity, and partnerships. Expand in stages with clear success and stop conditions."]
    },
    research: {
      entry: ["Research Fundamentals", "Define one question, gather credible sources, record claims and dates, and separate facts from assumptions."],
      advanced: ["Evidence Synthesis & Decision Analysis", "Compare sources, identify disagreement, estimate uncertainty, and explain how the evidence changes your decision."],
      master: ["Strategic Intelligence Architecture", "Build a repeatable research process with source standards, review checkpoints, decision records, and feedback from outcomes."]
    }
  };

  const route = routes[goal][stage];
  latestWizardPath = route[0];
  document.getElementById("wizardResultTitle").textContent = route[0];
  document.getElementById("wizardResultDesc").textContent = route[1];
  document.getElementById("wizardResult").classList.remove("hidden");
}
function addWizardPath() {
  if (latestWizardPath) {
    addPack(latestWizardPath);
    document.getElementById("wizardResultDesc").textContent += " Recommendation added to your pack.";
  }
}

function showDetails(title, body) {
  document.getElementById("detailsTitle").textContent = title;
  document.getElementById("detailsBody").textContent = body;
  document.getElementById("detailsModal").classList.remove("hidden");
}
function closeDetails() {
  document.getElementById("detailsModal").classList.add("hidden");
}

function addPack(name) {
  if (!selectedPackItems.includes(name)) selectedPackItems.push(name);
  updatePackUI();
}
function removePack(name) {
  const index = selectedPackItems.indexOf(name);
  if (index !== -1) selectedPackItems.splice(index, 1);
  updatePackUI();
}
function clearPack() {
  selectedPackItems.length = 0;
  updatePackUI();
  document.getElementById("packStatus").textContent = "Your pack has been cleared.";
}
function updatePackUI() {
  document.getElementById("packCount").textContent = selectedPackItems.length;
  const list = document.getElementById("packItems");
  list.replaceChildren();
  document.getElementById("emptyPack").classList.toggle("hidden", selectedPackItems.length > 0);

  selectedPackItems.forEach(name => {
    const li = document.createElement("li");
    const span = document.createElement("span");
    span.textContent = name;
    const button = document.createElement("button");
    button.type = "button";
    button.textContent = "Remove";
    button.addEventListener("click", () => removePack(name));
    li.append(span, button);
    list.appendChild(li);
  });
}
function openPack() {
  updatePackUI();
  document.getElementById("packModal").classList.remove("hidden");
}
function closePack() {
  document.getElementById("packModal").classList.add("hidden");
}

function downloadText(filename, text) {
  const blob = new Blob([text], { type: "text/plain;charset=utf-8" });
  const url = URL.createObjectURL(blob);
  const link = document.createElement("a");
  link.href = url;
  link.download = filename;
  document.body.appendChild(link);
  link.click();
  link.remove();
  URL.revokeObjectURL(url);
}

function downloadPack() {
  if (selectedPackItems.length === 0) {
    document.getElementById("packStatus").textContent = "Add at least one resource before downloading.";
    return;
  }

  const content = [
    "PATHKEEPER OPPORTUNITY PACK",
    "Generated: " + new Date().toLocaleString(),
    "",
    "SELECTED RESOURCES",
    ...selectedPackItems.map((item, index) => (index + 1) + ". " + item),
    "",
    "HOW TO USE THIS PACK",
    "1. Choose one resource that matches your current goal.",
    "2. Define a result you can observe or inspect.",
    "3. Record your evidence, assumptions, risks, and next action.",
    "4. Review the result and adjust your plan.",
    "",
    latestPlanText ? "LATEST STRATEGY & BACKUP PLAN\n" + latestPlanText : "No strategy plan has been generated yet.",
    "",
    "Note: This file lists selected resources and guidance. It does not contain separate PDF files or software templates unless those are provided independently."
  ].join("\n");

  downloadText("pathkeeper-opportunity-pack.txt", content);
  document.getElementById("packStatus").textContent = "Your text pack has been prepared.";
}

function generatePlan(event) {
  event.preventDefault();

  const goal = document.getElementById("planGoal").value.trim();
  const area = document.getElementById("planArea").value;
  const evidence = document.getElementById("planEvidence").value.trim() || "Not yet documented. Gather the relevant facts and existing resources.";
  const unknown = document.getElementById("planUnknown").value.trim() || "List the main assumptions and verify the most important one.";
  const experiment = document.getElementById("planExperiment").value.trim() || "Run the smallest low-risk test that can produce useful evidence.";
  const fallback = document.getElementById("planFallback").value.trim() || "Reduce the scope, choose a lower-cost alternative, and reassess using what the first test taught you.";

  latestPlanText = [
    "GOAL: " + goal,
    "FOCUS AREA: " + area,
    "",
    "STRATEGY",
    "1. Define the desired outcome and how you will recognize progress.",
    "2. Review current evidence: " + evidence,
    "3. Investigate uncertainty: " + unknown,
    "4. Run the experiment: " + experiment,
    "5. Record results, costs, time, quality, and unexpected effects.",
    "",
    "BACKUP PLAN",
    fallback,
    "",
    "REVIEW CHECKPOINT",
    "After the experiment, decide whether to continue, revise, or stop. Do not treat an untested assumption as a proven result."
  ].join("\n");

  const output = document.getElementById("planOutput");
  output.replaceChildren();
  latestPlanText.split("\n").forEach(line => {
    const p = document.createElement("p");
    p.style.margin = "6px 0";
    p.textContent = line;
    output.appendChild(p);
  });
  document.getElementById("generatedPlan").classList.remove("hidden");
}

function downloadPlan() {
  if (!latestPlanText) return;
  downloadText("pathkeeper-strategy-backup-plan.txt", latestPlanText);
}
function addPlanToPack() {
  if (!latestPlanText) return;
  addPack("Generated Strategy & Backup Plan");
  document.getElementById("planOutput").insertAdjacentText("beforeend", "\nPlan added to your resource pack.");
}

function backdropClose(event, modalId) {
  if (event.target.id === modalId) {
    document.getElementById(modalId).classList.add("hidden");
  }
}

document.addEventListener("keydown", event => {
  if (event.key === "Escape") {
    ["wizardModal", "detailsModal", "packModal"].forEach(id => {
      document.getElementById(id).classList.add("hidden");
    });
  }
});

updatePackUI();
recalculateSkills();
filterAtlas();
</script>
</body>
</html>
